// =========================================================================
// BAD TEST: code outside any function
//
// A '}' too many ends a function early, and the lines after it are code at
// file level. They used to be taken as a module declaration that swallowed
// every function after them; the error came later, as "unknown function
// 'b'". Now the first line that is not a declaration is the error.
// =========================================================================

fn a() -> i64 {
    return 1;
}
    var k: i64 = 5;
    k = k + 1;
    return k;
}

fn b() -> i64 {
    return 2;
}

fn main() {
    print(a() + b());
    return 0;
}
