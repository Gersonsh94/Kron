kron_program
kron_domain test_callback;
kron_imports
kron_definitions

extern "libc.so.6", "libSystem.B.dylib", "msvcrt.dll" {
    fn qsort(base: ptr<u8>, n: u64, size: u64, cmp: ptr<u8>) -> void;
}

var arr: [i64; 8];

fn export by_value(a: ptr<i64>, b: ptr<i64>) -> i32 {
    var x: i64 = 0;
    var y: i64 = 0;
    raw {
        x = peek(a);
        y = peek(b);
    }
    if x < y { return -1; }
    if x > y { return 1; }
    return 0;
}

fn main() -> i32 {
    arr[0] = 42; arr[1] = -5; arr[2] = 17; arr[3] = 3; arr[4] = 99; arr[5] = 0; arr[6] = 8; arr[7] = -40;
    raw {
        qsort(&arr, 8, 8, c_fn(by_value));
    }
    var i: i64 = 0;
    while i < 8 {
        print(arr[i]);
        i = i + 1;
    }
    return 0;
}
