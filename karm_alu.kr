kron_program
kron_domain karm_alu;
kron_imports
kron_definitions

// =========================================================================
// KARM: the ARM64 assembler for Kron -- mov, arithmetic, logic, shifts,
// selects and extensions
//
//   mov movz movn movk  add sub adds subs cmp cmn neg  mul madd msub sdiv
//   udiv  and orr eor ands bic orn eon tst mvn  lsl lsr asr ror  cset csel
//   csinc csneg  sxtb sxth sxtw uxtb uxth; and, orr, eor and mov on vN.16b
//
// The operands, the expressions and the emission are karm_core.kr's.
// =========================================================================

extern "kronc" {
    fn kc_nops() -> i64;
    fn kc_set_nops(n: i64) -> i64;
    fn kc_op(k: i64) -> i64;
    fn kc_opreg(k: i64) -> i64;
    fn kc_rnum() -> i64;
    fn kc_imm(k: i64) -> i64;
    fn kc_evok() -> i64;
    fn kc_clear_unres() -> i64;
    fn kc_undef_check() -> i64;
    fn kc_shiftop(t: i64) -> i64;
    fn kc_shamt() -> i64;
    fn kc_cond(t: i64) -> i64;
    fn kc_emit32(w: i64) -> i64;
    fn kc_err2(kind: i64) -> i64;
    fn kc_bad() -> i64;
    fn kc_range() -> i64;
    fn kc_need(n: i64) -> i64;
    fn kc_sf(cls: i64) -> i64;
    fn kc_rrr(base: i64, rd: i64, rn: i64, rm: i64) -> i64;
    fn kc_movimm(rd: i64, value: i64, cls: i64) -> i64;
    fn kc_copyop(k: i64, j: i64) -> i64;
    fn kc_shift_ops() -> i64;
    fn kc_zr(k: i64, cls: i64) -> i64;
}

// a < b, both taken unsigned
fn ko_ult(a: i64, b: i64) -> i64 {
    var top: i64 = 1 << 63;
    if (a ^ top) < (b ^ top) {
        return 1;
    }
    return 0;
}

// ---- mov ----------------------------------------------------------------

// mov Rd, Rm | mov Rd, #imm | mov to or from sp | mov vD.16b, vN.16b
fn ko_mov() -> i64 {
    if kc_need(2) == 0 {
        return kc_bad();
    }
    var c0: i64 = kc_opreg(0);
    var rd: i64 = kc_rnum();
    if c0 == 0 {
        return kc_bad();
    }
    if c0 == 7 {
        // mov vD.16b, vN.16b is orr vD.16b, vN.16b, vN.16b
        if kc_opreg(1) != 7 {
            return kc_bad();
        }
        return kc_rrr(0x4EA01C00, rd, kc_rnum(), kc_rnum());
    }
    var cls: i64 = c0;
    if c0 >= 3 {
        if c0 != 5 {
            return kc_bad();
        }
        return ko_mov_sp(31);
    }
    var c1: i64 = kc_opreg(1);
    if c1 == 0 {
        kc_clear_unres();
        var v: i64 = kc_imm(1);
        if kc_evok() == 0 {
            return kc_bad();
        }
        return kc_movimm(rd, v, cls);
    }
    if c1 == 5 {
        return ko_mov_sp(rd);
    }
    if c1 != cls {
        return kc_bad();
    }
    // ORR Rd, ZR, Rm
    return kc_rrr(0x2A000000 | kc_sf(cls), rd, 31, kc_rnum());
}

// ADD Rd, Rn, #0 -- one side is sp
fn ko_mov_sp(rd: i64) -> i64 {
    var c1: i64 = kc_opreg(1);
    if c1 != 5 && c1 != 1 {
        return kc_bad();
    }
    return kc_emit32(0x91000000 | ((kc_rnum() & 31) << 5) | (rd & 31));
}

// movz / movn / movk Rd, #imm16 {, lsl #s}
fn ko_movw(base: i64) -> i64 {
    var c: i64 = kc_opreg(0);
    if c != 1 && c != 2 {
        return kc_bad();
    }
    var rd: i64 = kc_rnum();
    var w: i64 = base | kc_sf(c);
    var v: i64 = kc_imm(1);
    if kc_evok() == 0 {
        return kc_bad();
    }
    if ko_ult(65535, v) != 0 {
        return kc_range();
    }
    var hw: i64 = 0;
    if kc_nops() >= 3 {
        if kc_shiftop(kc_op(2)) != 0 {
            return kc_bad();
        }
        var amt: i64 = kc_shamt();
        if (amt & 15) != 0 {
            return kc_range();
        }
        hw = amt >>> 4;
        if c == 2 {
            if hw > 1 {
                return kc_range();
            }
        } else if hw > 3 {
            return kc_range();
        }
    }
    return kc_emit32(w | (hw << 21) | (v << 5) | rd);
}

// ---- add and sub --------------------------------------------------------
// op: 0 add, 1 sub, 2 adds, 3 subs. Operands Rd, Rn, Rm{, shift #n} or #imm.
fn ko_addsub(opcode: i64) -> i64 {
    var op: i64 = opcode;
    var n: i64 = kc_nops();
    if n < 3 || n > 4 {
        return kc_bad();
    }
    var c0: i64 = kc_opreg(0);               // the class of Rd (5 = sp)
    if c0 == 0 {
        return kc_bad();
    }
    var rd: i64 = kc_rnum();
    var c1: i64 = kc_opreg(1);
    if c1 == 0 {
        return kc_bad();
    }
    var rn: i64 = kc_rnum();
    var c2: i64 = kc_opreg(2);
    if c2 != 0 {
        // register form; the width is w only when Rd is w
        var rm: i64 = kc_rnum();
        var sfw: i64 = 0x80000000;
        if c0 == 2 {
            sfw = 0;
        }
        var kind: i64 = ((op & 1) << 30) | ((op >>> 1) << 29) | sfw;
        // sp in Rd or Rn needs the extended-register form: UXTX (option
        // 011) for x, UXTW (010) for w
        if c0 == 5 || c1 == 5 {
            var ext: i64 = 0x0B206000;
            if sfw == 0 {
                ext = 0x0B204000;
            }
            return kc_rrr(ext | kind, rd, rn, rm);
        }
        // shifted register: 0x0B add, 0x4B sub, 0x2B adds, 0x6B subs
        var w: i64 = 0x0B000000 | kind;
        if n >= 4 {
            var st: i64 = kc_shiftop(kc_op(3));
            if ko_ult(2, st) != 0 {
                return kc_bad();
            }
            var amt: i64 = kc_shamt();
            if ko_ult(63, amt) != 0 {
                return kc_range();
            }
            w = w | (st << 22) | (amt << 10);
        }
        return kc_rrr(w, rd, rn, rm);
    }
    kc_clear_unres();
    var v: i64 = kc_imm(2);
    if kc_evok() == 0 {
        return kc_bad();
    }
    kc_undef_check();
    // a negative value turns add into sub and back
    if v < 0 {
        v = 0 - v;
        op = op ^ 1;
    }
    var sh: i64 = 0;
    if ko_ult(4095, v) != 0 {
        var big: i64 = 1;
        if (v & 4095) == 0 && ko_ult(4095, v >>> 12) == 0 {
            v = v >>> 12;
            sh = 1;
            big = 0;
        }
        if big != 0 {
            // out of range: still one word, so the sizes do not move
            kc_err2(3);
            v = 0;
        }
    }
    // 0x11 add, 0x51 sub, 0x31 adds, 0x71 subs
    var word: i64 = 0x11000000 | ((op & 1) << 30) | ((op >>> 1) << 29);
    if c0 != 2 {
        word = word | 0x80000000;
    }
    return kc_emit32(word | (sh << 22) | ((v & 4095) << 10) | (rn << 5) | rd);
}

// cmp Rn, op / cmn Rn, op: subs / adds with Rd = zr of the same width
fn ko_cmpn(op: i64) -> i64 {
    kc_shift_ops();
    kc_zr(0, kc_opreg(1));
    return ko_addsub(op);
}

// neg Rd, Rm: sub Rd, zr, Rm
fn ko_neg() -> i64 {
    if kc_need(2) == 0 {
        return kc_bad();
    }
    kc_copyop(1, 2);
    kc_zr(1, kc_opreg(0));
    kc_set_nops(3);
    return ko_addsub(1);
}

// ---- multiply and divide ------------------------------------------------

// Rd, Rn, Rm from operands 0..2, of one width (base is the 64-bit word):
// 1 when it was written
fn ko_three(base: i64) -> i64 {
    if kc_need(3) == 0 {
        return 0;
    }
    var w: i64 = base;
    var c: i64 = kc_opreg(0);
    if c == 2 {
        w = w & 0x7FFFFFFF;
    } else if c != 1 {
        return 0;
    }
    var rd: i64 = kc_rnum();
    if kc_opreg(1) != c {
        return 0;
    }
    var rn: i64 = kc_rnum();
    if kc_opreg(2) != c {
        return 0;
    }
    kc_rrr(w, rd, rn, kc_rnum());
    return 1;
}

// mul (MADD with zr as the addend), sdiv, udiv
fn ko_three_op(base: i64) -> i64 {
    if ko_three(base) == 0 {
        return kc_bad();
    }
    return 0;
}

// madd / msub Rd, Rn, Rm, Ra
fn ko_mfour(base: i64) -> i64 {
    if kc_need(4) == 0 {
        return kc_bad();
    }
    if kc_opreg(3) == 0 {
        return kc_bad();
    }
    var w: i64 = base | (kc_rnum() << 10);
    kc_set_nops(3);
    return ko_three_op(w);
}

// ---- logical ------------------------------------------------------------

// Vd, Vn, Vm of one vector class: 1 when the word was written
fn ko_vec3(base: i64, cls: i64) -> i64 {
    if kc_need(3) == 0 {
        return 0;
    }
    if kc_opreg(0) != cls {
        return 0;
    }
    var rd: i64 = kc_rnum();
    if kc_opreg(1) != cls {
        return 0;
    }
    var rn: i64 = kc_rnum();
    if kc_opreg(2) != cls {
        return 0;
    }
    kc_rrr(base, rd, rn, kc_rnum());
    return 1;
}

// reg: the register form (64-bit), imm: the immediate form (0 = none)
fn ko_logic(reg: i64, imm: i64) -> i64 {
    // vN.16b: three registers, no immediate
    if kc_opreg(0) == 7 {
        var v: i64 = 0;
        if reg == 0xCA000000 {
            v = 0x6E201C00;
        } else if reg == 0x8A000000 {
            v = 0x4E201C00;
        } else if reg == 0xAA000000 {
            v = 0x4EA01C00;
        } else {
            return kc_bad();
        }
        if ko_vec3(v, 7) == 0 {
            return kc_bad();
        }
        return 0;
    }
    var n: i64 = kc_nops();
    if n < 3 || n > 4 {
        return kc_bad();
    }
    var c: i64 = kc_opreg(0);
    if c == 5 {
        // only the immediate forms of and/orr/eor write sp
        c = 1;
    } else if c != 1 && c != 2 {
        return kc_bad();
    }
    var rd: i64 = kc_rnum();
    if kc_opreg(1) != c {
        return kc_bad();
    }
    var rn: i64 = kc_rnum();
    var c2: i64 = kc_opreg(2);
    if c2 != 0 {
        if c2 != c {
            return kc_bad();
        }
        var rm: i64 = kc_rnum();
        var w: i64 = reg;
        if c == 2 {
            w = w & 0x7FFFFFFF;
        }
        if n >= 4 {
            var st: i64 = kc_shiftop(kc_op(3));
            if st == -1 {
                return kc_bad();
            }
            var amt: i64 = kc_shamt();
            if ko_ult(63, amt) != 0 {
                return kc_range();
            }
            w = w | (st << 22) | (amt << 10);
        }
        return kc_rrr(w, rd, rn, rm);
    }
    if imm == 0 {
        return kc_bad();
    }
    kc_clear_unres();
    var value: i64 = kc_imm(2);
    if kc_evok() == 0 {
        return kc_bad();
    }
    kc_undef_check();
    var width: i64 = 64;
    var word: i64 = imm;
    if c == 2 {
        width = 32;
        word = word & 0x7FFFFFFF;
    }
    var m: i64 = ko_bitmask(value, width);
    if m == -1 {
        kc_err2(7);
        // still one word
        return kc_emit32(0);
    }
    return kc_emit32(word | (m << 10) | (rn << 5) | rd);
}

// N<<12 | immr<<6 | imms for a value of 32 or 64 bits, or -1 when it is
// not a repeated rotated run of ones
fn ko_bitmask(value: i64, width: i64) -> i64 {
    var v: i64 = value;
    if width == 32 {
        // replicate the 32-bit value so the search below works on 64 bits
        v = v & 0xFFFFFFFF;
        v = v | (v << 32);
    }
    if v == 0 || v == -1 {
        return -1;
    }
    // the smallest element size e that repeats across 64 bits
    var e: i64 = 2;
    var mask: i64 = 0;
    var el: i64 = 0;
    while true {
        if e > 64 || e > width {
            return -1;
        }
        mask = -1;
        if e != 64 {
            mask = (1 << e) - 1;
        }
        el = v & mask;
        var r: i64 = el;
        var s: i64 = e;
        while s < 64 {
            r = r | (r << s);
            s = s * 2;
        }
        if r == v {
            break;
        }
        e = e * 2;
    }
    // ones must be 1..e-1, and the element a rotation of (1<<ones)-1
    var ones: i64 = 0;
    var x: i64 = el;
    while x != 0 {
        ones = ones + (x & 1);
        x = x >>> 1;
    }
    if ones == 0 || ones >= e {
        return -1;
    }
    var run: i64 = (1 << ones) - 1;
    var rot: i64 = 0;
    while true {
        if rot >= e {
            return -1;
        }
        var a: i64 = run >>> rot;
        var b: i64 = 0;
        if e - rot < 64 {
            b = run << (e - rot);
        }
        if ((a | b) & mask) == el {
            break;
        }
        rot = rot + 1;
    }
    // imms = (~(e*2 - 1) & 0x3F) | (ones - 1); N = 1 for e = 64
    var imms: i64 = (~(e * 2 - 1) & 63) | (ones - 1);
    var nbit: i64 = 0;
    if e == 64 {
        nbit = 1;
        imms = ones - 1;
    }
    return (nbit << 12) | (rot << 6) | imms;
}

// tst Rn, op: ands zr, Rn, op
fn ko_tst() -> i64 {
    kc_shift_ops();
    kc_zr(0, kc_opreg(1));
    return ko_logic(0xEA000000, 0xF2000000);
}

// mvn Rd, Rm{, shift}: orn Rd, zr, Rm{, shift}
fn ko_mvn() -> i64 {
    var n: i64 = kc_nops();
    if n < 2 || n > 3 {
        return kc_bad();
    }
    if n == 3 {
        kc_copyop(2, 3);
    }
    kc_copyop(1, 2);
    kc_set_nops(n + 1);
    kc_zr(1, kc_opreg(0));
    return ko_logic(0xAA200000, 0);
}

// ---- shifts -------------------------------------------------------------
// lsl/lsr/asr/ror (kind 0..3) Rd, Rn, Rm  -> LSLV & co.
// lsl/lsr/asr/ror Rd, Rn, #s  -> UBFM / SBFM / EXTR
fn ko_shift(kind: i64) -> i64 {
    if kc_need(3) == 0 {
        return kc_bad();
    }
    if kc_opreg(2) != 0 {
        // register: 0x9AC02000 + type * 0x400
        return ko_three_op(0x9AC02000 | (kind << 10));
    }
    var c: i64 = kc_opreg(0);
    if c != 1 && c != 2 {
        return kc_bad();
    }
    var rd: i64 = kc_rnum();
    if kc_opreg(1) != c {
        return kc_bad();
    }
    var rn: i64 = kc_rnum();
    var s: i64 = kc_imm(2);
    if kc_evok() == 0 {
        return kc_bad();
    }
    var top: i64 = 63;
    var ubfm: i64 = 0xD3400000;           // UBFM x (N=1)
    var sbfm: i64 = 0x93400000;           // SBFM x
    var extr: i64 = 0x93C00000;           // EXTR x
    if c == 2 {
        top = 31;
        ubfm = 0x53000000;
        sbfm = 0x13000000;
        extr = 0x13800000;
    }
    if ko_ult(top, s) != 0 {
        kc_err2(3);
        return kc_emit32(0);
    }
    var w: i64 = 0;
    if kind == 0 {
        // immr = (-s) mod width, imms = width-1-s
        w = ubfm | ((((top + 1) - s) & top) << 16) | ((top - s) << 10);
    } else if kind == 1 {
        w = ubfm | (s << 16) | (top << 10);
    } else if kind == 2 {
        w = sbfm | (s << 16) | (top << 10);
    } else {
        // ror: EXTR Rd, Rn, Rn, #s
        w = extr | (rn << 16) | (s << 10);
    }
    return kc_emit32(w | (rn << 5) | rd);
}

// ---- conditional select and extensions ----------------------------------

// cset Rd, cond: CSINC Rd, zr, zr, invert(cond)
fn ko_cset() -> i64 {
    if kc_need(2) == 0 {
        return kc_bad();
    }
    var c: i64 = kc_opreg(0);
    if c != 1 && c != 2 {
        return kc_bad();
    }
    var rd: i64 = kc_rnum();
    var cc: i64 = kc_cond(kc_op(1));
    if ko_ult(cc, 14) == 0 {
        return kc_bad();
    }
    return kc_emit32(0x1A9F07E0 | kc_sf(c) | ((cc ^ 1) << 12) | rd);
}

// csel/csinc/csneg Rd, Rn, Rm, cond
fn ko_csx(base: i64) -> i64 {
    if kc_need(4) == 0 {
        return kc_bad();
    }
    var cc: i64 = kc_cond(kc_op(3));
    if cc == -1 {
        return kc_bad();
    }
    kc_set_nops(3);
    return ko_three_op(base | (cc << 12));
}

// sxtb/sxth Rd, Wn (Rd x or w), sxtw Xd, Wn, uxtb/uxth Wd, Wn:
// SBFM / UBFM Rd, Rn, #0, #imms
fn ko_ext(imms: i64, signed: i64) -> i64 {
    if kc_need(2) == 0 {
        return kc_bad();
    }
    var c: i64 = kc_opreg(0);
    if c != 1 && c != 2 {
        return kc_bad();
    }
    var rd: i64 = kc_rnum();
    if kc_opreg(1) != 2 {
        return kc_bad();
    }
    var rn: i64 = kc_rnum();
    // the unsigned forms write a w register (the upper half is zeroed)
    var w: i64 = 0x53000000;
    if signed != 0 {
        w = 0x13000000;
        if c == 1 {
            w = 0x93400000;
        }
    }
    return kc_emit32(w | (imms << 10) | (rn << 5) | rd);
}
