kron_program
kron_domain test_garray_bad;
kron_imports
kron_definitions

// =========================================================================
// BAD TEST: a global array that starts from a computed value
//
// Its first values are data written into the program; only numbers
// written out can be. It used to start at zero without a word.
// =========================================================================

var base: i64 = 10;
var table: [i64; 3] = [1, base + 1, 3];

fn main() -> i64 {
    print(table[1]);
    return 0;
}
