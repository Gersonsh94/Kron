kron_program
kron_domain test_fnvalues;
kron_imports
acquire_domain "std_text.kr";
kron_definitions

// =========================================================================
// TEST: functions as values
//
// A function's name is a value; fn(...) { ... } written in an expression is
// one too, keeping the values of the variables around it that it uses, as
// they were when it was made. Either is called like any function.
// =========================================================================

var hook: fn(i64) -> i64;

fn twice(x: i64) -> i64 {
    return x * 2;
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn make_adder(n: i64) -> fn(i64) -> i64 {
    return fn(x: i64) -> i64 { return x + n; };
}

fn map_list(l: list<i64>, f: fn(i64) -> i64) -> list<i64> {
    var out: list<i64>;
    for v in l {
        list_add(out, f(v));
    }
    return out;
}

fn main() {
    print(apply(twice, 21));                     // 42
    var f = twice;
    print(f(5));                                 // 10
    var add10 = make_adder(10);
    var add3 = make_adder(3);
    print(add10(1) + add3(1));                   // 15
    print(apply(add3, 4));                       // 7

    var k: i64 = 100;
    var plus_k = fn(x: i64) -> i64 { return x + k; };
    k = 1;                                       // the fn kept 100
    print(plus_k(5));                            // 105

    var scale: f64 = 1.5;
    var times = fn(x: f64) -> f64 { return x * scale; };
    print(times(4.0));                           // 6.000000

    var who: text = "Ana";
    var hello = fn(greeting: text) -> text { return greeting + ", " + who; };
    print(hello("Hi"));                          // Hi, Ana

    var sq = map_list([1, 2, 3], fn(x: i64) -> i64 { return x * x; });
    print(sq);                                   // [1, 4, 9]

    hook = add10;
    print(hook(32));                             // 42

    var count: i64 = 0;
    var many = fn(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
        return a + b + c + d + e + count;
    };
    print(many(1, 2, 3, 4, 5));                  // 15

    var outer: i64 = 7;
    var nest = fn(x: i64) -> i64 {
        var inner = fn(y: i64) -> i64 { return y * outer; };
        return inner(x) + 1;
    };
    print(nest(6));                              // 43
    return 0;
}
