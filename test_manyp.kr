kron_program
kron_domain test_manyp;
kron_imports
kron_definitions

// More than six parameters. The first six travel in registers; from the seventh
// on, on the stack, and the callee finds them past the shadow space.
//
// Expected output:
//   36     sum of eight integers
//   8      the eighth arrives intact
//   7      so does the seventh
//   1      and the first was not lost on the way
//   45     nine parameters
//   21     six still work as always

fn eight(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return a + b + c + d + e + f + g + h;
}

fn eighth(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return h;
}

fn seventh(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return g;
}

fn first(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return a;
}

fn nine(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64 {
    return a + b + c + d + e + f + g + h + i;
}

fn six(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    return a + b + c + d + e + f;
}

fn main() {
    print(eight(1, 2, 3, 4, 5, 6, 7, 8));       // 36
    print(eighth(1, 2, 3, 4, 5, 6, 7, 8));     // 8
    print(seventh(1, 2, 3, 4, 5, 6, 7, 8));    // 7
    print(first(1, 2, 3, 4, 5, 6, 7, 8));    // 1
    print(nine(1, 2, 3, 4, 5, 6, 7, 8, 9));   // 45
    print(six(1, 2, 3, 4, 5, 6));             // 21
    return 0;
}
