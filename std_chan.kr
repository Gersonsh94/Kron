kron_program
kron_domain std_chan;
kron_imports
kron_definitions

// =========================================================================
// Kron standard library -- channels.
//
// Threads talk through channels instead of sharing variables. A channel is
// a bounded FIFO queue of i64: chan_send puts a value at the back, chan_recv
// takes one from the front. A full channel makes the sender wait; an empty
// one makes the receiver wait.
//
//   chan_new(capacity)     a new channel; returns its number
//   chan_send(c, v)        1, or a fail if the channel is closed
//   chan_recv(c, out)      1 and the value in out[0]; 0 when the channel is
//                          closed and nothing is left in it
//   chan_close(c)          no more sends; receivers drain what is left
//   chan_len(c)            values waiting in the channel right now
//
// chan_recv reports the end of the channel through its return value, not
// through fail, on purpose: the fail flag is one variable shared by every
// thread, so two threads failing at once would read each other's failure.
// The value goes into an array the caller passes, which each thread owns:
//
//     var got: [i64; 1];
//     while chan_recv(c, got) == 1 { ... got[0] ... }
//
// Every global here is 'shared var': channels exist to be used from threads,
// and each access to them is guarded by the channel's lock.
//
// Locks 8 to 15 belong to the channels: programs use locks 0 to 7. Channel c
// is guarded by lock 8 + (c & 7); a lock guarding several channels is still
// correct.
//
// A thread waiting on a full or empty channel calls thread_yield() between
// tries, so it gives its time slice to other threads instead of keeping a
// core busy.
//
// This is step 1: plain functions. The syntax comes later.
// =========================================================================

const CH_MAX: i64 = 64;             // channels at once
const CH_POOL: i64 = 1048576;       // slots in the pool: 8 MB

shared var ch_pool: [i64; 1048576];        // every channel's slots, in .bss
shared var ch_base: [i64; 64];             // where each channel's slots start
shared var ch_cap: [i64; 64];              // how many slots it has
shared var ch_head: [i64; 64];             // next slot to read
shared var ch_tail: [i64; 64];             // next slot to write
shared var ch_count: [i64; 64];            // values waiting
shared var ch_closed: [i64; 64];           // 1 after chan_close
shared var ch_used: i64;                   // channels handed out
shared var ch_top: i64;                    // first slot of the pool not given out
shared var ch_ready: i64;                  // 1 once the channel locks exist

// A new channel with room for `capacity` values. Create channels before
// starting the threads that use them.
fn chan_new(capacity: i64) -> i64 {
    var c: i64 = 0;
    var k: i64 = 0;
    if capacity <= 0 {
        fail "channel of zero or negative capacity" hint "ask for at least one slot";
    }
    if ch_ready == 0 {
        k = 8;
        while k < 16 {
            lock_init(k);
            k = k + 1;
        }
        ch_ready = 1;
    }
    if ch_used >= CH_MAX {
        fail "no free channels left" hint "there are 64 at once";
    }
    if ch_top + capacity > CH_POOL {
        fail "no room left for the channel" hint "the pool holds one million slots in total";
    }
    c = ch_used;
    ch_base[c] = ch_top;
    ch_cap[c] = capacity;
    ch_head[c] = 0;
    ch_tail[c] = 0;
    ch_count[c] = 0;
    ch_closed[c] = 0;
    ch_top = ch_top + capacity;
    ch_used = ch_used + 1;
    return c;
}

// Put v at the back of channel c, waiting while it is full.
fn chan_send(c: i64, v: i64) -> i64 {
    var lk: i64 = 8 + (c & 7);
    var done: i64 = 0;
    if c < 0 {
        fail "no such channel" hint "use the number chan_new returned";
    }
    if c >= ch_used {
        fail "no such channel" hint "use the number chan_new returned";
    }
    while done == 0 {
        lock_take(lk);
        if ch_closed[c] != 0 {
            lock_give(lk);
            fail "send on a closed channel" hint "close a channel only when every sender is done";
        }
        if ch_count[c] < ch_cap[c] {
            ch_pool[ch_base[c] + ch_tail[c]] = v;
            ch_tail[c] = ch_tail[c] + 1;
            if ch_tail[c] == ch_cap[c] {
                ch_tail[c] = 0;
            }
            ch_count[c] = ch_count[c] + 1;
            done = 1;
        }
        lock_give(lk);
        if done == 0 {
            thread_yield();
        }
    }
    return 1;
}

// Take the value at the front of channel c into out[0], waiting while it is
// empty. Returns 1 with a value, 0 when the channel is closed and empty.
fn chan_recv(c: i64, out: [i64; 1]) -> i64 {
    var lk: i64 = 8 + (c & 7);
    var result: i64 = 2;               // 2 = still waiting
    if c < 0 {
        fail "no such channel" hint "use the number chan_new returned";
    }
    if c >= ch_used {
        fail "no such channel" hint "use the number chan_new returned";
    }
    while result == 2 {
        lock_take(lk);
        if ch_count[c] > 0 {
            out[0] = ch_pool[ch_base[c] + ch_head[c]];
            ch_head[c] = ch_head[c] + 1;
            if ch_head[c] == ch_cap[c] {
                ch_head[c] = 0;
            }
            ch_count[c] = ch_count[c] - 1;
            result = 1;
        } else {
            if ch_closed[c] != 0 {
                result = 0;
            }
        }
        lock_give(lk);
        if result == 2 {
            thread_yield();
        }
    }
    return result;
}

// No more sends on channel c. Values already in it can still be received.
fn chan_close(c: i64) -> i64 {
    var lk: i64 = 8 + (c & 7);
    if c < 0 {
        fail "no such channel" hint "use the number chan_new returned";
    }
    if c >= ch_used {
        fail "no such channel" hint "use the number chan_new returned";
    }
    lock_take(lk);
    ch_closed[c] = 1;
    lock_give(lk);
    return 0;
}

// Values waiting in channel c right now.
fn chan_len(c: i64) -> i64 {
    var lk: i64 = 8 + (c & 7);
    var n: i64 = 0;
    if c < 0 {
        fail "no such channel" hint "use the number chan_new returned";
    }
    if c >= ch_used {
        fail "no such channel" hint "use the number chan_new returned";
    }
    lock_take(lk);
    n = ch_count[c];
    lock_give(lk);
    return n;
}
