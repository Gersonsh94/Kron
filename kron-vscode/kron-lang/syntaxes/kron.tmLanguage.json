{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kron",
  "scopeName": "source.kron",
  "fileTypes": [
    "kr"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#header"
    },
    {
      "include": "#fndef"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#constants"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kron",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.kron",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.kron",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.kron",
      "match": "'(?:\\\\.|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kron",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.float.kron",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.kron",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "header": {
      "patterns": [
        {
          "name": "keyword.control.directive.kron",
          "match": "\\b(?:kron_definitions|acquire_domain|kron_program|kron_imports|kron_domain)\\b"
        }
      ]
    },
    "fndef": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.kron"
        },
        "2": {
          "name": "entity.name.function.kron"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kron",
          "match": "\\b(?:continue|default|return|switch|while|break|range|else|loop|case|for|if|in)\\b"
        },
        {
          "name": "storage.type.kron",
          "match": "\\b(?:private|aliased|struct|import|export|extern|module|public|delete|shared|const|enum|from|var|new|fn|as)\\b"
        },
        {
          "name": "support.type.primitive.kron",
          "match": "\\b(?:ArenaAllocationToken|physical_ptr|hardware_bit|utf8_stream|virtual_ptr|register16|register32|register64|register8|uint16|uint32|uint64|real32|real64|stream|int16|int32|int64|uint8|slice|int8|bool|void|text|list|map|str|i16|i32|i64|u16|u32|u64|f32|f64|ptr|i8|u8)\\b"
        },
        {
          "name": "keyword.other.unsafe.kron",
          "match": "\\b(?:dll_load|dll_proc|invcache|prefetch|syscall|c_call|peek16|peek32|poke16|poke32|c_fn|peek8|poke8|peek|poke|outb|raw|asm|inb)\\b"
        },
        {
          "name": "keyword.control.exception.kron",
          "match": "\\b(?:print_fail|failed|fail|hint)\\b"
        },
        {
          "name": "support.function.builtin.kron",
          "match": "\\b(?:ticks_per_sec|thread_start|thread_yield|thread_wait|vec2_store|readmouse|cpu_count|lock_init|lock_take|lock_give|vec2_load|loadfile|savefile|vec2_add|vec2_sub|vec2_mul|target_os|readkey|printc|mousex|mousey|sizeof|print|trunc|ticks|beep|rotl|rotr)\\b"
        },
        {
          "name": "keyword.other.system.kron",
          "match": "\\b(?:kron_isa_dynamic|kron_hypervisor|kron3d_context|filesystem|deployment|scheduler|netkernel|execution|syscalls|security|packages|driver|kernel|loader|power|epoch|boot|ring|call|mmu|isr|dma|hmi)\\b"
        }
      ]
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.kron"
        }
      }
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.kron",
          "match": "\\b(?:false|true|null)\\b"
        },
        {
          "name": "constant.other.kron",
          "match": "\\b[A-Z][A-Z0-9_]{1,}\\b"
        }
      ]
    }
  }
}
