kron_program
kron_domain cg_run;
kron_imports
kron_definitions

// =========================================================================
// THE PROGRAM: THE PRE-PASS, THE WALK, AND WHAT COMES AFTER IT
// =========================================================================

// cg_run(root) -> 1 written, 0 an error (a type error in cg_err_msg, a
// thread error in cg_thread_tok), below 0 an internal one: -dbg_which
fn cg_run(root: ptr<Ast>) -> i64 {
    var p: ptr<Ast> = 0;
    var d: ptr<Ast> = 0;
    var k: i64 = 0;
    var t: i64 = 0;
    cg_root = root;
    pending_struct = -1;
    cg_pool_n = 0;
    lq_n = 0;
    lq_done = 0;
    cg_lam_cur = -1;
    cg_in_raw = 0;
    ld_done = 0;
    // A module has no preamble: it is text for the compiler's own build,
    // which has its own entry, and like bare metal it has no runtime -- no
    // failure traces, no debugger hooks, no system libraries.
    if cg_as_module != 0 {
        cg_bare = 1;
        emit_cstr("; A Kron module, written by kronc --module. Edit the .kr file it comes\n; from, not this one: the build makes it again.\n");
    } else if cg_target == TARGET_ELF {
        cg_emit_hdrelf();
        cg_emit_hdrtrace();
    } else if cg_bare != 0 {
        cg_emit_hdrbare();
    } else {
        cg_emit_hdr();
        cg_emit_hdrtrace();
    }
    // the pre-pass: every function name, so &fn resolves in any order;
    // structs and enums, so a field may be of a type declared further down;
    // every global with its 'shared' mark; the extern blocks
    fn_count = 0;
    gs_count = 0;
    ce_count = 0;
    ie_count = 0;
    sl_count = 0;
    sl_full = 0;
    cg_ext_count = 0;
    cg_ext_any = 0;
    cg_has_exp = 0;
    cg_cur_fn = -1;
    cg_dyn_thread = 0;
    cg_thread_tok = 0;
    p = root;
    while p != 0 {
        if p.node_type != AST_PROGRAM {
            break;
        }
        d = p.left;
        if d != 0 {
            k = d.node_type;
            if k == AST_STRUCT_DEF {
                cg_register_struct_name(d);
            } else if k == AST_ENUM_DEF {
                cg_register_enum(d);
            } else if k == AST_VAR_DECL {
                if gs_count < CG_MAX_GLOBALS {
                    cg_qs(&gs_toks, gs_count, d.data);
                    cg_qs(&gs_shared, gs_count, (d.col >> 2) & 1);
                    gs_count += 1;
                }
            } else if k == AST_EXTERN {
                cg_register_externs(d);
            } else if k == AST_FUNCTION {
                if (d.type_info & 0xFFFF) == VIS_EXPORTED {
                    cg_has_exp = 1;
                }
                if d.data != 0 && cg_err_msg == 0 && cg_is_regname(d.data) != 0 {
                    cg_err_tok = d.data;
                    cg_err_msg = "a function cannot take the name of a register of the processor ";
                    cg_err_hint = "  hint: give it another name: the assembly the compiler writes calls a function by its name\r\n";
                    cg_had_error = 1;
                }
                if d.data != 0 && fn_count < CG_MAX_FUNCS {
                    if (d.type_info & 0xFFFF) == VIS_EXPORTED {
                        cg_qs8(&fn_export, fn_count, 1);
                    }
                    cg_qs(&fn_toks, fn_count, d.data);
                    cg_qs(&fn_nodes, fn_count, d);
                    cg_qs(&fn_ret_unsig, fn_count, (d.col >> 1) & 1);
                    cg_qs(&fn_ret_vtag, fn_count, d.col >> 8);
                    cg_qs(&fn_multi, fn_count, d.child_count);
                    cg_qs(&fn_ret_float, fn_count, d.col & 1);
                    fn_count += 1;
                }
            }
        }
        p = p.right;
    }
    // every global, now that every struct name is known
    p = root;
    while p != 0 {
        if p.node_type != AST_PROGRAM {
            break;
        }
        d = p.left;
        if d != 0 {
            if d.node_type == AST_VAR_DECL || d.node_type == AST_CONST_DECL {
                cg_global_note(d);
            }
        }
        p = p.right;
    }
    // The fields, measured. Sizing 'Box { min: Vec3; }' needs Vec3's size,
    // which may be measured later in the file: the pass is repeated, from
    // scratch each time, four rounds for four levels of nesting.
    struct_rounds = 4;
    while struct_rounds > 0 {
        field_count = 2;                     // fields 0 and 1 are stream's
        p = root;
        while p != 0 {
            if p.node_type != AST_PROGRAM {
                break;
            }
            d = p.left;
            if d != 0 {
                if d.node_type == AST_STRUCT_DEF {
                    cg_register_struct(d);
                }
            }
            p = p.right;
        }
        struct_rounds -= 1;
    }
    // the walk: functions to .text, the TITAN modules to real data
    kt_program_begin();
    cg_walk_top(root);
    if cg_lib != 0 || cg_has_exp != 0 {
        cg_emit_lib();
    }
    kt_program_end();
    kdb_program_end();
    cg_module_check();
    // what C calls into, after the program's own functions (outside the
    // range a failure's trace walks)
    if cg_lib != 0 || cg_has_exp != 0 {
        cg_emit_hdrlib();
        if cg_target == TARGET_ELF {
            cg_emit_hdrlib_elf();
        } else {
            cg_emit_hdrlib_win();
        }
    }
    cg_emit_fnrecs();
    cg_emit_extrecs();
    if cg_had_error != 0 {
        return 0 - dbg_which;
    }
    // code that can run in a thread may only touch 'shared' globals
    t = cg_thread_check();
    cg_thread_tok = t;
    if t != 0 {
        return 0;
    }
    return 1;
}

// the top of the program: every function, module, global and TITAN block
fn cg_walk_top(p: ptr<Ast>) -> i64 {
    var d: ptr<Ast> = 0;
    var k: i64 = 0;
    while p != 0 {
        if p.node_type != AST_PROGRAM {
            break;
        }
        d = p.left;
        if d != 0 {
            k = d.node_type;
            if k == AST_FUNCTION {
                cg_function(d);
                cg_drain_lambdas();
            } else if k == AST_HARDWARE_BLOCK {
                cg_module(d);
            } else if k == AST_VAR_DECL || k == AST_CONST_DECL {
                cg_global_decl(d);
            } else if k == AST_ISA_DEF {
                cg_isa(d);
            } else if k == AST_BOOT_DEF {
                cg_boot(d);
            } else if k == AST_MMU_DEF {
                cg_mmu(d);
            } else if k == AST_ISR_DEF {
                cg_isr_routine(d);
            } else if k == AST_CFG_DEF {
                cg_config(d);
            } else if k == AST_SCHED_DEF {
                cg_sched(d);
            } else if k == AST_SYS_DEF {
                cg_sys(d);
            }
        }
        p = p.right;
    }
    return 0;
}

// =========================================================================
// THE THREAD CHECK
// Code that can run in a thread may only touch globals declared 'shared
// var'. While emitting, the code generator notes who calls whom, which
// functions start threads, whose address is taken, and each function's
// first access to a global that is not shared. After the last function,
// cg_thread_check works out which functions can run in a thread -- the ones
// passed to thread_start and all they call -- and returns the offending
// access, if any. A call to an address could go anywhere: once reachable
// code makes one, every function whose address is taken is reachable too. A
// call through a fn value reaches only the functions used as values that
// take the same arguments: as many, the reals where its reals are.
// =========================================================================

// a global's name, its access noted
fn cg_emit_gtok(t: i64) -> i64 {
    cg_note_global(t);
    return emit_tok(t);
}

// the first access of the current function to a global that is not shared
fn cg_note_global(t: i64) -> i64 {
    var f: i64 = cg_cur_fn;
    var i: i64 = 0;
    if f < 0 || f >= CG_MAX_FUNCS {
        return 0;
    }
    if cg_q(&fn_gtok, f) != 0 {
        return 0;
    }
    while i < gs_count {
        if tok_equal(t, cg_q(&gs_toks, i)) == 1 {
            if cg_q(&gs_shared, i) == 0 {
                cg_qs(&fn_gtok, f, t);
            }
            return 0;
        }
        i += 1;
    }
    return 0;
}

// a call edge from the current function to the one a token names
fn cg_note_call(t: i64) -> i64 {
    var fr: i64 = cg_cur_fn;
    var to: i64 = 0;
    to = cg_find_func(t);
    if to >= 0 && to < CG_MAX_FUNCS {
        cg_qs(&fn_ncall, to, cg_q(&fn_ncall, to) + 1);
    }
    if fr < 0 {
        return 0;
    }
    if to < 0 {
        return 0;
    }
    if ce_count >= CG_MAX_EDGES {
        return 0;
    }
    cg_qs(&ce_from, ce_count, fr);
    cg_qs(&ce_to, ce_count, to);
    ce_count += 1;
    return 0;
}

// function f's address is taken
fn cg_note_addr(f: i64) -> i64 {
    if f >= 0 && f < CG_MAX_FUNCS {
        cg_qs(&fn_addr, f, 1);
        cg_qs8(&fn_vesc, f, 1);
    }
    return 0;
}

// the current function makes an indirect call to an address: it could be
// any function whose address is taken
fn cg_note_indirect() -> i64 {
    if cg_cur_fn >= 0 {
        cg_qs(&fn_indir, cg_cur_fn, 1);
    }
    return 0;
}

// the shape of a call or of a function: how many arguments, and which of
// them are reals (a bit each)
fn cg_shape(n: i64, reals: i64) -> i64 {
    return n | (reals << 8);
}

// the shape a function takes
fn cg_fn_key(f: i64) -> i64 {
    var fnode: ptr<Ast> = cg_q(&fn_nodes, f);
    var p: ptr<Ast> = 0;
    var n: i64 = 0;
    var reals: i64 = 0;
    if fnode == 0 {
        return -1;
    }
    p = fnode.left;
    while p != 0 {
        // a fn written as a value: its record, the last, is not an argument
        if p.right == 0 && cg_q8(&fn_islam, f) != 0 {
            return cg_shape(n, reals);
        }
        if n < 48 && (p.col & 1) != 0 {
            reals = reals | (1 << n);
        }
        n += 1;
        p = p.right;
    }
    return cg_shape(n, reals);
}

// 1 for a global declared shared, 0 for one that is not, -1 for no global
fn cg_global_shared(t: i64) -> i64 {
    var i: i64 = 0;
    while i < gs_count {
        if tok_equal(t, cg_q(&gs_toks, i)) == 1 {
            if cg_q(&gs_shared, i) != 0 { return 1; }
            return 0;
        }
        i += 1;
    }
    return -1;
}

// the parameter of the current function a name is, from 0; -1 for none
fn cg_param_index(t: i64) -> i64 {
    var fnode: ptr<Ast> = 0;
    var p: ptr<Ast> = 0;
    var k: i64 = 0;
    if cg_cur_fn < 0 || cg_lam_cur != -1 { return -1; }
    fnode = cg_q(&fn_nodes, cg_cur_fn);
    if fnode == 0 { return -1; }
    p = fnode.left;
    while p != 0 {
        if tok_equal(p.data, t) == 1 { return k; }
        k += 1;
        p = p.right;
    }
    return -1;
}

// a parameter of the current function read other than to be stored in a
// global that is not shared
fn cg_param_escapes(t: i64) -> i64 {
    var k: i64 = cg_param_index(t);
    if k >= 0 && k < 8 && cg_cur_fn < 4096 {
        cg_qs8(&pe_esc, cg_cur_fn * 8 + k, 1);
    }
    return 0;
}

fn cg_qs8(base: i64, i: i64, v: i64) -> i64 {
    raw { poke8(base + i, v); }
    return 0;
}

fn cg_q8(base: i64, i: i64) -> i64 {
    var v: i64 = 0;
    raw { v = peek8(base + i); }
    return v;
}

// 1 when node n is an argument being given as it is
fn cg_vd_has(n: ptr<Ast>) -> i64 {
    var i: i64 = 0;
    while i < cg_vd_n {
        if cg_q(&cg_vd_nodes, i) == n { return 1; }
        i += 1;
    }
    return 0;
}

// a call of function f: each argument that is a function's name, noted as
// going to f's parameter (and kept from counting as a value let loose)
fn cg_note_value_args(c: ptr<Ast>, f: i64) -> i64 {
    var a: ptr<Ast> = c.right;
    var k: i64 = 0;
    var g: i64 = 0;
    var e: ptr<Ast> = 0;
    while a != 0 {
        e = a.left;
        if e != 0 && e.node_type == AST_IDENTIFIER && k < 8 {
            if cg_find_var_idx(e.data) == -1 && cg_find_global(e.data) == -1 {
                g = cg_find_func(e.data);
                if g != -1 && vu_count < 16384 && cg_vd_n < 256 {
                    cg_qs(&vu_fn, vu_count, g);
                    cg_qs(&vu_to, vu_count, f * 8 + k);
                    vu_count += 1;
                    cg_qs(&cg_vd_nodes, cg_vd_n, e);
                    cg_vd_n += 1;
                }
            }
        }
        k += 1;
        a = a.right;
    }
    return 0;
}

// 1 when no call through a value in a thread can reach function j: its
// value only went, as it is, to parameters only stored in globals that
// are not shared
fn cg_fn_contained(j: i64) -> i64 {
    var i: i64 = 0;
    var any: i64 = 0;
    if cg_q8(&fn_vesc, j) != 0 { return 0; }
    while i < vu_count {
        if cg_q(&vu_fn, i) == j {
            if cg_q8(&pe_esc, cg_q(&vu_to, i)) != 0 { return 0; }
            any = 1;
        }
        i += 1;
    }
    return any;
}

// ---------------------------------------------------- fn values' sources ---
// A global or a parameter that holds a fn value is a slot: a call through
// it can call only what was put in it. What is put in it is noted as the
// program is written out -- an assignment, a global's first value, an
// argument of a direct call -- and when every way into a slot is known,
// the thread check takes only those functions as what a call through it
// reaches (task_for's job in its shared global, say, reaches the jobs
// given to task_for and no other function of that shape).
const SL_G: i64 = 1073741824;                // a global: SL_G + its index
const SL_P: i64 = 2147483648;                // a parameter: SL_P + F * 64 + k
const SL_F: i64 = 3221225472;                // a function: SL_F + its index
const SL_OPEN: i64 = 4294967296;             // anything else

// the slot a name is in the current function: one of its parameters, or
// a global no local hides; 0 for anything else (a local, a lambda's own)
fn cg_slot_of(t: i64) -> i64 {
    var k: i64 = 0;
    var g: i64 = 0;
    if t == 0 { return 0; }
    k = cg_param_index(t);
    if k >= 0 {
        if k < 64 && cg_cur_fn >= 0 && cg_cur_fn < CG_MAX_FUNCS {
            return SL_P + cg_cur_fn * 64 + k;
        }
        return 0;
    }
    if cg_find_var_idx(t) != -1 { return 0; }
    g = cg_find_global(t);
    if g >= 0 && g < CG_MAX_GLOBALS { return SL_G + g; }
    return 0;
}

// where the value of e comes from: a function, a slot holding a fn value,
// or SL_OPEN
fn cg_slot_src(e: ptr<Ast>) -> i64 {
    var f: i64 = 0;
    var s: i64 = 0;
    if e == 0 { return SL_OPEN; }
    if e.node_type != AST_IDENTIFIER { return SL_OPEN; }
    if cg_find_var_idx(e.data) == -1 && cg_find_global(e.data) == -1 {
        f = cg_find_func(e.data);
        if f >= 0 && f < CG_MAX_FUNCS { return SL_F + f; }
        return SL_OPEN;
    }
    if (cg_vtag_of_name(e.data) & 15) != 5 { return SL_OPEN; }
    s = cg_slot_of(e.data);
    if s != 0 { return s; }
    return SL_OPEN;
}

// slot dst may hold anything
fn cg_slot_open(dst: i64) -> i64 {
    if dst >= SL_P {
        cg_qs8(&sl_popen, dst - SL_P, 1);
    } else if dst >= SL_G {
        cg_qs8(&sl_gopen, dst - SL_G, 1);
    }
    return 0;
}

// slot dst takes what src is
fn cg_slot_edge(dst: i64, src: i64) -> i64 {
    if src == SL_OPEN { return cg_slot_open(dst); }
    if sl_count >= 16384 {
        sl_full = 1;
        return 0;
    }
    cg_qs(&sl_dst, sl_count, dst);
    cg_qs(&sl_src, sl_count, src);
    sl_count += 1;
    return 0;
}

// name t = e (an assignment, or a global's first value): noted when t is a
// slot holding a fn value
fn cg_slot_store(t: i64, e: ptr<Ast>) -> i64 {
    var dst: i64 = cg_slot_of(t);
    if dst == 0 { return 0; }
    if (cg_vtag_of_name(t) & 15) != 5 { return 0; }
    return cg_slot_edge(dst, cg_slot_src(e));
}

// a slot written some way not followed: multiple results, its address taken
fn cg_slot_lost(t: i64) -> i64 {
    var dst: i64 = cg_slot_of(t);
    if dst != 0 { cg_slot_open(dst); }
    return 0;
}

// a direct call of f: what each of its parameters takes
fn cg_slot_args(c: ptr<Ast>, f: i64) -> i64 {
    var a: ptr<Ast> = c.right;
    var k: i64 = 0;
    var src: i64 = 0;
    if f < 0 || f >= CG_MAX_FUNCS { return 0; }
    cg_qs(&fn_nrec, f, cg_q(&fn_nrec, f) + 1);
    while a != 0 && k < 64 {
        src = cg_slot_src(a.left);
        if src == SL_OPEN {
            cg_qs8(&sl_popen, f * 64 + k, 1);
        } else {
            cg_slot_edge(SL_P + f * 64 + k, src);
        }
        k += 1;
        a = a.right;
    }
    return 0;
}

// 1 when slot s may hold a value whose origin is not followed
fn cg_slot_unknown(s: i64) -> i64 {
    var f: i64 = 0;
    var k: i64 = 0;
    if s >= SL_P {
        f = (s - SL_P) / 64;
        k = (s - SL_P) % 64;
        if cg_q8(&sl_popen, f * 64 + k) != 0 { return 1; }
        // a function that is a value, a thread's start or main is called
        // with arguments nobody here wrote down, and so is an exported one
        if cg_q(&fn_asval, f) != 0 || cg_q(&fn_addr, f) != 0 || cg_q(&fn_root, f) != 0 { return 1; }
        if cg_q8(&fn_export, f) != 0 { return 1; }
        if f == cg_main_idx { return 1; }
        if cg_q(&fn_ncall, f) != cg_q(&fn_nrec, f) { return 1; }
        return 0;
    }
    if s >= SL_G {
        if cg_q8(&sl_gopen, s - SL_G) != 0 { return 1; }
        return 0;
    }
    return 1;
}

// the functions slot s can hold, marked in sl_found: 1 when they are all
// known, 0 when some other value may be in it (sl_found is then no use)
fn cg_slot_funcs(s: i64) -> i64 {
    var n: i64 = 0;
    var at: i64 = 0;
    var i: i64 = 0;
    var j: i64 = 0;
    var cur: i64 = 0;
    var src: i64 = 0;
    var dup: i64 = 0;
    // in a module the other modules' code is not seen; an exported
    // function's parameters are taken as unknown (cg_slot_unknown)
    if sl_full != 0 || cg_as_module != 0 { return 0; }
    while i < fn_count && i < CG_MAX_FUNCS {
        cg_qs8(&sl_found, i, 0);
        i += 1;
    }
    cg_qs(&sl_seen, 0, s);
    n = 1;
    while at < n {
        cur = cg_q(&sl_seen, at);
        at += 1;
        if cg_slot_unknown(cur) != 0 { return 0; }
        i = 0;
        while i < sl_count {
            if cg_q(&sl_dst, i) == cur {
                src = cg_q(&sl_src, i);
                if src >= SL_F {
                    cg_qs8(&sl_found, src - SL_F, 1);
                } else {
                    dup = 0;
                    j = 0;
                    while j < n {
                        if cg_q(&sl_seen, j) == src { dup = 1; }
                        j += 1;
                    }
                    if dup == 0 {
                        if n >= 16384 { return 0; }
                        cg_qs(&sl_seen, n, src);
                        n += 1;
                    }
                }
            }
            i += 1;
        }
    }
    return 1;
}

// a call with another number of arguments than the function takes
fn cg_check_arg_count(c: ptr<Ast>, f: i64) -> i64 {
    var fnode: ptr<Ast> = cg_q(&fn_nodes, f);
    var p: ptr<Ast> = 0;
    var np: i64 = 0;
    var na: i64 = cg_count_list(c.right);
    if fnode == 0 { return 0; }
    p = fnode.left;
    while p != 0 {
        np += 1;
        p = p.right;
    }
    if na != np {
        cg_err_tok = c.data;
        if na < np {
            cg_err_msg = "fewer arguments than the function takes: ";
        } else {
            cg_err_msg = "more arguments than the function takes: ";
        }
        cg_err_hint = "  hint: give it as many as its fn line declares, in their order\r\n";
        cg_had_error = 1;
    }
    return 0;
}

// the current function calls through a fn value: only a function used as
// a value, of the same shape, can be what it calls
fn cg_note_indirect_val(c: ptr<Ast>) -> i64 {
    var a: ptr<Ast> = c.right;
    var n: i64 = 0;
    var reals: i64 = 0;
    if c.data != 0 { cg_param_escapes(c.data); }   // a parameter called here
    if cg_cur_fn < 0 || ie_count >= CG_MAX_EDGES {
        return 0;
    }
    while a != 0 {
        if n < 48 && cg_expr_is_float(a.left) != 0 {
            reals = reals | (1 << n);
        }
        n += 1;
        a = a.right;
    }
    cg_qs(&ie_from, ie_count, cg_cur_fn);
    cg_qs(&ie_key, ie_count, cg_shape(n, reals));
    cg_qs(&ie_slot, ie_count, cg_slot_of(c.data));
    ie_count += 1;
    return 0;
}

// the current function calls an address (call p(args)): a function whose
// address is taken (&f) and that takes as many arguments, reals in the
// same places. The key carries bit 60 to say so.
const CG_IE_ADDR: i64 = 1152921504606846976;

fn cg_note_indirect_addr(c: ptr<Ast>) -> i64 {
    var a: ptr<Ast> = c.right;
    var n: i64 = 0;
    var reals: i64 = 0;
    if cg_cur_fn < 0 { return 0; }
    if ie_count >= CG_MAX_EDGES {
        return cg_note_indirect();
    }
    while a != 0 {
        if n < 48 && cg_expr_is_float(a.left) != 0 {
            reals = reals | (1 << n);
        }
        n += 1;
        a = a.right;
    }
    cg_qs(&ie_from, ie_count, cg_cur_fn);
    cg_qs(&ie_key, ie_count, cg_shape(n, reals) | CG_IE_ADDR);
    cg_qs(&ie_slot, ie_count, 0);
    ie_count += 1;
    return 0;
}

// the first argument of thread_start: &fn starts a thread in fn; anything
// computed could be any function
fn cg_note_thread(a: ptr<Ast>) -> i64 {
    var f: i64 = 0;
    if a != 0 {
        if a.node_type == AST_ADDR_OF && a.data != 0 {
            f = cg_find_func(a.data);
            if f >= 0 {
                cg_qs(&fn_root, f, 1);
                return 0;
            }
        }
    }
    cg_dyn_thread = 1;
    return 0;
}

// the token of a non-shared global touched by code that can run in a
// thread, 0 when there is none. main is the main thread wherever it is
// started from: nothing reaches it.
fn cg_thread_check() -> i64 {
    var n: i64 = fn_count;
    var i: i64 = 0;
    var j: i64 = 0;
    var r: i64 = 0;
    var changed: i64 = 1;
    var fr: i64 = 0;
    var to: i64 = 0;
    cg_main_idx = cg_find_func(cg_tok(CT_MAINNAME));
    while i < n {
        r = cg_q(&fn_root, i);
        if cg_dyn_thread != 0 {
            r = r | cg_q(&fn_addr, i);
        }
        cg_qs(&fn_reach, i, r);
        i += 1;
    }
    while changed != 0 {
        changed = 0;
        i = 0;
        while i < n {
            if cg_q(&fn_reach, i) != 0 && cg_q(&fn_indir, i) != 0 {
                j = 0;
                while j < n {
                    if cg_q(&fn_addr, j) != 0 && cg_q(&fn_reach, j) == 0 {
                        cg_qs(&fn_reach, j, 1);
                        changed = 1;
                    }
                    j += 1;
                }
            }
            i += 1;
        }
        i = 0;
        while i < ie_count {
            fr = cg_q(&ie_from, i);
            if cg_q(&fn_reach, fr) != 0 {
                var key: i64 = cg_q(&ie_key, i);
                var byaddr: i64 = 0;
                if (key & CG_IE_ADDR) != 0 {
                    byaddr = 1;
                    key = key - CG_IE_ADDR;
                }
                // through a global or a parameter whose values are all known:
                // only those functions
                var known: i64 = 0;
                if byaddr == 0 && cg_q(&ie_slot, i) != 0 {
                    known = cg_slot_funcs(cg_q(&ie_slot, i));
                }
                j = 0;
                while j < n {
                    var cand: i64 = cg_q(&fn_asval, j);
                    if byaddr == 1 { cand = cg_q(&fn_addr, j); }
                    if cand != 0 && cg_fn_contained(j) != 0 { cand = 0; }
                    if known != 0 {
                        cand = cg_q8(&sl_found, j);
                    }
                    if cand != 0 && cg_q(&fn_reach, j) == 0 {
                        if cg_fn_key(j) == key {
                            cg_qs(&fn_reach, j, 1);
                            changed = 1;
                        }
                    }
                    j += 1;
                }
            }
            i += 1;
        }
        i = 0;
        while i < ce_count {
            fr = cg_q(&ce_from, i);
            to = cg_q(&ce_to, i);
            if cg_q(&fn_reach, fr) != 0 && to != cg_main_idx {
                if cg_q(&fn_reach, to) == 0 {
                    cg_qs(&fn_reach, to, 1);
                    changed = 1;
                }
            }
            i += 1;
        }
    }
    i = 0;
    while i < n {
        if cg_q(&fn_reach, i) != 0 && cg_q(&fn_gtok, i) != 0 {
            return cg_q(&fn_gtok, i);
        }
        i += 1;
    }
    return 0;
}

// What a module cannot hold. Nothing starts a module -- the compiler's
// hand-written code calls its functions -- so it has no main, no global
// whose first value has to be computed when main begins, and no function C
// calls.
fn cg_module_check() -> i64 {
    var p: ptr<Ast> = cg_root;
    var d: ptr<Ast> = 0;
    var k: i64 = 0;
    var v: ptr<Ast> = 0;
    var tt: ptr<Tok> = 0;
    var bad: i64 = 0;
    var msg: i64 = 0;
    var hn: i64 = 0;
    var tag: i64 = 0;
    if cg_as_module == 0 || cg_had_error != 0 {
        return 0;
    }
    while p != 0 {
        if p.node_type != AST_PROGRAM {
            return 0;
        }
        d = p.left;
        bad = 0;
        if d != 0 {
            k = d.node_type;
            if k == AST_FUNCTION {
                if d.data != 0 {
                    if name_is_main(d.data) == 1 {
                        bad = 1;
                        msg = "a module has no main: ";
                        hn = "  hint: its functions are called by the compiler's own code; build a program without --module\r\n";
                    } else if (d.type_info & 0xFFFF) == VIS_EXPORTED {
                        bad = 1;
                        msg = "a module exports nothing to C: ";
                        hn = "  hint: its functions are called by name from the compiler's own code; drop 'export'\r\n";
                    }
                }
            } else if k == AST_VAR_DECL || k == AST_CONST_DECL {
                bad = cg_module_global_bad(d);
                msg = "a global of a module must start from a number written out: ";
                hn = "  hint: nothing runs before a module's functions are called; give it its value in one of them\r\n";
            }
        }
        if bad != 0 {
            cg_err_tok = d.data;
            cg_err_msg = msg;
            cg_err_hint = hn;
            cg_had_error = 1;
            return 0;
        }
        p = p.right;
    }
    return 0;
}

// 1 when a module's global needs a first value computed at start: not an
// array (data), a stream or a struct (zero), a literal; a list or a map is
// made when main begins
fn cg_module_global_bad(d: ptr<Ast>) -> i64 {
    var tt: ptr<Tok> = 0;
    var v: ptr<Ast> = 0;
    var tag: i64 = 0;
    if d.type_info != 0 {
        return 0;
    }
    if d.left != 0 {
        tt = d.left;
        if tt.kind == KW_STR {
            return 0;
        }
        if cg_find_struct(tt) != -1 {
            return 0;
        }
    }
    v = d.right;
    if v != 0 {
        if cg_global_lit_fits(d) != 0 {
            return 0;
        }
        return 1;
    }
    tag = cg_decl_vtag(d) & 15;
    if tag == 2 || tag == 3 {
        return 1;
    }
    return 0;
}

// 1 when the name is one of the registers kasm reads in an operand -- a
// function by that name would be called as the register: call r8
fn cg_is_regname(t: ptr<Tok>) -> i64 {
    var names: i64 = "rax rcx rdx rbx rsp rbp rsi rdi r8 r9 r10 r11 r12 r13 r14 r15 eax ecx edx ebx esp ebp esi edi r8d r9d r10d r11d r12d r13d r14d r15d ax cx dx bx sp bp si di r8w r9w r10w r11w r12w r13w r14w r15w al cl dl bl spl bpl sil dil r8b r9b r10b r11b r12b r13b r14b r15b xmm0 xmm1 xmm2 xmm3 xmm4 xmm5 xmm6 xmm7 xmm8 xmm9 xmm10 xmm11 xmm12 xmm13 xmm14 xmm15 ";
    var p: i64 = names;
    var n: i64 = t.length;
    var i: i64 = 0;
    var ok: i64 = 0;
    if n < 2 || n > 5 {
        return 0;
    }
    while cg_b(p) != 0 {
        ok = 1;
        i = 0;
        while i < n {
            if cg_b(p + i) != cg_b(t.value + i) {
                ok = 0;
                break;
            }
            i += 1;
        }
        if ok == 1 && cg_b(p + n) == 32 {
            return 1;
        }
        // the next name
        while cg_b(p) != 32 {
            p += 1;
        }
        p += 1;
    }
    return 0;
}
