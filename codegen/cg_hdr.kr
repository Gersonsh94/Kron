    emit_cstr("    mov qword [rax + 8], 0\n");
    emit_cstr("    mov qword [rax + 16], 0\n");
    emit_cstr("    mov qword [rax + 24], 0\n");
    emit_cstr("    mov qword [rax + 96], 0\n");
    emit_cstr("    mov [rax+104], r13\n");
    emit_cstr("    lea rcx, [rel __lib_tids]\n");
    emit_cstr("    mov [rcx+rbx*8], r12\n");
    emit_cstr("    lea rcx, [rel __lib_bases]\n");
    emit_cstr("    mov [rcx+rbx*8], rax\n");
    emit_cstr("    inc rbx\n");
    emit_cstr("    mov [rel __lib_n], rbx\n");
    emit_cstr("    jmp .ls_have\n");
    emit_cstr(".ls_found:\n");
    emit_cstr("    lea rax, [rel __lib_bases]\n");
    emit_cstr("    mov rax, [rax+rbx*8]\n");
    emit_cstr(".ls_have:\n");
    emit_cstr("    lea rdi, [rel __lib_lock]\n");
    emit_cstr("    mov dword [rdi], 0\n");
    emit_cstr("    mov rcx, rsp\n");
    emit_cstr("    sub rcx, rax\n");
    emit_cstr("    cmp rcx, 0x100000\n");
    emit_cstr("    jb .ls_stay\n");
    emit_cstr("    add rax, 0xFFFC0\n");
