    emit_cstr("    cmp rcx, r12\n");
    emit_cstr("    je .ls_found\n");
    emit_cstr("    inc rbx\n");
    emit_cstr("    jmp .ls_find\n");
    emit_cstr(".ls_new:\n");
    emit_cstr("    cmp rbx, 256\n");
    emit_cstr("    jae .ls_none\n");
    emit_cstr("    mov rax, 9\n");
    emit_cstr("    xor rdi, rdi\n");
    emit_cstr("    mov rsi, 0x200000\n");
    emit_cstr("    mov rdx, 3\n");
    emit_cstr("    mov r10, 0x22\n");
    emit_cstr("    mov r8, -1\n");
    emit_cstr("    xor r9, r9\n");
