    emit_cstr(".tp_other:\n");
    emit_cstr("    mov rsi, [rsi]\n");
    emit_cstr("    jmp .tp_rec\n");
    emit_cstr(".tp_found:\n");
    emit_cstr("    mov rcx, [rsi+32]\n");
    emit_cstr("    mov rdi, rsi\n");
    emit_cstr("    add rdi, 40\n");
    emit_cstr("    xor r14, r14\n");
    emit_cstr(".tp_ent:\n");
    emit_cstr("    test rcx, rcx\n");
    emit_cstr("    jz .tp_line\n");
    emit_cstr("    mov rax, [rdi]\n");
    emit_cstr("    cmp rax, r13\n");
    emit_cstr("    ja .tp_line\n");
    emit_cstr("    mov r14, [rdi+8]\n");
    emit_cstr("    add rdi, 16\n");
    emit_cstr("    sub rcx, 1\n");
    emit_cstr("    jmp .tp_ent\n");
    emit_cstr(".tp_line:\n");
    emit_cstr("    lea rcx, [rel __tp_from]\n");
    emit_cstr("    test r12, r12\n");
    emit_cstr("    jnz .tp_word\n");
    emit_cstr("    lea rcx, [rel __tp_at]\n");
    emit_cstr(".tp_word:\n");
    emit_cstr("    call __print_str\n");
    emit_cstr("    mov rcx, [rsi+16]\n");
    emit_cstr("    call __print_str\n");
    emit_cstr("    lea rcx, [rel __tp_open]\n");
    emit_cstr("    call __print_str\n");
    emit_cstr("    mov rcx, [rsi+24]\n");
    emit_cstr("    call __print_str\n");
    emit_cstr("    lea rcx, [rel __tp_colon]\n");
    emit_cstr("    call __print_str\n");
    emit_cstr("    mov rcx, r14\n");
    emit_cstr("    call __print_uint\n");
    emit_cstr("    lea rcx, [rel __tp_close]\n");
    emit_cstr("    call __print_str\n");
    emit_cstr("    lea rcx, [rel __pf_nl]\n");
    emit_cstr("    call __print_str\n");
    emit_cstr(".tp_next:\n");
    emit_cstr("    add r12, 1\n");
    emit_cstr("    jmp .tp_frame\n");
    emit_cstr(".tp_done:\n");
    emit_cstr("    mov rsp, rbp\n");
    emit_cstr("    sub rsp, 48\n");
    emit_cstr("    pop r14\n");
    emit_cstr("    pop r13\n");
    emit_cstr("    pop r12\n");
    emit_cstr("    pop rdi\n");
    emit_cstr("    pop rsi\n");
    emit_cstr("    pop rbx\n");
    emit_cstr("    pop rbp\n");
    emit_cstr("    ret\n");
    return 0;
}

// what C calls into: the entry of a library and of exports
fn cg_emit_hdrlib() -> i64 {
    emit_cstr("section .text\n");
    emit_cstr("__lib_ready:\n");
    emit_cstr("    push rbx\n");
    emit_cstr("    lea rbx, [rel __lib_state]\n");
    emit_cstr(".lr_check:\n");
    emit_cstr("    mov rax, [rbx]\n");
    emit_cstr("    cmp rax, 2\n");
    emit_cstr("    je .lr_out\n");
    emit_cstr("    mov eax, 1\n");
    emit_cstr("    xchg [rbx], eax\n");
    emit_cstr("    test rax, rax\n");
    emit_cstr("    jz .lr_mine\n");
    emit_cstr("    cmp rax, 2\n");
    emit_cstr("    jne .lr_wait\n");
    emit_cstr("    mov dword [rbx], 2\n");
    emit_cstr("    jmp .lr_out\n");
    emit_cstr(".lr_wait:\n");
    emit_cstr("    call __thread_yield\n");
    emit_cstr("    jmp .lr_check\n");
    emit_cstr(".lr_mine:\n");
    emit_cstr("    sub rsp, 32\n");
    emit_cstr("    call __kron_lib_init\n");
    emit_cstr("    add rsp, 32\n");
    emit_cstr("    mov dword [rbx], 2\n");
    emit_cstr(".lr_out:\n");
    emit_cstr("    pop rbx\n");
    emit_cstr("    ret\n");
    emit_cstr("__lib_enter:\n");
    emit_cstr("    push rbx\n");
    emit_cstr("    push rsi\n");
    emit_cstr("    push rdi\n");
    emit_cstr("    push r12\n");
    emit_cstr("    push r13\n");
    emit_cstr("    push r14\n");
    emit_cstr("    push r15\n");
    emit_cstr("    push rbp\n");
    emit_cstr("    mov r12, rcx\n");
    emit_cstr("    mov r13, rdx\n");
    emit_cstr("    mov r14, rsp\n");
    emit_cstr("    call __lib_stack\n");
    emit_cstr("    test rax, rax\n");
    emit_cstr("    jz .le_stay\n");
    emit_cstr("    mov rsp, rax\n");
    emit_cstr(".le_stay:\n");
    emit_cstr("    and rsp, -16\n");
    emit_cstr("    call __lib_ready\n");
    emit_cstr("    mov rbx, [r12+8]\n");
    emit_cstr("    and rbx, 255\n");
    emit_cstr("    xor esi, esi\n");
    emit_cstr(".le_fix:\n");
    emit_cstr("    cmp rsi, rbx\n");
    emit_cstr("    jae .le_fixed\n");
    emit_cstr("    mov rax, [r13+rsi*8]\n");
    emit_cstr("    mov rdx, [r12+8]\n");
    emit_cstr("    mov rcx, rsi\n");
    emit_cstr("    add rcx, 8\n");
    emit_cstr("    shr rdx, cl\n");
    emit_cstr("    and rdx, 1\n");
    emit_cstr("    jz .le_int\n");
    emit_cstr("    mov rdx, [r12+8]\n");
    emit_cstr("    mov rcx, rsi\n");
    emit_cstr("    add rcx, 32\n");
    emit_cstr("    shr rdx, cl\n");
    emit_cstr("    and rdx, 1\n");
    emit_cstr("    jz .le_put\n");
    emit_cstr("    movq xmm0, rax\n");
    emit_cstr("    cvtss2sd xmm0, xmm0\n");
    emit_cstr("    movq rax, xmm0\n");
    emit_cstr("    jmp .le_put\n");
    emit_cstr(".le_int:\n");
    emit_cstr("    mov rdx, [r12+16]\n");
    emit_cstr("    mov rcx, rsi\n");
    emit_cstr("    shl rcx, 1\n");
    emit_cstr("    shr rdx, cl\n");
    emit_cstr("    and rdx, 3\n");
    emit_cstr("    jz .le_put\n");
    emit_cstr("    mov rdi, [r12+24]\n");
    emit_cstr("    mov rcx, rsi\n");
    emit_cstr("    shr rdi, cl\n");
    emit_cstr("    and rdi, 1\n");
    emit_cstr("    mov rcx, 32\n");
    emit_cstr("    cmp rdx, 1\n");
    emit_cstr("    je .le_widen\n");
    emit_cstr("    mov rcx, 48\n");
    emit_cstr("    cmp rdx, 2\n");
    emit_cstr("    je .le_widen\n");
    emit_cstr("    mov rcx, 56\n");
    emit_cstr(".le_widen:\n");
    emit_cstr("    shl rax, cl\n");
    emit_cstr("    test rdi, rdi\n");
    emit_cstr("    jz .le_zero\n");
    emit_cstr("    sar rax, cl\n");
    emit_cstr("    jmp .le_put\n");
    emit_cstr(".le_zero:\n");
    emit_cstr("    shr rax, cl\n");
    emit_cstr(".le_put:\n");
    emit_cstr("    mov [r13+rsi*8], rax\n");
    emit_cstr("    inc rsi\n");
    emit_cstr("    jmp .le_fix\n");
    emit_cstr(".le_fixed:\n");
    emit_cstr("    mov rsi, rbx\n");
    emit_cstr(".le_push:\n");
    emit_cstr("    cmp rsi, 6\n");
    emit_cstr("    jbe .le_regs\n");
    emit_cstr("    dec rsi\n");
    emit_cstr("    mov rax, [r13+rsi*8]\n");
    emit_cstr("    push rax\n");
    emit_cstr("    jmp .le_push\n");
    emit_cstr(".le_regs:\n");
    emit_cstr("    mov rax, [r13]\n");
    emit_cstr("    movq xmm0, rax\n");
    emit_cstr("    mov rcx, rax\n");
    emit_cstr("    mov rax, [r13+8]\n");
    emit_cstr("    movq xmm1, rax\n");
    emit_cstr("    mov rdx, rax\n");
    emit_cstr("    mov rax, [r13+16]\n");
    emit_cstr("    movq xmm2, rax\n");
    emit_cstr("    mov r8, rax\n");
    emit_cstr("    mov rax, [r13+24]\n");
    emit_cstr("    movq xmm3, rax\n");
    emit_cstr("    mov r9, rax\n");
    emit_cstr("    mov rax, [r13+32]\n");
    emit_cstr("    movq xmm4, rax\n");
    emit_cstr("    mov r10, rax\n");
    emit_cstr("    mov rax, [r13+40]\n");
    emit_cstr("    movq xmm5, rax\n");
    emit_cstr("    mov r11, [r12]\n");
    emit_cstr("    sub rsp, 32\n");
    emit_cstr("    call r11\n");
    emit_cstr("    mov rsp, r14\n");
    emit_cstr("    mov rcx, [r12+8]\n");
    emit_cstr("    shr rcx, 24\n");
    emit_cstr("    and rcx, 255\n");
    emit_cstr("    cmp rcx, 9\n");
    emit_cstr("    jne .le_out\n");
    emit_cstr("    cvtsd2ss xmm0, xmm0\n");
    emit_cstr(".le_out:\n");
    emit_cstr("    pop rbp\n");
    emit_cstr("    pop r15\n");
    emit_cstr("    pop r14\n");
    emit_cstr("    pop r13\n");
    emit_cstr("    pop r12\n");
    emit_cstr("    pop rdi\n");
    emit_cstr("    pop rsi\n");
    emit_cstr("    pop rbx\n");
    emit_cstr("    ret\n");
    return 0;
}

// its Windows part
fn cg_emit_hdrlib_win() -> i64 {
    emit_cstr("__lib_stack:\n");
    emit_cstr("    xor eax, eax\n");
    emit_cstr("    ret\n");
    emit_cstr("__centry:\n");
    emit_cstr("    push rbp\n");
    emit_cstr("    mov rbp, rsp\n");
    emit_cstr("    mov [rbp+16], rcx\n");
    emit_cstr("    mov [rbp+24], rdx\n");
    emit_cstr("    mov [rbp+32], r8\n");
    emit_cstr("    mov [rbp+40], r9\n");
    emit_cstr("    mov rax, [r11+8]\n");
    emit_cstr("    test rax, 256\n");
    emit_cstr("    jz .cw1\n");
    emit_cstr("    movq rcx, xmm0\n");
    emit_cstr("    mov [rbp+16], rcx\n");
    emit_cstr(".cw1:\n");
    emit_cstr("    test rax, 512\n");
    emit_cstr("    jz .cw2\n");
    emit_cstr("    movq rcx, xmm1\n");
    emit_cstr("    mov [rbp+24], rcx\n");
    emit_cstr(".cw2:\n");
    emit_cstr("    test rax, 1024\n");
    emit_cstr("    jz .cw3\n");
    emit_cstr("    movq rcx, xmm2\n");
    emit_cstr("    mov [rbp+32], rcx\n");
    emit_cstr(".cw3:\n");
    emit_cstr("    test rax, 2048\n");
    emit_cstr("    jz .cw4\n");
    emit_cstr("    movq rcx, xmm3\n");
    emit_cstr("    mov [rbp+40], rcx\n");
    emit_cstr(".cw4:\n");
    emit_cstr("    mov rcx, r11\n");
    emit_cstr("    lea rdx, [rbp+16]\n");
    emit_cstr("    sub rsp, 32\n");
    emit_cstr("    call __lib_enter\n");
    emit_cstr("    mov rsp, rbp\n");
    emit_cstr("    pop rbp\n");
    emit_cstr("    ret\n");
    emit_cstr("__dll_main:\n");
    emit_cstr("    mov eax, 1\n");
    emit_cstr("    ret\n");
    return 0;
}

// its Linux part
