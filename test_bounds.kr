kron_program
kron_domain test_bounds;
kron_imports
kron_definitions

// =========================================================================
// TEST: array bounds
//
// An index out of range is an implicit fail at that point: the function
// leaves with 0 and its caller sees it through failed(). It never carries on
// with a garbage value. Checks local and global arrays, above and below
// (a negative index counts as a huge one), and that a valid access raises nothing.
//
// Expected output: 20, 0, 0, 1, 0, 1, 1, 0, 99, 0, and the fail printed.
// =========================================================================

var g: [i64; 4];

fn read_at(i: i64) -> i64 {
    var v: [i64; 3];
    v[0] = 10;
    v[1] = 20;
    v[2] = 30;
    return v[i];
}

fn write_global(i: i64) -> i64 {
    g[i] = 99;
    return 1;
}

fn main() {
    print(read_at(1));              // 20
    print(failed());             // 0

    print(read_at(3));              // 0   just past the end
    print(failed());             // 1

    print(read_at(0 - 1));          // 0   negative
    print(failed());             // 1

    print(write_global(3));   // 1   last element: valid
    print(failed());             // 0
    print(g[3]);                 // 99

    print(write_global(4));   // 0   global, out of range
    if failed() {
        print_fail();            // fail: index out of range / hint: ...
    }
    return 0;
}
