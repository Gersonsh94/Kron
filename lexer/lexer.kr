}

// klx_keyword(text, n): the token type of the n characters at text --
// a keyword's, or TOK_IDENTIFIER
fn klx_keyword(text: i64, n: i64) -> i64 {
    var i: i64 = 0;
    var j: i64 = 0;
    var k: i64 = 0;
    var first: i64 = 0;
    var same: i64 = 0;
    raw {
        first = peek8(text);
        while i < klx_kw_n {
            if peek(&klx_kw_len + i * 8) == n {
                k = peek(&klx_kw_text + i * 8);
                if peek8(k) == first {
                    same = 1;
                    j = 1;
                    while j < n {
                        if peek8(k + j) != peek8(text + j) {
                            same = 0;
                            break;
                        }
                        j += 1;
                    }
                    if same == 1 {
                        return peek(&klx_kw_type + i * 8);
                    }
                }
            }
            i += 1;
        }
    }
    return TOK_IDENTIFIER;
}

fn klx_keyword_name(kind: i64) -> i64 {
    var i: i64 = 0;
    raw {
        while i < klx_kw_n {
            if peek(&klx_kw_type + i * 8) == kind {
                return peek(&klx_kw_text + i * 8);
            }
            i += 1;
        }
    }
    return 0;
}

// -------------------------------------------------------------------------
// characters
// -------------------------------------------------------------------------

// klx_at(p): the character at position p of the source, -1 past its end
fn klx_at(p: i64) -> i64 {
    var c: i64 = -1;
    if p < klx_len {
        raw {
            c = peek8(klx_src + p);
        }
    }
    return c;
}

fn klx_is_letter(c: i64) -> i64 {
    if c == 95 { return 1; }                   // _
    if c >= 97 && c <= 122 { return 1; }       // a-z
    if c >= 65 && c <= 90 { return 1; }        // A-Z
    return 0;
}

fn klx_is_digit(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return 1; }
    return 0;
}

fn klx_is_hex(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return 1; }
    if c >= 97 && c <= 102 { return 1; }       // a-f
    if c >= 65 && c <= 70 { return 1; }        // A-F
    return 0;
}

// -------------------------------------------------------------------------
// the kinds of token
// -------------------------------------------------------------------------

// klx_skip(): past blanks, line ends and // comments
fn klx_skip() -> i64 {
    var c: i64 = 0;
    while klx_pos < klx_len {
        c = klx_at(klx_pos);
        if c == 32 || c == 9 {
            klx_pos += 1;
            klx_col += 1;
        } else if c == 13 {
            klx_pos += 1;                      // a CR takes no column
        } else if c == 10 {
            klx_pos += 1;
            klx_line += 1;
            klx_col = 1;
        } else if c == 47 && klx_at(klx_pos + 1) == 47 {
            // to the end of the line; the LF is the next round's
            klx_pos += 1;
            while klx_pos < klx_len && klx_at(klx_pos) != 10 {
                klx_pos += 1;
            }
        } else {
            return 0;
        }
    }
    return 0;
}

// klx_number(): an integer, or a real with a point or an exponent. An
// exponent is one only with digits after it (and an optional sign), so a
// name glued to a number is not swallowed.
fn klx_number() -> i64 {
    var real: i64 = 0;
    var c: i64 = 0;
    var p: i64 = 0;
    while klx_pos < klx_len {
        c = klx_at(klx_pos);
        if klx_is_digit(c) == 1 {
            klx_pos += 1;
            klx_col += 1;
        } else if c == 46 {
            real = 1;                          // the point counts no column
            klx_pos += 1;
        } else if c == 101 || c == 69 {
            p = klx_pos + 1;
            c = klx_at(p);
            if c == 43 || c == 45 {
                p += 1;
                c = klx_at(p);
            }
            if klx_is_digit(c) == 0 {
                break;
            }
            real = 1;
            klx_pos = p;
            while klx_is_digit(klx_at(klx_pos)) == 1 {
                klx_pos += 1;
            }
            break;
        } else {
            break;
        }
    }
    if real == 1 {
        return TOK_FLOAT;
    }
    return TOK_INTEGER;
}

// klx_punct(c): an operator or a mark, after its first character c. Two
// and three characters are taken when they make one: += -> == >>> ::
// -1 when c is no character of Kron's.
fn klx_punct(c: i64) -> i64 {
    var n: i64 = klx_at(klx_pos + 1);
    klx_pos += 1;
    klx_col += 1;
    if c == 123 { return TOK_LBRACE; }         // {
    if c == 125 { return TOK_RBRACE; }         // }
    if c == 40 { return TOK_LPAREN; }          // (
    if c == 41 { return TOK_RPAREN; }          // )
    if c == 91 { return TOK_LBRACKET; }        // [
    if c == 93 { return TOK_RBRACKET; }        // ]
    if c == 59 { return TOK_SEMICOLON; }       // ;
    if c == 44 { return TOK_COMMA; }           // ,
    if c == 46 { return TOK_DOT; }             // .
    if c == 37 { return TOK_PERCENT; }         // %
    if c == 126 { return TOK_TILDE; }          // ~
    if c == 43 {                               // + +=
        if n == 61 { klx_pos += 1; return TOK_PLUS_ASSIGN; }
        return TOK_PLUS;
    }
    if c == 45 {                               // - -= ->
        if n == 61 { klx_pos += 1; return TOK_MINUS_ASSIGN; }
        if n == 62 { klx_pos += 1; return TOK_ARROW; }
        return TOK_MINUS;
    }
    if c == 42 {                               // * *=
        if n == 61 { klx_pos += 1; return TOK_STAR_ASSIGN; }
        return TOK_STAR;
    }
    if c == 47 {                               // / /=
        if n == 61 { klx_pos += 1; return TOK_SLASH_ASSIGN; }
        return TOK_SLASH;
    }
    if c == 38 {                               // & &&
        if n == 38 { klx_pos += 1; return TOK_AND; }
        return TOK_AMPERSAND;
    }
    if c == 124 {                              // | ||
        if n == 124 { klx_pos += 1; return TOK_OR; }
        return TOK_PIPE;
    }
    if c == 94 {                               // ^ ^=
        if n == 61 { klx_pos += 1; return TOK_XOR_ASSIGN; }
        return TOK_CARET;
    }
    if c == 33 {                               // ! !=
        if n == 61 { klx_pos += 1; return TOK_NEQ; }
        return TOK_NOT;
    }
    if c == 61 {                               // = ==
        if n == 61 { klx_pos += 1; return TOK_EQ; }
        return TOK_ASSIGN;
    }
    if c == 60 {                               // < <= <<
        if n == 61 { klx_pos += 1; return TOK_LTE; }
        if n == 60 { klx_pos += 1; return TOK_LSHIFT; }
        return TOK_LT;
    }
    if c == 62 {                               // > >= >> >>>
        if n == 61 { klx_pos += 1; return TOK_GTE; }
        if n == 62 {
            klx_pos += 1;
            if klx_at(klx_pos) == 62 { klx_pos += 1; return TOK_URSHIFT; }
            return TOK_RSHIFT;
        }
        return TOK_GT;
    }
    if c == 58 {                               // : ::
        if n == 58 { klx_pos += 1; return TOK_DOUBLE_COLON; }
        return TOK_COLON;
    }
    return -1;
}

// klx_put(t, kind, start): the token at t, from start to here
fn klx_put(t: i64, kind: i64, start: i64) -> i64 {
    raw {
        poke(t, kind);
        poke(t + 8, klx_src + start);
        poke32(t + 16, klx_pos - start);
        poke16(t + 20, klx_tok_line);
        poke16(t + 22, klx_tok_col);
    }
    return 0;
}

// klx_fail(kind, start, n): klx_run stops; the error points at the n
// characters from start, on the line and column the token began
fn klx_fail(kind: i64, start: i64, n: i64) -> i64 {
    klx_err_kind = kind;
    raw {
        var t: i64 = &klx_err_tok;
        poke(t, 0);
        poke(t + 8, klx_src + start);
        poke32(t + 16, n);
        poke16(t + 20, klx_tok_line);
        poke16(t + 22, klx_tok_col);
    }
    return -1;
}

// klx_next(t): the next token, written at t. 1 for a token, 2 for TOK_EOF,
// -1 for an error.
fn klx_next(t: i64) -> i64 {
    klx_skip();
    if klx_pos >= klx_len {
        raw {
            poke(t, TOK_EOF);
            poke(t + 8, 0);
            poke32(t + 16, 0);
            poke16(t + 20, klx_line);
            poke16(t + 22, klx_col);
        }
        return 2;
    }
    klx_tok_line = klx_line;
    klx_tok_col = klx_col;
    var start: i64 = klx_pos;
    var c: i64 = klx_at(start);
    var kind: i64 = 0;
    var n: i64 = 0;
    if klx_is_letter(c) == 1 {
        // an identifier or a keyword
        while klx_pos < klx_len && (klx_is_letter(klx_at(klx_pos)) == 1 || klx_is_digit(klx_at(klx_pos)) == 1) {
            klx_pos += 1;
            klx_col += 1;
        }
        kind = klx_keyword(klx_src + start, klx_pos - start);
    } else if klx_is_digit(c) == 1 {
        n = klx_at(start + 1);
        if c == 48 && (n == 120 || n == 88) {
            // 0x...: a hex number, no columns counted
            klx_pos = start + 2;
            while klx_is_hex(klx_at(klx_pos)) == 1 {
                klx_pos += 1;
            }
            kind = TOK_HEX;
        } else {
            kind = klx_number();
        }
    } else if c == 34 {
        // "...", its quotes included; \x takes two characters. The text
        // counts no column and no line.
        klx_pos += 1;
        n = klx_at(klx_pos);
        while n != 34 {
            if n == -1 {
                return klx_fail(KLX_ERR_TEXT, start, 1);
            }
            if n == 92 {
                klx_pos += 2;
            } else {
                klx_pos += 1;
            }
            n = klx_at(klx_pos);
        }
        klx_pos += 1;
        kind = TOK_STRING;
    } else {
        kind = klx_punct(c);
        if kind == -1 {
            // the whole character, when it is a UTF-8 one of several bytes
            n = 1;
            if c >= 192 && c < 224 { n = 2; }
            if c >= 224 && c < 240 { n = 3; }
            if c >= 240 && c < 248 { n = 4; }
            if start + n > klx_len { n = klx_len - start; }
            return klx_fail(KLX_ERR_CHAR, start, n);
        }
    }
    klx_put(t, kind, start);
    return 1;
}

// -------------------------------------------------------------------------
// the door
// -------------------------------------------------------------------------

fn klx_init(src: i64, len: i64, buf: i64, count_ptr: i64, cap: i64) -> i64 {
    if klx_kw_n == 0 {
        klx_kw_fill();
    }
    klx_src = src;
    klx_len = len;
    klx_buf = buf;
    klx_count_ptr = count_ptr;
    klx_cap = cap;
    klx_pos = 0;
    klx_err_kind = 0;
    // a UTF-8 byte order mark: every Windows editor writes one, and the
    // file is no less a program for it
    if klx_at(0) == 0xEF && klx_at(1) == 0xBB && klx_at(2) == 0xBF {
        klx_pos = 3;
    }
    if count_ptr != 0 {
        raw {
            poke(count_ptr, 0);
        }
    }
    klx_line = 1;
    klx_col = 1;
    klx_tok_line = 1;
    klx_tok_col = 1;
    return 1;
}

fn klx_run() -> i64 {
    var count: i64 = 0;
    var r: i64 = 0;
    while r != 2 {
        if count >= klx_cap {
            klx_tok_line = klx_line;
            klx_tok_col = klx_col;
            return klx_fail(KLX_ERR_FULL, klx_pos, 0);
        }
        r = klx_next(klx_buf + count * KLX_TOKEN_SIZE);
        if r == -1 {
            return -1;
        }
        count += 1;
    }
    if klx_count_ptr != 0 {
        raw {
            poke(klx_count_ptr, count);
        }
    }
    return count;
}

fn klx_error_kind() -> i64 {
    return klx_err_kind;
}

fn klx_error_token() -> i64 {
    var t: i64 = 0;
    raw {
        t = &klx_err_tok;
    }
    return t;
}
