kron_program
kron_domain lexer;
kron_imports
acquire_domain "include/tokens.kr";
kron_definitions

// =========================================================================
// THE LEXER
//
// The first part of the compiler written in Kron. kronc --module turns this
// file into lexer_kr.asm, which kron_all.asm includes; lexer.asm beside it
// is the small hand-written door the rest of the compiler calls through.
//
//     klx_init(src, len, buf, count_ptr, cap)   start on a source
//     klx_run()                                 every token, then TOK_EOF;
//                                               their number, -1 on error
//     klx_keyword_name(type)                    a keyword's text, 0 if none
//     klx_error_kind() / klx_error_token()      what stopped klx_run
//
// A token is 24 bytes in the buffer the compiler gives:
//     +0  type     8 bytes
//     +8  value    8 bytes: where its text starts in the source
//     +16 length   4 bytes
//     +20 line     2 bytes
//     +22 column   2 bytes, of its first character
//
// It runs inside the compiler, where there is no runtime: no texts, no
// lists, no fail. Memory is reached with peek and poke, and every array
// through its address, so that nothing calls a bounds check.
//
// Columns are counted as the compiler always counted them, which error
// messages and the debugger's line tables depend on: a character of an
// identifier, a digit, a blank and the first character of an operator
// count one; the point of a real, its exponent, a hex number, a "..." text
// and the second character of an operator count none.
// =========================================================================

const KLX_TOKEN_SIZE: i64 = 24;
const KLX_KW_MAX: i64 = 192;

// what stopped klx_run, for klx_error_kind
const KLX_ERR_CHAR: i64 = 1;       // a character Kron does not use
const KLX_ERR_TEXT: i64 = 2;       // a "..." text with no closing quote
const KLX_ERR_FULL: i64 = 3;       // more tokens than the buffer holds

var klx_src: i64;                  // the source
var klx_len: i64;
var klx_pos: i64;                  // the next character to read
var klx_line: i64;
var klx_col: i64;
var klx_tok_line: i64;             // where the token being read starts
var klx_tok_col: i64;
var klx_buf: i64;                  // the tokens
var klx_cap: i64;                  // how many fit, the TOK_EOF included
var klx_count_ptr: i64;            // where the count goes, 0 for nowhere

// the keywords: text (NUL-ended), length and token type, by index
var klx_kw_text: [i64; 192];
var klx_kw_len: [i64; 192];
var klx_kw_type: [i64; 192];
var klx_kw_n: i64;

var klx_err_kind: i64;
var klx_err_tok: [i64; 3];         // a token where the error is

// -------------------------------------------------------------------------
// the keyword table
// -------------------------------------------------------------------------

fn klx_kw(text: i64, kind: i64) -> i64 {
    var n: i64 = 0;
    var i: i64 = klx_kw_n;
    if i >= KLX_KW_MAX {
        return 0;
    }
    raw {
        while peek8(text + n) != 0 {
            n += 1;
        }
        poke(&klx_kw_text + i * 8, text);
        poke(&klx_kw_len + i * 8, n);
        poke(&klx_kw_type + i * 8, kind);
    }
    klx_kw_n = i + 1;
    return 1;
}

// In this order: a type with two spellings is named, in error messages, by
// the first one here.
fn klx_kw_fill() -> i64 {
    klx_kw("var", KW_VAR);
    klx_kw("const", KW_CONST);
    klx_kw("fn", KW_FN);
    klx_kw("return", KW_RETURN);
