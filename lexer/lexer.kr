    klx_kw("peek8", KW_PEEK8);
    klx_kw("peek16", KW_PEEK16);
    klx_kw("peek32", KW_PEEK32);
    klx_kw("public", KW_GLOBAL_VISIBLE);
    klx_kw("private", KW_DOMAIN_ISOLATED);
