kron_program
kron_domain std_net;
kron_imports
kron_definitions

// =========================================================================
// Kron standard library -- TCP networking.
//
//   net_listen(port)                   a listening socket on every interface
//   net_listen_on(a, b, c, d, port)    the same, on one address: 127, 0, 0, 1
//   net_accept(server)                 waits for a client; returns its socket
//   net_connect(a, b, c, d, port)      a socket connected to a.b.c.d:port
//   net_send(sock, address, length)    bytes sent
//   net_recv(sock, address, capacity)  bytes received; 0 when the other side
//                                      closed the connection
//   net_close(sock)
//
// UDP: datagrams, for games and discovery on a LAN.
//   net_udp_open(port)                 a UDP socket on every interface; 0 any port
//   net_udp_open_on(a, b, c, d, port)  the same, on one address
//   net_udp_open_shared(port)          a UDP socket on a port other sockets
//   net_udp_open_shared_on(a, b, c, d, port)  may use too (SO_REUSEADDR):
//                                      several programs, or an engine and its
//                                      tools, all hearing the same broadcasts
//   net_udp_send(sock, a, b, c, d, port, address, length)
//                                      one datagram to a.b.c.d:port; bytes sent
//   net_udp_recv(sock, address, capacity)
//                                      one datagram: its bytes (cut to capacity),
//                                      waiting for it if none is there
//   net_udp_try_recv(sock, address, capacity)
//                                      the same, never waiting: -1 when no
//                                      datagram is there (a game's frame loop)
//   net_nonblocking(sock, on)          1: every recv, send and accept of sock
//                                      returns at once instead of waiting
//   net_from_ip(i)  net_from_port()    who sent the last datagram received:
//                                      octet i (0 to 3) of its address, its port
//   net_udp_broadcast(sock, on)        1 lets it send to 255.255.255.255
//   net_wait(sock, ms)                 1 when sock has something to read
//                                      within ms milliseconds, else 0 (TCP too)
//
// Every function fails, with a cause and a hint, when the system refuses.
//
// One source for both systems. The net_sys_* layer at the top picks its
// path with target_os(), a constant the compiler fills in:
//   Windows: ws2_32.dll, loaded the first time it is needed with dll_load and
//            dll_proc, so nothing is linked in.
//   Linux:   the kernel's socket calls, through syscall(...). Nothing to load.
// That layer is raw -- reaching the system is as delicate as memory by
// address. Buffers are addresses, as in std_str: &buf of an array, or a
// string literal.
//
// On Windows the first net_listen or net_connect loads the library: make one
// before starting threads that use the network. The globals are shared
// because threads use the network too; they are written once, by that call.
// =========================================================================

const NET_AF_INET: i64 = 2;
const NET_SOCK_STREAM: i64 = 1;
const NET_IPPROTO_TCP: i64 = 6;
const NET_SOCK_DGRAM: i64 = 2;
const NET_IPPROTO_UDP: i64 = 17;

// Linux system call numbers (x86-64) and the two options used here
const NET_SYS_CLOSE: i64 = 3;
const NET_SYS_POLL: i64 = 7;
const NET_SYS_SOCKET: i64 = 41;
const NET_SYS_CONNECT: i64 = 42;
const NET_SYS_ACCEPT: i64 = 43;
const NET_SYS_SENDTO: i64 = 44;
const NET_SYS_RECVFROM: i64 = 45;
const NET_SYS_BIND: i64 = 49;
const NET_SYS_LISTEN: i64 = 50;
const NET_SYS_SETSOCKOPT: i64 = 54;
const NET_SYS_FCNTL: i64 = 72;
const NET_F_GETFL: i64 = 3;
const NET_F_SETFL: i64 = 4;
const NET_O_NONBLOCK: i64 = 2048;
const NET_SOL_SOCKET: i64 = 1;
const NET_SO_REUSEADDR: i64 = 2;
const NET_SO_BROADCAST: i64 = 6;
const NET_MSG_NOSIGNAL: i64 = 16384;     // a closed peer is an error, not a signal that kills

shared var net_ready: i64;
shared var net_wsa: [i64; 64];          // WSADATA: 408 bytes
shared var p_startup: i64;
shared var p_socket: i64;
shared var p_bind: i64;
shared var p_listen: i64;
shared var p_accept: i64;
shared var p_connect: i64;
shared var p_send: i64;
shared var p_recv: i64;
shared var p_close: i64;
shared var p_sendto: i64;
shared var p_recvfrom: i64;
shared var p_poll: i64;
shared var p_setsockopt: i64;
shared var p_lasterr: i64;
shared var p_ioctl: i64;
shared var net_from: [i64; 2];         // the sender of the last datagram received
shared var net_fromlen: [i64; 1];

// Windows returns 32-bit ints in a 64-bit register, the high half undefined:
// keep the low half, with its sign, so -1 is still -1.
fn net_int(x: i64) -> i64 {
    return (x << 32) >> 32;
}

// Linux returns -errno on failure; the layer below reports every failure
// as -1, the way Windows does, so the functions above have one test.
fn net_linux(x: i64) -> i64 {
    if x < 0 {
        return -1;
    }
    return x;
}

fn net_is_linux() -> i64 {
    return target_os() == 2;
}

// A sockaddr_in in one i64: the family, the port in network byte order, and
// the IPv4 address a.b.c.d. The second half of the structure is zero. The
// layout is the same on Windows and Linux.
fn net_addr(a: i64, b: i64, c: i64, d: i64, port: i64) -> i64 {
    var ip: i64 = (a & 255) | ((b & 255) << 8) | ((c & 255) << 16) | ((d & 255) << 24);
    return NET_AF_INET | (((port >> 8) & 255) << 16) | ((port & 255) << 24) | (ip << 32);
}

// Starts the network, once. On Windows: loads ws2_32.dll and calls
// WSAStartup. On Linux there is nothing to start.
fn net_init() -> i64 {
    var lib: i64 = 0;
    var r: i64 = 0;
    if net_ready != 0 {
        return 1;
    }
    if net_is_linux() {
        net_ready = 1;
        return 1;
    }
    raw {
        lib = dll_load("ws2_32.dll");
    }
    if lib == 0 {
        fail "cannot load ws2_32.dll" hint "networking needs Windows sockets";
    }
    raw {
        p_startup = dll_proc(lib, "WSAStartup");
        p_socket = dll_proc(lib, "socket");
        p_bind = dll_proc(lib, "bind");
        p_listen = dll_proc(lib, "listen");
        p_accept = dll_proc(lib, "accept");
        p_connect = dll_proc(lib, "connect");
        p_send = dll_proc(lib, "send");
        p_recv = dll_proc(lib, "recv");
        p_close = dll_proc(lib, "closesocket");
        p_sendto = dll_proc(lib, "sendto");
        p_recvfrom = dll_proc(lib, "recvfrom");
        p_poll = dll_proc(lib, "WSAPoll");
        p_setsockopt = dll_proc(lib, "setsockopt");
        p_lasterr = dll_proc(lib, "WSAGetLastError");
        p_ioctl = dll_proc(lib, "ioctlsocket");
        r = call p_startup(514, &net_wsa);
    }
    r = net_int(r);
    if r != 0 {
        fail "the network could not start" hint "WSAStartup refused: check that networking is available";
    }
    net_ready = 1;
    return 1;
}

// ---- the system layer: every function returns -1 when the system refuses

fn net_sys_socket() -> i64 {
    var s: i64 = 0;
    if net_is_linux() {
        raw {
            s = syscall(NET_SYS_SOCKET, NET_AF_INET, NET_SOCK_STREAM, NET_IPPROTO_TCP);
        }
        return net_linux(s);
    }
    raw {
        s = call p_socket(NET_AF_INET, NET_SOCK_STREAM, NET_IPPROTO_TCP);
    }
    return s;
}

// bind; on Linux SO_REUSEADDR first, so a server can be started again on the
// same port right after it stopped, instead of waiting for TIME_WAIT
fn net_sys_bind(s: i64, addr: i64) -> i64 {
    var r: i64 = 0;
    var one: [i64; 1];
    one[0] = 1;
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_SETSOCKOPT, s, NET_SOL_SOCKET, NET_SO_REUSEADDR, &one, 4);
            r = syscall(NET_SYS_BIND, s, addr, 16);
        }
        return net_linux(r);
    }
    raw {
        r = call p_bind(s, addr, 16);
    }
    return net_int(r);
}

fn net_sys_listen(s: i64) -> i64 {
    var r: i64 = 0;
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_LISTEN, s, 16);
        }
        return net_linux(r);
    }
    raw {
        r = call p_listen(s, 16);
    }
    return net_int(r);
}

fn net_sys_accept(s: i64) -> i64 {
    var c: i64 = 0;
    if net_is_linux() {
        raw {
            c = syscall(NET_SYS_ACCEPT, s, 0, 0);
        }
        return net_linux(c);
    }
    raw {
        c = call p_accept(s, 0, 0);
    }
    return c;
}

fn net_sys_connect(s: i64, addr: i64) -> i64 {
    var r: i64 = 0;
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_CONNECT, s, addr, 16);
        }
        return net_linux(r);
    }
    raw {
        r = call p_connect(s, addr, 16);
    }
    return net_int(r);
}

fn net_sys_send(s: i64, address: i64, length: i64) -> i64 {
    var r: i64 = 0;
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_SENDTO, s, address, length, NET_MSG_NOSIGNAL, 0, 0);
        }
        return net_linux(r);
    }
    raw {
        r = call p_send(s, address, length, 0);
    }
    return net_int(r);
}

fn net_sys_recv(s: i64, address: i64, capacity: i64) -> i64 {
    var r: i64 = 0;
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_RECVFROM, s, address, capacity, 0, 0, 0);
        }
        return net_linux(r);
    }
    raw {
        r = call p_recv(s, address, capacity, 0);
    }
    return net_int(r);
}

fn net_sys_close(s: i64) -> i64 {
    var r: i64 = 0;
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_CLOSE, s);
        }
        return net_linux(r);
    }
    raw {
        r = call p_close(s);
    }
    return net_int(r);
}

// ---- the functions programs use

// A listening TCP socket on a.b.c.d:port.
fn net_listen_on(a: i64, b: i64, c: i64, d: i64, port: i64) -> i64 {
    var s: i64 = 0;
    var r: i64 = 0;
    var addr: [i64; 2];
    net_init();
    if failed() {
        fail "the network could not start" hint "WSAStartup refused: check that networking is available";
    }
    addr[0] = net_addr(a, b, c, d, port);
    addr[1] = 0;
    s = net_sys_socket();
    if s == -1 {
        fail "no socket available" hint "the system ran out of sockets";
    }
    r = net_sys_bind(s, &addr);
    if r != 0 {
        r = net_sys_close(s);
        fail "cannot bind the port" hint "another program may be using it: choose another port";
    }
    r = net_sys_listen(s);
    if r != 0 {
        r = net_sys_close(s);
        fail "cannot listen on the port" hint "check the port and the address";
    }
    return s;
}

// A listening TCP socket on every interface of this machine.
fn net_listen(port: i64) -> i64 {
    var s: i64 = net_listen_on(0, 0, 0, 0, port);
    if failed() {
        fail "cannot listen on the port" hint "another program may be using it: choose another port";
    }
    return s;
}

// Waits for a client on a listening socket; returns the client's socket.
fn net_accept(server: i64) -> i64 {
    var c: i64 = net_sys_accept(server);
    if c == -1 {
        fail "accept failed" hint "the listening socket may be closed";
    }
    return c;
}

// A TCP socket connected to a.b.c.d:port.
fn net_connect(a: i64, b: i64, c: i64, d: i64, port: i64) -> i64 {
    var s: i64 = 0;
    var r: i64 = 0;
    var addr: [i64; 2];
    net_init();
    if failed() {
        fail "the network could not start" hint "WSAStartup refused: check that networking is available";
    }
    addr[0] = net_addr(a, b, c, d, port);
    addr[1] = 0;
    s = net_sys_socket();
    if s == -1 {
        fail "no socket available" hint "the system ran out of sockets";
    }
    r = net_sys_connect(s, &addr);
    if r != 0 {
        r = net_sys_close(s);
        fail "cannot connect" hint "check the address and the port, and that the server is listening";
    }
    return s;
}

// Sends `length` bytes starting at `address`. Returns how many were sent.
fn net_send(sock: i64, address: i64, length: i64) -> i64 {
    var r: i64 = net_sys_send(sock, address, length);
    if r < 0 {
        fail "send failed" hint "the connection may be closed";
    }
    return r;
}

// Receives up to `capacity` bytes into `address`. Returns how many arrived;
// 0 means the other side closed the connection.
fn net_recv(sock: i64, address: i64, capacity: i64) -> i64 {
    var r: i64 = net_sys_recv(sock, address, capacity);
    if r < 0 {
        fail "receive failed" hint "the connection may be closed";
    }
    return r;
}

// Closes a socket.
fn net_close(sock: i64) -> i64 {
    return net_sys_close(sock);
}

// ---------------------------------------------------------------- UDP ---

fn net_sys_udp() -> i64 {
    var s: i64 = 0;
    if net_is_linux() {
        raw {
            s = syscall(NET_SYS_SOCKET, NET_AF_INET, NET_SOCK_DGRAM, NET_IPPROTO_UDP);
        }
        return net_linux(s);
    }
    raw {
        s = call p_socket(NET_AF_INET, NET_SOCK_DGRAM, NET_IPPROTO_UDP);
    }
    return s;
}

fn net_sys_sendto(s: i64, address: i64, length: i64, to: i64) -> i64 {
    var r: i64 = 0;
    var sa: [i64; 2];
    sa[0] = to;
    sa[1] = 0;
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_SENDTO, s, address, length, NET_MSG_NOSIGNAL, &sa, 16);
        }
        return net_linux(r);
    }
    raw {
        r = call p_sendto(s, address, length, 0, &sa, 16);
    }
    return net_int(r);
}

fn net_sys_recvfrom(s: i64, address: i64, capacity: i64) -> i64 {
    var r: i64 = 0;
    net_from[0] = 0;
    net_from[1] = 0;
    net_fromlen[0] = 16;
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_RECVFROM, s, address, capacity, 0, &net_from, &net_fromlen);
        }
        return net_linux(r);
    }
    raw {
        r = call p_recvfrom(s, address, capacity, 0, &net_from, &net_fromlen);
    }
    return net_int(r);
}

// 1 when s has something to read within ms milliseconds
fn net_sys_poll(s: i64, ms: i64) -> i64 {
    var r: i64 = 0;
    if net_is_linux() {
        // struct pollfd: int fd, short events (POLLIN 1), short revents
        var pfd: [i64; 1];
        pfd[0] = (s & 4294967295) | (1 << 32);
        raw {
            r = syscall(NET_SYS_POLL, &pfd, 1, ms);
        }
        return net_linux(r);
    }
    // WSAPOLLFD: SOCKET fd (8 bytes), short events (POLLIN 0x300), short revents
    var wfd: [i64; 2];
    wfd[0] = s;
    wfd[1] = 768;
    raw {
        r = call p_poll(&wfd, 1, ms);
    }
    return net_int(r);
}

// SO_REUSEADDR on s, before its bind: the port may be in use by other
// sockets that set it too (Linux sets it at every bind already)
fn net_sys_reuse(s: i64) -> i64 {
    var r: i64 = 0;
    var one: [i64; 1];
    one[0] = 1;
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_SETSOCKOPT, s, NET_SOL_SOCKET, NET_SO_REUSEADDR, &one, 4);
        }
        return net_linux(r);
    }
    // SOL_SOCKET 0xFFFF, SO_REUSEADDR 4 on Windows
    raw {
        r = call p_setsockopt(s, 65535, 4, &one, 4);
    }
    return net_int(r);
}

fn net_udp_open_on(a: i64, b: i64, c: i64, d: i64, port: i64) -> i64 {
    return net_udp_open_how(a, b, c, d, port, 0);
}

fn net_udp_open_shared_on(a: i64, b: i64, c: i64, d: i64, port: i64) -> i64 {
    return net_udp_open_how(a, b, c, d, port, 1);
}

fn net_udp_open_shared(port: i64) -> i64 {
    return net_udp_open_how(0, 0, 0, 0, port, 1);
}

fn net_udp_open_how(a: i64, b: i64, c: i64, d: i64, port: i64, shared_port: i64) -> i64 {
    var s: i64 = 0;
    var addr: [i64; 2];
    net_init();
    if port < 0 || port > 65535 {
        fail "no such port" hint "from 0 to 65535; 0 lets the system choose";
    }
    s = net_sys_udp();
    if s == -1 {
        fail "cannot make a UDP socket" hint "the system refused: too many open sockets?";
    }
    if shared_port != 0 {
        if net_sys_reuse(s) == -1 {
            net_sys_close(s);
            fail "the port cannot be shared" hint "the system refused SO_REUSEADDR";
        }
    }
    addr[0] = net_addr(a, b, c, d, port);
    addr[1] = 0;
    if net_sys_bind(s, &addr) == -1 {
        net_sys_close(s);
        fail "cannot use this port" hint "another program may be using it";
    }
    return s;
}

fn net_udp_open(port: i64) -> i64 {
    return net_udp_open_on(0, 0, 0, 0, port);
}

fn net_udp_send(sock: i64, a: i64, b: i64, c: i64, d: i64, port: i64, address: i64, length: i64) -> i64 {
    var n: i64 = net_sys_sendto(sock, address, length, net_addr(a, b, c, d, port));
    if n == -1 {
        fail "the datagram could not be sent" hint "check the address, and net_udp_broadcast for 255.255.255.255";
    }
    return n;
}

fn net_udp_recv(sock: i64, address: i64, capacity: i64) -> i64 {
    var n: i64 = net_sys_recvfrom(sock, address, capacity);
    while n == -1 && net_is_linux() == 0 {
        var e: i64 = 0;
        raw { e = call p_lasterr(); }
        e = net_int(e);
        // WSAEMSGSIZE: the datagram was larger than capacity; its first
        // capacity bytes are there, as Linux gives them
        if e == 10040 {
            return capacity;
        }
        // WSAECONNRESET: an earlier datagram of this socket reached a port
        // nobody listens on. Not this datagram's error: wait for the next
        if e != 10054 {
            fail "nothing could be received" hint "the socket may be closed";
        }
        n = net_sys_recvfrom(sock, address, capacity);
    }
    if n == -1 {
        fail "nothing could be received" hint "the socket may be closed";
    }
    return n;
}

// one datagram if one is there, never waiting: its bytes, or -1 when none is
fn net_udp_try_recv(sock: i64, address: i64, capacity: i64) -> i64 {
    while net_sys_poll(sock, 0) > 0 {
        var n: i64 = net_sys_recvfrom(sock, address, capacity);
        if n != -1 {
            return n;
        }
        if net_is_linux() {
            return -1;
        }
        var e: i64 = 0;
        raw { e = call p_lasterr(); }
        e = net_int(e);
        if e == 10040 {
            return capacity;                 // WSAEMSGSIZE: cut, as on Linux
        }
        if e == 10035 {
            return -1;                       // WSAEWOULDBLOCK: nothing after all
        }
        if e != 10054 {
            fail "nothing could be received" hint "the socket may be closed";
        }
        // WSAECONNRESET: an earlier datagram's port had nobody; look again
    }
    return -1;
}

// 1: the socket's calls return at once instead of waiting (a recv with
// nothing there fails, as net_udp_try_recv would say -1); 0: they wait again
fn net_nonblocking(sock: i64, on: i64) -> i64 {
    var r: i64 = 0;
    var fl: i64 = 0;
    if net_is_linux() {
        raw {
            fl = syscall(NET_SYS_FCNTL, sock, NET_F_GETFL, 0);
        }
        if fl >= 0 {
            if on != 0 {
                fl = fl | NET_O_NONBLOCK;
            } else {
                fl = fl & ~NET_O_NONBLOCK;
            }
            raw {
                r = syscall(NET_SYS_FCNTL, sock, NET_F_SETFL, fl);
            }
        }
        r = net_linux(r);
        if fl < 0 {
            r = -1;
        }
    } else {
        // ioctlsocket(s, FIONBIO, &arg): FIONBIO is 0x8004667E
        var arg: [i64; 1];
        arg[0] = 0;
        if on != 0 { arg[0] = 1; }
        raw {
            r = call p_ioctl(sock, 2147772030, &arg);
        }
        r = net_int(r);
    }
    if r == -1 {
        fail "the socket's waiting could not be changed" hint "the system refused: is it open?";
    }
    return 1;
}

// octet i (0 to 3) of the address of the last datagram's sender
fn net_from_ip(i: i64) -> i64 {
    if i < 0 || i > 3 {
        fail "an address has four parts" hint "i from 0 to 3";
    }
    return (net_from[0] >> (32 + i * 8)) & 255;
}

fn net_from_port() -> i64 {
    var v: i64 = net_from[0];
    return (((v >> 16) & 255) << 8) | ((v >> 24) & 255);
}

fn net_udp_broadcast(sock: i64, on: i64) -> i64 {
    var r: i64 = 0;
    var one: [i64; 1];
    one[0] = 0;
    if on != 0 { one[0] = 1; }
    if net_is_linux() {
        raw {
            r = syscall(NET_SYS_SETSOCKOPT, sock, NET_SOL_SOCKET, NET_SO_BROADCAST, &one, 4);
        }
        r = net_linux(r);
    } else {
        // SOL_SOCKET 0xFFFF, SO_BROADCAST 0x20 on Windows
        raw {
            r = call p_setsockopt(sock, 65535, 32, &one, 4);
        }
        r = net_int(r);
    }
    if r == -1 {
        fail "broadcast could not be set" hint "the system refused";
    }
    return 1;
}

// 1 when sock has something to read within ms milliseconds, else 0: a TCP
// socket's data or a waiting client, a UDP datagram
fn net_wait(sock: i64, ms: i64) -> i64 {
    var r: i64 = net_sys_poll(sock, ms);
    if r == -1 {
        fail "the socket cannot be waited on" hint "it may be closed";
    }
    if r > 0 { return 1; }
    return 0;
}
