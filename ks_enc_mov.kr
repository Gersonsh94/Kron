kron_program
kron_domain ks_enc_mov;
kron_imports
kron_definitions

// =========================================================================
// mov AND xchg
//
// Every form takes the two operands' kinds and values (k_d, v_d, k_s,
// v_s), which ks_mov_parse left in en_r12..en_r15 as well: they are what a
// line that cannot be encoded reports.
// =========================================================================

var mv_kd: i64;
var mv_vd: i64;
var mv_ks: i64;
var mv_vs: i64;

// the low 32 bits of a value, the register field the assembly read
fn ks_lo(v: i64) -> i64 {
    return v & 0xFFFFFFFF;
}

// xchg [reg], reg32 / reg64: 87 /r. With a memory operand the exchange is
// atomic without a lock prefix: what the Linux runtime's locks are built on.
fn ks_i_xchg() -> i64 {
    var kd: i64 = ks_parse_operand(&tok_b);
    var vd: i64 = po_val;
    var ks: i64 = 0;
    var vs: i64 = 0;
    var w: i64 = 0;
    en_r12 = kd;
    ks = ks_parse_operand(&tok_c);
    vs = po_val;
    en_r14 = ks;
    if ks_lo(kd) != 9 {
        return ks_unsupported();
    }
    if ks_lo(ks) == 8 {
        w = 0;
    } else if ks_lo(ks) == 1 {
        w = 1;
    } else {
        return ks_unsupported();
    }
    ks_emit_rex(w, ks_lo(vs), ks_lo(vd));
    ks_emit_b(0x87);
    return ks_emit_mem_reg(ks_lo(vs), ks_lo(vd));
}

fn ks_i_mov() -> i64 {
    var cr: i64 = 0;
    mv_kd = ks_parse_operand(&tok_b);
    mv_vd = po_val;
    // the destination's addend (as in [rel buf+1]): parsing the source
    // clears cur_addend
    dst_addend = cur_addend;
    dst_base = po_r8;
    en_r12 = mv_kd;
    mv_ks = ks_parse_operand(&tok_c);
    mv_vs = po_val;
    src_base = po_r8;
    en_r14 = mv_ks;
    // mov crN, r64 (0F 22 /r) and mov r64, crN (0F 20 /r)
    if ks_lo(mv_ks) == 1 {
        cr = ks_crnum(&tok_b);
        if ks_lo(cr) != 0xFFFFFFFF {
            return ks_mov_cr(ks_lo(cr), ks_lo(mv_vs), 0x22);
        }
    }
    if ks_lo(mv_kd) == 1 {
        cr = ks_crnum(&tok_c);
        if ks_lo(cr) != 0xFFFFFFFF {
            return ks_mov_cr(ks_lo(cr), ks_lo(mv_vd), 0x20);
        }
    }
    cr = ks_lo(mv_kd);
    if cr == 1 { return ks_mov_to_reg(); }
    if cr == 8 { return ks_mov_to_r32(); }
    if cr == 12 { return ks_mov_to_sib(); }
    if cr == 13 { return ks_mov_to_bd(); }
    if cr == 3 { return ks_mov_to_mem(); }
    if cr == 9 { return ks_mov_to_memreg(); }
    if cr == 5 { return ks_mov_to_rip(); }
    if cr == 11 { return ks_mov_to_rsp(); }
    if cr == 7 { return ks_mov_to_reg8(); }
    if cr == 10 { return ks_mov_to_reg16(); }
    return ks_unsupported();
}

// REX: R for cr8 and up, B for r8..r15
fn ks_mov_cr(cr: i64, gpr: i64, op: i64) -> i64 {
    var r: i64 = 0;
    if cr >= 8 {
        r = r | 0x44;
    }
    if gpr >= 8 {
        r = r | 0x41;
    }
    if r != 0 {
        ks_emit_b(r);
    }
    ks_emit_b(0x0F);
    ks_emit_b(op);
    return ks_emit_b(0xC0 | ((cr & 7) << 3) | (gpr & 7));
}

// a 32-bit destination: no REX.W
fn ks_mov_to_r32() -> i64 {
    var k: i64 = ks_lo(mv_ks);
    var d: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    if k == 3 {
        // an i32 or u32 struct field in the frame
        ks_emit_rex(0, d, 5);
        ks_emit_b(0x8B);
        return ks_emit_mem_rbp(d, s);
    }
    if k == 2 {
        ks_emit_rex(0, 0, d);
        ks_emit_b(0xB8 | (d & 7));
        return ks_emit_d(s);
    }
    if k == 8 {
        ks_emit_rex(0, s, d);
        ks_emit_b(0x89);
        return ks_emit_modrm(3, s, d);
    }
    if k == 5 {
        ks_emit_rex(0, d, 0);
        ks_emit_b(0x8B);
        return ks_emit_rip(d, s);
    }
    if k == 9 {
        ks_emit_rex(0, d, s);
        ks_emit_b(0x8B);
        return ks_emit_mem_reg(d, s);
    }
    if k == 13 {
        ks_emit_rex(0, d, ks_lo(src_base));
        ks_emit_b(0x8B);
        return ks_emit_mem_base_disp(d, ks_lo(src_base), s);
    }
    if k == 12 {
        return ks_emit_sib_mem(0x8B, d, s, 0);
    }
    return ks_unsupported();
}

// mov [rsp+N], reg64 | imm32: SIB 24, a disp8 or a disp32
fn ks_mov_to_rsp() -> i64 {
    var n: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    if ks_lo(mv_ks) == 1 {
        ks_emit_rex(1, s, 0);
        ks_emit_b(0x89);
        if n <= 127 {
            ks_emit_modrm(1, s, 4);
            ks_emit_b(0x24);
            return ks_emit_b(n);
        }
        ks_emit_modrm(2, s, 4);
        ks_emit_b(0x24);
        return ks_emit_d(n);
    }
    if ks_lo(mv_ks) != 2 {
        return ks_unsupported();
    }
    ks_emit_rex(1, 0, 0);
    ks_emit_b(0xC7);
    if n > 127 {
        ks_emit_modrm(2, 0, 4);
        ks_emit_b(0x24);
        ks_emit_d(n);
    } else {
        ks_emit_modrm(1, 0, 4);
        ks_emit_b(0x24);
        ks_emit_b(n);
    }
    return ks_emit_d(s);
}

// mov [rel label], src: the fixup takes the destination's addend back
fn ks_mov_to_rip() -> i64 {
    var k: i64 = ks_lo(mv_ks);
    var l: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    var w: i64 = 0;
    cur_addend = dst_addend;
    if k == 7 {
        // spl/bpl/sil/dil exist only with a REX byte present
        if s >= 4 {
            rex8_force = 1;
        }
        ks_emit_rex(0, s, 0);
        ks_emit_b(0x88);
        return ks_emit_rip(s, l);
    }
    if k == 8 {
        ks_emit_rex(0, s, 0);
        ks_emit_b(0x89);
        return ks_emit_rip(s, l);
    }
    if k == 10 {
        ks_emit_b(0x66);
        ks_emit_rex(0, s, 0);
        ks_emit_b(0x89);
        return ks_emit_rip(s, l);
    }
    if k == 2 {
        // the displacement counts to the end of the instruction: the bytes
        // of the immediate after it are taken off the addend
        if op_size == 1 {
            ks_emit_b(0xC6);
            cur_addend = dst_addend - 1;
            ks_emit_rip(0, l);
            return ks_emit_b(s);
        }
        if op_size == 2 {
            ks_emit_b(0x66);
            ks_emit_rex(0, 0, 0);
            ks_emit_b(0xC7);
            cur_addend = dst_addend - 2;
            ks_emit_rip(0, l);
            return ks_emit_w(s);
        }
        w = 1;
        if op_size == 4 {
            w = 0;
        }
        ks_emit_rex(w, 0, 0);
        ks_emit_b(0xC7);
        cur_addend = dst_addend - 4;
        ks_emit_rip(0, l);
        return ks_emit_d(s);
    }
    if k != 1 {
        return ks_unsupported();
    }
    ks_emit_rex(1, s, 0);
    ks_emit_b(0x89);
    return ks_emit_rip(s, l);
}

// mov [base+disp], reg64/32/16/8 | imm
fn ks_mov_to_bd() -> i64 {
    var k: i64 = ks_lo(mv_ks);
    var n: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    var b: i64 = ks_lo(dst_base);
    var w: i64 = 0;
    if k == 1 {
        ks_emit_rex(1, s, b);
        ks_emit_b(0x89);
        return ks_emit_mem_base_disp(s, b, n);
    }
    if k == 8 {
        ks_emit_rex(0, s, b);
        ks_emit_b(0x89);
        return ks_emit_mem_base_disp(s, b, n);
    }
    if k == 10 {
        ks_emit_b(0x66);
        ks_emit_rex(0, s, b);
        ks_emit_b(0x89);
        return ks_emit_mem_base_disp(s, b, n);
    }
    if k == 2 {
        if op_size == 1 {
            ks_emit_rex(0, 0, b);
            ks_emit_b(0xC6);
            ks_emit_mem_base_disp(0, b, n);
            return ks_emit_b(s);
        }
        if op_size == 2 {
            ks_emit_b(0x66);
            ks_emit_rex(0, 0, b);
            ks_emit_b(0xC7);
            ks_emit_mem_base_disp(0, b, n);
            return ks_emit_w(s);
        }
        w = 1;
        if op_size == 4 {
            w = 0;
        }
        ks_emit_rex(w, 0, b);
        ks_emit_b(0xC7);
        ks_emit_mem_base_disp(0, b, n);
        return ks_emit_d(s);
    }
    if k == 7 {
        if s >= 4 {
            rex8_force = 1;
        }
        ks_emit_rex(0, s, b);
        ks_emit_b(0x88);
        return ks_emit_mem_base_disp(s, b, n);
    }
    return ks_unsupported();
}

// mov [base+index*scale], reg64/32/16/8 | byte imm8
fn ks_mov_to_sib() -> i64 {
    var k: i64 = ks_lo(mv_ks);
    var v: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    if k == 7 {
        if s >= 4 {
            rex8_force = 1;
        }
        return ks_emit_sib_mem(0x88, s, v, 0);
    }
    if k == 8 {
        return ks_emit_sib_mem(0x89, s, v, 0);
    }
    if k == 10 {
        ks_emit_b(0x66);
        return ks_emit_sib_mem(0x89, s, v, 0);
    }
    if k == 2 {
        if op_size != 1 {
            return ks_unsupported();
        }
        ks_emit_sib_mem(0xC6, 0, v, 0);
        return ks_emit_b(s);
    }
    if k != 1 {
        return ks_unsupported();
    }
    return ks_emit_sib_mem(0x89, s, v, 1);
}

// mov reg16, src: 66 first, then the 32-bit forms
fn ks_mov_to_reg16() -> i64 {
    var k: i64 = ks_lo(mv_ks);
    var d: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    ks_emit_b(0x66);
    if k == 2 {
        ks_emit_rex(0, 0, d);
        ks_emit_b(0xB8 | (d & 7));
        return ks_emit_w(s);
    }
    if k == 10 {
        ks_emit_rex(0, s, d);
        ks_emit_b(0x89);
        return ks_emit_modrm(3, s, d);
    }
    if k == 9 {
        ks_emit_rex(0, d, s);
        ks_emit_b(0x8B);
        return ks_emit_mem_reg(d, s);
    }
    if k == 5 {
        ks_emit_rex(0, d, 0);
        ks_emit_b(0x8B);
        return ks_emit_rip(d, s);
    }
    if k == 12 {
        return ks_emit_sib_mem(0x8B, d, s, 0);
    }
    if k == 13 {
        ks_emit_rex(0, d, ks_lo(src_base));
        ks_emit_b(0x8B);
        return ks_emit_mem_base_disp(d, ks_lo(src_base), s);
    }
    return ks_unsupported();
}

// mov reg8, src: spl/bpl/sil/dil only exist behind a REX byte
fn ks_mov_to_reg8() -> i64 {
    var k: i64 = ks_lo(mv_ks);
    var d: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    if d >= 4 {
        rex8_force = 1;
    }
    if k == 7 {
        if s >= 4 {
            rex8_force = 1;
        }
        ks_emit_rex(0, s, d);
        ks_emit_b(0x88);
        return ks_emit_modrm(3, s, d);
    }
    if k == 2 {
        ks_emit_rex(0, 0, d);
        ks_emit_b(0xB0 | (d & 7));
        return ks_emit_b(s);
    }
    if k == 9 {
        ks_emit_rex(0, d, s);
        ks_emit_b(0x8A);
        return ks_emit_mem_reg(d, s);
    }
    if k == 12 {
        return ks_emit_sib_mem(0x8A, d, s, 0);
    }
    if k == 13 {
        ks_emit_rex(0, d, ks_lo(src_base));
        ks_emit_b(0x8A);
        return ks_emit_mem_base_disp(d, ks_lo(src_base), s);
    }
    if k == 5 {
        ks_emit_rex(0, d, 0);
        ks_emit_b(0x8A);
        return ks_emit_rip(d, s);
    }
    if k == 3 {
        ks_emit_rex(0, d, 5);
        ks_emit_b(0x8A);
        return ks_emit_mem_rbp(d, s);
    }
    return ks_unsupported();
}

// mov reg64, src
fn ks_mov_to_reg() -> i64 {
    var k: i64 = ks_lo(mv_ks);
    var d: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    if k == 12 {
        return ks_emit_sib_mem(0x8B, d, s, 1);
    }
    if k == 2 {
        // a value that fits in 32 unsigned bits needs no REX.W: writing eax
        // zero-extends
        if (mv_vs >>> 32) != 0 || (s & 0x80000000) != 0 {
            ks_emit_rex(1, 0, d);
            ks_emit_b(0xB8 | (d & 7));
            return ks_emit_q(mv_vs);
        }
        ks_emit_rex(0, 0, d);
        ks_emit_b(0xB8 | (d & 7));
        return ks_emit_d(s);
    }
    if k == 1 {
        ks_emit_rex(1, s, d);
        ks_emit_b(0x89);
        return ks_emit_modrm(3, s, d);
    }
    if k == 3 {
        ks_emit_rex(1, d, 5);
        ks_emit_b(0x8B);
        return ks_emit_mem_rbp(d, s);
    }
    if k == 5 {
        ks_emit_rex(1, d, 0);
        ks_emit_b(0x8B);
        return ks_emit_rip(d, s);
    }
    if k == 9 {
        ks_emit_rex(1, d, s);
        ks_emit_b(0x8B);
        return ks_emit_mem_reg(d, s);
    }
    if k == 13 {
        ks_emit_rex(1, d, ks_lo(src_base));
        ks_emit_b(0x8B);
        return ks_emit_mem_base_disp(d, ks_lo(src_base), s);
    }
    if k == 11 {
        ks_emit_rex(1, d, 4);
        ks_emit_b(0x8B);
        return ks_emit_mem_base_disp(d, 4, 0 - s);
    }
    if k == 4 {
        // mov reg64, label: lea reg64, [rel label], the same address
        ks_emit_rex(1, d, 0);
        ks_emit_b(0x8D);
        return ks_emit_rip(d, s);
    }
    return ks_unsupported();
}

// mov [rbp-N], src
fn ks_mov_to_mem() -> i64 {
    var k: i64 = ks_lo(mv_ks);
    var n: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    var t: i64 = 0;
    if k == 2 {
        if op_size == 1 {
            ks_emit_b(0xC6);
            ks_emit_mem_rbp(0, n);
            return ks_emit_b(s);
        }
        if op_size == 2 {
            ks_emit_b(0x66);
            ks_emit_b(0xC7);
            ks_emit_mem_rbp(0, n);
            return ks_emit_w(s);
        }
        if op_size == 4 {
            ks_emit_b(0xC7);
            ks_emit_mem_rbp(0, n);
            return ks_emit_d(s);
        }
        // a qword store takes a sign-extended imm32: anything wider is
        // refused
        t = mv_vs >>> 31;
        if t != 0 {
            if ((t + 1) >>> 33) != 1 {
                return ks_unsupported();
            }
        }
        ks_emit_rex(1, 0, 5);
        ks_emit_b(0xC7);
        ks_emit_mem_rbp(0, n);
        return ks_emit_d(s);
    }
    if k == 8 || k == 10 {
        if k == 10 {
            ks_emit_b(0x66);
        }
        ks_emit_rex(0, s, 5);
        ks_emit_b(0x89);
        return ks_emit_mem_rbp(s, n);
    }
    if k == 7 {
        if s >= 4 && s < 8 {
            rex8_force = 1;
        }
        ks_emit_rex(0, s, 5);
        ks_emit_b(0x88);
        return ks_emit_mem_rbp(s, n);
    }
    if k != 1 {
        return ks_unsupported();
    }
    ks_emit_rex(1, s, 5);
    ks_emit_b(0x89);
    return ks_emit_mem_rbp(s, n);
}

// mov [reg], src
fn ks_mov_to_memreg() -> i64 {
    var k: i64 = ks_lo(mv_ks);
    var d: i64 = ks_lo(mv_vd);
    var s: i64 = ks_lo(mv_vs);
    var w: i64 = 0;
    if k == 2 {
        if op_size == 1 {
            ks_emit_rex(0, 0, d);
            ks_emit_b(0xC6);
            ks_emit_mem_reg(0, d);
            return ks_emit_b(s);
        }
        if op_size == 2 {
            ks_emit_b(0x66);
            ks_emit_rex(0, 0, d);
            ks_emit_b(0xC7);
            ks_emit_mem_reg(0, d);
            return ks_emit_w(s);
        }
        w = 1;
        if op_size == 4 {
            w = 0;
        }
        ks_emit_rex(w, 0, d);
        ks_emit_b(0xC7);
        ks_emit_mem_reg(0, d);
        return ks_emit_d(s);
    }
    if k == 7 {
        if s >= 4 {
            rex8_force = 1;
        }
        ks_emit_rex(0, s, d);
        ks_emit_b(0x88);
        return ks_emit_mem_reg(s, d);
    }
    if k == 8 {
        ks_emit_rex(0, s, d);
        ks_emit_b(0x89);
        return ks_emit_mem_reg(s, d);
    }
    if k == 10 {
        ks_emit_b(0x66);
        ks_emit_rex(0, s, d);
        ks_emit_b(0x89);
        return ks_emit_mem_reg(s, d);
    }
    if k != 1 {
        return ks_unsupported();
    }
    ks_emit_rex(1, s, d);
    ks_emit_b(0x89);
    return ks_emit_mem_reg(s, d);
}
