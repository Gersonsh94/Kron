const TOK_TILDE: i64 = 38;
const TOK_LSHIFT: i64 = 39;
const TOK_RSHIFT: i64 = 40;
const TOK_EQ: i64 = 41;
const TOK_NEQ: i64 = 42;
const TOK_LT: i64 = 43;
const TOK_GT: i64 = 44;
const TOK_LTE: i64 = 45;
const TOK_GTE: i64 = 46;
const TOK_AND: i64 = 47;
const TOK_OR: i64 = 48;
const TOK_NOT: i64 = 49;
const TOK_URSHIFT: i64 = 50;
const TOK_PLUS_ASSIGN: i64 = 51;
const TOK_MINUS_ASSIGN: i64 = 52;
const TOK_STAR_ASSIGN: i64 = 53;
const TOK_SLASH_ASSIGN: i64 = 54;
const TOK_XOR_ASSIGN: i64 = 55;

