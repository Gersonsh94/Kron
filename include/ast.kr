kron_program
kron_domain ast;
kron_imports
kron_definitions

// =========================================================================
// The tree the parser builds and the passes after it read, for the parts
// of the compiler written in Kron. The numbers are the same as the %define
// lines of include/kron_types.inc, which the hand-written parts read.
//
// A node is 56 bytes:
// =========================================================================

struct Ast {
    node_type: i64;
    left: i64;
    right: i64;
    data: i64;
    child_count: u32;
    line: u16;
    col: u16;
    type_info: i64;
    owner_type: i64;
}

const AST_NODE_SIZE: i64 = 56;

const VIS_DEFAULT: i64 = 0;
const VIS_EXPORTED: i64 = 1;
