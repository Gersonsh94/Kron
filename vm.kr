kron_program
kron_domain vm;
kron_imports
kron_definitions

fn vm_push_add(a: int32, b: int32) { return a + b; }
fn vm_push_mul(a: int32, b: int32) { return a * b; }
fn vm_push_max(a: int32, b: int32) { if a > b { return a; } return b; }
fn vm_halt(a: int32, b: int32) { return 0 - 1; }

fn main() {
    var ops: [int64; 4];
    ops[0] = &vm_push_add;
    ops[1] = &vm_push_mul;
    ops[2] = &vm_push_max;
    ops[3] = &vm_halt;

    var program: [int32; 5];
    program[0] = 0;
    program[1] = 1;
    program[2] = 2;
    program[3] = 0;
    program[4] = 3;

    var acc: int32 = 3;
    var pc: int32 = 0;
    loop {
        var op: int32 = program[pc];
        var f: int64 = ops[op];
        var r: int32 = call f(acc, 5);
        if r < 0 { break; }
        acc = r;
        print(acc);
        pc = pc + 1;
    }
    return 0;
}
