kron_program
kron_domain std_ui;
kron_imports
acquire_domain "std_window.kr";
acquire_domain "std_image.kr";
kron_definitions

// =========================================================================
// Kron standard library -- programs with text, buttons and boxes to type in.
//
// Drawn by Kron itself on a std_window window, so a program looks and works
// the same on Windows, on Linux and on ARM64, with no library underneath:
// anti-aliased letters (Inter), rounded corners, soft shadows, a light and a
// dark theme, and controls that ease into their hover and pressed states.
//
// Immediate mode: every frame the program says what is on the screen, and
// each control answers what happened to it in that frame. There are no
// objects to create, keep or free:
//
//     while window_show() {
//         ui_begin();
//         ui_card(20, 20, 380, 200, "Profile");
//         ui_label(40, 70, "Name");
//         ui_input(40, 92, 340, &name, 64);
//         if ui_button(40, 150, 120, 38, "Save") {
//             ...
//         }
//         ui_end();
//     }
//
// Text
//   ui_label(x, y, "text")                    body text
//   ui_muted(x, y, "text")                    secondary text
//   ui_bold(x, y, "text")                     semibold
//   ui_title(x, y, "text")                    large
//   ui_text(x, y, "text", color)              body text in any color
//   ui_text_big(x, y, "text", color, scale)   large text in any color
//   ui_text_width("text")                     in pixels (body text)
// Controls
//   ui_button(x, y, w, h, "text")             filled with the accent color;
//                                             1 in the frame it is clicked
//   ui_button_alt(x, y, w, h, "text")         the quiet one, outlined
//   ui_button_color(x, y, w, h, "text", fill, text_color)
//   ui_input(x, y, w, buffer, capacity)       a box to type in, 38 high: the
//                                             text is the buffer's bytes, ending
//                                             in 0; 1 when enter is pressed in it
//   ui_input_hint(x, y, w, buffer, capacity, "shown while empty")
//   ui_check(x, y, "text", value)             a checkbox: returns the new value
//   ui_switch(x, y, "text", value)            an on/off switch: the new value
//   ui_slider(x, y, w, value, low, high)      returns the new value
//   ui_progress(x, y, w, value, total)        a bar
//   ui_card(x, y, w, h, "title")              a raised panel to group controls
//   ui_edit(x, y, w, t, "hint")               a box that edits text t (std_text):
//                                             caret, arrows, home and end,
//                                             delete, Ctrl+C / Ctrl+X / Ctrl+V;
//                                             1 when enter is pressed in it
//   ui_area(x, y, w, h, t)                    several lines of text t to edit,
//                                             with the wheel to scroll; 1 when
//                                             it changed this frame
//   ui_list(x, y, w, h, items, selected)      a list of texts that scrolls;
//                                             returns the selected index
//   ui_select(x, y, w, items, selected)       a dropdown to choose one of a
//                                             list of texts: the new index
//   ui_radio(x, y, "text", value, mine)       one of a group: returns mine
//                                             when clicked, value otherwise
//   ui_tabs(x, y, "One|Two|Three", selected)  tabs: the new index
//   ui_menubar()                              a bar of menus across the top:
//   ui_menu("File")                           1 while this menu is open, and
//   ui_menu_item("Open")                      1 when this item is chosen
//   ui_menu_line()                            a line between items
//   ui_image(x, y, img)                       a picture (std_image), with alpha
//   ui_image_size(x, y, w, h, img)            the same, scaled
//   ui_copy(x)  ui_paste()                    the clipboard: a text in, a new
//                                             text out; other programs see it
// Shapes
//   ui_round(x, y, w, h, radius, color)       a rounded rectangle
//   ui_circle(cx, cy, radius, color)
// Frame and theme
//   ui_begin() / ui_end()                     around each frame's controls;
//                                             ui_begin paints the background
//   ui_dark(on)                               the dark theme, or the light one
//   ui_accent(color)                          the color of buttons and focus
//   ui_key(k) / ui_typed(c)                   the key k pressed, or the
//                                             character c typed, this frame
//   ui_int_text(buffer, n)                    a number as text
//   ui_real_text(buffer, v, decimals)         a real as text, trailing zeros cut
//
// A control is known by where it is: two controls must not share x and y.
// Wherever a control shows text it takes a text (std_text) or a literal.
// The older ui_input works on a byte buffer: &name of a [u8; N].
// The letters cover ASCII and Latin-1: accented vowels, n with tilde, the
// opening question and exclamation marks... Text is UTF-8, as the source is.
// =========================================================================

// ---- the letters: Inter, 15 px regular and semibold, 30 px display -------
// Each glyph: advance, width and left offset (+128) as two hex digits each,
// then its pixels, one hex digit of coverage (0..15) each, row by row.
// Rendered from Inter (SIL Open Font License) for the 191 printable
// characters of Latin-1.

var ui_pix: [i64; 24000];            // every glyph's coverage, a byte a pixel
var ui_gofs: [i64; 768];             // font * 256 + char -> where its pixels start
var ui_gadv: [i64; 768];
var ui_gw: [i64; 768];
var ui_gx: [i64; 768];
var ui_fh: [i64; 3];                 // line height of each font
var ui_ready: i64;

// colors of the theme
var ui_c_bg: i64;
var ui_c_card: i64;
var ui_c_text: i64;
var ui_c_muted: i64;
var ui_c_line: i64;
var ui_c_field: i64;
var ui_c_track: i64;
var ui_c_accent: i64;
var ui_c_accent_dark: i64;
var ui_c_on_accent: i64;
var ui_c_shadow: i64;
var ui_c_hover: i64;
var ui_is_dark: i64;

// the frame
var ui_mx: i64;
var ui_my: i64;
var ui_down: i64;
var ui_was_down: i64;
var ui_pressed: i64;
var ui_released: i64;
var ui_active: i64;                  // the control the press began on
var ui_focus: i64;                   // the box being typed in
var ui_kb_want: i64;                 // a box to type in has the focus this frame
var ui_kb_shown: i64;                // ... and had it the last: the screen keyboard is up
var ui_tick: i64;
var ui_chars: [i64; 64];
var ui_nchars: i64;
var ui_keys: [i64; 64];
var ui_nkeys: i64;

// eased hover and press amounts, by control
var ui_wheel: i64;
var ui_rpressed: i64;
var ui_ctrl: i64;
var ui_caret: i64;                   // where the caret is in the focused box
var ui_scroll_px: i64;               // how far the focused box is scrolled
var ui_sc_id: [i64; 64];             // scroll positions of lists and areas
var ui_sc_v: [i64; 64];
var ui_sc_next: i64;
// an overlay (an open menu or dropdown) sits above everything else: the
// controls under it ignore the mouse, and it is drawn last, in ui_end
var ui_block_on: i64;
var ui_block_x: i64;
var ui_block_y: i64;
var ui_block_w: i64;
var ui_block_h: i64;
var ui_nb_on: i64;                   // the overlay being built this frame
var ui_nb_x: i64;
var ui_nb_y: i64;
var ui_nb_w: i64;
var ui_nb_h: i64;
var ui_ov_kind: [i64; 128];          // what ui_end draws: 1 panel, 2 item,
var ui_ov_x: [i64; 128];             // 3 line, 4 a list row
var ui_ov_y: [i64; 128];
var ui_ov_w: [i64; 128];
var ui_ov_h: [i64; 128];
var ui_ov_text: [i64; 128];
var ui_ov_flag: [i64; 128];
var ui_ov_n: i64;
var ui_raw_hit: i64;                 // set while an overlay tests the mouse
var ui_menu_open: i64;               // the open menu, 0 none
var ui_menu_x: i64;                  // where the next menu title goes
var ui_menu_y: i64;
var ui_menu_h: i64;
var ui_menu_any: i64;                // the pointer is on the bar or a menu
var ui_drop_x: i64;
var ui_drop_y: i64;
var ui_drop_n: i64;
var ui_drop_w: i64;
var ui_drop_wnext: i64;
var ui_sel_open: i64;                // the open dropdown list, 0 none
var ui_anim_id: [i64; 64];
var ui_anim_v: [i64; 64];
var ui_anim_next: i64;

fn ui_hexv(c: i64) -> i64 {
    if c >= 65 { return c - 55; }
    return c - 48;
}

fn ui_load_font(f: i64, hex: i64, height: i64, at: i64) -> i64 {
    var p: i64 = hex;
    var o: i64 = at;
    var c: i64 = 32;
    ui_fh[f] = height;
    while c < 256 {
        if c == 127 { c = 160; }
        var a0: i64 = 0;
        var a1: i64 = 0;
        var w0: i64 = 0;
        var w1: i64 = 0;
        var x0: i64 = 0;
        var x1: i64 = 0;
        raw {
            a0 = peek8(p);
            a1 = peek8(p + 1);
            w0 = peek8(p + 2);
            w1 = peek8(p + 3);
            x0 = peek8(p + 4);
            x1 = peek8(p + 5);
        }
        var slot: i64 = f * 256 + c;
        var w: i64 = ui_hexv(w0) * 16 + ui_hexv(w1);
        ui_gadv[slot] = ui_hexv(a0) * 16 + ui_hexv(a1);
        ui_gw[slot] = w;
        ui_gx[slot] = ui_hexv(x0) * 16 + ui_hexv(x1) - 128;
        ui_gofs[slot] = o;
        p = p + 6;
        var n: i64 = w * height;
        var i: i64 = 0;
        raw {
            var dst: i64 = &ui_pix + o;
            while i < n {
                poke8(dst + i, ui_hexv(peek8(p + i)));
                i = i + 1;
            }
        }
        p = p + n;
        o = o + n;
        c = c + 1;
    }
    return o;
}

fn ui_init() -> i64 {
    var o: i64 = 0;
    o = ui_load_font(0, "", 19, o);
    o = ui_load_font(1, "", 19, o);
    o = ui_load_font(2, "", 38, o);
    if ui_c_accent == 0 {
        ui_dark(0);
    }
    ui_ready = 1;
    return 1;
}

fn ui_dark(on: i64) -> i64 {
    var accent: i64 = ui_c_accent;
    ui_is_dark = on;
    if on {
        ui_c_bg = 0x0F1117;
        ui_c_card = 0x1A1D26;
        ui_c_text = 0xE6E8EE;
        ui_c_muted = 0x9AA1B2;
        ui_c_line = 0x2C3140;
        ui_c_field = 0x12141B;
        ui_c_track = 0x2C3140;
        ui_c_shadow = 0x000000;
        ui_c_hover = 0x262A36;
    } else {
        ui_c_bg = 0xF3F4F7;
        ui_c_card = 0xFFFFFF;
        ui_c_text = 0x111827;
        ui_c_muted = 0x6B7280;
        ui_c_line = 0xD7DBE2;
        ui_c_field = 0xFFFFFF;
        ui_c_track = 0xE3E6EC;
        ui_c_shadow = 0x1F2937;
        ui_c_hover = 0xF1F2F6;
    }
    if accent == 0 {
        accent = 0x5B5BD6;
    }
    ui_accent(accent);
    return 1;
}

fn ui_accent(color: i64) -> i64 {
    ui_c_accent = color;
    ui_c_accent_dark = ui_mix(color, 0x000000, 40);
    ui_c_on_accent = 0xFFFFFF;
    return 1;
}

// ---- colors --------------------------------------------------------------

// over drawn on under with alpha 0..255
fn ui_mix(under: i64, over: i64, alpha: i64) -> i64 {
    if alpha >= 255 { return over; }
    if alpha <= 0 { return under; }
    var ia: i64 = 255 - alpha;
    var r: i64 = (((over >> 16) & 255) * alpha + ((under >> 16) & 255) * ia) / 255;
    var g: i64 = (((over >> 8) & 255) * alpha + ((under >> 8) & 255) * ia) / 255;
    var b: i64 = ((over & 255) * alpha + (under & 255) * ia) / 255;
    return (r << 16) | (g << 8) | b;
}

fn ui_blend_at(x: i64, y: i64, color: i64, alpha: i64) -> i64 {
    if alpha <= 0 { return 0; }
    if alpha >= 255 {
        window_pixel(x, y, color);
        return 1;
    }
    window_pixel(x, y, ui_mix(window_pixel_at(x, y), color, alpha));
    return 1;
}

// ---- the frame -----------------------------------------------------------

fn ui_begin() -> i64 {
    if ui_ready == 0 {
        ui_init();
    }
    ui_mx = window_mouse_x();
    ui_my = window_mouse_y();
    ui_was_down = ui_down;
    ui_down = window_mouse_down();
    // presses and releases as events, so a click shorter than a frame
    // still counts; and as edges, in case an event was missed
    ui_pressed = 0;
    ui_released = 0;
    if window_mouse_pressed() > 0 { ui_pressed = 1; }
    if window_mouse_released() > 0 { ui_released = 1; }
    if ui_down {
        if ui_was_down == 0 { ui_pressed = 1; }
    } else {
        if ui_was_down { ui_released = 1; }
    }
    // a press on nothing takes the focus away from the boxes
    if ui_pressed {
        ui_focus = 0;
    }
    ui_nchars = 0;
    var c: i64 = window_char();
    while c != 0 {
        if ui_nchars < 64 {
            ui_chars[ui_nchars] = c;
            ui_nchars = ui_nchars + 1;
        }
        c = window_char();
    }
    ui_nkeys = 0;
    var k: i64 = window_key();
    while k != 0 {
        if ui_nkeys < 64 {
            ui_keys[ui_nkeys] = k;
            ui_nkeys = ui_nkeys + 1;
        }
        k = window_key();
    }
    ui_tick = ui_tick + 1;
    ui_wheel = window_wheel();
    ui_rpressed = window_right_pressed();
    ui_ctrl = window_ctrl();
    // the overlay of the last frame blocks the mouse in this one
    ui_block_on = ui_nb_on;
    ui_block_x = ui_nb_x;
    ui_block_y = ui_nb_y;
    ui_block_w = ui_nb_w;
    ui_block_h = ui_nb_h;
    ui_nb_on = 0;
    ui_ov_n = 0;
    ui_menu_any = 0;
    window_unclip();
    window_clear(ui_c_bg);
    return 1;
}

fn ui_end() -> i64 {
    window_unclip();
    // a phone's screen keyboard follows the boxes to type in
    if ui_kb_want != ui_kb_shown {
        window_keyboard(ui_kb_want);
        ui_kb_shown = ui_kb_want;
    }
    ui_kb_want = 0;
    // a press anywhere else closes an open menu or dropdown
    if ui_pressed {
        if ui_menu_open != 0 && ui_menu_any == 0 {
            ui_menu_open = 0;
            ui_nb_on = 0;
        }
    }
    if ui_key(27) {
        ui_menu_open = 0;
        ui_sel_open = 0;
        ui_nb_on = 0;
    }
    ui_draw_overlay();
    if ui_released {
        ui_active = 0;
    }
    return 1;
}

fn ui_ov_add(kind: i64, x: i64, y: i64, w: i64, h: i64, text: i64, flag: i64) -> i64 {
    if ui_ov_n >= 128 {
        return 0;
    }
    ui_ov_kind[ui_ov_n] = kind;
    ui_ov_x[ui_ov_n] = x;
    ui_ov_y[ui_ov_n] = y;
    ui_ov_w[ui_ov_n] = w;
    ui_ov_h[ui_ov_n] = h;
    ui_ov_text[ui_ov_n] = text;
    ui_ov_flag[ui_ov_n] = flag;
    ui_ov_n = ui_ov_n + 1;
    return 1;
}

// grow this frame's overlay rectangle to cover x, y, w, h
fn ui_nb_cover(x: i64, y: i64, w: i64, h: i64) -> i64 {
    if ui_nb_on == 0 {
        ui_nb_on = 1;
        ui_nb_x = x;
        ui_nb_y = y;
        ui_nb_w = w;
        ui_nb_h = h;
        return 1;
    }
    var x1: i64 = ui_nb_x + ui_nb_w;
    var y1: i64 = ui_nb_y + ui_nb_h;
    if x < ui_nb_x { ui_nb_x = x; }
    if y < ui_nb_y { ui_nb_y = y; }
    if x + w > x1 { x1 = x + w; }
    if y + h > y1 { y1 = y + h; }
    ui_nb_w = x1 - ui_nb_x;
    ui_nb_h = y1 - ui_nb_y;
    return 1;
}

fn ui_draw_overlay() -> i64 {
    var i: i64 = 0;
    while i < ui_ov_n {
        var k: i64 = ui_ov_kind[i];
        var x: i64 = ui_ov_x[i];
        var y: i64 = ui_ov_y[i];
        var w: i64 = ui_ov_w[i];
        var h: i64 = ui_ov_h[i];
        if k == 1 {
            ui_shadow(x, y, w, h, 10, 60);
            ui_round(x, y, w, h, 10, ui_c_line);
            ui_round(x + 1, y + 1, w - 2, h - 2, 9, ui_c_card);
        } else if k == 2 {
            if ui_ov_flag[i] == 1 {
                ui_round(x + 4, y, w - 8, h, 6, ui_mix(ui_c_card, ui_c_accent, 40));
            } else if ui_ov_flag[i] == 2 {
                ui_round(x + 4, y, w - 8, h, 6, ui_c_accent);
            }
            var color: i64 = ui_c_text;
            if ui_ov_flag[i] == 2 {
                color = ui_c_on_accent;
            }
            ui_font_text(x + 14, y + (h - 19) / 2, 0, ui_ov_text[i], color);
        } else if k == 3 {
            window_rect(x + 10, y + h / 2, w - 20, 1, ui_c_line);
        }
        i = i + 1;
    }
    return 1;
}

fn ui_key(k: i64) -> i64 {
    var i: i64 = 0;
    while i < ui_nkeys {
        if ui_keys[i] == k { return 1; }
        i = i + 1;
    }
    return 0;
}

fn ui_typed(c: i64) -> i64 {
    var i: i64 = 0;
    while i < ui_nchars {
        if ui_chars[i] == c { return 1; }
        i = i + 1;
    }
    return 0;
}

fn ui_inside(x: i64, y: i64, w: i64, h: i64) -> i64 {
    if ui_mx < x { return 0; }
    if ui_my < y { return 0; }
    if ui_mx >= x + w { return 0; }
    if ui_my >= y + h { return 0; }
    // under an open menu or dropdown, the overlay has the mouse
    if ui_block_on && ui_raw_hit == 0 {
        if ui_mx >= ui_block_x && ui_my >= ui_block_y {
            if ui_mx < ui_block_x + ui_block_w && ui_my < ui_block_y + ui_block_h {
                return 0;
            }
        }
    }
    return 1;
}

// the same test for the overlay itself
fn ui_inside_raw(x: i64, y: i64, w: i64, h: i64) -> i64 {
    ui_raw_hit = 1;
    var r: i64 = ui_inside(x, y, w, h);
    ui_raw_hit = 0;
    return r;
}

fn ui_id(x: i64, y: i64) -> i64 {
    return (x & 0xFFFF) * 65536 + (y & 0xFFFF) + 1;
}

// eases a control's amount toward target (0..255), a step a frame
fn ui_anim(id: i64, target: i64) -> i64 {
    var i: i64 = 0;
    var slot: i64 = -1;
    while i < 64 {
        if ui_anim_id[i] == id {
            slot = i;
            i = 64;
        }
        i = i + 1;
    }
    if slot < 0 {
        slot = ui_anim_next;
        ui_anim_next = (ui_anim_next + 1) & 63;
        ui_anim_id[slot] = id;
        ui_anim_v[slot] = 0;
    }
    var v: i64 = ui_anim_v[slot];
    if v < target {
        v = v + 48;
        if v > target { v = target; }
    }
    if v > target {
        v = v - 48;
        if v < target { v = target; }
    }
    ui_anim_v[slot] = v;
    return v;
}

// ---- shapes --------------------------------------------------------------

// coverage (0..255) of the pixel (dx, dy) of an r x r corner square by the
// quarter circle of radius r centered at its far corner, sampled 4 x 4
fn ui_cover(dx: i64, dy: i64, r: i64) -> i64 {
    var c: i64 = r * 8;
    var r2: i64 = c * c;
    var n: i64 = 0;
    var sy: i64 = 0;
    while sy < 4 {
        var py: i64 = dy * 8 + sy * 2 + 1 - c;
        var sx: i64 = 0;
        while sx < 4 {
            var px: i64 = dx * 8 + sx * 2 + 1 - c;
            if px * px + py * py <= r2 {
                n = n + 1;
            }
            sx = sx + 1;
        }
        sy = sy + 1;
    }
    return n * 255 / 16;
}

fn ui_round(x: i64, y: i64, w: i64, h: i64, radius: i64, color: i64) -> i64 {
    return ui_round_a(x, y, w, h, radius, color, 255);
}

// a rounded rectangle, alpha 0..255
fn ui_round_a(x: i64, y: i64, w: i64, h: i64, radius: i64, color: i64, alpha: i64) -> i64 {
    if w <= 0 { return 0; }
    if h <= 0 { return 0; }
    var r: i64 = radius;
    if r * 2 > w { r = w / 2; }
    if r * 2 > h { r = h / 2; }
    if r < 0 { r = 0; }
    if alpha >= 255 {
        window_rect(x + r, y, w - 2 * r, h, color);
        window_rect(x, y + r, r, h - 2 * r, color);
        window_rect(x + w - r, y + r, r, h - 2 * r, color);
    } else {
        ui_rect_a(x + r, y, w - 2 * r, h, color, alpha);
        ui_rect_a(x, y + r, r, h - 2 * r, color, alpha);
        ui_rect_a(x + w - r, y + r, r, h - 2 * r, color, alpha);
    }
    var dy: i64 = 0;
    while dy < r {
        var dx: i64 = 0;
        while dx < r {
            var a: i64 = ui_cover(dx, dy, r) * alpha / 255;
            if a > 0 {
                ui_blend_at(x + dx, y + dy, color, a);
                ui_blend_at(x + w - 1 - dx, y + dy, color, a);
                ui_blend_at(x + dx, y + h - 1 - dy, color, a);
                ui_blend_at(x + w - 1 - dx, y + h - 1 - dy, color, a);
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return 1;
}

fn ui_rect_a(x: i64, y: i64, w: i64, h: i64, color: i64, alpha: i64) -> i64 {
    var j: i64 = 0;
    while j < h {
        var i: i64 = 0;
        while i < w {
            ui_blend_at(x + i, y + j, color, alpha);
            i = i + 1;
        }
        j = j + 1;
    }
    return 1;
}

// a one-pixel rounded outline, alpha 0..255: the shadows are made of these
fn ui_outline(x: i64, y: i64, w: i64, h: i64, radius: i64, color: i64, alpha: i64) -> i64 {
    var r: i64 = radius;
    if r * 2 > w { r = w / 2; }
    if r * 2 > h { r = h / 2; }
    ui_rect_a(x + r, y, w - 2 * r, 1, color, alpha);
    ui_rect_a(x + r, y + h - 1, w - 2 * r, 1, color, alpha);
    ui_rect_a(x, y + r, 1, h - 2 * r, color, alpha);
    ui_rect_a(x + w - 1, y + r, 1, h - 2 * r, color, alpha);
    var dy: i64 = 0;
    while dy < r {
        var dx: i64 = 0;
        while dx < r {
            var a: i64 = ui_cover(dx, dy, r);
            if r > 1 {
                // only the band between radius r and r - 1
                if dx >= 1 {
                    if dy >= 1 {
                        a = a - ui_cover(dx - 1, dy - 1, r - 1);
                    }
                }
            }
            if a > 0 {
                a = a * alpha / 255;
                ui_blend_at(x + dx, y + dy, color, a);
                ui_blend_at(x + w - 1 - dx, y + dy, color, a);
                ui_blend_at(x + dx, y + h - 1 - dy, color, a);
                ui_blend_at(x + w - 1 - dx, y + h - 1 - dy, color, a);
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return 1;
}

// a soft shadow under a rounded rectangle
fn ui_shadow(x: i64, y: i64, w: i64, h: i64, radius: i64, strength: i64) -> i64 {
    var i: i64 = 1;
    while i <= 5 {
        var a: i64 = strength * (6 - i) * (6 - i) / 36;
        ui_outline(x - i, y - i + 2, w + 2 * i, h + 2 * i, radius + i, ui_c_shadow, a);
        i = i + 1;
    }
    return 1;
}

fn ui_circle(cx: i64, cy: i64, radius: i64, color: i64) -> i64 {
    return ui_round(cx - radius, cy - radius, radius * 2, radius * 2, radius, color);
}

// a round dot at a position given in eighths of a pixel: strokes are made
// of these, so they come out smooth at any angle
fn ui_dot8(cx8: i64, cy8: i64, r8: i64, color: i64) -> i64 {
    var x0: i64 = (cx8 - r8) / 8 - 1;
    var y0: i64 = (cy8 - r8) / 8 - 1;
    var x1: i64 = (cx8 + r8) / 8 + 1;
    var y1: i64 = (cy8 + r8) / 8 + 1;
    var r2: i64 = r8 * r8;
    var py: i64 = y0;
    while py <= y1 {
        var px: i64 = x0;
        while px <= x1 {
            var n: i64 = 0;
            var sy: i64 = 0;
            while sy < 4 {
                var dy: i64 = py * 8 + sy * 2 + 1 - cy8;
                var sx: i64 = 0;
                while sx < 4 {
                    var dx: i64 = px * 8 + sx * 2 + 1 - cx8;
                    if dx * dx + dy * dy <= r2 { n = n + 1; }
                    sx = sx + 1;
                }
                sy = sy + 1;
            }
            if n > 0 {
                // keep the darker of what is there and this stroke's coverage
                ui_blend_at(px, py, color, n * 255 / 16);
            }
            px = px + 1;
        }
        py = py + 1;
    }
    return 1;
}

// a stroke from (x0, y0) to (x1, y1), in eighths of a pixel
fn ui_stroke8(x0: i64, y0: i64, x1: i64, y1: i64, r8: i64, color: i64) -> i64 {
    var dx: i64 = x1 - x0;
    var dy: i64 = y1 - y0;
    var len: i64 = dx;
    if len < 0 { len = 0 - len; }
    var ady: i64 = dy;
    if ady < 0 { ady = 0 - ady; }
    if ady > len { len = ady; }
    var steps: i64 = len / 4 + 1;
    var i: i64 = 0;
    while i <= steps {
        ui_dot8(x0 + dx * i / steps, y0 + dy * i / steps, r8, color);
        i = i + 2;
    }
    return 1;
}

// ---- text ----------------------------------------------------------------

// one character of UTF-8 text at p: its code in ui_cp, its bytes returned.
// Codes past 255 have no letter here and come back as 0.
var ui_cp: i64;
fn ui_utf8(p: i64) -> i64 {
    var b0: i64 = 0;
    var b1: i64 = 0;
    raw { b0 = peek8(p); }
    if b0 < 128 {
        ui_cp = b0;
        return 1;
    }
    raw { b1 = peek8(p + 1); }
    if b0 >= 0xC0 {
        if b0 < 0xE0 {
            if b1 >= 0x80 {
                if b1 < 0xC0 {
                    ui_cp = ((b0 & 31) << 6) | (b1 & 63);
                    return 2;
                }
            }
        }
    }
    // longer sequences, or a stray byte: skip it whole
    ui_cp = 0;
    var n: i64 = 1;
    if b0 >= 0xE0 { n = 3; }
    if b0 >= 0xF0 { n = 4; }
    return n;
}

// the bytes of a text handle (std_text), or the address itself; a text is
// read at once and drawn before anything can change it
fn ui_str(x: i64) -> i64 {
    if ob_is(x) == 0 {
        if x == 0 {
            return "";
        }
        return x;
    }
    lock_take(HP_LOCK);
    var p: i64 = 0;
    if tv_view(x) {
        p = tv_p;
    }
    hp_take_err();
    lock_give(HP_LOCK);
    if p == 0 {
        return "";
    }
    return p;
}

// the width of n bytes of text at p, or up to its end when n < 0
fn ui_run_width(f: i64, p: i64, n: i64) -> i64 {
    if ui_ready == 0 { ui_init(); }
    var w: i64 = 0;
    var i: i64 = 0;
    var c: i64 = 0;
    raw { c = peek8(p); }
    while c != 0 && (n < 0 || i < n) {
        var step: i64 = ui_utf8(p + i);
        var cp: i64 = ui_cp;
        if cp >= 32 {
            if cp < 256 {
                w = w + ui_gadv[f * 256 + cp];
            }
        }
        i = i + step;
        raw { c = peek8(p + i); }
    }
    return w;
}

fn ui_font_width(f: i64, text: i64) -> i64 {
    return ui_run_width(f, ui_str(text), -1);
}

fn ui_text_width(text: i64) -> i64 {
    return ui_font_width(0, text);
}

fn ui_glyph(x: i64, y: i64, f: i64, c: i64, color: i64) -> i64 {
    var slot: i64 = f * 256 + c;
    var w: i64 = ui_gw[slot];
    var h: i64 = ui_fh[f];
    var gx: i64 = x + ui_gx[slot];
    var src: i64 = 0;
    raw { src = &ui_pix + ui_gofs[slot]; }
    var row: i64 = 0;
    while row < h {
        var col: i64 = 0;
        while col < w {
            var a: i64 = 0;
            raw { a = peek8(src + row * w + col); }
            if a != 0 {
                ui_blend_at(gx + col, y + row, color, a * 17);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return ui_gadv[slot];
}

// text in font f (0 body, 1 semibold, 2 large); returns its width
fn ui_font_text(x: i64, y: i64, f: i64, text: i64, color: i64) -> i64 {
    return ui_run(x, y, f, ui_str(text), -1, color);
}

// n bytes of text at p (all of it when n < 0); returns the width
fn ui_run(x: i64, y: i64, f: i64, p: i64, n: i64, color: i64) -> i64 {
    if ui_ready == 0 { ui_init(); }
    var px: i64 = x;
    var i: i64 = 0;
    var c: i64 = 0;
    var text: i64 = p;
    raw { c = peek8(text); }
    while c != 0 && (n < 0 || i < n) {
        var step: i64 = ui_utf8(text + i);
        var cp: i64 = ui_cp;
        if cp >= 32 {
            if cp < 127 {
                px = px + ui_glyph(px, y, f, cp, color);
            } else if cp >= 160 {
                if cp < 256 {
                    px = px + ui_glyph(px, y, f, cp, color);
                }
            }
        }
        i = i + step;
        raw { c = peek8(text + i); }
    }
    return px - x;
}

fn ui_text(x: i64, y: i64, text: i64, color: i64) -> i64 {
    return ui_font_text(x, y, 0, text, color);
}

// large text; any scale of 2 or more is the large font
fn ui_text_big(x: i64, y: i64, text: i64, color: i64, scale: i64) -> i64 {
    if scale >= 2 {
        return ui_font_text(x, y, 2, text, color);
    }
    return ui_font_text(x, y, 0, text, color);
}

fn ui_label(x: i64, y: i64, text: i64) -> i64 {
    return ui_font_text(x, y, 0, text, ui_c_text);
}

fn ui_muted(x: i64, y: i64, text: i64) -> i64 {
    return ui_font_text(x, y, 0, text, ui_c_muted);
}

fn ui_bold(x: i64, y: i64, text: i64) -> i64 {
    return ui_font_text(x, y, 1, text, ui_c_text);
}

fn ui_title(x: i64, y: i64, text: i64) -> i64 {
    return ui_font_text(x, y, 2, text, ui_c_text);
}

// ---- controls ------------------------------------------------------------

fn ui_card(x: i64, y: i64, w: i64, h: i64, title: i64) -> i64 {
    if ui_is_dark {
        ui_shadow(x, y, w, h, 14, 120);
    } else {
        ui_shadow(x, y, w, h, 14, 40);
    }
    ui_round(x, y, w, h, 14, ui_c_card);
    if ui_is_dark {
        ui_outline(x, y, w, h, 14, ui_c_line, 255);
    }
    var t: i64 = 0;
    raw { t = peek8(title); }
    if t != 0 {
        ui_font_text(x + 20, y + 16, 1, title, ui_c_text);
    }
    return 1;
}

// kept for programs written against the first version
fn ui_panel(x: i64, y: i64, w: i64, h: i64, title: i64) -> i64 {
    return ui_card(x, y, w, h, title);
}

fn ui_button_color(x: i64, y: i64, w: i64, h: i64, text: i64, fill: i64, fg: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var over: i64 = ui_inside(x, y, w, h);
    var clicked: i64 = 0;
    if over {
        if ui_pressed { ui_active = id; }
        if ui_released {
            if ui_active == id { clicked = 1; }
        }
    }
    var held: i64 = 0;
    if ui_down {
        if ui_active == id {
            if over { held = 1; }
        }
    }
    var hot: i64 = ui_anim(id, over * 255);
    var body: i64 = ui_mix(fill, 0xFFFFFF, hot * 22 / 255);
    if ui_is_dark == 0 {
        body = ui_mix(fill, 0x000000, hot * 22 / 255);
    }
    if held {
        body = ui_mix(fill, 0x000000, 50);
    }
    ui_shadow(x, y, w, h, 10, 18 + hot / 12);
    ui_round(x, y, w, h, 10, body);
    var tw: i64 = ui_font_width(1, text);
    ui_font_text(x + (w - tw) / 2, y + (h - 19) / 2, 1, text, fg);
    return clicked;
}

fn ui_button(x: i64, y: i64, w: i64, h: i64, text: i64) -> i64 {
    return ui_button_color(x, y, w, h, text, ui_c_accent, ui_c_on_accent);
}

fn ui_button_alt(x: i64, y: i64, w: i64, h: i64, text: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var over: i64 = ui_inside(x, y, w, h);
    var clicked: i64 = 0;
    if over {
        if ui_pressed { ui_active = id; }
        if ui_released {
            if ui_active == id { clicked = 1; }
        }
    }
    var hot: i64 = ui_anim(id, over * 255);
    ui_round(x, y, w, h, 10, ui_mix(ui_c_line, ui_c_accent, hot));
    var inner: i64 = ui_mix(ui_c_card, ui_c_hover, hot);
    if ui_down {
        if ui_active == id {
            if over { inner = ui_mix(ui_c_card, ui_c_accent, 40); }
        }
    }
    ui_round(x + 1, y + 1, w - 2, h - 2, 9, inner);
    var tw: i64 = ui_font_width(1, text);
    ui_font_text(x + (w - tw) / 2, y + (h - 19) / 2, 1, text, ui_mix(ui_c_text, ui_c_accent, hot));
    return clicked;
}

fn ui_check(x: i64, y: i64, text: i64, value: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var tw: i64 = ui_text_width(text);
    var over: i64 = ui_inside(x, y, 28 + tw, 22);
    var v: i64 = value;
    if over {
        if ui_pressed { ui_active = id; }
        if ui_released {
            if ui_active == id {
                if v { v = 0; } else { v = 1; }
            }
        }
    }
    var on: i64 = ui_anim(id, v * 255);
    var edge: i64 = ui_mix(ui_c_line, ui_c_accent, on);
    if over { edge = ui_mix(edge, ui_c_accent, 160); }
    ui_round(x, y + 1, 20, 20, 6, edge);
    ui_round(x + 2, y + 3, 16, 16, 4, ui_mix(ui_c_field, ui_c_accent, on));
    if on > 128 {
        // the tick, two smooth strokes, in eighths of a pixel
        ui_stroke8((x + 5) * 8, (y + 11) * 8, (x + 9) * 8, (y + 15) * 8, 12, ui_c_on_accent);
        ui_stroke8((x + 9) * 8, (y + 15) * 8, (x + 16) * 8, (y + 6) * 8, 12, ui_c_on_accent);
    }
    ui_font_text(x + 30, y + 2, 0, text, ui_c_text);
    return v;
}

fn ui_switch(x: i64, y: i64, text: i64, value: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var tw: i64 = ui_text_width(text);
    var over: i64 = ui_inside(x, y, 54 + tw, 24);
    var v: i64 = value;
    if over {
        if ui_pressed { ui_active = id; }
        if ui_released {
            if ui_active == id {
                if v { v = 0; } else { v = 1; }
            }
        }
    }
    var on: i64 = ui_anim(id, v * 255);
    var track: i64 = ui_mix(ui_c_track, ui_c_accent, on);
    if ui_is_dark == 0 {
        if on == 0 { track = 0xD3D7DF; }
    }
    ui_round(x, y, 44, 24, 12, track);
    var kx: i64 = x + 12 + on * 20 / 255;
    ui_shadow(kx - 9, y + 3, 18, 18, 9, 30);
    ui_circle(kx, y + 12, 9, 0xFFFFFF);
    ui_font_text(x + 54, y + 3, 0, text, ui_c_text);
    return v;
}

fn ui_slider(x: i64, y: i64, w: i64, value: i64, low: i64, high: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var over: i64 = ui_inside(x - 8, y, w + 16, 24);
    if over {
        if ui_pressed { ui_active = id; }
    }
    var v: i64 = value;
    if ui_active == id {
        if ui_down {
            var span: i64 = high - low;
            var at: i64 = ui_mx - x;
            if at < 0 { at = 0; }
            if at > w { at = w; }
            if w > 0 {
                v = low + (at * span + w / 2) / w;
            }
        }
    }
    if v < low { v = low; }
    if v > high { v = high; }
    var pos: i64 = 0;
    if high > low {
        pos = (v - low) * w / (high - low);
    }
    ui_round(x, y + 9, w, 6, 3, ui_c_track);
    ui_round(x, y + 9, pos + 3, 6, 3, ui_c_accent);
    var hot: i64 = ui_anim(id, over * 255);
    var r: i64 = 9 + hot / 128;
    ui_shadow(x + pos - r, y + 12 - r, r * 2, r * 2, r, 40);
    ui_circle(x + pos, y + 12, r, ui_c_accent);
    ui_circle(x + pos, y + 12, r - 3, 0xFFFFFF);
    return v;
}

fn ui_progress(x: i64, y: i64, w: i64, value: i64, total: i64) -> i64 {
    var pos: i64 = 0;
    if total > 0 {
        pos = value * w / total;
    }
    if pos < 0 { pos = 0; }
    if pos > w { pos = w; }
    ui_round(x, y, w, 8, 4, ui_c_track);
    if pos > 0 {
        ui_round(x, y, pos, 8, 4, ui_c_accent);
    }
    return 1;
}

fn ui_input_hint(x: i64, y: i64, w: i64, buffer: i64, capacity: i64, placeholder: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var h: i64 = 38;
    var over: i64 = ui_inside(x, y, w, h);
    if over {
        if ui_pressed { ui_focus = id; }
    }
    var entered: i64 = 0;
    var n: i64 = 0;
    raw {
        while peek8(buffer + n) != 0 {
            n = n + 1;
        }
    }
    var focused: i64 = 0;
    if ui_focus == id { focused = 1; }
    if focused { ui_kb_want = 1; }    // a phone shows its keyboard
    if focused {
        var i: i64 = 0;
        while i < ui_nchars {
            var ch: i64 = ui_chars[i];
            if ch < 128 {
                if n < capacity - 1 {
                    raw {
                        poke8(buffer + n, ch);
                        poke8(buffer + n + 1, 0);
                    }
                    n = n + 1;
                }
            } else {
                // Latin-1 typed: two bytes of UTF-8
                if n < capacity - 2 {
                    raw {
                        poke8(buffer + n, 0xC0 | (ch >> 6));
                        poke8(buffer + n + 1, 0x80 | (ch & 63));
                        poke8(buffer + n + 2, 0);
                    }
                    n = n + 2;
                }
            }
            i = i + 1;
        }
        i = 0;
        while i < ui_nkeys {
            if ui_keys[i] == 8 {
                if n > 0 {
                    // back over continuation bytes to the start of the character
                    n = n - 1;
                    var b: i64 = 0;
                    raw { b = peek8(buffer + n); }
                    var more: i64 = 1;
                    while more {
                        more = 0;
                        if n > 0 {
                            if b >= 0x80 {
                                if b < 0xC0 {
                                    n = n - 1;
                                    raw { b = peek8(buffer + n); }
                                    more = 1;
                                }
                            }
                        }
                    }
                    raw { poke8(buffer + n, 0); }
                }
            }
            if ui_keys[i] == 13 {
                entered = 1;
            }
            i = i + 1;
        }
    }
    var hot: i64 = ui_anim(id, focused * 255);
    // the focus ring: a soft halo of the accent color
    if hot > 0 {
        ui_round_a(x - 3, y - 3, w + 6, h + 6, 12, ui_c_accent, hot * 50 / 255);
    }
    var edge: i64 = ui_c_line;
    if over { edge = ui_mix(ui_c_line, ui_c_muted, 120); }
    edge = ui_mix(edge, ui_c_accent, hot);
    ui_round(x, y, w, h, 10, edge);
    ui_round(x + 1, y + 1, w - 2, h - 2, 9, ui_c_field);
    // the end of the text when it is longer than the box
    var start: i64 = 0;
    while ui_font_width(0, buffer + start) > w - 28 {
        start = start + 1;
    }
    var tx: i64 = 0;
    if n == 0 {
        if focused == 0 {
            ui_font_text(x + 14, y + 9, 0, placeholder, ui_c_muted);
        }
    } else {
        tx = ui_font_text(x + 14, y + 9, 0, buffer + start, ui_c_text);
    }
    if focused {
        if (ui_tick / 30) % 2 == 0 {
            ui_round(x + 14 + tx, y + 9, 2, 20, 1, ui_c_accent);
        }
    }
    return entered;
}

fn ui_input(x: i64, y: i64, w: i64, buffer: i64, capacity: i64) -> i64 {
    return ui_input_hint(x, y, w, buffer, capacity, "");
}

// ---- editing a text ------------------------------------------------------
// Texts (std_text) changed in place: bytes in at a position, bytes out.

fn ui_tx_insert(t: i64, at: i64, src: i64, n: i64) -> i64 {
    lock_take(HP_LOCK);
    var q: i64 = ob_get(t, OB_TEXT);
    if q != 0 {
        var len: i64 = 0;
        raw { len = peek(q); }
        var pos: i64 = at;
        if pos < 0 { pos = 0; }
        if pos > len { pos = len; }
        q = tx_room(t, len + n);
        if q != 0 {
            raw {
                var i: i64 = len - 1;
                while i >= pos {
                    poke8(q + 8 + i + n, peek8(q + 8 + i));
                    i = i - 1;
                }
                var k: i64 = 0;
                while k < n {
                    poke8(q + 8 + pos + k, peek8(src + k));
                    k = k + 1;
                }
                poke(q, len + n);
                poke8(q + 8 + len + n, 0);
            }
        }
    }
    hp_take_err();
    lock_give(HP_LOCK);
    return n;
}

fn ui_tx_remove(t: i64, at: i64, n: i64) -> i64 {
    lock_take(HP_LOCK);
    var q: i64 = ob_get(t, OB_TEXT);
    if q != 0 {
        var len: i64 = 0;
        raw { len = peek(q); }
        if at >= 0 && n > 0 && at + n <= len {
            raw {
                var i: i64 = at;
                while i + n < len {
                    poke8(q + 8 + i, peek8(q + 8 + i + n));
                    i = i + 1;
                }
                poke(q, len - n);
                poke8(q + 8 + len - n, 0);
            }
        }
    }
    hp_take_err();
    lock_give(HP_LOCK);
    return 0;
}

fn ui_tx_len(t: i64) -> i64 {
    var p: i64 = ui_str(t);
    var n: i64 = 0;
    raw {
        while peek8(p + n) != 0 {
            n = n + 1;
        }
    }
    return n;
}

fn ui_byte(p: i64, i: i64) -> i64 {
    var b: i64 = 0;
    raw { b = peek8(p + i); }
    return b;
}

// the start of the character before position i
fn ui_prev_char(p: i64, i: i64) -> i64 {
    var k: i64 = i - 1;
    while k > 0 {
        var b: i64 = ui_byte(p, k);
        if b < 0x80 || b >= 0xC0 {
            return k;
        }
        k = k - 1;
    }
    if k < 0 { return 0; }
    return k;
}

fn ui_next_char(p: i64, i: i64, len: i64) -> i64 {
    if i >= len { return len; }
    var k: i64 = i + ui_utf8(p + i);
    if k > len { return len; }
    return k;
}

// the typed characters of this frame into t at the caret, as UTF-8; with
// single set, a line end in pasted text stops the paste
fn ui_type_into(t: i64, single: i64) -> i64 {
    var changed: i64 = 0;
    var i: i64 = 0;
    var b: [i64; 1];
    while i < ui_nchars {
        var ch: i64 = ui_chars[i];
        raw {
            var bp: i64 = &b;
            if ch < 128 {
                poke8(bp, ch);
            } else {
                poke8(bp, 0xC0 | (ch >> 6));
                poke8(bp + 1, 0x80 | (ch & 63));
            }
        }
        var n: i64 = 1;
        if ch >= 128 { n = 2; }
        ui_tx_insert(t, ui_caret, &b, n);
        ui_caret = ui_caret + n;
        changed = 1;
        i = i + 1;
    }
    return changed;
}

// Ctrl+C, Ctrl+X, Ctrl+V on text t
fn ui_clip_keys(t: i64, single: i64) -> i64 {
    if ui_ctrl == 0 { return 0; }
    var changed: i64 = 0;
    if ui_key(67) || ui_key(88) {
        var p: i64 = ui_str(t);
        window_clip_set(p, ui_tx_len(t));
        if ui_key(88) {
            ui_tx_remove(t, 0, ui_tx_len(t));
            ui_caret = 0;
            changed = 1;
        }
    }
    if ui_key(86) {
        var c: i64 = window_clip_get();
        var n: i64 = 0;
        raw {
            while peek8(c + n) != 0 {
                if single {
                    if peek8(c + n) == 10 || peek8(c + n) == 13 {
                        break;
                    }
                }
                n = n + 1;
            }
        }
        // a \r\n pasted into an area keeps the \n only
        var at: i64 = 0;
        while at < n {
            var run: i64 = 0;
            raw {
                while at + run < n && peek8(c + at + run) != 13 {
                    run = run + 1;
                }
            }
            if run > 0 {
                ui_tx_insert(t, ui_caret, c + at, run);
                ui_caret = ui_caret + run;
            }
            at = at + run + 1;
        }
        changed = 1;
    }
    return changed;
}

// the caret position in a run of text at p for a click at x px from its start
fn ui_caret_at(p: i64, n: i64, px: i64) -> i64 {
    var i: i64 = 0;
    var w: i64 = 0;
    while i < n {
        var step: i64 = ui_utf8(p + i);
        var cw: i64 = 0;
        if ui_cp >= 32 && ui_cp < 256 {
            cw = ui_gadv[ui_cp];
        }
        if w + cw / 2 >= px {
            return i;
        }
        w = w + cw;
        i = i + step;
    }
    return n;
}

fn ui_edit(x: i64, y: i64, w: i64, t: i64, placeholder: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var h: i64 = 38;
    var over: i64 = ui_inside(x, y, w, h);
    var focused: i64 = 0;
    if ui_focus == id { focused = 1; }
    if focused { ui_kb_want = 1; }    // a phone shows its keyboard
    var p: i64 = ui_str(t);
    var len: i64 = ui_tx_len(t);
    if over && ui_pressed {
        if focused == 0 {
            ui_scroll_px = 0;
        }
        ui_focus = id;
        focused = 1;
        ui_caret = ui_caret_at(p, len, ui_mx - (x + 14) + ui_scroll_px);
    }
    var entered: i64 = 0;
    if focused {
        if ui_caret > len { ui_caret = len; }
        ui_clip_keys(t, 1);
        ui_type_into(t, 1);
        var i: i64 = 0;
        while i < ui_nkeys {
            var k: i64 = ui_keys[i];
            p = ui_str(t);
            len = ui_tx_len(t);
            if k == 8 {
                if ui_caret > 0 {
                    var a: i64 = ui_prev_char(p, ui_caret);
                    ui_tx_remove(t, a, ui_caret - a);
                    ui_caret = a;
                }
            } else if k == 46 {
                if ui_caret < len {
                    var b2: i64 = ui_next_char(p, ui_caret, len);
                    ui_tx_remove(t, ui_caret, b2 - ui_caret);
                }
            } else if k == 37 {
                ui_caret = ui_prev_char(p, ui_caret);
            } else if k == 39 {
                ui_caret = ui_next_char(p, ui_caret, len);
            } else if k == 36 {
                ui_caret = 0;
            } else if k == 35 {
                ui_caret = len;
            } else if k == 13 {
                entered = 1;
            }
            i = i + 1;
        }
        p = ui_str(t);
        len = ui_tx_len(t);
    }
    var hot: i64 = ui_anim(id, focused * 255);
    if hot > 0 {
        ui_round_a(x - 3, y - 3, w + 6, h + 6, 12, ui_c_accent, hot * 50 / 255);
    }
    var edge: i64 = ui_c_line;
    if over { edge = ui_mix(ui_c_line, ui_c_muted, 120); }
    edge = ui_mix(edge, ui_c_accent, hot);
    ui_round(x, y, w, h, 10, edge);
    ui_round(x + 1, y + 1, w - 2, h - 2, 9, ui_c_field);
    var room: i64 = w - 28;
    var scroll: i64 = 0;
    if focused {
        // keep the caret in view
        var cx: i64 = ui_run_width(0, p, ui_caret);
        if cx - ui_scroll_px > room {
            ui_scroll_px = cx - room;
        }
        if cx - ui_scroll_px < 0 {
            ui_scroll_px = cx;
        }
        scroll = ui_scroll_px;
    }
    window_clip(x + 10, y + 2, w - 20, h - 4);
    if len == 0 {
        if focused == 0 {
            ui_font_text(x + 14, y + 9, 0, placeholder, ui_c_muted);
        }
    } else {
        ui_run(x + 14 - scroll, y + 9, 0, p, -1, ui_c_text);
    }
    if focused {
        if (ui_tick / 30) % 2 == 0 {
            var cx2: i64 = ui_run_width(0, p, ui_caret);
            ui_round(x + 14 + cx2 - scroll, y + 9, 2, 20, 1, ui_c_accent);
        }
    }
    window_unclip();
    return entered;
}

// ---- scroll positions, kept per control ----

fn ui_scroll_get(id: i64) -> i64 {
    var i: i64 = 0;
    while i < 64 {
        if ui_sc_id[i] == id {
            return ui_sc_v[i];
        }
        i = i + 1;
    }
    return 0;
}

fn ui_scroll_set(id: i64, v: i64) -> i64 {
    var i: i64 = 0;
    while i < 64 {
        if ui_sc_id[i] == id {
            ui_sc_v[i] = v;
            return v;
        }
        i = i + 1;
    }
    ui_sc_id[ui_sc_next] = id;
    ui_sc_v[ui_sc_next] = v;
    ui_sc_next = (ui_sc_next + 1) & 63;
    return v;
}

// a scrollbar at the right edge of a box; returns the new scroll position
fn ui_scrollbar(id: i64, x: i64, y: i64, h: i64, scroll: i64, total: i64) -> i64 {
    if total <= h {
        return 0;
    }
    var bar_id: i64 = id + 7777777;
    var track: i64 = h - 8;
    var thumb: i64 = track * h / total;
    if thumb < 24 { thumb = 24; }
    var room: i64 = track - thumb;
    var at: i64 = 0;
    if total > h {
        at = scroll * room / (total - h);
    }
    var tx: i64 = x - 10;
    var ty: i64 = y + 4 + at;
    var over: i64 = ui_inside(tx - 4, y, 14, h);
    if over && ui_pressed {
        ui_active = bar_id;
    }
    var s: i64 = scroll;
    if ui_active == bar_id && ui_down && room > 0 {
        var pos: i64 = ui_my - y - 4 - thumb / 2;
        if pos < 0 { pos = 0; }
        if pos > room { pos = room; }
        s = pos * (total - h) / room;
    }
    var color: i64 = ui_mix(ui_c_line, ui_c_muted, 60);
    if over || ui_active == bar_id {
        color = ui_c_muted;
    }
    ui_round(tx, ty, 6, thumb, 3, color);
    return s;
}

// ---- lists -----------------------------------------------------------------

fn ui_item(items: i64, i: i64) -> i64 {
    var v: i64 = list_get(items, i);
    if failed() {
        return "";
    }
    return v;
}

fn ui_list(x: i64, y: i64, w: i64, h: i64, items: i64, selected: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var rowh: i64 = 32;
    var n: i64 = list_len(items);
    if failed() {
        n = 0;
    }
    var total: i64 = n * rowh + 8;
    var scroll: i64 = ui_scroll_get(id);
    var over: i64 = ui_inside(x, y, w, h);
    var sel: i64 = selected;
    if over && ui_wheel != 0 {
        scroll = scroll - ui_wheel * rowh * 3;
    }
    if over && ui_pressed {
        ui_focus = id;
    }
    // the keyboard moves the selection while the list has the focus
    if ui_focus == id {
        if ui_key(40) && sel < n - 1 {
            sel = sel + 1;
        }
        if ui_key(38) && sel > 0 {
            sel = sel - 1;
        }
        if ui_key(38) || ui_key(40) {
            if sel * rowh < scroll {
                scroll = sel * rowh;
            }
            if (sel + 1) * rowh + 8 > scroll + h {
                scroll = (sel + 1) * rowh + 8 - h;
            }
        }
    }
    scroll = ui_scrollbar(id, x + w, y, h, scroll, total);
    if scroll > total - h { scroll = total - h; }
    if scroll < 0 { scroll = 0; }
    ui_scroll_set(id, scroll);
    ui_shadow(x, y, w, h, 12, 25);
    ui_round(x, y, w, h, 12, ui_c_line);
    ui_round(x + 1, y + 1, w - 2, h - 2, 11, ui_c_card);
    window_clip(x + 2, y + 2, w - 4, h - 4);
    var first: i64 = scroll / rowh;
    var i: i64 = first;
    while i < n {
        var ry: i64 = y + 4 + i * rowh - scroll;
        if ry > y + h {
            i = n;
        } else {
            var hovered: i64 = 0;
            if ui_inside(x + 4, ry, w - 22, rowh) {
                if ry + rowh > y && ry < y + h {
                    hovered = 1;
                }
            }
            if hovered && ui_released && ui_active == 0 {
                sel = i;
            }
            if hovered && ui_pressed {
                sel = i;
            }
            var color: i64 = ui_c_text;
            if i == sel {
                ui_round(x + 4, ry + 1, w - 22, rowh - 2, 8, ui_c_accent);
                color = ui_c_on_accent;
            } else if hovered {
                ui_round(x + 4, ry + 1, w - 22, rowh - 2, 8, ui_mix(ui_c_card, ui_c_accent, 30));
            }
            ui_font_text(x + 16, ry + (rowh - 19) / 2, 0, ui_item(items, i), color);
        }
        i = i + 1;
    }
    window_unclip();
    if total > h {
        ui_scrollbar(id, x + w, y, h, scroll, total);
    }
    return sel;
}

// ---- several lines of text -----------------------------------------------

// where line `line` starts in p (n bytes), and the length of that line in
// ui_line_n
var ui_line_n: i64;

fn ui_line_start(p: i64, n: i64, line: i64) -> i64 {
    var at: i64 = 0;
    var l: i64 = 0;
    while l < line && at < n {
        if ui_byte(p, at) == 10 {
            l = l + 1;
        }
        at = at + 1;
    }
    var e: i64 = at;
    while e < n && ui_byte(p, e) != 10 {
        e = e + 1;
    }
    ui_line_n = e - at;
    return at;
}

// the line and the start of the line the caret is on
var ui_caret_line: i64;
fn ui_caret_line_start(p: i64, c: i64) -> i64 {
    var at: i64 = 0;
    var start: i64 = 0;
    var l: i64 = 0;
    while at < c {
        if ui_byte(p, at) == 10 {
            l = l + 1;
            start = at + 1;
        }
        at = at + 1;
    }
    ui_caret_line = l;
    return start;
}

fn ui_area(x: i64, y: i64, w: i64, h: i64, t: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var lineh: i64 = 22;
    var over: i64 = ui_inside(x, y, w, h);
    var focused: i64 = 0;
    if ui_focus == id { focused = 1; }
    if focused { ui_kb_want = 1; }    // a phone shows its keyboard
    var p: i64 = ui_str(t);
    var n: i64 = ui_tx_len(t);
    var scroll: i64 = ui_scroll_get(id);
    var changed: i64 = 0;
    if over && ui_wheel != 0 {
        scroll = scroll - ui_wheel * lineh * 3;
    }
    if over && ui_pressed {
        ui_focus = id;
        focused = 1;
        var line: i64 = (ui_my - y - 8 + scroll) / lineh;
        if line < 0 { line = 0; }
        var ls: i64 = ui_line_start(p, n, line);
        ui_caret = ls + ui_caret_at(p + ls, ui_line_n, ui_mx - x - 14);
    }
    if focused {
        if ui_caret > n { ui_caret = n; }
        if ui_clip_keys(t, 0) { changed = 1; }
        if ui_type_into(t, 0) { changed = 1; }
        var i: i64 = 0;
        var nl: [i64; 1];
        while i < ui_nkeys {
            var k: i64 = ui_keys[i];
            p = ui_str(t);
            n = ui_tx_len(t);
            if k == 13 {
                raw { poke8(&nl, 10); }
                ui_tx_insert(t, ui_caret, &nl, 1);
                ui_caret = ui_caret + 1;
                changed = 1;
            } else if k == 9 {
                ui_tx_insert(t, ui_caret, "    ", 4);
                ui_caret = ui_caret + 4;
                changed = 1;
            } else if k == 8 {
                if ui_caret > 0 {
                    var a: i64 = ui_prev_char(p, ui_caret);
                    ui_tx_remove(t, a, ui_caret - a);
                    ui_caret = a;
                    changed = 1;
                }
            } else if k == 46 {
                if ui_caret < n {
                    var b2: i64 = ui_next_char(p, ui_caret, n);
                    ui_tx_remove(t, ui_caret, b2 - ui_caret);
                    changed = 1;
                }
            } else if k == 37 {
                ui_caret = ui_prev_char(p, ui_caret);
            } else if k == 39 {
                ui_caret = ui_next_char(p, ui_caret, n);
            } else if k == 36 {
                ui_caret = ui_caret_line_start(p, ui_caret);
            } else if k == 35 {
                var s0: i64 = ui_caret_line_start(p, ui_caret);
                ui_line_start(p, n, ui_caret_line);
                ui_caret = s0 + ui_line_n;
            } else if k == 38 || k == 40 {
                // up and down keep the column as near as the letters allow
                var s1: i64 = ui_caret_line_start(p, ui_caret);
                var col: i64 = ui_run_width(0, p + s1, ui_caret - s1);
                var target: i64 = ui_caret_line - 1;
                if k == 40 { target = ui_caret_line + 1; }
                if target >= 0 {
                    var ts: i64 = ui_line_start(p, n, target);
                    if k == 38 || ts > s1 {
                        ui_caret = ts + ui_caret_at(p + ts, ui_line_n, col);
                    }
                }
            }
            i = i + 1;
        }
        p = ui_str(t);
        n = ui_tx_len(t);
        // keep the caret's line in view
        if ui_key(13) || ui_key(38) || ui_key(40) || ui_nchars > 0 || ui_key(8) {
            ui_caret_line_start(p, ui_caret);
            var cy: i64 = ui_caret_line * lineh;
            if cy < scroll { scroll = cy; }
            if cy + lineh + 16 > scroll + h { scroll = cy + lineh + 16 - h; }
        }
    }
    // how many lines
    var lines: i64 = 1;
    var k2: i64 = 0;
    while k2 < n {
        if ui_byte(p, k2) == 10 { lines = lines + 1; }
        k2 = k2 + 1;
    }
    var total: i64 = lines * lineh + 16;
    scroll = ui_scrollbar(id, x + w, y, h, scroll, total);
    if scroll > total - h { scroll = total - h; }
    if scroll < 0 { scroll = 0; }
    ui_scroll_set(id, scroll);
    var hot: i64 = ui_anim(id, focused * 255);
    if hot > 0 {
        ui_round_a(x - 3, y - 3, w + 6, h + 6, 12, ui_c_accent, hot * 50 / 255);
    }
    var edge: i64 = ui_mix(ui_c_line, ui_c_accent, hot);
    ui_round(x, y, w, h, 10, edge);
    ui_round(x + 1, y + 1, w - 2, h - 2, 9, ui_c_field);
    window_clip(x + 2, y + 2, w - 18, h - 4);
    var first: i64 = scroll / lineh;
    var at: i64 = ui_line_start(p, n, first);
    var line2: i64 = first;
    var going: i64 = 1;
    while going {
        var ly: i64 = y + 8 + line2 * lineh - scroll;
        if ly > y + h || at > n {
            going = 0;
        } else {
            var e: i64 = at;
            while e < n && ui_byte(p, e) != 10 {
                e = e + 1;
            }
            ui_run(x + 14, ly, 0, p + at, e - at, ui_c_text);
            if focused && ui_caret >= at && ui_caret <= e {
                if (ui_tick / 30) % 2 == 0 {
                    var cx: i64 = ui_run_width(0, p + at, ui_caret - at);
                    ui_round(x + 14 + cx, ly, 2, 19, 1, ui_c_accent);
                }
            }
            at = e + 1;
            line2 = line2 + 1;
            if e >= n {
                going = 0;
            }
        }
    }
    window_unclip();
    if total > h {
        ui_scrollbar(id, x + w, y, h, scroll, total);
    }
    return changed;
}

// ---- choosing -------------------------------------------------------------

fn ui_radio(x: i64, y: i64, text: i64, value: i64, mine: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var tw: i64 = ui_text_width(text);
    var over: i64 = ui_inside(x, y, 28 + tw, 22);
    var v: i64 = value;
    if over {
        if ui_pressed { ui_active = id; }
        if ui_released && ui_active == id {
            v = mine;
        }
    }
    var on: i64 = 0;
    if v == mine { on = 255; }
    var a: i64 = ui_anim(id, on);
    var edge: i64 = ui_mix(ui_c_line, ui_c_accent, a);
    if over { edge = ui_mix(edge, ui_c_accent, 160); }
    ui_circle(x + 10, y + 11, 10, edge);
    ui_circle(x + 10, y + 11, 8, ui_c_field);
    if a > 0 {
        ui_circle(x + 10, y + 11, 3 + a * 2 / 255, ui_c_accent);
    }
    ui_font_text(x + 30, y + 2, 0, text, ui_c_text);
    return v;
}

// the i-th piece of "a|b|c": its start in p and its length in ui_line_n
fn ui_piece(p: i64, i: i64) -> i64 {
    var at: i64 = 0;
    var k: i64 = 0;
    while k < i {
        while ui_byte(p, at) != 0 && ui_byte(p, at) != 124 {
            at = at + 1;
        }
        if ui_byte(p, at) == 124 {
            at = at + 1;
        }
        k = k + 1;
    }
    var e: i64 = at;
    while ui_byte(p, e) != 0 && ui_byte(p, e) != 124 {
        e = e + 1;
    }
    ui_line_n = e - at;
    return at;
}

fn ui_tabs(x: i64, y: i64, labels: i64, selected: i64) -> i64 {
    var p: i64 = ui_str(labels);
    var count: i64 = 1;
    var k: i64 = 0;
    while ui_byte(p, k) != 0 {
        if ui_byte(p, k) == 124 { count = count + 1; }
        k = k + 1;
    }
    var sel: i64 = selected;
    var tx: i64 = x;
    var i: i64 = 0;
    var total: i64 = 0;
    while i < count {
        var at: i64 = ui_piece(p, i);
        var n: i64 = ui_line_n;
        var tw: i64 = ui_run_width(1, p + at, n) + 32;
        var id: i64 = ui_id(tx, y);
        var over: i64 = ui_inside(tx, y, tw, 40);
        if over && ui_pressed { ui_active = id; }
        if over && ui_released && ui_active == id {
            sel = i;
        }
        var hot: i64 = ui_anim(id, over * 255);
        var color: i64 = ui_mix(ui_c_muted, ui_c_text, hot);
        if i == sel {
            color = ui_c_accent;
        }
        ui_run(tx + 16, y + 10, 1, p + at, n, color);
        if i == sel {
            ui_round(tx + 8, y + 37, tw - 16, 3, 1, ui_c_accent);
        }
        tx = tx + tw;
        total = total + tw;
        i = i + 1;
    }
    window_rect(x, y + 40, total, 1, ui_c_line);
    return sel;
}

fn ui_select(x: i64, y: i64, w: i64, items: i64, selected: i64) -> i64 {
    var id: i64 = ui_id(x, y);
    var h: i64 = 38;
    var n: i64 = list_len(items);
    if failed() { n = 0; }
    var sel: i64 = selected;
    var open: i64 = 0;
    if ui_sel_open == id { open = 1; }
    var over: i64 = ui_inside(x, y, w, h);
    if over && ui_pressed && ui_menu_open == 0 {
        if open {
            ui_sel_open = 0;
            open = 0;
        } else {
            ui_sel_open = id;
            open = 1;
            ui_active = id;
        }
    }
    var hot: i64 = ui_anim(id, (over | open) * 255);
    var edge: i64 = ui_mix(ui_c_line, ui_c_accent, hot);
    ui_round(x, y, w, h, 10, edge);
    ui_round(x + 1, y + 1, w - 2, h - 2, 9, ui_c_field);
    window_clip(x + 2, y + 2, w - 34, h - 4);
    if sel >= 0 && sel < n {
        ui_font_text(x + 14, y + 9, 0, ui_item(items, sel), ui_c_text);
    }
    window_unclip();
    // the arrow
    ui_stroke8((x + w - 24) * 8, (y + 16) * 8, (x + w - 19) * 8, (y + 21) * 8, 10, ui_c_muted);
    ui_stroke8((x + w - 19) * 8, (y + 21) * 8, (x + w - 14) * 8, (y + 16) * 8, 10, ui_c_muted);
    if open {
        var rowh: i64 = 32;
        var shown: i64 = n;
        if shown > 8 { shown = 8; }
        var dy: i64 = y + h + 4;
        var dh: i64 = shown * rowh + 8;
        var scroll: i64 = ui_scroll_get(id);
        if ui_inside_raw(x, dy, w, dh) && ui_wheel != 0 {
            scroll = scroll - ui_wheel * rowh;
        }
        if scroll > n * rowh + 8 - dh { scroll = n * rowh + 8 - dh; }
        if scroll < 0 { scroll = 0; }
        ui_scroll_set(id, scroll);
        ui_nb_cover(x, dy, w, dh);
        ui_ov_add(1, x, dy, w, dh, 0, 0);
        var first: i64 = scroll / rowh;
        var i: i64 = first;
        while i < n && i < first + shown {
            var ry: i64 = dy + 4 + (i - first) * rowh;
            var flag: i64 = 0;
            if ui_inside_raw(x + 4, ry, w - 8, rowh) {
                flag = 1;
                if ui_released && ui_active != id {
                    sel = i;
                    ui_sel_open = 0;
                }
                if ui_released && ui_active == id && ui_pressed == 0 {
                    sel = i;
                    ui_sel_open = 0;
                }
            }
            if i == sel { flag = 2; }
            ui_ov_add(2, x, ry, w, rowh, ui_item(items, i), flag);
            i = i + 1;
        }
        // a press outside closes it
        if ui_pressed && over == 0 && ui_inside_raw(x, dy, w, dh) == 0 {
            ui_sel_open = 0;
        }
    }
    return sel;
}

// ---- menus ----------------------------------------------------------------

fn ui_menubar() -> i64 {
    ui_menu_h = 36;
    ui_menu_x = 8;
    ui_menu_y = 0;
    window_rect(0, 0, window_width(), ui_menu_h, ui_c_card);
    window_rect(0, ui_menu_h - 1, window_width(), 1, ui_c_line);
    if ui_inside_raw(0, 0, window_width(), ui_menu_h) {
        ui_menu_any = 1;
    }
    return 1;
}

fn ui_menu(label: i64) -> i64 {
    var tw: i64 = ui_font_width(0, label) + 24;
    var x: i64 = ui_menu_x;
    var y: i64 = ui_menu_y + 4;
    var id: i64 = ui_id(x, y) + 3333333;
    ui_menu_x = ui_menu_x + tw;
    var over: i64 = ui_inside_raw(x, y, tw, ui_menu_h - 8);
    if over {
        ui_menu_any = 1;
        if ui_pressed {
            if ui_menu_open == id {
                ui_menu_open = 0;
            } else {
                ui_menu_open = id;
                ui_drop_w = 200;
            }
        } else if ui_menu_open != 0 && ui_menu_open != id {
            ui_menu_open = id;                 // moving along the bar
            ui_drop_w = 200;
        }
    }
    var open: i64 = 0;
    if ui_menu_open == id { open = 1; }
    if open || over {
        var fill: i64 = ui_mix(ui_c_card, ui_c_accent, 30);
        if open { fill = ui_mix(ui_c_card, ui_c_accent, 55); }
        ui_round(x, y, tw, ui_menu_h - 8, 8, fill);
    }
    ui_font_text(x + 12, y + 5, 0, label, ui_c_text);
    if open {
        ui_drop_x = x;
        ui_drop_y = ui_menu_h + 2;
        ui_drop_n = 0;
        if ui_drop_wnext > ui_drop_w {
            ui_drop_w = ui_drop_wnext;
        }
        ui_drop_wnext = 200;
        ui_ov_add(1, ui_drop_x, ui_drop_y, ui_drop_w, 8, 0, 0);
        ui_nb_cover(ui_drop_x, ui_drop_y, ui_drop_w, 8);
        return 1;
    }
    return 0;
}

// the panel of the open menu grows by one row of height h
fn ui_drop_grow(h: i64) -> i64 {
    // the panel is the last kind-1 overlay: find it and stretch it
    var i: i64 = ui_ov_n - 1;
    while i >= 0 {
        if ui_ov_kind[i] == 1 {
            ui_ov_h[i] = ui_ov_h[i] + h;
            ui_ov_w[i] = ui_drop_w;
            i = -1;
        }
        i = i - 1;
    }
    ui_nb_cover(ui_drop_x, ui_drop_y, ui_drop_w, ui_drop_n + 8);
    return 1;
}

fn ui_menu_item(label: i64) -> i64 {
    var rowh: i64 = 32;
    var tw: i64 = ui_font_width(0, label) + 40;
    if tw > ui_drop_wnext { ui_drop_wnext = tw; }
    var x: i64 = ui_drop_x;
    var y: i64 = ui_drop_y + 4 + ui_drop_n;
    ui_drop_n = ui_drop_n + rowh;
    ui_drop_grow(rowh);
    var flag: i64 = 0;
    var chosen: i64 = 0;
    if ui_inside_raw(x + 4, y, ui_drop_w - 8, rowh) {
        flag = 1;
        ui_menu_any = 1;
        if ui_released {
            chosen = 1;
            ui_menu_open = 0;
        }
    }
    ui_ov_add(2, x, y, ui_drop_w, rowh, label, flag);
    return chosen;
}

fn ui_menu_line() -> i64 {
    var x: i64 = ui_drop_x;
    var y: i64 = ui_drop_y + 4 + ui_drop_n;
    ui_drop_n = ui_drop_n + 9;
    ui_drop_grow(9);
    if ui_inside_raw(x, y, ui_drop_w, 9) {
        ui_menu_any = 1;
    }
    ui_ov_add(3, x, y, ui_drop_w, 9, 0, 0);
    return 0;
}

// ---- pictures -------------------------------------------------------------

fn ui_image_size(x: i64, y: i64, w: i64, h: i64, img: i64) -> i64 {
    lock_take(HP_LOCK);
    var q: i64 = im_pixels(img);
    hp_take_err();
    lock_give(HP_LOCK);
    if q == 0 {
        return 0;
    }
    var iw: i64 = 0;
    var ih: i64 = 0;
    raw {
        iw = peek(q);
        ih = peek(q + 8);
    }
    if w <= 0 || h <= 0 {
        return 0;
    }
    var row: i64 = 0;
    while row < h {
        var sy: i64 = row * ih / h;
        var col: i64 = 0;
        while col < w {
            var sx: i64 = col * iw / w;
            var c: i64 = 0;
            raw { c = peek32(q + 16 + (sy * iw + sx) * 4); }
            var a: i64 = (c >> 24) & 255;
            if a == 255 {
                window_pixel(x + col, y + row, c & 0xFFFFFF);
            } else if a > 0 {
                ui_blend_at(x + col, y + row, c & 0xFFFFFF, a);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return 1;
}

fn ui_image(x: i64, y: i64, img: i64) -> i64 {
    var w: i64 = image_width(img);
    var h: i64 = image_height(img);
    if failed() {
        return 0;
    }
    return ui_image_size(x, y, w, h, img);
}

// ---- the clipboard --------------------------------------------------------

fn ui_copy(x: i64) -> i64 {
    var p: i64 = ui_str(x);
    var n: i64 = 0;
    raw {
        while peek8(p + n) != 0 {
            n = n + 1;
        }
    }
    return window_clip_set(p, n);
}

fn ui_paste() -> text {
    return text(window_clip_get());
}

// ---- numbers as text -----------------------------------------------------

fn ui_int_text(buffer: i64, n: i64) -> i64 {
    var digits: [i64; 4];
    var v: i64 = n;
    var len: i64 = 0;
    var neg: i64 = 0;
    if v < 0 {
        neg = 1;
        v = 0 - v;
    }
    raw {
        var d: i64 = &digits;
        if v == 0 {
            poke8(d, 48);
            len = 1;
        }
        while v > 0 {
            poke8(d + len, 48 + v % 10);
            v = v / 10;
            len = len + 1;
        }
        var o: i64 = 0;
        if neg {
            poke8(buffer, 45);
            o = 1;
        }
        var i: i64 = 0;
        while i < len {
            poke8(buffer + o + i, peek8(d + len - 1 - i));
            i = i + 1;
        }
        poke8(buffer + o + len, 0);
        len = len + o;
    }
    return len;
}

fn ui_real_text(buffer: i64, value: f64, decimals: i64) -> i64 {
    var v: f64 = value;
    var neg: i64 = 0;
    if v < 0.0 {
        neg = 1;
        v = 0.0 - v;
    }
    if v > 9000000000000000000.0 {
        raw {
            poke8(buffer, 69);               // E: too large to write out
            poke8(buffer + 1, 0);
        }
        return 1;
    }
    var scale: i64 = 1;
    var k: i64 = 0;
    while k < decimals {
        scale = scale * 10;
        k = k + 1;
    }
    var whole: i64 = v as i64;
    var frac: i64 = ((v - (whole as f64)) * (scale as f64) + 0.5) as i64;
    if frac >= scale {
        whole = whole + 1;
        frac = frac - scale;
    }
    var o: i64 = 0;
    raw {
        if neg {
            if whole + frac > 0 {
                poke8(buffer, 45);
                o = 1;
            }
        }
    }
    var len: i64 = ui_int_text(buffer + o, whole) + o;
    if decimals > 0 {
        if frac > 0 {
            raw {
                poke8(buffer + len, 46);
                var i: i64 = decimals - 1;
                var f: i64 = frac;
                while i >= 0 {
                    poke8(buffer + len + 1 + i, 48 + f % 10);
                    f = f / 10;
                    i = i - 1;
                }
                len = len + 1 + decimals;
                while peek8(buffer + len - 1) == 48 {
                    len = len - 1;
                }
                poke8(buffer + len, 0);
            }
        }
    }
    return len;
}
