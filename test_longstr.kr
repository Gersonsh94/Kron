kron_program
kron_domain test_longstr;
kron_imports
kron_definitions

// A string literal of 3000 characters. One that long used to be written as
// a single 'db' line, which the assemblers' line buffers cut short without
// a word: past about a thousand characters the bytes came out as zeros.
//
// Expected output:
//   48     the first character, '0'
//   57     the 3000th, '9'
//   0      the terminator right after it
//   3000   the length a stream counts

fn main() {
    var s: stream = "";
    raw {
        print(peek8(s.bytes));
        print(peek8(s.bytes + 2999));
        print(peek8(s.bytes + 3000));
    }
    print(s.len);
    return 0;
}
