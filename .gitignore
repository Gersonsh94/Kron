# ---- what the build makes -------------------------------------------------
*_kr.asm
*.fused.asm
*.fused.kr
stage*.exe
boot*.exe
obj/
seed/kronc.prev.exe

# ---- what the tests write (RUNTESTS, ARMTESTS, LINUXTESTS, MACTESTS,
#      WEBTESTS, GPUTESTS): every run makes them again ---------------------
tests/tmp/
tests/arm/
tests/linux/
# tests/mac is kept: MACTESTS.bat builds the macOS tests on Windows and the
# Mac takes them from the repository (it has no compiler of its own). What
# running them there writes is left out.
tests/mac/*.out
tests/mac/*.build
tests/web/
tests/pe/
tests/*.log
ref_asm/

# ---- what compiling a program leaves beside it ------------------------------
# (kronc.exe and seed/kronc.exe are kept: they are committed on purpose)
*.kbin
*.expanded
*.obj
preproc.asm
kernel_program.asm
test_*.exe
lexer/*.exe
parser/*.exe
semantic/*.exe
codegen/*.exe
