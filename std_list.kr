kron_program
kron_domain std_list;
kron_imports
acquire_domain "std_heap.kr";
kron_definitions

// =========================================================================
// Kron standard library -- lists that grow.
//
//     var l: i64 = list_new();
//     list_add(l, 10);
//     list_add(l, 20);
//     print(list_get(l, 1));            // 20
//     print(list_len(l));               // 2
//
//   list_new()                     an empty list
//   list_add(l, v)                 v at the end; returns l
//   list_get(l, i)  list_set(l, i, v)
//   list_len(l)     list_last(l)
//   list_pop(l)                    the last value, taken out
//   list_insert(l, i, v)           v at position i, the rest moves up
//   list_remove(l, i)              the value at i, taken out
//   list_find(l, v)                where v is, or -1
//   list_sort(l)                   smallest first, as integers
//   list_reverse(l)  list_clear(l)  list_copy(l)
//   list_add_real(l, x)  list_get_real(l, i)  list_set_real(l, i, x)
//   list_free(l)                   the list is gone; using it again fails
//
// A list<S> with S a struct holds whole structs: l[i] is a copy of one,
// l[i] = v and list_add(l, v) copy v in; list_len, list_insert,
// list_remove, list_pop, list_last and list_reverse count and move whole
// structs (the _n functions below do the work).
//
// A list holds i64: numbers, or the handles of texts, maps and other lists.
// Freeing a list does not free what its values refer to.
//
// A list is a handle (see std_heap.kr): an index out of range, a freed list
// or something that is not a list fails with a cause and a hint, and
// returns 0. Lists can be used from several threads; each call is atomic.
// =========================================================================

shared var li_real: f64;            // a real's bits pass through here

// --------------------------------------------------------- internals ---
// Block: [length][values...]. The lock is held.

fn li_new(cap: i64) -> i64 {
    var q: i64 = hp_alloc(8 + cap * 8);
    if q == 0 {
        return 0;
    }
    var h: i64 = ob_new(OB_LIST, q);
    if h == 0 {
        hp_release(q);
    }
    return h;
}

fn li_len(h: i64) -> i64 {
    var q: i64 = ob_get(h, OB_LIST);
    if q == 0 {
        return 0;
    }
    var n: i64 = 0;
    raw { n = peek(q); }
    return n;
}

// the block with room for n values, moved if needed; 0 on failure
fn li_room(h: i64, n: i64) -> i64 {
    var q: i64 = ob_get(h, OB_LIST);
    if q == 0 {
        return 0;
    }
    if hp_room(q) >= 8 + n * 8 {
        return q;
    }
    var r: i64 = hp_grow(q, 8 + n * 8);
    if r == 0 {
        return 0;
    }
    ob_put(h, r);
    return r;
}

fn li_add(h: i64, v: i64) -> i64 {
    var q: i64 = ob_get(h, OB_LIST);
    if q == 0 {
        return 0;
    }
    var n: i64 = 0;
    raw { n = peek(q); }
    q = li_room(h, n + 1);
    if q == 0 {
        return 0;
    }
    raw {
        poke(q + 8 + n * 8, v);
        poke(q, n + 1);
    }
    return h;
}

// the address of value i, or 0 with hp_err
fn li_at(h: i64, i: i64) -> i64 {
    var q: i64 = ob_get(h, OB_LIST);
    if q == 0 {
        return 0;
    }
    var n: i64 = 0;
    raw { n = peek(q); }
    if i < 0 {
        hp_err = 5;
        return 0;
    }
    if i >= n {
        hp_err = 5;
        return 0;
    }
    return q + 8 + i * 8;
}

fn li_get(h: i64, i: i64) -> i64 {
    var a: i64 = li_at(h, i);
    if a == 0 {
        return 0;
    }
    var v: i64 = 0;
    raw { v = peek(a); }
    return v;
}

fn li_free(h: i64) -> i64 {
    var q: i64 = ob_get(h, OB_LIST);
    if q == 0 {
        return 0;
    }
    ob_drop(h);
    hp_release(q);
    return 0;
}

// Sorting, smallest first: bottom-up merge sort, stable. mode 0 compares
// the values as integers, mode 1 as texts (text_sort in std_text).
fn li_sort(h: i64, mode: i64) -> i64 {
    var q: i64 = ob_get(h, OB_LIST);
    if q == 0 {
        return 0;
    }
    var n: i64 = 0;
    raw { n = peek(q); }
    if n < 2 {
        return h;
    }
    var tmp: i64 = hp_alloc(n * 8);
    if tmp == 0 {
        return 0;
    }
    var src: i64 = q + 8;
    var dst: i64 = tmp;
    var width: i64 = 1;
    while width < n {
        var lo: i64 = 0;
        while lo < n {
            var mid: i64 = lo + width;
            if mid > n {
                mid = n;
            }
            var hi: i64 = lo + width * 2;
            if hi > n {
                hi = n;
            }
            var a: i64 = lo;
            var b: i64 = mid;
            var k: i64 = lo;
            while k < hi {
                var take_b: i64 = 0;
                if a >= mid {
                    take_b = 1;
                } else if b < hi {
                    var va: i64 = 0;
                    var vb: i64 = 0;
                    raw {
                        va = peek(src + a * 8);
                        vb = peek(src + b * 8);
                    }
                    if li_less(vb, va, mode) {
                        take_b = 1;
                    }
                }
                raw {
                    if take_b {
                        poke(dst + k * 8, peek(src + b * 8));
                    } else {
                        poke(dst + k * 8, peek(src + a * 8));
                    }
                }
                if take_b {
                    b = b + 1;
                } else {
                    a = a + 1;
                }
                k = k + 1;
            }
            lo = hi;
        }
        var t: i64 = src;
        src = dst;
        dst = t;
        width = width * 2;
    }
    if src != q + 8 {
        hp_copy(q + 8, src, n * 8);
    }
    hp_release(tmp);
    return h;
}

fn li_less(x: i64, y: i64, mode: i64) -> i64 {
    if mode == 0 {
        if x < y {
            return 1;
        }
        return 0;
    }
    if tv_compare(x, y) < 0 {
        return 1;
    }
    return 0;
}

// ---------------------------------------------------------- the calls ---

fn list_end(r: i64) -> i64 {
    var e: i64 = hp_take_err();
    lock_give(HP_LOCK);
    if e != 0 {
        return heap_fail(e);
    }
    return r;
}

fn list_new() -> list<i64> {
    lock_take(HP_LOCK);
    return list_end(li_new(8));
}

fn list_free(l: i64) -> i64 {
    lock_take(HP_LOCK);
    return list_end(li_free(l));
}

fn list_len(l: i64) -> i64 {
    lock_take(HP_LOCK);
    return list_end(li_len(l));
}

fn list_add(l: i64, v: i64) -> i64 {
    lock_take(HP_LOCK);
    return list_end(li_add(l, v));
}

fn list_get(l: i64, i: i64) -> i64 {
    lock_take(HP_LOCK);
    return list_end(li_get(l, i));
}

fn list_set(l: i64, i: i64, v: i64) -> i64 {
    lock_take(HP_LOCK);
    var a: i64 = li_at(l, i);
    if a != 0 {
        raw { poke(a, v); }
    }
    return list_end(v);
}

fn list_last(l: i64) -> i64 {
    lock_take(HP_LOCK);
    var n: i64 = li_len(l);
    var v: i64 = 0;
    if hp_err == 0 {
        if n == 0 {
            hp_err = 10;
        } else {
            v = li_get(l, n - 1);
        }
    }
    return list_end(v);
}

fn list_pop(l: i64) -> i64 {
    lock_take(HP_LOCK);
    var n: i64 = li_len(l);
    var v: i64 = 0;
    if hp_err == 0 {
        if n == 0 {
            hp_err = 10;
        } else {
            v = li_get(l, n - 1);
            var q: i64 = ob_get(l, OB_LIST);
            raw { poke(q, n - 1); }
        }
    }
    return list_end(v);
}

fn list_insert(l: i64, i: i64, v: i64) -> i64 {
    lock_take(HP_LOCK);
    var n: i64 = li_len(l);
    if hp_err == 0 {
        if i < 0 {
            hp_err = 5;
        } else if i > n {
            hp_err = 5;
        } else {
            var q: i64 = li_room(l, n + 1);
            if q != 0 {
                var k: i64 = n;
                raw {
                    while k > i {
                        poke(q + 8 + k * 8, peek(q + 8 + (k - 1) * 8));
                        k = k - 1;
                    }
                    poke(q + 8 + i * 8, v);
                    poke(q, n + 1);
                }
            }
        }
    }
    return list_end(l);
}

fn list_remove(l: i64, i: i64) -> i64 {
    lock_take(HP_LOCK);
    var v: i64 = li_get(l, i);
    if hp_err == 0 {
        var q: i64 = ob_get(l, OB_LIST);
        var n: i64 = 0;
        raw {
            n = peek(q);
            var k: i64 = i;
            while k < n - 1 {
                poke(q + 8 + k * 8, peek(q + 8 + (k + 1) * 8));
                k = k + 1;
            }
            poke(q, n - 1);
        }
    }
    return list_end(v);
}

fn list_clear(l: i64) -> i64 {
    lock_take(HP_LOCK);
    var q: i64 = ob_get(l, OB_LIST);
    if q != 0 {
        raw { poke(q, 0); }
    }
    return list_end(l);
}

fn list_find(l: i64, v: i64) -> i64 {
    lock_take(HP_LOCK);
    var q: i64 = ob_get(l, OB_LIST);
    var found: i64 = -1;
    if q != 0 {
        raw {
            var n: i64 = peek(q);
            var k: i64 = 0;
            while k < n {
                if peek(q + 8 + k * 8) == v {
                    found = k;
                    k = n;
                }
                k = k + 1;
            }
        }
    }
    return list_end(found);
}

fn list_sort(l: i64) -> i64 {
    lock_take(HP_LOCK);
    return list_end(li_sort(l, 0));
}

fn list_reverse(l: i64) -> i64 {
    lock_take(HP_LOCK);
    var q: i64 = ob_get(l, OB_LIST);
    if q != 0 {
        raw {
            var n: i64 = peek(q);
            var a: i64 = 0;
            var b: i64 = n - 1;
            while a < b {
                var t: i64 = peek(q + 8 + a * 8);
                poke(q + 8 + a * 8, peek(q + 8 + b * 8));
                poke(q + 8 + b * 8, t);
                a = a + 1;
                b = b - 1;
            }
        }
    }
    return list_end(l);
}

fn list_copy(l: i64) -> i64 {
    lock_take(HP_LOCK);
    var n: i64 = li_len(l);
    var r: i64 = 0;
    if hp_err == 0 {
        r = li_new(n);
        if r != 0 {
            var q: i64 = ob_get(l, OB_LIST);
            var d: i64 = ob_get(r, OB_LIST);
            hp_copy(d, q, 8 + n * 8);
        }
    }
    return list_end(r);
}

// ------------------------------------------------- lists of structs ---
// A list<S> with S a struct keeps each element as k values in a row, k the
// struct's size in slots of eight. The compiler turns l[i], l[i] = v,
// list_add(l, v), list_len(l) and the rest into these on such a list; the
// struct goes in and out by address. Each call is atomic, like the others.

fn list_sget(l: i64, i: i64) -> i64 {
    return list_get(l, i);
}

fn list_sset(l: i64, i: i64, v: i64) -> i64 {
    return list_set(l, i, v);
}

// the address of element i (k values each), 0 with hp_err set when there
// is none. The lock is held.
fn li_at_n(l: i64, i: i64, k: i64) -> i64 {
    var q: i64 = ob_get(l, OB_LIST);
    if q == 0 {
        return 0;
    }
    var n: i64 = 0;
    raw { n = peek(q); }
    if i < 0 {
        hp_err = 5;
        return 0;
    }
    if i >= n / k {
        hp_err = 5;
        return 0;
    }
    return q + 8 + i * k * 8;
}

fn list_len_n(l: i64, k: i64) -> i64 {
    lock_take(HP_LOCK);
    return list_end(li_len(l) / k);
}

fn list_add_n(l: i64, src: i64, k: i64) -> i64 {
    lock_take(HP_LOCK);
    var n: i64 = li_len(l);
    if hp_err == 0 {
        var q: i64 = li_room(l, n + k);
        if q != 0 {
            hp_copy(q + 8 + n * 8, src, k * 8);
            raw { poke(q, n + k); }
        }
    }
    return list_end(l);
}

fn list_get_n(l: i64, i: i64, dst: i64, k: i64) -> i64 {
    lock_take(HP_LOCK);
    var a: i64 = li_at_n(l, i, k);
    if a != 0 {
        hp_copy(dst, a, k * 8);
    }
    return list_end(dst);
}

fn list_set_n(l: i64, i: i64, src: i64, k: i64) -> i64 {
    lock_take(HP_LOCK);
    var a: i64 = li_at_n(l, i, k);
    if a != 0 {
        hp_copy(a, src, k * 8);
    }
    return list_end(l);
}

fn list_insert_n(l: i64, i: i64, src: i64, k: i64) -> i64 {
    lock_take(HP_LOCK);
    var n: i64 = li_len(l);
    if hp_err == 0 {
        if i < 0 {
            hp_err = 5;
        } else if i > n / k {
            hp_err = 5;
        } else {
            var q: i64 = li_room(l, n + k);
            if q != 0 {
                var j: i64 = n - 1;
                raw {
                    while j >= i * k {
                        poke(q + 8 + (j + k) * 8, peek(q + 8 + j * 8));
                        j = j - 1;
                    }
                }
                hp_copy(q + 8 + i * k * 8, src, k * 8);
                raw { poke(q, n + k); }
            }
        }
    }
    return list_end(l);
}

fn list_remove_n(l: i64, i: i64, dst: i64, k: i64) -> i64 {
    lock_take(HP_LOCK);
    var a: i64 = li_at_n(l, i, k);
    if a != 0 {
        hp_copy(dst, a, k * 8);
        var q: i64 = ob_get(l, OB_LIST);
        raw {
            var n: i64 = peek(q);
            var j: i64 = i * k;
            while j < n - k {
                poke(q + 8 + j * 8, peek(q + 8 + (j + k) * 8));
                j = j + 1;
            }
            poke(q, n - k);
        }
    }
    return list_end(dst);
}

fn list_last_n(l: i64, dst: i64, k: i64) -> i64 {
    lock_take(HP_LOCK);
    var n: i64 = li_len(l) / k;
    if hp_err == 0 {
        if n == 0 {
            hp_err = 10;
        } else {
            hp_copy(dst, li_at_n(l, n - 1, k), k * 8);
        }
    }
    return list_end(dst);
}

fn list_pop_n(l: i64, dst: i64, k: i64) -> i64 {
    lock_take(HP_LOCK);
    var n: i64 = li_len(l) / k;
    if hp_err == 0 {
        if n == 0 {
            hp_err = 10;
        } else {
            hp_copy(dst, li_at_n(l, n - 1, k), k * 8);
            var q: i64 = ob_get(l, OB_LIST);
            raw { poke(q, (n - 1) * k); }
        }
    }
    return list_end(dst);
}

fn list_reverse_n(l: i64, k: i64) -> i64 {
    lock_take(HP_LOCK);
    var q: i64 = ob_get(l, OB_LIST);
    if q != 0 {
        raw {
            var n: i64 = peek(q) / k;
            var a: i64 = 0;
            var b: i64 = n - 1;
            while a < b {
                var j: i64 = 0;
                while j < k {
                    var pa: i64 = q + 8 + (a * k + j) * 8;
                    var pb: i64 = q + 8 + (b * k + j) * 8;
                    var t: i64 = peek(pa);
                    poke(pa, peek(pb));
                    poke(pb, t);
                    j = j + 1;
                }
                a = a + 1;
                b = b - 1;
            }
        }
    }
    return list_end(l);
}

fn list_add_real(l: i64, x: f64) -> i64 {
    var bits: i64 = 0;
    lock_take(HP_LOCK);
    raw {
        li_real = x;
        bits = peek(&li_real);
    }
    return list_end(li_add(l, bits));
}

fn list_get_real(l: i64, i: i64) -> f64 {
    lock_take(HP_LOCK);
    var bits: i64 = li_get(l, i);
    var x: f64 = 0.0;
    raw {
        poke(&li_real, bits);
        x = li_real;
    }
    var e: i64 = hp_take_err();
    lock_give(HP_LOCK);
    if e != 0 {
        heap_fail(e);
        return 0.0;
    }
    return x;
}

fn list_set_real(l: i64, i: i64, x: f64) -> f64 {
    lock_take(HP_LOCK);
    var a: i64 = li_at(l, i);
    if a != 0 {
        raw {
            li_real = x;
            poke(a, peek(&li_real));
        }
    }
    var e: i64 = hp_take_err();
    lock_give(HP_LOCK);
    if e != 0 {
        heap_fail(e);
        return 0.0;
    }
    return x;
}
