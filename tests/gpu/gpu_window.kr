kron_program
kron_domain gpu_window;
kron_imports
acquire_domain "std_time.kr";
acquire_domain "std_gpu.kr";
kron_definitions

// =========================================================================
// GPU test: three seconds of a turning sphere and cube in a window, drawn
// by the card and shown in the window. Run by GPUTESTS.bat. It checks that
// the frames come and how fast; a person looking checks the picture.
// The exit code is the number of checks that failed.
// =========================================================================

var failures: i64;

fn report(ok: i64, what: i64) -> i64 {
    var t: text = text_new();
    if ok {
        text_add(t, "  ok    ");
    } else {
        text_add(t, "  FAIL  ");
        failures = failures + 1;
    }
    text_add(t, what);
    say(t);
    return ok;
}

fn main() -> i64 {
    say("GPU window test (3 seconds)");
    if window_open(960, 540, "Kron GPU test: a sphere and a cube") == 0 {
        report(0, "the window opens");
        return failures;
    }
    if gpu_open(960, 540) == 0 {
        say("  FAIL  the GPU did not open (the reason follows)");
        return 1;
    }
    var src: text = "uniform { mvp: mat4; model: mat4; light: vec3; tint: vec4; }\nin pos: vec3;\nin normal: vec3;\nin uv: vec2;\nvar vn: vec3;\nvertex {\n vn = (model * vec4(normal, 0.0)).xyz;\n position = mvp * vec4(pos, 1.0);\n}\nfragment {\n let d = max(dot(normalize(vn), light), 0.0);\n color = vec4(tint.rgb * (0.2 + 0.8 * d), 1.0);\n}\n";
    var prog: i64 = gpu_shader(src);
    report(prog != 0, "the shader compiles");
    var sphere: i64 = gpu_sphere(24, 48);
    var cube: i64 = gpu_cube();
    var proj: Mat4 = m4_perspective(radians(60.0), 960.0 / 540.0, 0.1, 100.0);
    var view: Mat4 = m4_look_at(v3(0.0, 1.5, 5.0), v3(0.0, 0.0, 0.0), v3(0.0, 1.0, 0.0));
    var covered: i64 = 0;
    var t0: i64 = time_ms();
    var frames: i64 = 0;
    while window_show() && time_ms() - t0 < 3000 {
        var t: f64 = ((time_ms() - t0) as f64) / 1000.0;
        frames = frames + 1;
        gpu_begin(color4(12, 14, 30, 255));
        gpu_set_vec3(prog, "light", v3_norm(v3(0.5, 1.0, 0.8)));
        var m1: Mat4 = m4_mul(m4_translate(-1.3, 0.0, 0.0), m4_rotate_y(t));
        gpu_set_mat4(prog, "mvp", m4_mul(proj, m4_mul(view, m1)));
        gpu_set_mat4(prog, "model", m1);
        gpu_set_vec4(prog, "tint", v4(0.9, 0.5, 0.2, 1.0));
        gpu_draw(prog, sphere, 0);
        var m2: Mat4 = m4_mul(m4_translate(1.3, 0.0, 0.0), m4_mul(m4_rotate_y(t * 1.3), m4_mul(m4_rotate_x(t * 0.7), m4_scale(0.7, 0.7, 0.7))));
        gpu_set_mat4(prog, "mvp", m4_mul(proj, m4_mul(view, m2)));
        gpu_set_mat4(prog, "model", m2);
        gpu_set_vec4(prog, "tint", v4(0.3, 0.6, 1.0, 1.0));
        gpu_draw(prog, cube, 0);
        gpu_end();
        if gpu_pixel(480 - 156, 270) != 0x0C0E1E { covered = covered + 1; }
        if window_key() == 27 { window_close(); }
    }
    var secs: f64 = ((time_ms() - t0) as f64) / 1000.0;
    var t2: text = text_add_int(text_new(), frames);
    text_add(t2, " frames in ");
    text_add_real(t2, secs, 2);
    text_add(t2, " s: ");
    text_add_int(t2, ((frames as f64) / secs) as i64);
    text_add(t2, " a second");
    report(frames >= 30, t2);
    report(covered * 2 >= frames, "the sphere is where it should be in the frames");
    gpu_close();
    window_close();
    if failures == 0 { say("GPU window test: all passed"); }
    return failures;
}
