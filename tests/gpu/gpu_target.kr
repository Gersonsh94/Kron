kron_program
kron_domain gpu_target;
kron_imports
acquire_domain "std_gpu.kr";
kron_definitions

// =========================================================================
// GPU test: render targets. A target is drawn into before the frame, and
// the frame reads its colour and its depth as textures. Run by GPUTESTS.bat;
// the exit code is the number of checks that failed.
// =========================================================================

var failures: i64;
const W: i64 = 128;
const H: i64 = 128;
const T: i64 = 64;

fn report(ok: i64, what: i64) -> i64 {
    var t: text = text_new();
    if ok {
        text_add(t, "  ok    ");
    } else {
        text_add(t, "  FAIL  ");
        failures = failures + 1;
    }
    text_add(t, what);
    say(t);
    return ok;
}

fn iabs(x: i64) -> i64 {
    if x < 0 { return 0 - x; }
    return x;
}

fn channel(c: i64, k: i64) -> i64 { return (c >> (16 - k * 8)) & 255; }

fn near(c: i64, r: i64, g: i64, b: i64, tol: i64) -> i64 {
    if iabs(channel(c, 0) - r) > tol { return 0; }
    if iabs(channel(c, 1) - g) > tol { return 0; }
    if iabs(channel(c, 2) - b) > tol { return 0; }
    return 1;
}

fn hex(c: i64) -> text {
    var t: text = text_new();
    text_add(t, " (got ");
    text_add_int(t, channel(c, 0));
    text_add(t, ",");
    text_add_int(t, channel(c, 1));
    text_add(t, ",");
    text_add_int(t, channel(c, 2));
    text_add(t, ")");
    return t;
}

fn check_pixel(x: i64, y: i64, r: i64, g: i64, b: i64, tol: i64, what: i64) -> i64 {
    var c: i64 = gpu_pixel(x, y);
    var t: text = text_add(text_add(text_new(), what), hex(c));
    return report(near(c, r, g, b, tol), t);
}

// a square from (x0, y0) to (x1, y1) in screen space (-1..1), at depth z
fn quad(x0: f64, y0: f64, x1: f64, y1: f64, z: f64) -> i64 {
    var v: i64 = list_new();
    var i: i64 = list_new();
    list_add_real(v, x0); list_add_real(v, y0); list_add_real(v, z); list_add_real(v, 0.0); list_add_real(v, 1.0);
    list_add_real(v, x1); list_add_real(v, y0); list_add_real(v, z); list_add_real(v, 1.0); list_add_real(v, 1.0);
    list_add_real(v, x1); list_add_real(v, y1); list_add_real(v, z); list_add_real(v, 1.0); list_add_real(v, 0.0);
    list_add_real(v, x0); list_add_real(v, y1); list_add_real(v, z); list_add_real(v, 0.0); list_add_real(v, 0.0);
    list_add(i, 0); list_add(i, 1); list_add(i, 2);
    list_add(i, 0); list_add(i, 2); list_add(i, 3);
    return gpu_mesh_lists(v, 5, i);
}

fn main() -> i64 {
    say("GPU target test");
    if gpu_open(W, H) == 0 {
        say("  FAIL  the GPU did not open (the reason follows)");
        return 1;
    }

    var flat: text = "uniform { tint: vec4; }\nin pos: vec3;\nin uv: vec2;\nvertex {\n position = vec4(pos, 1.0);\n}\nfragment {\n color = tint;\n}\n";
    var pic: text = "texture albedo;\nin pos: vec3;\nin uv: vec2;\nvar vuv: vec2;\nvertex {\n vuv = uv;\n position = vec4(pos, 1.0);\n}\nfragment {\n color = sample(albedo, vuv);\n}\n";
    var depth: text = "texture albedo;\nin pos: vec3;\nin uv: vec2;\nvar vuv: vec2;\nvertex {\n vuv = uv;\n position = vec4(pos, 1.0);\n}\nfragment {\n let d = sample(albedo, vuv).r;\n color = vec4(d, d, d, 1.0);\n}\n";
    var pflat: i64 = gpu_shader(flat);
    var ppic: i64 = gpu_shader(pic);
    var pdepth: i64 = gpu_shader(depth);
    report(pflat != 0 && ppic != 0 && pdepth != 0, "the shaders compile");
    if pflat == 0 || ppic == 0 || pdepth == 0 {
        return failures;
    }
    var full: i64 = quad(-1.0, -1.0, 1.0, 1.0, 0.5);
    var mid: i64 = quad(-0.5, -0.5, 0.5, 0.5, 0.5);
    var near_q: i64 = quad(-0.5, -0.5, 0.5, 0.5, 0.2);
    var far_q: i64 = quad(-0.5, -0.5, 0.5, 0.5, 0.8);

    // 1. colour: a red square drawn into a green target, read by the frame
    var tc: i64 = gpu_target(T, T);
    report(tc > 0, "a colour target is made");
    gpu_set_vec4(pflat, "tint", v4(1.0, 0.0, 0.0, 1.0));
    gpu_begin_target(tc, color4(0, 255, 0, 255));
    gpu_draw(pflat, mid, 0);
    gpu_end_target();
    gpu_begin(color4(0, 0, 0, 255));
    gpu_draw(ppic, full, gpu_target_texture(tc));
    gpu_end();
    check_pixel(W / 2, H / 2, 255, 0, 0, 8, "target colour: the red square in the middle");
    check_pixel(2, 2, 0, 255, 0, 8, "target colour: green around it");
    check_pixel(W - 3, H - 3, 0, 255, 0, 8, "target colour: green in the other corner");

    // 2. depth: two squares, the near one at 0.2 and the far at 0.8, in a
    // target cleared to depth 1.0; the frame reads the depth back as grey
    var td: i64 = gpu_target(T, T);
    report(td > 0, "a depth target is made");
    gpu_set_vec4(pflat, "tint", v4(0.0, 0.0, 0.0, 1.0));
    gpu_begin_target(td, color4(0, 0, 0, 255));
    gpu_draw(pflat, far_q, 0);
    gpu_draw(pflat, near_q, 0);
    gpu_end_target();
    gpu_begin(color4(0, 0, 0, 255));
    gpu_draw(pdepth, full, gpu_target_depth(td));
    gpu_end();
    check_pixel(W / 2, H / 2, 51, 51, 51, 4, "target depth: the near square, 0.2, in the middle");
    check_pixel(2, 2, 255, 255, 255, 2, "target depth: far, 1.0, outside the square");

    // 3. the same target again: a fresh frame sees the new depth, not the old
    gpu_set_vec4(pflat, "tint", v4(0.0, 0.0, 0.0, 1.0));
    gpu_begin_target(td, color4(0, 0, 0, 255));
    gpu_draw(pflat, mid, 0);
    gpu_end_target();
    gpu_begin(color4(0, 0, 0, 255));
    gpu_draw(pdepth, full, gpu_target_depth(td));
    gpu_end();
    check_pixel(W / 2, H / 2, 128, 128, 128, 4, "target depth, drawn again: the middle at 0.5");

    if failures == 0 {
        say("GPU target test: all passed");
    } else {
        say("GPU target test: some checks failed");
    }
    return failures;
}
