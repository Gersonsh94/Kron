kron_program
kron_domain test_os;
kron_imports
acquire_domain "std_os.kr";
kron_definitions

// std_os: environment, running commands, arguments. The same output on
// Windows (cmd) and Linux (sh).

fn main() {
    print(env_has("PATH"));                            // 1
    print(env_has("KRON_SURELY_NOT_SET"));             // 0
    env_get("KRON_SURELY_NOT_SET");
    print(failed());                                   // 1
    print(os_run("exit 3"));                           // 3
    var out: i64 = os_run_output("echo hello from the shell");
    say(text_trim(out));
    print(list_len(os_args()));                        // 1
    print(text_len(os_cwd()) > 0);                     // 1
    return 0;
}
