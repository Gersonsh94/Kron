kron_program
kron_domain make_host;
kron_imports
acquire_domain "std_text.kr";
acquire_domain "std_file.kr";
kron_definitions

// =========================================================================
// make_host: web/kron_web.js -> web_host.kr
//
// The compiler carries the host of the web target inside itself and writes
// it as kron_web.js beside every NAME.wasm, so the two always match. This
// turns the script into the Kron text the compiler is built with. After
// changing web/kron_web.js, from the folder of the compiler:
//
//   kronc web\make_host.kr -o make_host.exe
//   make_host.exe
//
// then build the compiler again. Carriage returns are left out, so the
// result is the same whatever line endings the script has.
// =========================================================================

fn nl(out: text) -> i64 {
    text_add_char(out, 13);
    text_add_char(out, 10);
    return 0;
}

fn main() {
    var js = file_read_all("web/kron_web.js");
    var n: i64 = text_len(js);
    if n == 0 {
        print("make_host: cannot read web/kron_web.js");
        return;
    }
    var size: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if text_at(js, i) != 13 {
            size = size + 1;
        }
        i = i + 1;
    }
    var out: text = "kron_program";
    nl(out);
    text_add(out, "kron_domain web_host;");
    nl(out);
    text_add(out, "kron_imports");
    nl(out);
    text_add(out, "kron_definitions");
    nl(out);
    nl(out);
    text_add(out, "// =========================================================================");
    nl(out);
    text_add(out, "// web_host.kr -- the host of the web target, from web/kron_web.js.");
    nl(out);
    text_add(out, "// Written by web/make_host.kr: change the script and run it, not this.");
    nl(out);
    text_add(out, "//");
    nl(out);
    text_add(out, "//   ww_host_js()        the script, as one text");
    nl(out);
    text_add(out, "//   ww_host_js_size()   its length in bytes");
    nl(out);
    text_add(out, "// =========================================================================");
    nl(out);
    nl(out);
    text_add(out, "fn ww_host_js_size() -> i64 {");
    nl(out);
    text_add(out, "    return ");
    text_add_int(out, size);
    text_add(out, ";");
    nl(out);
    text_add(out, "}");
    nl(out);
    nl(out);
    text_add(out, "fn ww_host_js() -> i64 {");
    nl(out);
    text_add(out, "    return ");
    text_add_char(out, 34);
    i = 0;
    while i < n {
        var c: i64 = text_at(js, i);
        if c == 10 {
            text_add_char(out, 92);
            text_add_char(out, 110);
        } else if c == 9 {
            text_add_char(out, 92);
            text_add_char(out, 116);
        } else if c == 34 || c == 92 {
            text_add_char(out, 92);
            text_add_char(out, c);
        } else if c != 13 {
            text_add_char(out, c);
        }
        i = i + 1;
    }
    text_add_char(out, 34);
    text_add(out, ";");
    nl(out);
    text_add(out, "}");
    nl(out);
    file_write_all("web_host.kr", out);
    print("make_host: web_host.kr, " + size + " bytes");
}
