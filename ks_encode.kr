kron_program
kron_domain ks_encode;
kron_imports
kron_definitions

// =========================================================================
// encode_line: the bytes of the instruction in tok_a / tok_b / tok_c
//
// A line it cannot encode is reported in pass two with two numbers: the
// kinds of its operands as the line set them (en_r12, en_r14). A form that
// never parses an operand leaves there what run_pass had -- the bytes of
// the source still to read and the length of the whole -- and those are
// what gets reported, as before.
// =========================================================================

fn ks_encode_line() -> i64 {
    rex8_force = 0;
    en_r12 = rp_left;
    en_r14 = rp_len;
    if ks_b(&tok_a) == 0 {
        return 0;
    }
    if ks_is("mov") == 1 { return ks_i_mov(); }
    if ks_is("push") == 1 { return ks_i_push(); }
    if ks_is("pop") == 1 { return ks_i_pop(); }
    if ks_is("add") == 1 { return ks_arith(0x01, 0); }
    if ks_is("sub") == 1 { return ks_arith(0x29, 5); }
    if ks_is("imul") == 1 { return ks_i_imul(); }
    if ks_is("mul") == 1 { return ks_unary_f7(4); }
    if ks_is("idiv") == 1 { return ks_unary_f7(7); }
    if ks_is("div") == 1 { return ks_unary_f7(6); }
    if ks_is("cqo") == 1 { return ks_two(0x48, 0x99); }
    if ks_is("cmp") == 1 { return ks_arith(0x39, 7); }
    if ks_is("test") == 1 { return ks_arith(0x85, 0); }
    if ks_is("xor") == 1 { return ks_arith(0x31, 6); }
    if ks_is("neg") == 1 { return ks_unary_f7(3); }
    if ks_is("inc") == 1 { return ks_unary_ff(0); }
    if ks_is("dec") == 1 { return ks_unary_ff(1); }
    if ks_is("lea") == 1 { return ks_i_lea(); }
    if ks_is("ret") == 1 { return ks_emit_b(0xC3); }
    if ks_is("call") == 1 { return ks_i_call(); }
    if ks_is("jmp") == 1 {
        ks_emit_b(0xE9);
        return ks_rel32_target();
    }
    if ks_is("je") == 1 { return ks_jcc(0x84); }
    if ks_is("jz") == 1 { return ks_jcc(0x84); }
    if ks_is("jne") == 1 { return ks_jcc(0x85); }
    if ks_is("jnz") == 1 { return ks_jcc(0x85); }
    if ks_is("jns") == 1 { return ks_jcc(0x89); }
    if ks_is("jbe") == 1 { return ks_jcc(0x86); }
    if ks_is("hlt") == 1 { return ks_emit_b(0xF4); }
    if ks_is("cli") == 1 { return ks_emit_b(0xFA); }
    if ks_is("syscall") == 1 { return ks_two(0x0F, 0x05); }
    if ks_is("iretq") == 1 { return ks_two(0x48, 0xCF); }
    if ks_is("movzx") == 1 { return ks_i_movzx(); }
    if ks_is("movsx") == 1 { return ks_i_movsx(); }
    if ks_is("sete") == 1 { return ks_setcc(0x94); }
    if ks_is("setne") == 1 { return ks_setcc(0x95); }
    if ks_is("setl") == 1 { return ks_setcc(0x9C); }
    if ks_is("setg") == 1 { return ks_setcc(0x9F); }
    if ks_is("setle") == 1 { return ks_setcc(0x9E); }
    if ks_is("setge") == 1 { return ks_setcc(0x9D); }
    if ks_is("setb") == 1 { return ks_setcc(0x92); }
    if ks_is("setae") == 1 { return ks_setcc(0x93); }
    if ks_is("seta") == 1 { return ks_setcc(0x97); }
    if ks_is("setbe") == 1 { return ks_setcc(0x96); }
    if ks_is("in") == 1 { return ks_emit_b(0xEC); }
    if ks_is("out") == 1 { return ks_emit_b(0xEE); }
    if ks_is("addps") == 1 { return ks_sse_packed(0x58, 0); }
    if ks_is("subps") == 1 { return ks_sse_packed(0x5C, 0); }
    if ks_is("mulps") == 1 { return ks_sse_packed(0x59, 0); }
    if ks_is("divps") == 1 { return ks_sse_packed(0x5E, 0); }
    if ks_is("addpd") == 1 { return ks_sse_packed(0x58, 0x66); }
    if ks_is("subpd") == 1 { return ks_sse_packed(0x5C, 0x66); }
    if ks_is("mulpd") == 1 { return ks_sse_packed(0x59, 0x66); }
    if ks_is("divpd") == 1 { return ks_sse_packed(0x5E, 0x66); }
    if ks_is("movaps") == 1 { return ks_sse_mov(0x28, 0); }
    if ks_is("movups") == 1 { return ks_sse_mov(0x10, 0); }
    if ks_is("movapd") == 1 { return ks_sse_mov(0x28, 0x66); }
    if ks_is("movupd") == 1 { return ks_sse_mov(0x10, 0x66); }
    if ks_is("sqrtps") == 1 { return ks_sse_packed(0x51, 0); }
    if ks_is("sqrtpd") == 1 { return ks_sse_packed(0x51, 0x66); }
    if ks_is("movsd") == 1 { return ks_i_movsd(0xF2); }
    if ks_is("movss") == 1 { return ks_i_movsd(0xF3); }
    if ks_is("cvtss2sd") == 1 { return ks_sse_arith(0x5A, 0xF3); }
    if ks_is("cvtsd2ss") == 1 { return ks_sse_arith(0x5A, 0xF2); }
    if ks_is("addsd") == 1 { return ks_sse_arith(0x58, 0xF2); }
    if ks_is("subsd") == 1 { return ks_sse_arith(0x5C, 0xF2); }
    if ks_is("mulsd") == 1 { return ks_sse_arith(0x59, 0xF2); }
    if ks_is("divsd") == 1 { return ks_sse_arith(0x5E, 0xF2); }
    if ks_is("comisd") == 1 { return ks_sse_cmp(0x2F); }
    if ks_is("ucomisd") == 1 { return ks_sse_cmp(0x2E); }
    if ks_is("shl") == 1 { return ks_shift(4); }
    if ks_is("shr") == 1 { return ks_shift(5); }
    if ks_is("sar") == 1 { return ks_shift(7); }
    if ks_is("rol") == 1 { return ks_shift(0); }
    if ks_is("ror") == 1 { return ks_shift(1); }
    if ks_is("clflush") == 1 { return ks_cacheop(0xAE, 7); }
    if ks_is("prefetcht0") == 1 { return ks_cacheop(0x18, 1); }
    if ks_is("ja") == 1 { return ks_jcc(0x87); }
    if ks_is("jae") == 1 { return ks_jcc(0x83); }
    if ks_is("jb") == 1 { return ks_jcc(0x82); }
    if ks_is("jg") == 1 { return ks_jcc(0x8F); }
    if ks_is("jge") == 1 { return ks_jcc(0x8D); }
    if ks_is("jl") == 1 { return ks_jcc(0x8C); }
    if ks_is("jle") == 1 { return ks_jcc(0x8E); }
    if ks_is("js") == 1 { return ks_jcc(0x88); }
    if ks_is("and") == 1 { return ks_arith(0x21, 4); }
    if ks_is("or") == 1 { return ks_arith(0x09, 1); }
    if ks_is("not") == 1 { return ks_unary_f7(2); }
    if ks_is("rep") == 1 { return ks_i_rep(); }
    if ks_is("movsb") == 1 { return ks_emit_b(0xA4); }
    if ks_is("stosb") == 1 { return ks_emit_b(0xAA); }
    if ks_is("cvtsi2sd") == 1 { return ks_i_cvtsi(); }
    if ks_is("cvtsd2si") == 1 { return ks_sse_to_int(0x2D); }
    if ks_is("cvttsd2si") == 1 { return ks_sse_to_int(0x2C); }
    if ks_is("xorps") == 1 { return ks_i_xorps(); }
    if ks_is("movq") == 1 { return ks_i_movq(); }
    if ks_is("xchg") == 1 { return ks_i_xchg(); }
    // an unknown mnemonic, in pass two, is an error worth reporting
    return ks_unsupported();
}

// a known mnemonic with a form this assembler cannot encode: said, in pass
// two -- skipping it made binaries that looked fine and crashed
fn ks_unsupported() -> i64 {
    if kasm_pass != 2 {
        return 0;
    }
    return ks_err_record(en_r12, en_r14, 0);
}

fn ks_two(a: i64, b: i64) -> i64 {
    ks_emit_b(a);
    return ks_emit_b(b);
}

// -------------------------------------------------------------------------
// push / pop
// -------------------------------------------------------------------------

fn ks_i_push() -> i64 {
    var k: i64 = ks_parse_operand(&tok_b);
    var v: i64 = ks_lo(po_val);
    en_r12 = k;
    en_r14 = k;
    if ks_lo(k) == 5 {
        // push qword [rel label]: FF /6, no REX (a push is eight bytes)
        ks_emit_b(0xFF);
        return ks_emit_rip(6, v);
    }
    if ks_lo(k) != 1 {
        return ks_unsupported();
    }
    if v >= 8 {
        ks_emit_b(0x41);
    }
    return ks_emit_b(0x50 | (v & 7));
}

fn ks_i_pop() -> i64 {
    var k: i64 = ks_parse_operand(&tok_b);
    var v: i64 = ks_lo(po_val);
    en_r12 = k;
    en_r14 = k;
    if ks_lo(k) != 1 {
        return ks_unsupported();
    }
    if v >= 8 {
        ks_emit_b(0x41);
    }
    return ks_emit_b(0x58 | (v & 7));
}

// -------------------------------------------------------------------------
// add sub cmp and or xor test: one shape. op is the r/m form, dg the
// group-1 digit of the immediate form.
// -------------------------------------------------------------------------

var ar_kd: i64;
var ar_d: i64;
var ar_ks: i64;
var ar_s: i64;

// 'op reg, [mem]' takes the reversed opcode, two above the r/m form; test
// is symmetric
fn ks_rev_op(op: i64) -> i64 {
    if op == 0x85 {
        return op;
    }
    return (op + 2) & 255;
}

fn ks_arith(op: i64, dg: i64) -> i64 {
    var k: i64 = 0;
    ar_kd = ks_lo(ks_parse_operand(&tok_b));
    dst_base = po_r8;
    ar_d = ks_lo(po_val);
    en_r12 = ar_kd;
    dst_addend = cur_addend;
    ar_ks = ks_lo(ks_parse_operand(&tok_c));
    src_base = po_r8;
    ar_s = ks_lo(po_val);
    en_r14 = ar_ks;
    k = ar_kd;
    if k == 12 { return ks_arith_sib_imm(op, dg); }
    if k == 7 { return ks_arith_r8(op, dg); }
    if k == 8 { return ks_arith_r32(op, dg); }
    if k == 5 || k == 9 || k == 13 { return ks_arith_mem(op, dg); }
    if k != 1 {
        return ks_unsupported();
    }
    k = ar_ks;
    if k == 1 {
        ks_emit_rex(1, ar_s, ar_d);
        ks_emit_b(op);
        return ks_emit_modrm(3, ar_s, ar_d);
    }
    if k == 2 {
        if op == 0x85 {
            // test has no group-1 form: REX.W F7 /0 id
            ks_emit_rex(1, 0, ar_d);
            ks_emit_b(0xF7);
            ks_emit_modrm(3, 0, ar_d);
            return ks_emit_d(ar_s);
        }
        ks_emit_rex(1, 0, ar_d);
        return ks_arith_imm_tail(dg);
    }
    if k == 5 {
        ks_emit_rex(1, ar_d, 0);
        ks_emit_b(ks_rev_op(op));
        return ks_emit_rip(ar_d, ar_s);
    }
    if k == 9 {
        ks_emit_rex(1, ar_d, ar_s);
        ks_emit_b(ks_rev_op(op));
        return ks_emit_mem_reg(ar_d, ar_s);
    }
    if k == 13 {
        ks_emit_rex(1, ar_d, ks_lo(src_base));
        ks_emit_b(ks_rev_op(op));
        return ks_emit_mem_base_disp(ar_d, ks_lo(src_base), ar_s);
    }
    return ks_unsupported();
}

// 83 /n ib when the immediate is 0..127, else 81 /n id
fn ks_arith_imm_tail(dg: i64) -> i64 {
    if ar_s <= 127 {
        ks_emit_b(0x83);
        ks_emit_modrm(3, dg, ar_d);
        return ks_emit_b(ar_s);
    }
    ks_emit_b(0x81);
    ks_emit_modrm(3, dg, ar_d);
    return ks_emit_d(ar_s);
}

// a 32-bit destination: the same encodings without REX.W
fn ks_arith_r32(op: i64, dg: i64) -> i64 {
    var k: i64 = ar_ks;
    if k == 8 {
        ks_emit_rex(0, ar_s, ar_d);
        ks_emit_b(op);
        return ks_emit_modrm(3, ar_s, ar_d);
    }
    if k == 2 {
        if op == 0x85 {
            ks_emit_rex(0, 0, ar_d);
            ks_emit_b(0xF7);
            ks_emit_modrm(3, 0, ar_d);
            return ks_emit_d(ar_s);
        }
        ks_emit_rex(0, 0, ar_d);
        return ks_arith_imm_tail(dg);
    }
    if k == 12 {
        return ks_emit_sib_mem(ks_rev_op(op), ar_d, ar_s, 0);
    }
    if k == 9 {
        ks_emit_rex(0, ar_d, ar_s);
        ks_emit_b(ks_rev_op(op));
        return ks_emit_mem_reg(ar_d, ar_s);
    }
    if k == 13 {
        ks_emit_rex(0, ar_d, ks_lo(src_base));
        ks_emit_b(ks_rev_op(op));
        return ks_emit_mem_base_disp(ar_d, ks_lo(src_base), ar_s);
    }
    if k == 5 {
        ks_emit_rex(0, ar_d, 0);
        ks_emit_b(ks_rev_op(op));
        return ks_emit_rip(ar_d, ar_s);
    }
    return ks_unsupported();
}

// an 8-bit destination: the reversed 8-bit opcode is op + 1, the
// register-to-register one op - 1; spl/bpl/sil/dil need a REX byte
fn ks_arith_r8(op: i64, dg: i64) -> i64 {
    var k: i64 = ar_ks;
    var o: i64 = (op + 1) & 255;
    if ar_d >= 4 {
        rex8_force = 1;
    }
    if k == 12 {
        return ks_emit_sib_mem(o, ar_d, ar_s, 0);
    }
    if k == 9 {
        ks_emit_rex(0, ar_d, ar_s);
        ks_emit_b(o);
        return ks_emit_mem_reg(ar_d, ar_s);
    }
    if k == 7 {
        if ar_s >= 4 {
            rex8_force = 1;
        }
        ks_emit_rex(0, ar_s, ar_d);
        ks_emit_b((op - 1) & 255);
        return ks_emit_modrm(3, ar_s, ar_d);
    }
    if k == 5 {
        ks_emit_rex(0, ar_d, 0);
        ks_emit_b(o);
        return ks_emit_rip(ar_d, ar_s);
    }
    if k == 3 {
        ks_emit_rex(0, ar_d, 5);
        ks_emit_b(o);
        return ks_emit_mem_rbp(ar_d, ar_s);
    }
    if k == 13 {
        ks_emit_rex(0, ar_d, ks_lo(src_base));
        ks_emit_b(o);
        return ks_emit_mem_base_disp(ar_d, ks_lo(src_base), ar_s);
    }
    if k != 2 {
        return ks_unsupported();
    }
    // the prefix by hand: REX.B for r8b..r15b, a bare REX for spl..dil
    if ar_d >= 8 {
        ks_emit_b(0x41);
    } else if ar_d >= 4 {
        ks_emit_b(0x40);
    }
    if op == 0x85 {
        ks_emit_b(0xF6);                 // test r/m8, imm8: F6 /0
        ks_emit_modrm(3, 0, ar_d);
        return ks_emit_b(ar_s);
    }
    ks_emit_b(0x80);
    ks_emit_modrm(3, dg, ar_d);
    return ks_emit_b(ar_s);
}

// op byte [base + index*scale +- disp], imm8; test takes F6 /0
fn ks_arith_sib_imm(op: i64, dg: i64) -> i64 {
    var rex: i64 = 64;
    if ar_ks != 2 || op_size != 1 {
        return ks_unsupported();
    }
    if (((ar_d >>> 8) & 255) & 8) != 0 {
        rex = rex | 2;
    }
    if ((ar_d & 255) & 8) != 0 {
        rex = rex | 1;
    }
    if rex != 64 {
        ks_emit_b(rex);
    }
    if op == 0x85 {
        ks_emit_b(0xF6);
        dg = 0;
    } else {
        ks_emit_b(0x80);
    }
    ks_emit_sib_modrm(dg, ar_d);
    return ks_emit_b(ar_s);
}

// a memory destination ([rel x], [reg], [base-N]): 80 /n ib | 81 /n id
// (F6 / F7 /0 for test) for an immediate, the r/m opcode for a register
fn ks_arith_mem(op: i64, dg: i64) -> i64 {
    var k: i64 = ar_ks;
    var w: i64 = 1;
    var b: i64 = 0;
    if k == 1 || k == 8 {
        if k == 8 {
            w = 0;
        }
        b = ar_d;
        if ar_kd == 5 {
            b = 0;
        } else if ar_kd == 13 {
            b = ks_lo(dst_base);
        }
        ks_emit_rex(w, ar_s, b);
        ks_emit_b(op);
        if ar_kd == 5 {
            return ks_emit_rip(ar_s, ar_d);
        }
        if ar_kd == 13 {
            return ks_emit_mem_base_disp(ar_s, ks_lo(dst_base), ar_d);
        }
        return ks_emit_mem_reg(ar_s, ar_d);
    }
    if k != 2 {
        return ks_unsupported();
    }
    if op_size == 2 {
        ks_emit_b(0x66);                 // before any REX
    }
    w = 1;
    if op_size == 1 || op_size == 2 || op_size == 4 {
        w = 0;
    }
    b = ar_d;
    if ar_kd == 13 {
        b = ks_lo(dst_base);
    }
    if ar_kd == 5 {
        b = 0;
    }
    ks_emit_rex(w, 0, b);
    if op == 0x85 {
        if op_size == 1 {
            ks_emit_b(0xF6);
        } else {
            ks_emit_b(0xF7);
        }
    } else {
        if op_size == 1 {
            ks_emit_b(0x80);
        } else {
            ks_emit_b(0x81);
        }
    }
    if ar_kd == 5 {
        // the displacement counts to the end: the immediate after it is
        // taken off the destination's addend
        cur_addend = dst_addend;
        if op_size == 1 {
            cur_addend = cur_addend - 1;
        } else if op_size == 2 {
            cur_addend = cur_addend - 2;
        } else {
            cur_addend = cur_addend - 4;
        }
        ks_emit_rip(dg, ar_d);
    } else if ar_kd == 13 {
        ks_emit_mem_base_disp(dg, ks_lo(dst_base), ar_d);
    } else {
        ks_emit_mem_reg(dg, ar_d);
    }
    if op_size == 1 {
        return ks_emit_b(ar_s);
    }
    if op_size == 2 {
        return ks_emit_w(ar_s);
    }
    return ks_emit_d(ar_s);
}

// -------------------------------------------------------------------------
// imul, the F7 and FF groups, lea
// -------------------------------------------------------------------------

// imul reg, reg | imul reg, imm | imul reg, reg, imm
fn ks_i_imul() -> i64 {
    var kd: i64 = ks_lo(ks_parse_operand(&tok_b));
    var d: i64 = ks_lo(po_val);
    var p: i64 = &tok_c;
    var s: i64 = 0;
    var imm: i64 = 0;
    var ks: i64 = 0;
    var w: i64 = 0;
    en_r12 = kd;
    while ks_b(p) != 0 && ks_b(p) != 44 {
        p += 1;
    }
    if ks_b(p) == 44 {
        // three operands: the register cut out on its own, then the value
        // (an equ constant, say)
        ks_bs(p, 0);
        ks_parse_operand(&tok_c);
        s = ks_lo(po_val);
        ks_bs(p, 44);
        p += 1;
        while ks_b(p) == 32 {
            p += 1;
        }
        imm = ks_parse_expr(p);
        en_r14 = imm;
    } else {
        ks = ks_lo(ks_parse_operand(&tok_c));
        s = ks_lo(po_val);
        en_r14 = ks;
        if ks != 2 {
            if kd == 1 {
                w = 1;
            }
            ks_emit_rex(w, d, s);
            ks_emit_b(0x0F);
            ks_emit_b(0xAF);
            return ks_emit_modrm(3, d, s);
        }
        // imul reg, imm is imul reg, reg, imm
        imm = s;
        en_r14 = imm;
        s = d;
    }
    // REX.W only for a 64-bit destination
    if kd == 1 {
        w = 1;
    }
    ks_emit_rex(w, d, s);
    if ks_sx8(imm) == imm {
        ks_emit_b(0x6B);
        ks_emit_modrm(3, d, s);
        return ks_emit_b(imm);
    }
    ks_emit_b(0x69);
    ks_emit_modrm(3, d, s);
    return ks_emit_d(imm);
}

// the low byte, sign-extended
fn ks_sx8(v: i64) -> i64 {
    v = v & 255;
    if v >= 128 {
        return v - 256;
    }
    return v;
}

// mul div idiv neg not: F7 /dg on a 64- or 32-bit register
fn ks_unary_f7(dg: i64) -> i64 {
    var k: i64 = ks_lo(ks_parse_operand(&tok_b));
    var d: i64 = ks_lo(po_val);
    dst_base = po_r8;
    en_r12 = k;
    en_r14 = k;
    if k == 8 {
        ks_emit_rex(0, 0, d);
    } else if k == 1 {
        ks_emit_rex(1, 0, d);
    } else {
        return ks_unsupported();
    }
    ks_emit_b(0xF7);
    return ks_emit_modrm(3, dg, d);
}

// inc dec: FF /dg (FE for a byte), honouring byte/word/dword/qword in
// memory
fn ks_unary_ff(dg: i64) -> i64 {
    var k: i64 = ks_lo(ks_parse_operand(&tok_b));
    var d: i64 = ks_lo(po_val);
    var w: i64 = 1;
    dst_base = po_r8;
    en_r12 = k;
    en_r14 = k;
    if k == 5 || k == 13 {
        if op_size == 2 {
            ks_emit_b(0x66);
        }
        if op_size == 1 || op_size == 2 || op_size == 4 {
            w = 0;
        }
        if k == 5 {
            ks_emit_rex(w, 0, 0);
        } else {
            ks_emit_rex(w, 0, ks_lo(dst_base));
        }
        if op_size == 1 {
            ks_emit_b(0xFE);
        } else {
            ks_emit_b(0xFF);
        }
        if k == 5 {
            return ks_emit_rip(dg, d);
        }
        return ks_emit_mem_base_disp(dg, ks_lo(dst_base), d);
    }
    if k == 8 {
        ks_emit_rex(0, 0, d);
        ks_emit_b(0xFF);
        return ks_emit_modrm(3, dg, d);
    }
    if k == 7 {
        if d >= 4 {
            rex8_force = 1;
        }
        ks_emit_rex(0, 0, d);
        ks_emit_b(0xFE);
        return ks_emit_modrm(3, dg, d);
    }
    if k != 1 {
        return ks_unsupported();
    }
    ks_emit_rex(1, 0, d);
    ks_emit_b(0xFF);
    return ks_emit_modrm(3, dg, d);
}

fn ks_i_lea() -> i64 {
    var kd: i64 = ks_lo(ks_parse_operand(&tok_b));
    var d: i64 = ks_lo(po_val);
    var k: i64 = 0;
    var s: i64 = 0;
    en_r12 = kd;
    k = ks_lo(ks_parse_operand(&tok_c));
    s = ks_lo(po_val);
    en_r14 = k;
    src_base = po_r8;
    if k == 5 {
        ks_emit_rex(1, d, 0);
        ks_emit_b(0x8D);
        return ks_emit_rip(d, s);
    }
    if k == 11 {
        ks_emit_rex(1, d, 4);
        ks_emit_b(0x8D);
        return ks_emit_mem_base_disp(d, 4, 0 - s);
    }
    if k == 12 {
        return ks_emit_sib_mem(0x8D, d, s, 1);
    }
    if k == 9 {
        ks_emit_rex(1, d, s);
        ks_emit_b(0x8D);
        return ks_emit_mem_reg(d, s);
    }
    if k == 13 {
        ks_emit_rex(1, d, ks_lo(src_base));
        ks_emit_b(0x8D);
        return ks_emit_mem_base_disp(d, ks_lo(src_base), s);
    }
    if k != 3 {
        return ks_unsupported();
    }
    ks_emit_rex(1, d, 5);
    ks_emit_b(0x8D);
    return ks_emit_mem_rbp(d, s);
}

// -------------------------------------------------------------------------
// control flow
// -------------------------------------------------------------------------

// rep: the prefix, then the string operation left in tok_b
fn ks_i_rep() -> i64 {
    ks_emit_b(0xF3);
    if ks_str_eq(&tok_b, "movsb") == 1 {
        return ks_emit_b(0xA4);
    }
    if ks_str_eq(&tok_b, "stosb") == 1 {
        return ks_emit_b(0xAA);
    }
    return ks_unsupported();
}

// call reg: FF /2; call label: E8 rel32
fn ks_i_call() -> i64 {
    var k: i64 = ks_parse_operand(&tok_b);
    var v: i64 = ks_lo(po_val);
    if ks_lo(k) == 1 {
        ks_emit_rex(0, 0, v);
        ks_emit_b(0xFF);
        return ks_emit_modrm(3, 2, v);
    }
    ks_emit_b(0xE8);
    return ks_rel32_target();
}

fn ks_jcc(cc: i64) -> i64 {
    ks_emit_b(0x0F);
    ks_emit_b(cc);
    return ks_rel32_target();
}

// a label of the program (a fixup), else an external symbol (for the
// linker), else a label defined nowhere
fn ks_rel32_target() -> i64 {
    var k: i64 = ks_parse_operand(&tok_b);
    var v: i64 = ks_lo(po_val);
    var x: i64 = 0;
    if ks_lo(k) == 4 && v != 0xFFFFFFFF {
        ks_add_fixup(v, 0);              // 0: rel32
        return ks_emit_d(0);
    }
    x = ks_find_extern(&tok_b, ks_strlen(&tok_b));
    if x != -1 {
        ks_add_extref(x);
    } else {
        ks_unknown_label();
    }
    return ks_emit_d(0);
}

// setcc al: 0F <cc> C0
fn ks_setcc(cc: i64) -> i64 {
    ks_emit_b(0x0F);
    ks_emit_b(cc);
    return ks_emit_b(0xC0);
}

// -------------------------------------------------------------------------
// movzx and movsx
// -------------------------------------------------------------------------

var mz_kd: i64;
var mz_d: i64;
var mz_ks: i64;
var mz_s: i64;

// movsx r64, r8: REX.W 0F BE /r
fn ks_i_movsx() -> i64 {
    var d: i64 = 0;
    var k: i64 = 0;
    var s: i64 = 0;
    ks_parse_operand(&tok_b);
    d = ks_lo(po_val);
    k = ks_lo(ks_parse_operand(&tok_c));
    s = ks_lo(po_val);
    en_r14 = k;
    if k != 7 {
        return ks_unsupported();
    }
    ks_emit_rex(1, d, s);
    ks_emit_b(0x0F);
    ks_emit_b(0xBE);
    return ks_emit_modrm(3, d, s);
}

fn ks_i_movzx() -> i64 {
    var k: i64 = 0;
    mz_kd = ks_lo(ks_parse_operand(&tok_b));
    mz_d = ks_lo(po_val);
    en_r12 = mz_kd;
    mz_ks = ks_lo(ks_parse_operand(&tok_c));
    src_base = po_r8;
    mz_s = ks_lo(po_val);
    en_r14 = mz_ks;
    k = mz_ks;
    if k == 5 || k == 3 || k == 9 || k == 13 { return ks_movzx_mem(k); }
    if k == 12 { return ks_movzx_sib(); }
    if k == 7 || k == 10 {
        ks_emit_rex(1, mz_d, mz_s);
        ks_emit_b(0x0F);
        ks_emit_b(0xB6);
        return ks_emit_modrm(3, mz_d, mz_s);
    }
    return ks_unsupported();
}

// 0F B6 (a byte) or 0F B7 (a word); REX.W for a 64-bit destination. A
// dword source is a plain 32-bit load, as NASM assembles it.
fn ks_movzx_mem(k: i64) -> i64 {
    var w: i64 = 0;
    var rm: i64 = 0;
    if mz_kd == 1 {
        w = 1;
    }
    if op_size == 4 {
        return ks_mz32_load();
    }
    if k == 5 {
        rm = 0;
    } else if k == 3 {
        rm = 5;
    } else if k == 9 {
        rm = mz_s;
    } else {
        rm = ks_lo(src_base);
    }
    ks_emit_rex(w, mz_d, rm);
    ks_emit_b(0x0F);
    if op_size == 2 {
        ks_emit_b(0xB7);
    } else {
        ks_emit_b(0xB6);
    }
    if k == 5 {
        return ks_emit_rip(mz_d, mz_s);
    }
    if k == 3 {
        return ks_emit_mem_rbp(mz_d, mz_s);
    }
    if k == 9 {
        return ks_emit_mem_reg(mz_d, mz_s);
    }
    return ks_emit_mem_base_disp(mz_d, ks_lo(src_base), mz_s);
}

// [base+index*scale]: the REX byte by hand, before the 0F escape
fn ks_movzx_sib() -> i64 {
    var r: i64 = 0;
    if mz_kd == 1 {
        r = r | 8;
    }
    if (mz_d & 8) != 0 {
        r = r | 4;
    }
    if ((mz_s >>> 8) & 8) != 0 {
        r = r | 2;
    }
    if (mz_s & 8) != 0 {
        r = r | 1;
    }
    if r != 0 {
        ks_emit_b(r | 64);
    }
    if op_size == 4 {
        return ks_mz32_load();
    }
    ks_emit_b(0x0F);
    if op_size == 2 {
        ks_emit_b(0xB7);
    } else {
        ks_emit_b(0xB6);
    }
    return ks_emit_sib_modrm(mz_d, mz_s);
}

// movzx reg, dword [mem]: the 32-bit loads of mov
fn ks_mz32_load() -> i64 {
    var k: i64 = mz_ks;
    var d: i64 = mz_d;
    var s: i64 = mz_s;
    if k == 3 {
        ks_emit_rex(0, d, 5);
        ks_emit_b(0x8B);
        return ks_emit_mem_rbp(d, s);
    }
    if k == 9 {
        ks_emit_rex(0, d, s);
        ks_emit_b(0x8B);
        return ks_emit_mem_reg(d, s);
    }
    if k == 13 {
        ks_emit_rex(0, d, ks_lo(src_base));
        ks_emit_b(0x8B);
        return ks_emit_mem_base_disp(d, ks_lo(src_base), s);
    }
    if k == 12 {
        return ks_emit_sib_mem(0x8B, d, s, 0);
    }
    if k == 5 {
        ks_emit_rex(0, d, 0);
        ks_emit_b(0x8B);
        return ks_emit_rip(d, s);
    }
    return ks_unsupported();
}

// -------------------------------------------------------------------------
// SSE
// -------------------------------------------------------------------------

// two operands' values, the destination's and the source's
var ss_d: i64;
var ss_s: i64;

fn ks_sse_ops() -> i64 {
    ks_parse_operand(&tok_b);
    ss_d = ks_lo(po_val);
    ks_parse_operand(&tok_c);
    ss_s = ks_lo(po_val);
    return 0;
}

// ps (no prefix) / pd (66), register to register: 0F <op> /r
fn ks_sse_packed(op: i64, pfx: i64) -> i64 {
    ks_sse_ops();
    if pfx != 0 {
        ks_emit_b(pfx);
    }
    ks_sse_rex(ss_d, ss_s);
    ks_emit_b(0x0F);
    ks_emit_b(op);
    return ks_emit_modrm(3, ss_d, ss_s);
}

// F2 (or F3) 0F <op> /r on two xmm registers
fn ks_sse_arith(op: i64, pfx: i64) -> i64 {
    sse_pfx = pfx;
    ks_sse_ops();
    ks_emit_b(sse_pfx);
    ks_sse_rex(ss_d, ss_s);
    ks_emit_b(0x0F);
    ks_emit_b(op);
    return ks_emit_modrm(3, ss_d, ss_s);
}

// comisd / ucomisd: 66 0F 2F|2E /r
fn ks_sse_cmp(op: i64) -> i64 {
    ks_sse_ops();
    ks_emit_b(0x66);
    ks_sse_rex(ss_d, ss_s);
    ks_emit_b(0x0F);
    ks_emit_b(op);
    return ks_emit_modrm(3, ss_d, ss_s);
}

fn ks_i_xorps() -> i64 {
    ks_sse_ops();
    ks_sse_rex(ss_d, ss_s);
    ks_emit_b(0x0F);
    ks_emit_b(0x57);
    return ks_emit_modrm(3, ss_d, ss_s);
}

// cvtsi2sd xmm, r64: F2 REX.W 0F 2A /r
fn ks_i_cvtsi() -> i64 {
    ks_sse_ops();
    ks_emit_b(0xF2);
    ks_emit_rex(1, ss_d, ss_s);
    ks_emit_b(0x0F);
    ks_emit_b(0x2A);
    return ks_emit_modrm(3, ss_d, ss_s);
}

// cvtsd2si / cvttsd2si r64, xmm: F2 REX.W 0F 2D|2C /r
fn ks_sse_to_int(op: i64) -> i64 {
    ks_sse_ops();
    ks_emit_b(0xF2);
    ks_emit_rex(1, ss_d, ss_s);
    ks_emit_b(0x0F);
    ks_emit_b(op);
    return ks_emit_modrm(3, ss_d, ss_s);
}

// movq xmm, r64: 66 REX.W 0F 6E /r; movq r64, xmm: 66 REX.W 0F 7E /r with
// the xmm register in the reg field
fn ks_i_movq() -> i64 {
    var k: i64 = ks_lo(ks_parse_operand(&tok_b));
    var d: i64 = ks_lo(po_val);
    var s: i64 = 0;
    var t: i64 = 0;
    var op: i64 = 0x6E;
    en_r12 = k;
    ks_parse_operand(&tok_c);
    s = ks_lo(po_val);
    if k != 6 {
        op = 0x7E;
        t = d;
        d = s;
        s = t;
    }
    ks_emit_b(0x66);
    ks_emit_rex(1, d, s);
    ks_emit_b(0x0F);
    ks_emit_b(op);
    return ks_emit_modrm(3, d, s);
}

// movaps movups movapd movupd: a load (0F op), or a store (0F op+1)
fn ks_sse_mov(op: i64, pfx: i64) -> i64 {
    var kd: i64 = ks_lo(ks_parse_operand(&tok_b));
    var d: i64 = ks_lo(po_val);
    var k: i64 = 0;
    var s: i64 = 0;
    var rm: i64 = 0;
    en_r12 = kd;
    k = ks_lo(ks_parse_operand(&tok_c));
    s = ks_lo(po_val);
    en_r14 = k;
    if kd == 6 {
        if pfx != 0 {
            ks_emit_b(pfx);
        }
        if k == 6 || k == 9 {
            rm = s;
        }
        ks_sse_rex(d, rm);
        ks_emit_b(0x0F);
        ks_emit_b(op);
        if k == 6 {
            return ks_emit_modrm(3, d, s);
        }
        if k == 3 {
            return ks_emit_mem_rbp(d, s);
        }
        if k == 9 {
            return ks_emit_mem_reg(d, s);
        }
        return ks_unsupported();
    }
    op = (op + 1) & 255;
    if pfx != 0 {
        ks_emit_b(pfx);
    }
    if kd == 9 {
        rm = d;
    }
    ks_sse_rex(s, rm);
    ks_emit_b(0x0F);
    ks_emit_b(op);
    if kd == 3 {
        return ks_emit_mem_rbp(s, d);
    }
    if kd == 9 {
        return ks_emit_mem_reg(s, d);
    }
    return ks_unsupported();
}

// movsd / movss: F2|F3 0F 10 (a load) or 11 (a store)
fn ks_i_movsd(pfx: i64) -> i64 {
    var kd: i64 = 0;
    var d: i64 = 0;
    var k: i64 = 0;
    var s: i64 = 0;
    var rm: i64 = 0;
    sse_pfx = pfx;
    kd = ks_lo(ks_parse_operand(&tok_b));
    d = ks_lo(po_val);
    en_r12 = kd;
    k = ks_lo(ks_parse_operand(&tok_c));
    s = ks_lo(po_val);
    en_r14 = k;
    if kd != 6 {
        ks_emit_b(sse_pfx);
        if kd == 9 {
            rm = d;
        }
        ks_sse_rex(s, rm);
        ks_emit_b(0x0F);
        ks_emit_b(0x11);
        if kd == 3 {
            return ks_emit_mem_rbp(s, d);
        }
        if kd == 9 {
            return ks_emit_mem_reg(s, d);
        }
        if kd == 5 {
            return ks_emit_rip(s, d);
        }
        if kd == 12 {
            // r8..r15 would need a REX byte before the opcode
            if (d & 0x0808) != 0 {
                return ks_unsupported();
            }
            return ks_emit_sib_modrm(s, d);
        }
        return ks_unsupported();
    }
    ks_emit_b(sse_pfx);
    if k == 6 || k == 9 {
        rm = s;
    }
    ks_sse_rex(d, rm);
    ks_emit_b(0x0F);
    ks_emit_b(0x10);
    if k == 6 {
        return ks_emit_modrm(3, d, s);
    }
    if k == 3 {
        return ks_emit_mem_rbp(d, s);
    }
    if k == 9 {
        return ks_emit_mem_reg(d, s);
    }
    if k == 5 {
        return ks_emit_rip(d, s);
    }
    if k == 12 {
        if (s & 0x0808) != 0 {
            return ks_unsupported();
        }
        return ks_emit_sib_modrm(d, s);
    }
    return ks_unsupported();
}

// clflush [reg]: 0F AE /7; prefetcht0 [reg]: 0F 18 /1
fn ks_cacheop(op: i64, dg: i64) -> i64 {
    var k: i64 = ks_lo(ks_parse_operand(&tok_b));
    var d: i64 = ks_lo(po_val);
    if k != 9 {
        return ks_unsupported();
    }
    if d >= 8 {
        ks_emit_b(0x41);
    }
    ks_emit_b(0x0F);
    ks_emit_b(op);
    return ks_emit_mem_reg(dg, d);
}

// shl shr sar rol ror: REX.W D3 /n (by cl) | REX.W C1 /n ib; C0 /n ib for
// an 8-bit register
fn ks_shift(dg: i64) -> i64 {
    var kd: i64 = ks_lo(ks_parse_operand(&tok_b));
    var d: i64 = ks_lo(po_val);
    var k: i64 = 0;
    var s: i64 = 0;
    var w: i64 = 1;
    en_r12 = kd;
    k = ks_lo(ks_parse_operand(&tok_c));
    s = ks_lo(po_val);
    en_r14 = k;
    if kd == 7 {
        if k != 2 {
            return ks_unsupported();
        }
        if d >= 8 {
            ks_emit_b(0x41);
        } else if d >= 4 {
            ks_emit_b(0x40);
        }
        ks_emit_b(0xC0);
        ks_emit_modrm(3, dg, d);
        return ks_emit_b(s);
    }
    if kd == 8 {
        w = 0;
    } else if kd != 1 {
        return ks_unsupported();
    }
    if k == 7 {
        if s != 1 {
            return ks_unsupported();     // only cl counts
        }
        ks_emit_rex(w, 0, d);
        ks_emit_b(0xD3);
        return ks_emit_modrm(3, dg, d);
    }
    if k != 2 {
        return ks_unsupported();
    }
    ks_emit_rex(w, 0, d);
    ks_emit_b(0xC1);
    ks_emit_modrm(3, dg, d);
    return ks_emit_b(s);
}
