fn xa_tail_lib() -> i64 {
    return "\nsection .text\n; __centry: where C enters a function a Kron library exports, in the AAPCS64\n; convention. x9 (r11) = the export's record (dq function, shape, widths,\n; signed); the integers in x0-x7, the reals in d0-d7, each in order, the rest\n; on the caller's stack. They go in a row, in the order of the parameters,\n; to __lib_enter (Kron code, x86-64's convention lowered): until it moves to\n; this thread's Kron stack, x28 points into the C stack, and sp 64 KB under\n; it. C keeps x19-x29 and d8-d15; Kron uses some of them, so all are kept.\n__centry:\n    stp x29, x30, [sp, #-16]!\n    stp x27, x28, [sp, #-16]!\n    stp x25, x26, [sp, #-16]!\n    stp x23, x24, [sp, #-16]!\n    stp x21, x22, [sp, #-16]!\n    stp x19, x20, [sp, #-16]!\n    stp d8, d9, [sp, #-16]!\n    stp d10, d11, [sp, #-16]!\n    stp d12, d13, [sp, #-16]!\n    stp d14, d15, [sp, #-16]!\n    mov x19, sp\n    sub sp, sp, #256\n    mov x10, sp\n    stp x0, x1, [x10]\n    stp x2, x3, [x10, #16]\n    stp x4, x5, [x10, #32]\n    stp x6, x7, [x10, #48]\n    stp d0, d1, [x10, #64]\n    stp d2, d3, [x10, #80]\n    stp d4, d5, [x10, #96]\n    stp d6, d7, [x10, #112]\n    ldr x11, [x9, #8]\n    and x12, x11, #255\n    mov x13, #0\n    mov x14, #0\n    mov x15, #0\n    add x16, x19, #160\n    mov x17, #0\n.ce_arg:\n    cmp x13, x12\n    b.hs .ce_go\n    add x3, x13, #8\n    lsr x3, x11, x3\n    and x3, x3, #1\n    cbz x3, .ce_int\n    cmp x15, #8\n    b.hs .ce_stk\n    add x3, x10, #64\n    ldr x4, [x3, x15, lsl #3]\n    add x15, x15, #1\n    b .ce_put\n.ce_int:\n    cmp x14, #8\n    b.hs .ce_stk\n    ldr x4, [x10, x14, lsl #3]\n    add x14, x14, #1\n    b .ce_put\n.ce_stk:\n    ldr x4, [x16, x17]\n    add x17, x17, #8\n.ce_put:\n    add x3, x10, #128\n    str x4, [x3, x13, lsl #3]\n    add x13, x13, #1\n    b .ce_arg\n.ce_go:\n    sub x28, x10, #16\n    mov x3, #65536\n    sub x3, x28, x3\n    mov sp, x3\n    mov x1, x9\n    add x2, x10, #128\n    str x30, [x28, #-8]!\n    bl __lib_enter\n    ldr x30, [x28], #8\n    mov sp, x19\n    ldp d14, d15, [sp], #16\n    ldp d12, d13, [sp], #16\n    ldp d10, d11, [sp], #16\n    ldp d8, d9, [sp], #16\n    ldp x19, x20, [sp], #16\n    ldp x21, x22, [sp], #16\n    ldp x23, x24, [sp], #16\n    ldp x25, x26, [sp], #16\n    ldp x27, x28, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n";
}

fn xa_tail_lib_mac() -> i64 {
    return "\nsection .text\n; __centry: where C enters a function a Kron library exports, in the AAPCS64\n; convention. x9 (r11) = the export's record (dq function, shape, widths,\n; signed); the integers in x0-x7, the reals in d0-d7, each in order, the rest\n; on the caller's stack, packed by width as Apple's convention has it. They go in a row, in the order of the parameters,\n; to __lib_enter (Kron code, x86-64's convention lowered): until it moves to\n; this thread's Kron stack, x28 points into the C stack, and sp 64 KB under\n; it. C keeps x19-x29 and d8-d15; Kron uses some of them, so all are kept.\n__centry:\n    stp x29, x30, [sp, #-16]!\n    stp x27, x28, [sp, #-16]!\n    stp x25, x26, [sp, #-16]!\n    stp x23, x24, [sp, #-16]!\n    stp x21, x22, [sp, #-16]!\n    stp x19, x20, [sp, #-16]!\n    stp d8, d9, [sp, #-16]!\n    stp d10, d11, [sp, #-16]!\n    stp d12, d13, [sp, #-16]!\n    stp d14, d15, [sp, #-16]!\n    mov x19, sp\n    sub sp, sp, #256\n    mov x10, sp\n    stp x0, x1, [x10]\n    stp x2, x3, [x10, #16]\n    stp x4, x5, [x10, #32]\n    stp x6, x7, [x10, #48]\n    stp d0, d1, [x10, #64]\n    stp d2, d3, [x10, #80]\n    stp d4, d5, [x10, #96]\n    stp d6, d7, [x10, #112]\n    ldr x11, [x9, #8]\n    and x12, x11, #255\n    mov x13, #0\n    mov x14, #0\n    mov x15, #0\n    add x16, x19, #160\n    mov x17, #0\n.ce_arg:\n    cmp x13, x12\n    b.hs .ce_go\n    add x3, x13, #8\n    lsr x3, x11, x3\n    and x3, x3, #1\n    cbz x3, .ce_int\n    cmp x15, #8\n    b.hs .ce_stk\n    add x3, x10, #64\n    ldr x4, [x3, x15, lsl #3]\n    add x15, x15, #1\n    b .ce_put\n.ce_int:\n    cmp x14, #8\n    b.hs .ce_stk\n    ldr x4, [x10, x14, lsl #3]\n    add x14, x14, #1\n    b .ce_put\n.ce_stk:\n    ldr x5, [x9, #16]\n    lsl x3, x13, #1\n    lsr x5, x5, x3\n    and x5, x5, #3\n    cbz x5, .ce_s8\n    cmp x5, #1\n    b.eq .ce_s4\n    cmp x5, #2\n    b.eq .ce_s2\n    ldrb w4, [x16, x17]\n    add x17, x17, #1\n    b .ce_put\n.ce_s2:\n    add x17, x17, #1\n    and x17, x17, #0xfffffffffffffffe\n    ldrh w4, [x16, x17]\n    add x17, x17, #2\n    b .ce_put\n.ce_s4:\n    add x17, x17, #3\n    and x17, x17, #0xfffffffffffffffc\n    ldr w4, [x16, x17]\n    add x17, x17, #4\n    b .ce_put\n.ce_s8:\n    add x17, x17, #7\n    and x17, x17, #0xfffffffffffffff8\n    ldr x4, [x16, x17]\n    add x17, x17, #8\n.ce_put:\n    add x3, x10, #128\n    str x4, [x3, x13, lsl #3]\n    add x13, x13, #1\n    b .ce_arg\n.ce_go:\n    sub x28, x10, #16\n    mov x3, #65536\n    sub x3, x28, x3\n    mov sp, x3\n    mov x1, x9\n    add x2, x10, #128\n    str x30, [x28, #-8]!\n    bl __lib_enter\n    ldr x30, [x28], #8\n    mov sp, x19\n    ldp d14, d15, [sp], #16\n    ldp d12, d13, [sp], #16\n    ldp d10, d11, [sp], #16\n    ldp d8, d9, [sp], #16\n    ldp x19, x20, [sp], #16\n    ldp x21, x22, [sp], #16\n    ldp x23, x24, [sp], #16\n    ldp x25, x26, [sp], #16\n    ldp x27, x28, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n";
}

fn xa_get_tail(k: i64) -> i64 {
    if k == 1 {
        return xa_tail_mac();
    }
    if k == 2 {
        return xa_tail_lib();
    }
    if k == 3 {
        return xa_tail_lib_mac();
    }
    return xa_tail();
}
