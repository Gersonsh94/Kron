kron_program
kron_domain test_exp_lit;
kron_imports
kron_definitions

// Reals written with an exponent: 1.5e3, 2e-3, 1e300.
//
// Expected output:
//   1500.000000
//   0.002000
//   1.000000e+300
//   -250000.000000
//   1000000.000000      2e6 / 2

fn main() {
    print(1.5e3);
    print(2e-3);
    var big: f64 = 1e300;
    print(big);
    print(0.0 - 2.5E+5);
    var half: f64 = 2e6 / 2.0;
    print(half);
    return 0;
}
