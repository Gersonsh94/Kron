kron_program
kron_domain web_host;
kron_imports
kron_definitions

// =========================================================================
// web_host.kr -- the host of the web target, from web/kron_web.js.
// Written by web/make_host.kr: change the script and run it, not this.
//
//   ww_host_js()        the script, as one text
//   ww_host_js_size()   its length in bytes
// =========================================================================

fn ww_host_js_size() -> i64 {
    return 68728;
}

fn ww_host_js() -> i64 {
    return "// =============================================================================\n// kron_web.js -- the host of a Kron program compiled with --target=web.\n//\n// The program is the Linux program, lowered to WebAssembly: everything it\n// asks of the system goes through one import, env.syscall, with the Linux\n// x86-64 numbers. This file answers those calls -- files, time, memory,\n// threads, output -- the way Linux would, and adds its own from 1000 up:\n// the window std_window draws in, which here is a <canvas>.\n//\n// One file, four roles:\n//   node          node kron_web.js prog.wasm: console programs, files\n//                 on the real disk, threads as worker threads (the tests)\n//   page          <script src=\"kron_web.js\"> then KronWeb.start({...}); the\n//                 page draws the pictures and sends the keyboard and mouse\n//   worker        the program runs in a worker, so its loop may block and\n//                 sleep; each of its threads is one more worker, with its own\n//                 instance of the module over the one shared memory\n//   service       a service worker that adds the two headers shared memory\n//                 needs (COOP, COEP) when the server does not send them\n//\n// 3D (std_gpu.kr, calls from 1200): the page draws with WebGPU. The program\n// sends it its shaders (WGSL, from std_shader.kr), meshes and pictures once,\n// then each frame's draws in one message; the page draws them on a canvas\n// laid over the window's.\n//\n// Files, in a browser, are folders and files in memory: they start empty and\n// go away with the page. Each thread has its own descriptors: a file one\n// thread opened is not open in the others.\n// =============================================================================\n'use strict';\n\n(function () {\n\nconst IS_NODE = typeof process !== 'undefined' && process.versions && process.versions.node &&\n                typeof window === 'undefined' && typeof importScripts === 'undefined';\nconst IS_SERVICE = typeof ServiceWorkerGlobalScope !== 'undefined' &&\n                   typeof self !== 'undefined' && self instanceof ServiceWorkerGlobalScope;\nconst IS_WORKER = !IS_SERVICE && typeof importScripts === 'function' && typeof window === 'undefined';\nconst IS_PAGE = typeof window !== 'undefined' && typeof document !== 'undefined';\n\n// errno values the library looks at\nconst ENOENT = 2, EBADF = 9, ECHILD = 10, EAGAIN = 11, ENOMEM = 12, EACCES = 13,\n      EEXIST = 17, ENOTDIR = 20, EISDIR = 21, EINVAL = 22, ENOTTY = 25,\n      ENOSYS = 38, ENOTEMPTY = 39;\n\n// the events the page sends (shared ring, 8 ints each)\nconst EV_KEY_DOWN = 1, EV_KEY_UP = 2, EV_MOVE = 3, EV_DOWN = 4, EV_UP = 5,\n      EV_WHEEL = 6, EV_CLOSE = 7, EV_CHAR = 8, EV_DELTA = 9, EV_TOUCH = 10;\nconst PAD_INTS = 4 * 32;            // four gamepads: 16 buttons, 6 axes (x 10000)\nconst RING_SLOTS = 1024;            // events\nconst RING_INTS = 8;\nconst CTL_INTS = 16;                // head, tail, wake, clip length ...\nconst CLIP_BYTES = 65536;\nconst SAB_BYTES = (CTL_INTS + RING_SLOTS * RING_INTS) * 4 + CLIP_BYTES + PAD_INTS * 4;\n\nclass KronExit {\n  constructor(code, all) { this.code = code; this.all = all; }\n}\n\n// words of the shared memory the hosts of all threads use (below .data)\nconst BRK_WORD = 64;                // the heap's end, in 64 KB pages\nconst TID_WORD = 65;                // the last thread id given\n\n// the memory the module imports: where its flags are, its least and most\nfunction memoryImport(bytes) {\n  let p = 8;\n  const uleb = () => { let r = 0, s = 0, b; do { b = bytes[p++]; r += (b & 0x7F) * 2 ** s; s += 7; } while (b & 0x80); return r; };\n  while (p < bytes.length) {\n    const id = bytes[p++], size = uleb();\n    const end = p + size;\n    if (id === 2) {\n      let n = uleb();\n      while (n-- > 0) {\n        for (let i = 0; i < 2; i++) { const len = uleb(); p += len; }   // module, name\n        const kind = bytes[p++];\n        if (kind === 0) uleb();\n        else if (kind === 1) { p++; const f = bytes[p++]; uleb(); if (f & 1) uleb(); }\n        else if (kind === 3) p += 2;\n        else if (kind === 2) {\n          const at = p, f = bytes[p++], min = uleb(), max = (f & 1) ? uleb() : 65536;\n          return { at, shared: (f & 2) !== 0, min, max };\n        }\n      }\n      return null;\n    }\n    p = end;\n  }\n  return null;\n}\n\n// a memory for the module: shared when the platform has it (threads need\n// it), as large as the module allows and the platform grants\nfunction makeMemory(bytes) {\n  const mi = memoryImport(bytes);\n  if (!mi) throw new Error('not a Kron module: it imports no memory');\n  const canShare = typeof SharedArrayBuffer !== 'undefined';\n  if (mi.shared && !canShare) bytes[mi.at] &= ~2;     // run without threads\n  const shared = mi.shared && canShare;\n  for (const max of [mi.max, 32768, 16384, 8192, 4096]) {\n    if (max > mi.max || max < mi.min) continue;\n    try { return { memory: new WebAssembly.Memory({ initial: mi.min, maximum: max, shared }), shared }; }\n    catch (e) { /* ask for less */ }\n  }\n  throw new Error('no memory for the program: it needs ' + (mi.min * 64) + ' KB');\n}\n\n// ---------------------------------------------------------------------------\n// FILES. On node, the real disk; in a browser, folders and files in memory\n// (they start empty and go away with the page).\n// ---------------------------------------------------------------------------\nclass MemFS {\n  constructor() { this.files = new Map(); this.dirs = new Set(['/']); this.cwd = '/'; }\n  abs(p) {\n    if (!p.startsWith('/')) p = (this.cwd.endsWith('/') ? this.cwd : this.cwd + '/') + p;\n    const out = [];\n    for (const part of p.split('/')) {\n      if (part === '' || part === '.') continue;\n      if (part === '..') out.pop(); else out.push(part);\n    }\n    return '/' + out.join('/');\n  }\n  parent(p) { const i = p.lastIndexOf('/'); return i <= 0 ? '/' : p.slice(0, i); }\n  isDir(p) { return this.dirs.has(this.abs(p)); }\n  isFile(p) { return this.files.has(this.abs(p)); }\n  exists(p) { return this.isDir(p) || this.isFile(p); }\n  read(p) { return this.files.get(this.abs(p)); }\n  write(p, data) {\n    const a = this.abs(p);\n    if (!this.dirs.has(this.parent(a))) return -ENOENT;\n    this.files.set(a, data);\n    return 0;\n  }\n  mkdir(p) {\n    const a = this.abs(p);\n    if (this.exists(a)) return -EEXIST;\n    if (!this.dirs.has(this.parent(a))) return -ENOENT;\n    this.dirs.add(a);\n    return 0;\n  }\n  rmdir(p) {\n    const a = this.abs(p);\n    if (!this.dirs.has(a)) return -ENOENT;\n    for (const k of this.files.keys()) if (k.startsWith(a + '/')) return -ENOTEMPTY;\n    for (const k of this.dirs) if (k.startsWith(a + '/')) return -ENOTEMPTY;\n    this.dirs.delete(a);\n    return 0;\n  }\n  unlink(p) { const a = this.abs(p); if (!this.files.has(a)) return -ENOENT; this.files.delete(a); return 0; }\n  rename(a, b) {\n    a = this.abs(a); b = this.abs(b);\n    if (this.files.has(a)) { this.files.set(b, this.files.get(a)); this.files.delete(a); return 0; }\n    return -ENOENT;\n  }\n  list(p) {\n    const a = this.abs(p), pre = a === '/' ? '/' : a + '/', names = new Set();\n    for (const k of this.files.keys()) if (k.startsWith(pre) && !k.slice(pre.length).includes('/')) names.add([k.slice(pre.length), 8]);\n    for (const k of this.dirs) if (k !== a && k.startsWith(pre) && !k.slice(pre.length).includes('/')) names.add([k.slice(pre.length), 4]);\n    return [...names];\n  }\n}\n\n// ---------------------------------------------------------------------------\n// THE MACHINE: one instance of the module and the system around it\n// ---------------------------------------------------------------------------\nclass Kron {\n  constructor(opts) {\n    this.out = opts.out;                 // (fd, Uint8Array) -> void\n    this.spawn = opts.spawn || null;     // starts a thread: { module, memory, stack, ctid, tid }\n    this.freed = new Map();              // released mappings, by length\n    this.debug = !!opts.debug;           // a call the host could not answer, to the console\n    this.shared = opts.shared || null;   // { ctl: Int32Array, ring: Int32Array, clip: Uint8Array }\n    this.hasWindow = !!opts.hasWindow;   // the page has a canvas for window_open\n    this.post = opts.post || null;       // messages to the page: (message, transfer)\n    this.fs = IS_NODE ? null : new MemFS();\n    this.fds = new Map();                // fd -> { path, pos, data, dir, nodefd }\n    this.nextFd = 3;\n    this.decoder = new TextDecoder();\n    this.encoder = new TextEncoder();\n    this.sleeper = (typeof SharedArrayBuffer !== 'undefined') ? new Int32Array(new SharedArrayBuffer(4)) : null;\n    if (IS_NODE) this.nodefs = require('fs');\n  }\n\n  // the program: compile, make its memory, instantiate\n  async load(bytes) {\n    bytes = new Uint8Array(bytes);\n    const { memory, shared } = makeMemory(bytes);\n    this.module = await WebAssembly.compile(bytes);\n    await this.attach(this.module, memory, shared);\n    const heap = Number(this.inst.exports.kron_heap.value);\n    Atomics.store(this.i32(), BRK_WORD, heap / 65536);\n    Atomics.store(this.i32(), TID_WORD, 1);\n  }\n\n  // one more thread of a program: the same module, the same memory\n  async attach(module, memory, shared) {\n    this.module = module;\n    this.mem = memory;\n    this.sharedMem = shared;\n    const env = { syscall: (n, a, b, c, d, e, f) => this.syscall(n, a, b, c, d, e, f), memory };\n    this.inst = await WebAssembly.instantiate(module, { env });\n  }\n\n  // a thread's life: kron_thread runs the function; then, as Linux does for\n  // CLONE_CHILD_CLEARTID, its id word goes to 0 and whoever waits is woken\n  runThread(stack, ctid) {\n    let code = 0, all = false;\n    try {\n      this.inst.exports.kron_thread(BigInt(stack));\n    } catch (e) {\n      if (e instanceof KronExit) { code = e.code; all = e.all; }\n      else {\n        this.out(2, this.encoder.encode('kron_web: thread: ' + (e && e.stack ? e.stack : e) + '\\n'));\n        code = 70; all = true;\n      }\n    }\n    const i32 = this.i32();\n    Atomics.store(i32, ctid >>> 2, 0);\n    Atomics.notify(i32, ctid >>> 2);\n    return { code, all };\n  }\n\n  run() {\n    try {\n      this.inst.exports.kron_start();\n      return 0;\n    } catch (e) {\n      if (e instanceof KronExit) return e.code;\n      throw e;\n    }\n  }\n\n  // views on memory, fresh after any growth\n  u8() { return new Uint8Array(this.mem.buffer); }\n  dv() { return new DataView(this.mem.buffer); }\n  i32() { return new Int32Array(this.mem.buffer); }\n  cstr(p) {\n    const m = this.u8(); let e = p;\n    while (m[e] !== 0) e++;\n    return this.decoder.decode(m.slice(p, e));      // a copy: shared memory cannot be decoded\n  }\n  put64(p, v) { this.dv().setBigInt64(p, BigInt(v), true); }\n  put32(p, v) { this.dv().setInt32(p, v, true); }\n\n  // anonymous memory past the stack, as mmap gives it\n  // the end of the heap is a word of the memory, so all threads move it\n  map(len) {\n    len = Math.ceil(len / 65536) * 65536;\n    const again = this.freed.get(len);\n    if (again && again.length) {\n      const p = again.pop();\n      this.u8().fill(0, p, p + len);\n      return p;\n    }\n    const i32 = this.i32(), pages = len / 65536;\n    let old;\n    for (;;) {\n      old = Atomics.load(i32, BRK_WORD);\n      if (Atomics.compareExchange(i32, BRK_WORD, old, old + pages) === old) break;\n    }\n    const p = old * 65536, need = p + len;\n    while (this.mem.buffer.byteLength < need) {\n      const have = this.mem.buffer.byteLength;\n      try { this.mem.grow(Math.ceil((need - have) / 65536)); }\n      catch (e) { if (this.mem.buffer.byteLength < need) return -ENOMEM; }\n    }\n    return p;\n  }\n\n  unmap(p, len) {\n    len = Math.ceil(len / 65536) * 65536;\n    if (!this.freed.has(len)) this.freed.set(len, []);\n    this.freed.get(len).push(p);\n    return 0;\n  }\n\n  sleep(ms) {\n    if (ms <= 0) return;\n    if (this.shared) { Atomics.wait(this.shared.ctl, 4, 0, ms); return; }\n    if (this.sleeper) { Atomics.wait(this.sleeper, 0, 0, ms); return; }\n    const end = Date.now() + ms; while (Date.now() < end) { /* no way to wait */ }\n  }\n\n  now() { return (typeof performance !== 'undefined' ? performance.timeOrigin + performance.now() : Date.now()); }\n\n  // ---- the system calls -------------------------------------------------\n  syscall(nb, a, b, c, d, e, f) {\n    const n = Number(nb);\n    const A = Number(a), B = Number(b), C = Number(c), D = Number(d);\n    let r;\n    try {\n      r = this.call(n, A, B, C, D, Number(e), Number(f), a);\n    } catch (err) {\n      if (err instanceof KronExit) throw err;\n      if (typeof console !== \"undefined\" && this.debug) console.error(\"syscall \" + n + \": \" + err);\n      r = -EINVAL;\n    }\n    return BigInt(r);\n  }\n\n  call(n, a, b, c, d, e, f, abig) {\n    switch (n) {\n      case 0: return this.read(a, b, c, -1);                     // read\n      case 1: return this.write(a, b, c, -1);                    // write\n      case 2: return this.open(this.cstr(a), b);                 // open\n      case 257: return this.open(this.cstr(b), c);               // openat\n      case 3: return this.close(a);                              // close\n      case 4: case 6: return this.stat(this.cstr(a), b);         // stat, lstat\n      case 5: return this.fstat(a, b);                           // fstat\n      case 8: return this.lseek(a, abig === undefined ? b : b, c); // lseek\n      case 9: return this.map(b);                                // mmap\n      case 11: return this.unmap(a, b);                          // munmap\n      case 12: return -ENOMEM;                                   // brk\n      case 13: case 14: return 0;                                // signals\n      case 16: return -ENOTTY;                                   // ioctl\n      case 17: return this.read(a, b, c, d);                     // pread64\n      case 18: return this.write(a, b, c, d);                    // pwrite64\n      case 21: return this.exists(this.cstr(a)) ? 0 : -ENOENT;   // access\n      case 24: return 0;                                         // sched_yield\n      case 35: {                                                 // nanosleep\n        const dv = this.dv();\n        const s = Number(dv.getBigInt64(a, true)), ns = Number(dv.getBigInt64(a + 8, true));\n        this.sleep(s * 1000 + Math.floor(ns / 1e6));\n        return 0;\n      }\n      case 39: return 1;                                         // getpid\n      case 186: return this.tid || 1;                            // gettid\n      case 56: return this.clone(a, b, c, d);                    // clone: a thread\n      case 57: case 58: case 59: return -ENOSYS;                 // fork vfork execve\n      case 60: throw new KronExit(a | 0, !this.tid);             // exit: this thread\n      case 231: throw new KronExit(a | 0, true);                 // exit_group: all\n      case 61: return -ECHILD;                                   // wait4\n      case 72: return 0;                                         // fcntl\n      case 79: {                                                 // getcwd\n        const cwd = this.encoder.encode((IS_NODE ? process.cwd() : this.fs.cwd) + '\\0');\n        if (cwd.length > b) return -34;\n        this.u8().set(cwd, a);\n        return cwd.length;\n      }\n      case 80: return this.chdir(this.cstr(a));                  // chdir\n      case 82: return this.rename(this.cstr(a), this.cstr(b));   // rename\n      case 83: return this.mkdir(this.cstr(a));                  // mkdir\n      case 84: return this.rmdir(this.cstr(a));                  // rmdir\n      case 87: return this.unlink(this.cstr(a));                 // unlink\n      case 89: return -EINVAL;                                   // readlink\n      case 90: return 0;                                         // chmod\n      case 96: {                                                 // gettimeofday\n        const t = this.now();\n        this.put64(a, Math.floor(t / 1000)); this.put64(a + 8, Math.floor((t % 1000) * 1000));\n        return 0;\n      }\n      case 97: this.put64(b, 0x800000); this.put64(b + 8, 0x800000); return 0; // getrlimit\n      case 202: return this.futex(a, b, c, d);                   // futex\n      case 204: if (b > 0) { this.u8().fill(0, c, c + b); this.u8()[c] = 1; } return 8; // affinity\n      case 217: return this.getdents(a, b, c);                   // getdents64\n      case 228: {                                                // clock_gettime\n        let t;\n        if (a === 1 || a === 4) t = (typeof performance !== 'undefined') ? performance.now() : Date.now();\n        else t = this.now();\n        const sec = Math.floor(t / 1000), ns = Math.floor((t - sec * 1000) * 1e6);\n        this.put64(b, sec); this.put64(b + 8, ns);\n        return 0;\n      }\n      case 318: {                                                // getrandom\n        const buf = new Uint8Array(b);\n        if (typeof crypto !== 'undefined' && crypto.getRandomValues) {\n          for (let i = 0; i < b; i += 65536) crypto.getRandomValues(buf.subarray(i, Math.min(b, i + 65536)));\n        } else for (let i = 0; i < b; i++) buf[i] = Math.random() * 256;\n        this.u8().set(buf, a);\n        return b;\n      }\n      // ---- the browser's own ----------------------------------------------\n      case 1100: return 2;                                       // the system: the web\n      case 1000: return this.hasWindow ? 1 : -ENOSYS;            // is there a window\n      case 1001: return this.winOpen(a, b, c);                   // open: w, h, title\n      case 1002: return this.winPresent(a, b, c);                // picture, w, h\n      case 1003: return this.winEvent(a);                        // next event into a\n      case 1005: return this.clipSet(a, b);                      // clipboard: set\n      case 1006: return this.clipGet(a, b);                      // and get\n      case 1007: return this.winClose();\n      case 1008: if (this.post) this.post({ kind: 'pointer-lock', on: a }); return 1;\n      case 1009: return this.padState(a, b);                     // a gamepad: index, into b\n      // ---- 3D: WebGPU, drawn by the page (std_gpu.kr) -----------------------\n      case 1200: return this.gpuOpen(a, b);\n      case 1201: return this.gpuProgram(a, b, c, d, e, f);\n      case 1202: return this.gpuMesh(a, b, c, d);\n      case 1203: return this.gpuTexture(a, b, c);\n      case 1204: return this.gpuBegin(a, b);\n      case 1205: return this.gpuDraw(a, b, c, d, e, f);\n      case 1206: return this.gpuEnd();\n      case 1207: return this.gpuClose();\n      case 1208: return this.gpuInstNew(a);\n      case 1209: return this.gpuInstWrite(a, b, c, d);\n      case 1210: return this.gpuInstFree(a);\n      case 1211: return this.gpuTarget(a, b, c);\n      case 1212: return this.gpuCompute(a, b, c);\n      case 1213: return this.gpuRun(a, b, c, d, e);\n      // ---- sound: WebAudio, played by the page (std_audio.kr) ---------------\n      case 1210: return this.audioOpen(a);\n      case 1211: return this.audioWrite(a, b);\n      case 1212: return this.audioQueued();\n      case 1213: if (this.post) this.post({ kind: 'audio-close' }); return 0;\n      default: return -ENOSYS;\n    }\n  }\n\n  // ---- threads ------------------------------------------------------------\n  clone(flags, stack, ptid, ctid) {\n    if (!this.sharedMem || !this.spawn) return -EAGAIN;\n    const i32 = this.i32();\n    const tid = Atomics.add(i32, TID_WORD, 1) + 1;\n    if (flags & 0x100000) Atomics.store(i32, ptid >>> 2, tid);     // CLONE_PARENT_SETTID\n    try {\n      this.spawn({ module: this.module, memory: this.mem, stack, ctid, tid });\n    } catch (e) {\n      if (flags & 0x100000) Atomics.store(i32, ptid >>> 2, 0);\n      return -EAGAIN;\n    }\n    return tid;\n  }\n\n  futex(addr, op, val, timeout) {\n    op &= 127;\n    if (!this.sharedMem) return op === 0 ? -EAGAIN : 0;\n    const i32 = this.i32();\n    if (op === 0) {\n      let ms = Infinity;\n      if (timeout) {\n        const dv = this.dv();\n        ms = Number(dv.getBigInt64(timeout, true)) * 1000 + Number(dv.getBigInt64(timeout + 8, true)) / 1e6;\n      }\n      const r = Atomics.wait(i32, addr >>> 2, val | 0, ms);\n      return r === 'not-equal' ? -EAGAIN : (r === 'timed-out' ? -110 : 0);\n    }\n    if (op === 1) return Atomics.notify(i32, addr >>> 2, val);\n    return -ENOSYS;\n  }\n\n  // ---- files --------------------------------------------------------------\n  exists(path) {\n    if (IS_NODE) return this.nodefs.existsSync(path);\n    return this.fs.exists(path);\n  }\n\n  open(path, flags) {\n    const acc = flags & 3, creat = flags & 0x40, trunc = flags & 0x200,\n          append = flags & 0x400, excl = flags & 0x80, wantDir = flags & 0x10000;\n    const fd = this.nextFd++;\n    if (IS_NODE) {\n      const fs = this.nodefs;\n      try {\n        const st = fs.existsSync(path) ? fs.statSync(path) : null;\n        if (st && st.isDirectory()) {\n          if (acc !== 0) return -EISDIR;\n          this.fds.set(fd, { dir: fs.readdirSync(path, { withFileTypes: true }).map(x => [x.name, x.isDirectory() ? 4 : 8]), dpos: 0 });\n          return fd;\n        }\n        if (wantDir) return st ? -ENOTDIR : -ENOENT;\n        if (!st && !creat) return -ENOENT;\n        if (st && creat && excl) return -EEXIST;\n        let fl = acc === 0 ? 'r' : (acc === 1 ? 'w' : 'r+');\n        if (acc !== 0 && !st) fl = acc === 1 ? 'w' : 'w+';\n        else if (acc !== 0 && trunc) fl = acc === 1 ? 'w' : 'w+';\n        else if (acc === 1 && st) fl = 'r+';\n        const nfd = fs.openSync(path, fl);\n        this.fds.set(fd, { nodefd: nfd, pos: 0, append: !!append });\n        return fd;\n      } catch (e) {\n        return e.code === 'ENOENT' ? -ENOENT : (e.code === 'EACCES' ? -EACCES : -EINVAL);\n      }\n    }\n    const m = this.fs;\n    if (m.isDir(path)) {\n      if (acc !== 0) return -EISDIR;\n      this.fds.set(fd, { dir: m.list(path), dpos: 0 });\n      return fd;\n    }\n    if (wantDir) return m.isFile(path) ? -ENOTDIR : -ENOENT;\n    let data = m.read(path);\n    if (!data) {\n      if (!creat) return -ENOENT;\n      data = new Uint8Array(0);\n      const r = m.write(path, data);\n      if (r < 0) return r;\n    } else if (creat && excl) return -EEXIST;\n    if (trunc && acc !== 0) { data = new Uint8Array(0); m.write(path, data); }\n    this.fds.set(fd, { path: m.abs(path), pos: 0, append: !!append });\n    return fd;\n  }\n\n  close(fd) {\n    if (fd <= 2) return 0;\n    const f = this.fds.get(fd);\n    if (!f) return -EBADF;\n    if (IS_NODE && f.nodefd !== undefined) this.nodefs.closeSync(f.nodefd);\n    this.fds.delete(fd);\n    return 0;\n  }\n\n  size(f) {\n    if (IS_NODE) return this.nodefs.fstatSync(f.nodefd).size;\n    return this.fs.read(f.path).length;\n  }\n\n  read(fd, p, n, at) {\n    if (fd === 0) {\n      if (IS_NODE) {\n        const buf = Buffer.alloc(n);\n        let got = 0;\n        try { got = this.nodefs.readSync(0, buf, 0, n, null); } catch (e) { got = 0; }\n        this.u8().set(buf.subarray(0, got), p);\n        return got;\n      }\n      return 0;\n    }\n    const f = this.fds.get(fd);\n    if (!f || f.dir) return -EBADF;\n    const pos = at >= 0 ? at : f.pos;\n    let got;\n    if (IS_NODE) {\n      const buf = Buffer.alloc(n);\n      got = this.nodefs.readSync(f.nodefd, buf, 0, n, pos);\n      this.u8().set(buf.subarray(0, got), p);\n    } else {\n      const data = this.fs.read(f.path) || new Uint8Array(0);\n      const part = data.subarray(Math.min(pos, data.length), Math.min(pos + n, data.length));\n      this.u8().set(part, p);\n      got = part.length;\n    }\n    if (at < 0) f.pos = pos + got;\n    return got;\n  }\n\n  write(fd, p, n, at) {\n    const bytes = this.u8().slice(p, p + n);\n    if (fd === 1 || fd === 2) { this.out(fd, bytes); return n; }\n    const f = this.fds.get(fd);\n    if (!f || f.dir) return -EBADF;\n    let pos = at >= 0 ? at : (f.append ? this.size(f) : f.pos);\n    if (IS_NODE) {\n      this.nodefs.writeSync(f.nodefd, bytes, 0, n, pos);\n    } else {\n      const old = this.fs.read(f.path) || new Uint8Array(0);\n      const len = Math.max(old.length, pos + n);\n      const data = new Uint8Array(len);\n      data.set(old);\n      data.set(bytes, pos);\n      this.fs.files.set(f.path, data);\n    }\n    if (at < 0) f.pos = pos + n;\n    return n;\n  }\n\n  lseek(fd, off, whence) {\n    const f = this.fds.get(fd);\n    if (!f || f.dir) return -EBADF;\n    let base = 0;\n    if (whence === 1) base = f.pos;\n    else if (whence === 2) base = this.size(f);\n    const pos = base + off;\n    if (pos < 0) return -EINVAL;\n    f.pos = pos;\n    return pos;\n  }\n\n  fillStat(p, isDir, size) {\n    this.u8().fill(0, p, p + 144);\n    const dv = this.dv();\n    dv.setUint32(p + 24, isDir ? 0o40755 : 0o100644, true);\n    dv.setBigInt64(p + 16, 1n, true);\n    dv.setBigInt64(p + 48, BigInt(size), true);\n    dv.setBigInt64(p + 56, 4096n, true);\n    return 0;\n  }\n  stat(path, p) {\n    if (IS_NODE) {\n      try { const st = this.nodefs.statSync(path); return this.fillStat(p, st.isDirectory(), st.size); }\n      catch (e) { return -ENOENT; }\n    }\n    if (this.fs.isDir(path)) return this.fillStat(p, true, 0);\n    const d = this.fs.read(path);\n    if (!d) return -ENOENT;\n    return this.fillStat(p, false, d.length);\n  }\n  fstat(fd, p) {\n    if (fd <= 2) return this.fillStat(p, false, 0);\n    const f = this.fds.get(fd);\n    if (!f) return -EBADF;\n    if (f.dir) return this.fillStat(p, true, 0);\n    return this.fillStat(p, false, this.size(f));\n  }\n\n  getdents(fd, p, cap) {\n    const f = this.fds.get(fd);\n    if (!f || !f.dir) return -EBADF;\n    const m = this.u8(), dv = this.dv();\n    let used = 0;\n    const all = [['.', 4], ['..', 4], ...f.dir];\n    while (f.dpos < all.length) {\n      const [name, type] = all[f.dpos];\n      const nb = this.encoder.encode(name);\n      const reclen = (19 + nb.length + 1 + 7) & ~7;\n      if (used + reclen > cap) break;\n      const q = p + used;\n      m.fill(0, q, q + reclen);\n      dv.setBigUint64(q, BigInt(f.dpos + 1), true);\n      dv.setBigInt64(q + 8, BigInt(f.dpos + 1), true);\n      dv.setUint16(q + 16, reclen, true);\n      m[q + 18] = type;\n      m.set(nb, q + 19);\n      used += reclen;\n      f.dpos++;\n    }\n    return used;\n  }\n\n  chdir(path) {\n    if (IS_NODE) { try { process.chdir(path); return 0; } catch (e) { return -ENOENT; } }\n    if (!this.fs.isDir(path)) return -ENOENT;\n    this.fs.cwd = this.fs.abs(path);\n    return 0;\n  }\n  rename(a, b) {\n    if (IS_NODE) { try { this.nodefs.renameSync(a, b); return 0; } catch (e) { return -ENOENT; } }\n    return this.fs.rename(a, b);\n  }\n  mkdir(path) {\n    if (IS_NODE) {\n      try { this.nodefs.mkdirSync(path); return 0; }\n      catch (e) { return e.code === 'EEXIST' ? -EEXIST : -ENOENT; }\n    }\n    return this.fs.mkdir(path);\n  }\n  rmdir(path) {\n    if (IS_NODE) {\n      try { this.nodefs.rmdirSync(path); return 0; }\n      catch (e) { return e.code === 'ENOTEMPTY' ? -ENOTEMPTY : -ENOENT; }\n    }\n    return this.fs.rmdir(path);\n  }\n  unlink(path) {\n    if (IS_NODE) { try { this.nodefs.unlinkSync(path); return 0; } catch (e) { return -ENOENT; } }\n    return this.fs.unlink(path);\n  }\n\n  // ---- the window: the page's canvas ------------------------------------\n  // The page draws: a worker that loops without returning to its event loop\n  // never shows a canvas of its own, so each picture goes to the page as a\n  // message, and while the page has not drawn the last one, the next waits.\n  winOpen(w, h, title) {\n    if (!this.hasWindow) return -ENOSYS;\n    this.win = { w, h };\n    if (this.shared) Atomics.store(this.shared.ctl, 5, 0);\n    this.post({ kind: 'open', w, h, title: title ? this.cstr(title) : '' });\n    return 1;\n  }\n  winPresent(fb, w, h) {\n    if (!this.win) return 0;\n    if (this.shared && Atomics.load(this.shared.ctl, 5) !== 0) return 1;   // a frame is waiting\n    const src = new Uint32Array(this.mem.buffer, fb, w * h);\n    const data = new Uint8ClampedArray(w * h * 4);\n    const dst = new Uint32Array(data.buffer);\n    // 0x00RRGGBB in memory; the canvas wants R, G, B, A bytes\n    for (let i = 0; i < src.length; i++) {\n      const v = src[i];\n      dst[i] = 0xFF000000 | ((v & 0xFF) << 16) | (v & 0xFF00) | ((v >>> 16) & 0xFF);\n    }\n    if (this.shared) Atomics.store(this.shared.ctl, 5, 1);\n    this.post({ kind: 'frame', w, h, data }, [data.buffer]);\n    return 1;\n  }\n  winEvent(p) {\n    if (!this.shared) return 0;\n    const ctl = this.shared.ctl, ring = this.shared.ring;\n    const head = Atomics.load(ctl, 0), tail = Atomics.load(ctl, 1);\n    if (head === tail) return 0;\n    const at = (head % RING_SLOTS) * RING_INTS;\n    const dv = this.dv();\n    for (let i = 0; i < 6; i++) dv.setBigInt64(p + i * 8, BigInt(ring[at + i]), true);\n    Atomics.store(ctl, 0, head + 1);\n    return 1;\n  }\n  clipSet(p, n) {\n    const text = this.decoder.decode(this.u8().slice(p, p + n));\n    if (this.post) this.post({ kind: 'clip', text });\n    if (this.shared) {\n      const bytes = this.encoder.encode(text).subarray(0, CLIP_BYTES);\n      this.shared.clip.set(bytes);\n      Atomics.store(this.shared.ctl, 3, bytes.length);\n    }\n    return n;\n  }\n  clipGet(p, cap) {\n    if (!this.shared) return 0;\n    const n = Math.min(Atomics.load(this.shared.ctl, 3), cap);\n    this.u8().set(this.shared.clip.subarray(0, n), p);\n    return n;\n  }\n  winClose() {\n    if (this.post) this.post({ kind: 'close' });\n    this.win = null;\n    return 0;\n  }\n\n  // ---- 3D: messages to the page, which draws with WebGPU ------------------\n  // Under node there is no page: with KRON_GPU_RECORD=file the messages go\n  // to that file instead, one JSON line each, for a test to replay.\n  gpuSend(m, transfer) {\n    if (IS_NODE) {\n      const enc = {};\n      for (const k in m) enc[k] = (m[k] instanceof Uint8Array) ? { b64: Buffer.from(m[k]).toString('base64') } : m[k];\n      this.nodefs.appendFileSync(process.env.KRON_GPU_RECORD, JSON.stringify(enc) + '\\n');\n      return;\n    }\n    this.post(m, transfer || []);\n  }\n  bytes(p, n) { return this.u8().slice(p, p + n); }\n  gpuOpen(w, h) {\n    this.gpuIds = 0;\n    if (IS_NODE) {\n      if (!process.env.KRON_GPU_RECORD) return -ENOSYS;\n      this.nodefs.writeFileSync(process.env.KRON_GPU_RECORD, '');\n      this.gpuSend({ kind: 'gpu-open', w, h });\n      return 1;\n    }\n    if (!this.post || !this.hasWindow) return -ENOSYS;\n    if (!this.shared) { this.gpuSend({ kind: 'gpu-open', w, h }); return 1; }\n    const ctl = this.shared.ctl;\n    Atomics.store(ctl, 6, 0);\n    Atomics.store(ctl, 7, 0);\n    this.gpuSend({ kind: 'gpu-open', w, h });\n    Atomics.wait(ctl, 6, 0, 20000);                  // the page answers: 1 or -1\n    return Atomics.load(ctl, 6) > 0 ? 1 : -ENOSYS;\n  }\n  gpuProgram(src, n, fmts, nin, usize, flags) {\n    const wgsl = this.decoder.decode(this.bytes(src, n));\n    const dv = this.dv(), comps = [];\n    for (let i = 0; i < nin; i++) comps.push(Number(dv.getBigInt64(fmts + i * 8, true)));\n    const id = ++this.gpuIds;\n    this.gpuSend({ kind: 'gpu-prog', id, wgsl, comps, usize, flags });\n    return id;\n  }\n  gpuMesh(vp, vn, ip, inn) {\n    const id = ++this.gpuIds;\n    const v = this.bytes(vp, vn), i = this.bytes(ip, inn);\n    this.gpuSend({ kind: 'gpu-mesh', id, v, i }, IS_NODE ? [] : [v.buffer, i.buffer]);\n    return id;\n  }\n  gpuTexture(p, w, h) {\n    const id = ++this.gpuIds;\n    const data = this.bytes(p, w * h * 4);\n    this.gpuSend({ kind: 'gpu-tex', id, w, h, data }, IS_NODE ? [] : [data.buffer]);\n    return id;\n  }\n  // a frame, or with target a render target's pass (gpuTarget's number)\n  gpuBegin(p, target) {\n    const dv = this.dv();\n    const clear = [0, 1, 2, 3].map(i => dv.getFloat32(p + i * 4, true));\n    this.gpuFrame = { clear, draws: [], u: [], target: target || 0 };\n    return 1;\n  }\n  // tp: the four textures, then the instance buffer (0 none) and how many,\n  // then for an indirect draw the indices' buffer (0 the mesh's) and the\n  // counts' (0 for a plain draw)\n  gpuDraw(pipe, mesh, count, up, usize, tp) {\n    if (!this.gpuFrame) return 0;\n    const dv = this.dv();\n    const tex = [0, 1, 2, 3].map(i => Number(dv.getBigInt64(tp + i * 8, true)));\n    const inst = Number(dv.getBigInt64(tp + 32, true)), ninst = Number(dv.getBigInt64(tp + 40, true));\n    const ind = Number(dv.getBigInt64(tp + 48, true)), args = Number(dv.getBigInt64(tp + 56, true));\n    this.gpuFrame.draws.push({ pipe, mesh, count, tex, inst, ninst, ind, args, u: this.gpuFrame.u.length, usize });\n    this.gpuFrame.u.push(usize > 0 ? this.bytes(up, usize) : new Uint8Array(0));\n    return 1;\n  }\n  gpuEnd() {\n    const f = this.gpuFrame;\n    if (!f) return 0;\n    this.gpuFrame = null;\n    // one frame on its way at a time: wait for the page to draw the last\n    // (a target's pass goes on ahead: the frame after it waits)\n    if (this.shared && !IS_NODE && !f.target) {\n      const ctl = this.shared.ctl;\n      if (Atomics.load(ctl, 7) !== 0) Atomics.wait(ctl, 7, 1, 250);\n      Atomics.store(ctl, 7, 1);\n    }\n    if (IS_NODE) {\n      f.u = f.u.map(b => Buffer.from(b).toString('base64'));\n      this.gpuSend({ kind: 'gpu-frame', frame: f });\n      return 1;\n    }\n    this.gpuSend({ kind: 'gpu-frame', frame: f });\n    return 1;\n  }\n  gpuClose() {\n    this.gpuSend({ kind: 'gpu-close' });\n    return 1;\n  }\n  // instance buffers: the program keeps the values, and sends them again\n  // when it changed them, before the frame that draws them\n  gpuInstNew(size) {\n    const id = ++this.gpuIds;\n    this.gpuSend({ kind: 'gpu-inst-new', id, size });\n    return id;\n  }\n  gpuInstWrite(id, p, n, at) {\n    const data = this.bytes(p, n);\n    this.gpuSend({ kind: 'gpu-inst', id, data, at: at || 0 }, IS_NODE ? [] : [data.buffer]);\n    return 1;\n  }\n  // compute shaders: made once, run between frames on instance buffers\n  // nbuf: the buffers, and the textures above bit 8\n  gpuCompute(src, n, nbuf) {\n    const wgsl = this.decoder.decode(this.bytes(src, n));\n    const id = ++this.gpuIds;\n    this.gpuSend({ kind: 'gpu-cprog', id, wgsl, nbuf: nbuf & 255, ntex: (nbuf >> 8) & 255 });\n    return id;\n  }\n  // bp: the four buffers, then the four textures\n  gpuRun(pipe, count, up, usize, bp) {\n    const dv = this.dv();\n    const bufs = [0, 1, 2, 3].map(i => Number(dv.getBigInt64(bp + i * 8, true)));\n    const tex = [4, 5, 6, 7].map(i => Number(dv.getBigInt64(bp + i * 8, true)));\n    const u = this.bytes(up, usize);\n    this.gpuSend({ kind: 'gpu-run', pipe, count, u, bufs, tex }, IS_NODE ? [] : [u.buffer]);\n    return 1;\n  }\n  gpuInstFree(id) {\n    this.gpuSend({ kind: 'gpu-inst-free', id });\n    return 1;\n  }\n  // a render target: its colours are textures id, id + 1 .., its depth the\n  // one after them; kind: (hdr << 2) | (colours - 1)\n  gpuTarget(w, h, kind) {\n    const ncol = ((kind || 0) & 3) + 1;\n    const id = this.gpuIds + 1;\n    this.gpuIds += ncol + 1;\n    this.gpuSend({ kind: 'gpu-target', id, w, h, tkind: kind || 0 });\n    return id;\n  }\n\n  // ---- gamepads: what the page read last, 23 values from index b ---------\n  padState(i, p) {\n    if (!this.shared || !this.shared.pads || i < 0 || i > 3) return 0;\n    const dv = this.dv(), src = this.shared.pads;\n    for (let k = 0; k < 23; k++) dv.setBigInt64(p + k * 8, BigInt(Atomics.load(src, i * 32 + k)), true);\n    return src[i * 32];\n  }\n\n  // ---- sound: stereo 16-bit frames to the page, which schedules them ------\n  audioOpen(rate) {\n    if (IS_NODE || !this.post || !this.hasWindow) return -ENOSYS;\n    this.auRate = rate;\n    this.auStart = this.now();\n    this.auWritten = 0;\n    this.post({ kind: 'audio-open', rate });\n    return 1;\n  }\n  audioWrite(p, frames) {\n    const data = new Int16Array(this.bytes(p, frames * 4).buffer);\n    this.auWritten += frames;\n    this.post({ kind: 'audio', data }, [data.buffer]);\n    return frames;\n  }\n  audioQueued() {\n    // what was sent and has not been played yet, by the clock\n    const played = (this.now() - this.auStart) * this.auRate / 1000;\n    if (played > this.auWritten) { this.auStart = this.now(); this.auWritten = 0; return 0; }\n    return Math.floor(this.auWritten - played);\n  }\n}\n\n// =============================================================================\n// KronGPU: what the page does with those messages -- WebGPU itself. A test\n// under node gives it a WebGPU of its own (the 'webgpu' package) and reads\n// the frame back with readPixels.\n// =============================================================================\nclass KronGPU {\n  constructor(gpu) {\n    this.gpu = gpu;\n    this.pipes = new Map();\n    this.meshes = new Map();\n    this.texs = new Map();\n    this.insts = new Map();\n    this.targets = new Map();\n    this.ubuf = null;\n    this.ubufSize = 0;\n  }\n  async open(w, h, canvas) {\n    if (!this.gpu) return false;\n    const adapter = await this.gpu.requestAdapter();\n    if (!adapter) return false;\n    // a target's depth is read as a texture of floats, filtered when the\n    // card can (float32-filterable), else at half precision\n    this.f32f = adapter.features.has('float32-filterable');\n    this.device = await adapter.requestDevice({ requiredFeatures: this.f32f ? ['float32-filterable'] : [] });\n    this.w = w; this.h = h;\n    if (canvas) {\n      this.ctx = canvas.getContext('webgpu');\n      this.format = this.gpu.getPreferredCanvasFormat();\n      this.ctx.configure({ device: this.device, format: this.format, alphaMode: 'opaque' });\n    } else {\n      this.format = 'bgra8unorm';\n      this.target = this.device.createTexture({ size: [w, h], format: this.format,\n        usage: GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.COPY_SRC });\n    }\n    this.depth = this.device.createTexture({ size: [w, h], format: 'depth24plus',\n      usage: GPUTextureUsage.RENDER_ATTACHMENT });\n    this.sampler = this.device.createSampler({ magFilter: 'linear', minFilter: 'linear',\n      addressModeU: 'repeat', addressModeV: 'repeat' });\n    return true;\n  }\n  program(m) {\n    const d = this.device;\n    const module = d.createShaderModule({ code: m.wgsl });\n    const ntex = (m.wgsl.match(/var t\\d+: texture_2d/g) || []).length;\n    const g0 = d.createBindGroupLayout({ entries: m.usize > 0 ? [{ binding: 0,\n      visibility: GPUShaderStage.VERTEX | GPUShaderStage.FRAGMENT,\n      buffer: { type: 'uniform', hasDynamicOffset: true } }] : [] });\n    const e1 = [];\n    const vf = GPUShaderStage.VERTEX | GPUShaderStage.FRAGMENT;\n    for (let k = 0; k < ntex; k++) {\n      e1.push({ binding: 2 * k, visibility: vf, texture: {} });\n      e1.push({ binding: 2 * k + 1, visibility: vf, sampler: {} });\n    }\n    const g1 = d.createBindGroupLayout({ entries: e1 });\n    const fmt = ['', 'float32', 'float32x2', 'float32x3', 'float32x4'];\n    // the corners' inputs from buffer 0; the last ninst, the instances',\n    // from buffer 1, once an instance\n    const ninst = (m.flags >> 8) & 255, nv = m.comps.length - ninst;\n    let off = 0, ioff = 0;\n    const attributes = [], iattributes = [];\n    m.comps.forEach((c, i) => {\n      if (i < nv) { attributes.push({ shaderLocation: i, offset: off, format: fmt[c] }); off += c * 4; }\n      else { iattributes.push({ shaderLocation: i, offset: ioff, format: fmt[c] }); ioff += c * 4; }\n    });\n    const buffers = attributes.length ? [{ arrayStride: off, attributes }] : [];\n    if (iattributes.length) buffers.push({ arrayStride: ioff, stepMode: 'instance', attributes: iattributes });\n    const blend = (m.flags & 4) ? { color: { srcFactor: 'src-alpha', dstFactor: 'one-minus-src-alpha' },\n                                     alpha: { srcFactor: 'one', dstFactor: 'one-minus-src-alpha' } } : undefined;\n    // the colours it writes, of the format of its kind\n    const kind = (m.flags >> 16) & 7, fmt8 = (kind & 4) ? 'rgba16float' : this.format;\n    const targets = [];\n    for (let c = 0; c <= (kind & 3); c++) targets.push({ format: fmt8, blend });\n    const pipe = d.createRenderPipeline({\n      layout: d.createPipelineLayout({ bindGroupLayouts: [g0, g1] }),\n      vertex: { module, entryPoint: 'vs_main', buffers },\n      fragment: { module, entryPoint: 'fs_main', targets },\n      primitive: { topology: 'triangle-list', cullMode: (m.flags & 1) ? 'back' : 'none', frontFace: 'ccw' },\n      depthStencil: { format: 'depth24plus', depthWriteEnabled: !!(m.flags & 2),\n                      depthCompare: (m.flags & 2) ? 'less' : 'always' }\n    });\n    this.pipes.set(m.id, { pipe, g0, g1, ntex, usize: m.usize, groups: new Map() });\n  }\n  mesh(m) {\n    const d = this.device;\n    const mk = (bytes, usage) => {\n      const b = d.createBuffer({ size: (bytes.length + 3) & ~3, usage: usage | GPUBufferUsage.COPY_DST });\n      d.queue.writeBuffer(b, 0, bytes.buffer, bytes.byteOffset, (bytes.length + 3) & ~3);\n      return b;\n    };\n    this.meshes.set(m.id, { v: mk(m.v, GPUBufferUsage.VERTEX), i: mk(m.i, GPUBufferUsage.INDEX) });\n  }\n  texture(m) {\n    const t = this.device.createTexture({ size: [m.w, m.h], format: 'bgra8unorm',\n      usage: GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST });\n    this.device.queue.writeTexture({ texture: t }, m.data, { bytesPerRow: m.w * 4 }, [m.w, m.h]);\n    this.texs.set(m.id, t.createView());\n  }\n  instNew(m) {\n    this.insts.set(m.id, { buf: this.device.createBuffer({ size: Math.max(16, (m.size + 3) & ~3),\n      usage: GPUBufferUsage.VERTEX | GPUBufferUsage.STORAGE | GPUBufferUsage.INDEX |\n             GPUBufferUsage.INDIRECT | GPUBufferUsage.COPY_DST }) });\n  }\n  inst(m) {\n    const b = this.insts.get(m.id);\n    if (b && m.data.length >= 4) this.device.queue.writeBuffer(b.buf, m.at || 0, m.data.buffer, m.data.byteOffset, m.data.length & ~3);\n  }\n  computeProgram(m) {\n    const d = this.device;\n    const module = d.createShaderModule({ code: m.wgsl });\n    const g0 = d.createBindGroupLayout({ entries: [{ binding: 0, visibility: GPUShaderStage.COMPUTE,\n      buffer: { type: 'uniform' } }] });\n    const e1 = [];\n    for (let k = 0; k < m.nbuf; k++) e1.push({ binding: k, visibility: GPUShaderStage.COMPUTE, buffer: { type: 'storage' } });\n    const g1 = d.createBindGroupLayout({ entries: e1 });\n    // the textures, in group 2: each with its sampler\n    const ntex = m.ntex || 0, e2 = [];\n    for (let k = 0; k < ntex; k++) {\n      e2.push({ binding: 2 * k, visibility: GPUShaderStage.COMPUTE, texture: {} });\n      e2.push({ binding: 2 * k + 1, visibility: GPUShaderStage.COMPUTE, sampler: {} });\n    }\n    const layouts = [g0, g1];\n    let g2 = null;\n    if (ntex > 0) { g2 = d.createBindGroupLayout({ entries: e2 }); layouts.push(g2); }\n    const pipe = d.createComputePipeline({ layout: d.createPipelineLayout({ bindGroupLayouts: layouts }),\n      compute: { module, entryPoint: 'cs_main' } });\n    this.pipes.set(m.id, { cpipe: pipe, g0, g1, g2, ntex, nbuf: m.nbuf });\n  }\n  // a run: its uniforms in a buffer of their own, 64 items a group\n  run(m) {\n    const d = this.device, p = this.pipes.get(m.pipe);\n    if (!p) return;\n    const size = Math.max(16, (m.u.length + 15) & ~15);\n    const ub = d.createBuffer({ size, usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST });\n    const staging = new Uint8Array(size);\n    staging.set(m.u);\n    d.queue.writeBuffer(ub, 0, staging);\n    const entries = [];\n    for (let k = 0; k < p.nbuf; k++) {\n      const b = this.insts.get(m.bufs[k]);\n      if (!b) { ub.destroy(); return; }\n      entries.push({ binding: k, resource: { buffer: b.buf } });\n    }\n    const enc = d.createCommandEncoder();\n    const pass = enc.beginComputePass();\n    pass.setPipeline(p.cpipe);\n    pass.setBindGroup(0, d.createBindGroup({ layout: p.g0, entries: [{ binding: 0, resource: { buffer: ub } }] }));\n    pass.setBindGroup(1, d.createBindGroup({ layout: p.g1, entries }));\n    if (p.g2) {\n      const e2 = [];\n      for (let k = 0; k < p.ntex; k++) {\n        const t = this.texs.get(m.tex[k]);\n        if (!t) { pass.end(); ub.destroy(); return; }\n        e2.push({ binding: 2 * k, resource: t });\n        e2.push({ binding: 2 * k + 1, resource: this.sampler });\n      }\n      pass.setBindGroup(2, d.createBindGroup({ layout: p.g2, entries: e2 }));\n    }\n    pass.dispatchWorkgroups(Math.ceil(m.count / 64));\n    pass.end();\n    d.queue.submit([enc.finish()]);\n  }\n  instFree(m) {\n    const b = this.insts.get(m.id);\n    if (b) { b.buf.destroy(); this.insts.delete(m.id); }\n  }\n  // a render target: colour in the frame's format (the programs' pipelines\n  // draw into it), depth as the frame's, and the depth copied after each\n  // pass into a texture of floats a shader can sample, as Vulkan's\n  makeTarget(m) {\n    const d = this.device;\n    // its colours: as many as its kind says, 8 bits or 16-bit floats\n    const tkind = m.tkind || 0, ncol = (tkind & 3) + 1;\n    const cfmt = (tkind & 4) ? 'rgba16float' : this.format;\n    const cols = [];\n    for (let c = 0; c < ncol; c++) cols.push(d.createTexture({ size: [m.w, m.h], format: cfmt,\n      usage: GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.TEXTURE_BINDING }));\n    const col = cols[0];\n    const dep = d.createTexture({ size: [m.w, m.h], format: 'depth24plus',\n      usage: GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.TEXTURE_BINDING });\n    const dfmt = this.f32f ? 'r32float' : 'r16float';\n    const dcopy = d.createTexture({ size: [m.w, m.h], format: dfmt,\n      usage: GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_SRC });\n    if (!this.dpipe) {\n      const module = d.createShaderModule({ code:\n        '@group(0) @binding(0) var dt: texture_depth_2d;\\n' +\n        '@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {\\n' +\n        '    var p = array<vec2<f32>, 3>(vec2<f32>(-1.0, -1.0), vec2<f32>(3.0, -1.0), vec2<f32>(-1.0, 3.0));\\n' +\n        '    return vec4<f32>(p[i], 0.0, 1.0);\\n}\\n' +\n        '@fragment fn fs(@builtin(position) q: vec4<f32>) -> @location(0) vec4<f32> {\\n' +\n        '    return vec4<f32>(textureLoad(dt, vec2<i32>(q.xy), 0), 0.0, 0.0, 1.0);\\n}\\n' });\n      this.dpipe = d.createRenderPipeline({ layout: 'auto', vertex: { module, entryPoint: 'vs' },\n        fragment: { module, entryPoint: 'fs', targets: [{ format: dfmt }] },\n        primitive: { topology: 'triangle-list' } });\n    }\n    const dgroup = d.createBindGroup({ layout: this.dpipe.getBindGroupLayout(0),\n      entries: [{ binding: 0, resource: dep.createView() }] });\n    this.targets.set(m.id, { col, cview: col.createView(), cviews: cols.map(c => c.createView()),\n                             dview: dep.createView(), dcopy, dgroup, w: m.w, h: m.h });\n    cols.forEach((c, k) => this.texs.set(m.id + k, c.createView()));\n    this.texs.set(m.id + ncol, dcopy.createView());\n  }\n  frame(f) {\n    const d = this.device;\n    // every draw's uniforms, 256 bytes apart (more for big blocks)\n    let size = 0;\n    const at = f.draws.map(dr => { const a = size; size += Math.max(256, Math.ceil(dr.usize / 256) * 256); return a; });\n    if (size > this.ubufSize) {\n      this.ubufSize = Math.max(size, 65536);\n      this.ubuf = d.createBuffer({ size: this.ubufSize, usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST });\n      for (const p of this.pipes.values()) p.u0 = null;\n    }\n    const staging = new Uint8Array(Math.max(size, 4));\n    f.draws.forEach((dr, i) => { if (dr.usize > 0) staging.set(f.u[dr.u], at[i]); });\n    if (size > 0) d.queue.writeBuffer(this.ubuf, 0, staging, 0, size);\n    const enc = d.createCommandEncoder();\n    const tg = f.target ? this.targets.get(f.target) : null;\n    if (f.target && !tg) return Promise.resolve();\n    const views = tg ? tg.cviews : [this.ctx ? this.ctx.getCurrentTexture().createView() : this.target.createView()];\n    const clearValue = { r: f.clear[0], g: f.clear[1], b: f.clear[2], a: f.clear[3] };\n    const pass = enc.beginRenderPass({\n      colorAttachments: views.map(view => ({ view, clearValue, loadOp: 'clear', storeOp: 'store' })),\n      depthStencilAttachment: { view: tg ? tg.dview : this.depth.createView(), depthClearValue: 1,\n                                depthLoadOp: 'clear', depthStoreOp: 'store' }\n    });\n    f.draws.forEach((dr, i) => {\n      const p = this.pipes.get(dr.pipe), mesh = this.meshes.get(dr.mesh);\n      if (!p || !mesh) return;\n      pass.setPipeline(p.pipe);\n      if (!p.u0) p.u0 = d.createBindGroup({ layout: p.g0, entries: p.usize > 0 ?\n        [{ binding: 0, resource: { buffer: this.ubuf, offset: 0, size: Math.max(16, p.usize) } }] : [] });\n      pass.setBindGroup(0, p.u0, p.usize > 0 ? [at[i]] : []);\n      const key = dr.tex.slice(0, p.ntex).join(',');\n      let g = p.groups.get(key);\n      if (!g) {\n        const entries = [];\n        for (let k = 0; k < p.ntex; k++) {\n          entries.push({ binding: 2 * k, resource: this.texs.get(dr.tex[k]) });\n          entries.push({ binding: 2 * k + 1, resource: this.sampler });\n        }\n        g = d.createBindGroup({ layout: p.g1, entries });\n        p.groups.set(key, g);\n      }\n      pass.setBindGroup(1, g);\n      pass.setVertexBuffer(0, mesh.v);\n      if (dr.args) {\n        // an indirect draw: indices and counts from buffers the card wrote\n        const ab = this.insts.get(dr.args), xb = dr.ind ? this.insts.get(dr.ind) : null;\n        if (!ab || (dr.ind && !xb)) return;\n        if (dr.inst) {\n          const ib = this.insts.get(dr.inst);\n          if (!ib) return;\n          pass.setVertexBuffer(1, ib.buf);\n        }\n        pass.setIndexBuffer(xb ? xb.buf : mesh.i, 'uint32');\n        pass.drawIndexedIndirect(ab.buf, 0);\n        return;\n      }\n      pass.setIndexBuffer(mesh.i, 'uint32');\n      if (dr.inst) {\n        const ib = this.insts.get(dr.inst);\n        if (!ib) return;\n        pass.setVertexBuffer(1, ib.buf);\n        pass.drawIndexed(dr.count, dr.ninst);\n      } else pass.drawIndexed(dr.count);\n    });\n    pass.end();\n    if (tg) {\n      const dp = enc.beginRenderPass({ colorAttachments: [{ view: tg.dcopy.createView(), loadOp: 'clear',\n        clearValue: { r: 1, g: 0, b: 0, a: 1 }, storeOp: 'store' }] });\n      dp.setPipeline(this.dpipe);\n      dp.setBindGroup(0, tg.dgroup);\n      dp.draw(3);\n      dp.end();\n    }\n    d.queue.submit([enc.finish()]);\n    return d.queue.onSubmittedWorkDone();\n  }\n  // the frame drawn without a canvas, as B G R A bytes: for tests\n  async readPixels() {\n    const d = this.device, row = Math.ceil(this.w * 4 / 256) * 256;\n    const buf = d.createBuffer({ size: row * this.h, usage: GPUBufferUsage.COPY_DST | GPUBufferUsage.MAP_READ });\n    const enc = d.createCommandEncoder();\n    enc.copyTextureToBuffer({ texture: this.target }, { buffer: buf, bytesPerRow: row }, [this.w, this.h]);\n    d.queue.submit([enc.finish()]);\n    await buf.mapAsync(GPUMapMode.READ);\n    const src = new Uint8Array(buf.getMappedRange()), out = new Uint8Array(this.w * this.h * 4);\n    for (let y = 0; y < this.h; y++) out.set(src.subarray(y * row, y * row + this.w * 4), y * this.w * 4);\n    buf.unmap();\n    return out;\n  }\n}\n\n// =============================================================================\n// node: run a module from the command line; its threads are worker threads\n// =============================================================================\nif (IS_NODE) {\n  const fs = require('fs');\n  const wt = require('worker_threads');\n  const out = (fd, bytes) => { try { fs.writeSync(fd, bytes); } catch (e) { /* closed */ } };\n  const spawn = (t) => {\n    const w = new wt.Worker(__filename, { workerData: t });\n    w.on('message', (m) => { if (m.kind === 'exit') process.exit(m.code); });\n    w.on('error', (e) => { out(2, Buffer.from('kron_web: thread: ' + e + '\\n')); process.exit(70); });\n    w.unref();\n  };\n  if (!wt.isMainThread && wt.workerData && wt.workerData.module) {\n    const t = wt.workerData;\n    const k = new Kron({ out, spawn });\n    k.tid = t.tid;\n    k.attach(t.module, t.memory, true).then(() => {\n      const r = k.runThread(t.stack, t.ctid);\n      if (r.all) wt.parentPort.postMessage({ kind: 'exit', code: r.code });\n    });\n    return;\n  }\n  if (require.main === module) {\n    const file = process.argv[2];\n    if (!file) {\n      process.stderr.write('usage: node kron_web.js program.wasm\\n');\n      process.exit(2);\n    }\n    const k = new Kron({ out, spawn, debug: !!process.env.KRON_WEB_DEBUG });\n    k.load(fs.readFileSync(file)).then(() => {\n      process.exit(k.run());\n    }).catch(e => {\n      process.stderr.write('kron_web: ' + (e && e.stack ? e.stack : e) + '\\n');\n      process.exit(70);\n    });\n  }\n  if (typeof module !== 'undefined') module.exports = { Kron, KronExit, KronGPU };\n  return;\n}\n\n// =============================================================================\n// service worker: the two headers that make the page cross-origin isolated\n// =============================================================================\nif (IS_SERVICE) {\n  self.addEventListener('install', () => self.skipWaiting());\n  self.addEventListener('activate', e => e.waitUntil(self.clients.claim()));\n  self.addEventListener('fetch', e => {\n    const req = e.request;\n    if (req.cache === 'only-if-cached' && req.mode !== 'same-origin') return;\n    e.respondWith(fetch(req).then(res => {\n      if (res.status === 0) return res;\n      const h = new Headers(res.headers);\n      h.set('Cross-Origin-Opener-Policy', 'same-origin');\n      h.set('Cross-Origin-Embedder-Policy', 'require-corp');\n      h.set('Cross-Origin-Resource-Policy', 'cross-origin');\n      return new Response(res.body, { status: res.status, statusText: res.statusText, headers: h });\n    }).catch(err => new Response(String(err), { status: 500 })));\n  });\n  return;\n}\n\n// =============================================================================\n// worker: the program runs here, and each of its threads in a worker of its\n// own; the page starts those, since this one may be blocked waiting\n// =============================================================================\nif (IS_WORKER) {\n  const out = (fd, bytes) => self.postMessage({ kind: 'out', fd, text: new TextDecoder().decode(bytes) });\n  const spawn = (t) => self.postMessage({ kind: 'thread', t });\n  self.onmessage = async (msg) => {\n    const m = msg.data;\n    if (m.kind === 'thread') {\n      const t = m.t;\n      const k = new Kron({ out, spawn });\n      k.tid = t.tid;\n      try {\n        await k.attach(t.module, t.memory, true);\n        const r = k.runThread(t.stack, t.ctid);\n        self.postMessage(r.all ? { kind: 'exit', code: r.code } : { kind: 'thread-end' });\n      } catch (e) {\n        self.postMessage({ kind: 'error', text: String(e && e.stack ? e.stack : e) });\n      }\n      return;\n    }\n    if (m.kind !== 'start') return;\n    let shared = null;\n    if (m.sab) {\n      shared = {\n        ctl: new Int32Array(m.sab, 0, CTL_INTS),\n        ring: new Int32Array(m.sab, CTL_INTS * 4, RING_SLOTS * RING_INTS),\n        clip: new Uint8Array(m.sab, (CTL_INTS + RING_SLOTS * RING_INTS) * 4, CLIP_BYTES),\n        pads: new Int32Array(m.sab, (CTL_INTS + RING_SLOTS * RING_INTS) * 4 + CLIP_BYTES, PAD_INTS)\n      };\n    }\n    const k = new Kron({\n      out, spawn,\n      hasWindow: !!m.window,\n      shared,\n      post: (x, transfer) => self.postMessage(x, transfer || [])\n    });\n    try {\n      const bytes = await (await fetch(m.wasm)).arrayBuffer();\n      await k.load(bytes);\n      const code = k.run();\n      self.postMessage({ kind: 'exit', code });\n    } catch (e) {\n      self.postMessage({ kind: 'error', text: String(e && e.stack ? e.stack : e) });\n    }\n  };\n  return;\n}\n\n// =============================================================================\n// page: KronWeb.start({ wasm, canvas, console })\n// =============================================================================\nif (IS_PAGE) {\n  const script = document.currentScript ? document.currentScript.src : 'kron_web.js';\n\n  // keys as the program sees them: the same codes as on Windows and Linux\n  function keyCode(e) {\n    const k = e.key;\n    const named = { Enter: 13, Escape: 27, Backspace: 8, Tab: 9, ArrowLeft: 37, ArrowUp: 38,\n      ArrowRight: 39, ArrowDown: 40, Delete: 46, Home: 36, End: 35, PageUp: 33, PageDown: 34,\n      ' ': 32, Shift: 16, Control: 17, Alt: 18 };\n    if (named[k] !== undefined) return named[k];\n    if (/^F([1-9]|1[0-2])$/.test(k)) return 111 + Number(k.slice(1));\n    if (k.length === 1) {\n      const c = k.toUpperCase().charCodeAt(0);\n      if ((c >= 65 && c <= 90) || (c >= 48 && c <= 57)) return c;\n    }\n    return e.keyCode || 0;\n  }\n\n  async function isolate() {\n    // shared memory needs the page cross-origin isolated; when the server\n    // does not send the headers, a service worker (this same file) adds\n    // them, once it controls the page: register, wait for it, reload once\n    if (self.crossOriginIsolated) { sessionStorage.removeItem('kron_coi'); return; }\n    if (!window.isSecureContext || !('serviceWorker' in navigator)) return;\n    try {\n      await navigator.serviceWorker.register(script);\n      await navigator.serviceWorker.ready;\n      if (sessionStorage.getItem('kron_coi')) return;      // reloaded once: no\n      sessionStorage.setItem('kron_coi', '1');\n      location.reload();\n      await new Promise(() => {});\n    } catch (e) { /* no service worker: run without */ }\n  }\n\n  window.KronWeb = {\n    // what draws the 3D, for a page that replays a recorded program (tests)\n    KronGPU,\n    async start(opts) {\n      await isolate();\n      const canvas = typeof opts.canvas === 'string' ? document.querySelector(opts.canvas) : opts.canvas;\n      const con = typeof opts.console === 'string' ? document.querySelector(opts.console) : opts.console;\n      const say = (t) => { if (con) { con.textContent += t; con.scrollTop = con.scrollHeight; } else console.log(t); };\n      if (!self.crossOriginIsolated) {\n        say('(this page is not cross-origin isolated: the program runs, but it cannot wait,\\n' +\n            ' and a window gets no keyboard or mouse. Serve it with kron_serve, or any server\\n' +\n            ' that sends Cross-Origin-Opener-Policy and Cross-Origin-Embedder-Policy.)\\n');\n      }\n      const worker = new Worker(script);\n      let sab = null, ctl = null, ring = null, clip = null, pads = null;\n      if (self.crossOriginIsolated) {\n        sab = new SharedArrayBuffer(SAB_BYTES);\n        ctl = new Int32Array(sab, 0, CTL_INTS);\n        ring = new Int32Array(sab, CTL_INTS * 4, RING_SLOTS * RING_INTS);\n        clip = new Uint8Array(sab, (CTL_INTS + RING_SLOTS * RING_INTS) * 4, CLIP_BYTES);\n        pads = new Int32Array(sab, (CTL_INTS + RING_SLOTS * RING_INTS) * 4 + CLIP_BYTES, PAD_INTS);\n        // the gamepads, read every frame into the shared memory\n        const poll = () => {\n          const gp = navigator.getGamepads ? navigator.getGamepads() : [];\n          for (let i = 0; i < 4; i++) {\n            const g = gp[i], at = i * 32;\n            pads[at] = (g && g.connected) ? 1 : 0;\n            for (let b = 0; b < 16; b++) pads[at + 1 + b] = (g && g.buttons[b] && g.buttons[b].pressed) ? 1 : 0;\n            for (let a = 0; a < 4; a++) pads[at + 17 + a] = g && g.axes[a] !== undefined ? Math.round(g.axes[a] * 10000) : 0;\n            pads[at + 21] = g && g.buttons[6] ? Math.round(g.buttons[6].value * 10000) : 0;\n            pads[at + 22] = g && g.buttons[7] ? Math.round(g.buttons[7].value * 10000) : 0;\n          }\n          requestAnimationFrame(poll);\n        };\n        requestAnimationFrame(poll);\n      }\n      const send = (type, a = 0, b = 0, c = 0, d = 0, e = 0) => {\n        if (!ctl) return;\n        const head = Atomics.load(ctl, 0), tail = Atomics.load(ctl, 1);\n        if (tail - head >= RING_SLOTS) return;\n        const at = (tail % RING_SLOTS) * RING_INTS;\n        ring[at] = type; ring[at + 1] = a; ring[at + 2] = b; ring[at + 3] = c; ring[at + 4] = d; ring[at + 5] = e;\n        Atomics.store(ctl, 1, tail + 1);\n        Atomics.notify(ctl, 2);\n      };\n      const mods = (e) => (e.shiftKey ? 1 : 0) | (e.ctrlKey || e.metaKey ? 4 : 0) | (e.altKey ? 8 : 0);\n      let ctx = null;\n      if (canvas) {\n        canvas.tabIndex = 0;\n        ctx = canvas.getContext('2d');\n        const pos = (e) => {\n          const r = canvas.getBoundingClientRect();\n          return [Math.floor((e.clientX - r.left) * canvas.width / r.width),\n                  Math.floor((e.clientY - r.top) * canvas.height / r.height)];\n        };\n        canvas.addEventListener('mousemove', e => {\n          if (document.pointerLockElement === canvas) { send(EV_DELTA, e.movementX | 0, e.movementY | 0); return; }\n          const [x, y] = pos(e); send(EV_MOVE, x, y, mods(e));\n        });\n        canvas.addEventListener('mousedown', () => { if (wantLock && document.pointerLockElement !== canvas) canvas.requestPointerLock(); });\n        canvas.addEventListener('mousedown', e => { canvas.focus(); const [x, y] = pos(e); send(EV_DOWN, e.button, x, y, mods(e)); e.preventDefault(); });\n        window.addEventListener('mouseup', e => { const [x, y] = pos(e); send(EV_UP, e.button, x, y, mods(e)); });\n        canvas.addEventListener('contextmenu', e => e.preventDefault());\n        // each finger: 1 down, 2 move, 3 up, with its number (the browser\n        // still makes the first one a mouse for the left button)\n        canvas.style.touchAction = 'none';\n        const touch = (phase) => (e) => {\n          for (const t of e.changedTouches) { const [x, y] = pos(t); send(EV_TOUCH, phase, t.identifier | 0, x, y); }\n        };\n        canvas.addEventListener('touchstart', touch(1), { passive: true });\n        canvas.addEventListener('touchmove', touch(2), { passive: true });\n        canvas.addEventListener('touchend', touch(3), { passive: true });\n        canvas.addEventListener('touchcancel', touch(3), { passive: true });\n        canvas.addEventListener('wheel', e => { send(EV_WHEEL, e.deltaY < 0 ? 1 : -1, mods(e)); e.preventDefault(); }, { passive: false });\n        let pastePending = null;\n        canvas.addEventListener('keydown', e => {\n          const code = keyCode(e), m = mods(e);\n          if ((e.ctrlKey || e.metaKey) && code === 86) {\n            // ctrl+v: the text first, through the paste event, then the key\n            pastePending = setTimeout(() => { pastePending = null; send(EV_KEY_DOWN, code, m); }, 120);\n            return;\n          }\n          send(EV_KEY_DOWN, code, m);\n          if (e.key.length === 1 && !e.ctrlKey && !e.metaKey) {\n            const cp = e.key.codePointAt(0);\n            if (cp < 256) send(EV_CHAR, cp, m);\n          }\n          if (!(e.ctrlKey && (code === 67 || code === 88))) e.preventDefault();\n        });\n        canvas.addEventListener('keyup', e => send(EV_KEY_UP, keyCode(e), mods(e)));\n        canvas.addEventListener('paste', e => {\n          const t = (e.clipboardData && e.clipboardData.getData('text')) || '';\n          if (clip) {\n            const bytes = new TextEncoder().encode(t).subarray(0, CLIP_BYTES);\n            clip.set(bytes);\n            Atomics.store(ctl, 3, bytes.length);\n          }\n          if (pastePending) { clearTimeout(pastePending); pastePending = null; send(EV_KEY_DOWN, 86, 4); }\n          e.preventDefault();\n        });\n        canvas.focus();\n      }\n      const threads = new Set();\n      let ended = false;\n      let gpu3d = null, gcanvas = null, actx = null, acursor = 0, wantLock = false;\n      const onmsg = (msg) => {\n        const m = msg.data;\n        if (m.kind === 'thread') {\n          // a thread of the program: a worker of its own, started from here\n          if (ended) return;\n          const tw = new Worker(script);\n          threads.add(tw);\n          tw.onmessage = (x) => {\n            if (x.data.kind === 'thread-end') { threads.delete(tw); tw.terminate(); }\n            else onmsg(x);\n          };\n          tw.postMessage({ kind: 'thread', t: m.t });\n          return;\n        }\n        if (m.kind === 'exit' || m.kind === 'error') {\n          ended = true;\n          for (const tw of threads) tw.terminate();\n          threads.clear();\n        }\n        if (m.kind === 'out') say(m.text);\n        else if (m.kind === 'open') {\n          if (m.title) document.title = m.title;\n          if (canvas) { canvas.width = m.w; canvas.height = m.h; canvas.style.display = 'block'; canvas.focus(); }\n        }\n        else if (m.kind === 'frame') {\n          if (ctx) ctx.putImageData(new ImageData(m.data, m.w, m.h), 0, 0);\n          if (ctl) Atomics.store(ctl, 5, 0);\n        }\n        else if (m.kind === 'close') { if (canvas) canvas.style.display = 'none'; }\n        else if (m.kind === 'gpu-open') {\n          // a canvas of its own over the window's: a canvas draws either 2D or 3D\n          (async () => {\n            let ok = false;\n            try {\n              if (canvas && navigator.gpu) {\n                gcanvas = document.createElement('canvas');\n                gcanvas.width = m.w; gcanvas.height = m.h;\n                gcanvas.style.cssText = 'position:absolute;pointer-events:none;';\n                const place = () => { const r = canvas.getBoundingClientRect();\n                  gcanvas.style.left = (r.left + window.scrollX) + 'px'; gcanvas.style.top = (r.top + window.scrollY) + 'px';\n                  gcanvas.style.width = r.width + 'px'; gcanvas.style.height = r.height + 'px'; };\n                document.body.appendChild(gcanvas);\n                place();\n                window.addEventListener('resize', place);\n                setInterval(place, 500);\n                gpu3d = new KronGPU(navigator.gpu);\n                ok = await gpu3d.open(m.w, m.h, gcanvas);\n              }\n            } catch (e) { say('WebGPU: ' + e + '\\n'); ok = false; }\n            if (ctl) { Atomics.store(ctl, 6, ok ? 1 : -1); Atomics.notify(ctl, 6); }\n          })();\n        }\n        else if (m.kind === 'gpu-prog') { if (gpu3d) try { gpu3d.program(m); } catch (e) { say('WebGPU: ' + e + '\\n'); } }\n        else if (m.kind === 'gpu-mesh') { if (gpu3d) gpu3d.mesh(m); }\n        else if (m.kind === 'gpu-tex') { if (gpu3d) gpu3d.texture(m); }\n        else if (m.kind === 'gpu-inst-new') { if (gpu3d) gpu3d.instNew(m); }\n        else if (m.kind === 'gpu-inst') { if (gpu3d) gpu3d.inst(m); }\n        else if (m.kind === 'gpu-inst-free') { if (gpu3d) gpu3d.instFree(m); }\n        else if (m.kind === 'gpu-cprog') { if (gpu3d) try { gpu3d.computeProgram(m); } catch (e) { say('WebGPU: ' + e + '\\n'); } }\n        else if (m.kind === 'gpu-run') { if (gpu3d) gpu3d.run(m); }\n        else if (m.kind === 'gpu-target') { if (gpu3d) try { gpu3d.makeTarget(m); } catch (e) { say('WebGPU: ' + e + '\\n'); } }\n        else if (m.kind === 'gpu-frame') {\n          const done = () => { if (ctl) { Atomics.store(ctl, 7, 0); Atomics.notify(ctl, 7); } };\n          if (gpu3d) gpu3d.frame(m.frame).then(done, done); else done();\n        }\n        else if (m.kind === 'pointer-lock') {\n          wantLock = !!m.on;\n          if (!wantLock && document.pointerLockElement) document.exitPointerLock();\n        }\n        else if (m.kind === 'audio-open') {\n          try {\n            actx = new AudioContext({ sampleRate: m.rate });\n            acursor = 0;\n            // a page may only start sound after the user did something\n            const resume = () => { if (actx && actx.state !== 'running') actx.resume(); };\n            window.addEventListener('keydown', resume);\n            window.addEventListener('mousedown', resume);\n            window.addEventListener('touchstart', resume);\n          } catch (e) { say('WebAudio: ' + e + '\\n'); actx = null; }\n        }\n        else if (m.kind === 'audio') {\n          // until the user clicks or types, the page may not play: what\n          // comes meanwhile is dropped rather than piled up behind\n          if (actx && actx.state !== 'running') acursor = 0;\n          else if (actx) {\n            const n = m.data.length / 2, buf = actx.createBuffer(2, n, actx.sampleRate);\n            const l = buf.getChannelData(0), r = buf.getChannelData(1);\n            for (let i = 0; i < n; i++) { l[i] = m.data[2 * i] / 32768; r[i] = m.data[2 * i + 1] / 32768; }\n            const src = actx.createBufferSource();\n            src.buffer = buf;\n            src.connect(actx.destination);\n            const t = Math.max(acursor, actx.currentTime + 0.02);\n            src.start(t);\n            acursor = t + n / actx.sampleRate;\n          }\n        }\n        else if (m.kind === 'audio-close') { if (actx) actx.close(); actx = null; }\n        else if (m.kind === 'gpu-close') { if (gcanvas) { gcanvas.remove(); gcanvas = null; } gpu3d = null; }\n        else if (m.kind === 'clip') { if (navigator.clipboard) navigator.clipboard.writeText(m.text).catch(() => {}); }\n        else if (m.kind === 'exit') { if (m.code) say('\\n(the program ended with ' + m.code + ')\\n'); if (opts.onexit) opts.onexit(m.code); }\n        else if (m.kind === 'error') say('\\n' + m.text + '\\n');\n      };\n      worker.onmessage = onmsg;\n      window.addEventListener('beforeunload', () => send(EV_CLOSE));\n      const wasm = new URL(opts.wasm, location.href).href;\n      worker.postMessage({ kind: 'start', wasm, sab, window: !!canvas });\n      return worker;\n    }\n  };\n}\n\n})();\n";
}
