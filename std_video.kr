kron_program
kron_domain std_video;
kron_imports
acquire_domain "std_audio.kr";
acquire_domain "std_image.kr";
acquire_domain "std_file.kr";
kron_definitions

// =========================================================================
// Kron standard library -- video: MPEG-1 films (.mpg), picture and sound.
//
// The decoders are a port of pl_mpeg (Dominic Szablewski, MIT licence, see
// THIRD_PARTY.md):
// MPEG-1 video (I, P and B pictures), MPEG-1 Layer II sound (MP2), and the
// MPEG program stream that carries both. Any tool makes such a file, ffmpeg
// for one:
//
//     ffmpeg -i film.mp4 -c:v mpeg1video -q:v 4 -c:a mp2 -b:a 192k film.mpg
//
// A raw MPEG-1 video stream (.m1v) opens too, without sound.
//
//     video_open(path)            1, or a fail with the reason
//     video_width()  video_height()  video_fps()
//     video_length()              the film's length in ms
//     video_has_sound()           1 when it has sound
//     video_next()                the next picture, in the order they are
//                                 shown: 1, 0 after the last
//     video_time()                the time of the picture decoded last, ms
//     video_frame_at(ms)          the pictures up to the one shown at ms
//                                 decoded: 1 when the picture changed
//     video_seek(ms)              to the picture at ms (or the one before)
//     video_image()               the last picture, a std_image picture
//                                 (window, gpu_texture); the same picture
//                                 each time, drawn over by the next
//     video_sound(volume)         its sound played from the time of the last
//                                 picture, through std_audio: the voice
//     video_close()
//
// A film with its sound:
//
//     video_open("intro.mpg");
//     var v: i64 = video_sound(1.0);
//     while window_show() && audio_playing(v) {
//         if video_frame_at(audio_position(v)) {
//             draw video_image() ...
//         }
//     }
//
// One film is open at a time. The file is read whole when it opens.
// =========================================================================

// ------------------------------------------------------------ the file ---
var vd_on: i64;
var vd_file: i64;
var vd_size: i64;
var vd_ves: i64;           // the video's stream, gathered from the packets
var vd_vlen: i64;
var vd_aes: i64;           // the sound's
var vd_alen: i64;
// the bit readers: 0 the video's stream, 1 the sound's
var br_p: [i64; 2];
var br_n: [i64; 2];        // bytes
var br_bit: [i64; 2];

// ------------------------------------------------------------- tables ---
// the VLC tables of pl_mpeg, one after another: their first entries
const VL_MBA: i64 = 0;
const VL_MBT_I: i64 = 80;
const VL_MBT_P: i64 = 84;
const VL_MBT_B: i64 = 98;
const VL_CBP: i64 = 120;
const VL_MOTION: i64 = 246;
const VL_DCTL: i64 = 314;
const VL_DCTC: i64 = 332;
const VL_COEFF: i64 = 350;
const VL_N: i64 = 574;
var vl_i: [i64; 574];
var vl_v: [i64; 574];
var vt_zigzag: [i64; 64];
var vt_intra: [i64; 64];
var vt_nonintra: [i64; 64];
var vt_premul: [i64; 64];
var vt_rate: [f64; 16];
var vt_window: [f64; 512];
var vt_srate: [i64; 8];
var vt_brate: [i64; 28];
var vt_sfbase: [i64; 3];
var vt_lut1: [i64; 32];
var vt_lut2: [i64; 9];
var vt_lut3: [i64; 96];
var vt_lut4: [i64; 96];
var vt_qtab: [i64; 51];
var vt_ready: i64;
var vt_pos: i64;

fn vt_num(t: i64) -> f64 {
    var c: i64 = 0;
    raw { c = peek8(t + vt_pos); }
    while c == 32 {
        vt_pos = vt_pos + 1;
        raw { c = peek8(t + vt_pos); }
    }
    var neg: i64 = 0;
    if c == 45 {
        neg = 1;
        vt_pos = vt_pos + 1;
    }
    var v: f64 = 0.0;
    var scale: f64 = 1.0;
    var frac: i64 = 0;
    var go: i64 = 1;
    while go == 1 {
        raw { c = peek8(t + vt_pos); }
        if c >= 48 && c <= 57 {
            if frac == 1 {
                scale = scale / 10.0;
                v = v + ((c - 48) as f64) * scale;
            } else {
                v = v * 10.0 + ((c - 48) as f64);
            }
            vt_pos = vt_pos + 1;
        } else if c == 46 {
            frac = 1;
            vt_pos = vt_pos + 1;
        } else {
            go = 0;
        }
    }
    if c == 101 {
        vt_pos = vt_pos + 1;
        var eneg: i64 = 0;
        raw { c = peek8(t + vt_pos); }
        if c == 45 {
            eneg = 1;
            vt_pos = vt_pos + 1;
        }
        var e: i64 = 0;
        raw { c = peek8(t + vt_pos); }
        while c >= 48 && c <= 57 {
            e = e * 10 + c - 48;
            vt_pos = vt_pos + 1;
            raw { c = peek8(t + vt_pos); }
        }
        while e > 0 {
            if eneg == 1 { v = v / 10.0; } else { v = v * 10.0; }
            e = e - 1;
        }
    }
    if neg == 1 { return 0.0 - v; }
    return v;
}

fn vt_fill_i(arr: i64, t: i64, n: i64) -> i64 {
    vt_pos = 0;
    var i: i64 = 0;
    while i < n {
        var v: i64 = vt_num(t) as i64;
        raw { poke(arr + i * 8, v); }
        i = i + 1;
    }
    return 0;
}

fn vt_fill_f(arr: i64, t: i64, n: i64) -> i64 {
    vt_pos = 0;
    var one: [f64; 1];
    var i: i64 = 0;
    while i < n {
        one[0] = vt_num(t);
        raw { poke(arr + i * 8, peek(&one)); }
        i = i + 1;
    }
    return 0;
}

fn vt_init() -> i64 {
    if vt_ready == 1 { return 0; }
    vt_fill_i(&vl_i, vt_text_vl_index(), VL_N);
    vt_fill_i(&vl_v, vt_text_vl_value(), VL_N);
    vt_fill_i(&vt_zigzag, vt_text_zigzag(), 64);
    vt_fill_i(&vt_intra, vt_text_intra_q(), 64);
    vt_fill_i(&vt_nonintra, vt_text_nonintra_q(), 64);
    vt_fill_i(&vt_premul, vt_text_premul(), 64);
    vt_fill_f(&vt_rate, vt_text_rate(), 16);
    vt_fill_f(&vt_window, vt_text_window(), 512);
    vt_fill_i(&vt_srate, vt_text_srate(), 8);
    vt_fill_i(&vt_brate, vt_text_brate(), 28);
    vt_fill_i(&vt_sfbase, vt_text_sfbase(), 3);
    vt_fill_i(&vt_lut1, vt_text_lut1(), 32);
    vt_fill_i(&vt_lut2, vt_text_lut2(), 9);
    vt_fill_i(&vt_lut3, vt_text_lut3(), 96);
    vt_fill_i(&vt_lut4, vt_text_lut4(), 96);
    vt_fill_i(&vt_qtab, vt_text_qtab(), 51);
    vt_ready = 1;
    return 0;
}

// ------------------------------------------------------- bit readers ---
// a byte of the file or of a stream
fn vd_b(p: i64) -> i64 {
    var c: i64 = 0;
    raw { c = peek8(p); }
    return c;
}

fn br_has(r: i64, bits: i64) -> i64 {
    return br_bit[r] + bits <= br_n[r] * 8;
}

// count bits (up to 32), the first one highest; 0 past the end
fn br_read(r: i64, count: i64) -> i64 {
    var bi: i64 = br_bit[r];
    if bi + count > br_n[r] * 8 {
        return 0;
    }
    var p: i64 = br_p[r] + (bi >> 3);
    var v: i64 = 0;
    raw {
        v = (peek8(p) << 32) | (peek8(p + 1) << 24) | (peek8(p + 2) << 16) | (peek8(p + 3) << 8) | peek8(p + 4);
    }
    br_bit[r] = bi + count;
    return (v >> (40 - (bi & 7) - count)) & ((1 << count) - 1);
}

fn br_skip(r: i64, count: i64) -> i64 {
    if br_has(r, count) { br_bit[r] = br_bit[r] + count; }
    return 0;
}

fn br_align(r: i64) -> i64 {
    br_bit[r] = ((br_bit[r] + 7) >> 3) << 3;
    return 0;
}

fn br_skip_bytes(r: i64, v: i64) -> i64 {
    br_align(r);
    var n: i64 = 0;
    while br_has(r, 8) && vd_b(br_p[r] + (br_bit[r] >> 3)) == v {
        br_bit[r] = br_bit[r] + 8;
        n = n + 1;
    }
    return n;
}

// the next start code (00 00 01 xx): xx, the reader after it; -1 at the end
fn br_next_start(r: i64) -> i64 {
    br_align(r);
    var i: i64 = br_bit[r] >> 3;
    var p: i64 = br_p[r];
    var n: i64 = br_n[r];
    while i + 5 <= n {
        if vd_b(p + i + 2) > 1 {
            i = i + 3;
        } else if vd_b(p + i) == 0 && vd_b(p + i + 1) == 0 && vd_b(p + i + 2) == 1 {
            br_bit[r] = (i + 4) << 3;
            return vd_b(p + i + 3);
        } else {
            i = i + 1;
        }
    }
    br_bit[r] = n << 3;
    return -1;
}

fn br_find_start(r: i64, code: i64) -> i64 {
    var c: i64 = br_next_start(r);
    while c != code && c != -1 {
        c = br_next_start(r);
    }
    return c;
}

fn br_peek_nonzero(r: i64, bits: i64) -> i64 {
    if !br_has(r, bits) { return 0; }
    var v: i64 = br_read(r, bits);
    br_bit[r] = br_bit[r] - bits;
    return v != 0;
}

// a value of a VLC table starting at base
fn br_vlc(r: i64, base: i64) -> i64 {
    var idx: i64 = 0;
    var k: i64 = 0;
    var go: i64 = 1;
    while go == 1 {
        k = base + idx + br_read(r, 1);
        idx = vl_i[k];
        if idx <= 0 { go = 0; }
    }
    return vl_v[k];
}

// ------------------------------------------------------------- video ---
const PIC_I: i64 = 1;
const PIC_P: i64 = 2;
const PIC_B: i64 = 3;
const START_SEQUENCE: i64 = 179;   // 0xB3
const START_PICTURE: i64 = 0;
const START_EXTENSION: i64 = 181;  // 0xB5
const START_USER: i64 = 178;       // 0xB2
const START_GOP: i64 = 184;        // 0xB8

var vv_fps: f64;
var vv_time: f64;          // seconds, of the next picture given
var vv_frames: i64;        // pictures given
var vv_w: i64;
var vv_h: i64;
var vv_mbw: i64;
var vv_mbh: i64;
var vv_mbsize: i64;
var vv_lw: i64;            // the planes' sizes: luma, chroma
var vv_lh: i64;
var vv_cw: i64;
var vv_ch: i64;
var vv_start: i64;
var vv_ptype: i64;
var vv_fw_full: i64;       // motion: forward and backward
var vv_fw_rsize: i64;
var vv_fw_h: i64;
var vv_fw_v: i64;
var vv_fw_set: i64;
var vv_bw_full: i64;
var vv_bw_rsize: i64;
var vv_bw_h: i64;
var vv_bw_v: i64;
var vv_bw_set: i64;
var vv_has_seq: i64;
var vv_qscale: i64;
var vv_slice_begin: i64;
var vv_mba: i64;
var vv_row: i64;
var vv_col: i64;
var vv_mbtype: i64;
var vv_intra: i64;
var vv_dc: [i64; 3];
var vv_data: i64;          // the three frames' planes
var vv_y: [i64; 3];        // each frame's planes, by its number
var vv_cr: [i64; 3];
var vv_cb: [i64; 3];
var vv_cur: i64;           // which frame is which: current, forward, backward
var vv_fwd: i64;
var vv_bwd: i64;
var vv_block: [i64; 64];
var vv_iq: [i64; 64];
var vv_nq: [i64; 64];
var vv_has_ref: i64;
var vv_out: i64;           // the frame given last, -1 none
var vv_skip_b: i64;        // after a seek: B pictures until a second reference

fn vv_clamp(n: i64) -> i64 {
    if n > 255 { return 255; }
    if n < 0 { return 0; }
    return n;
}

fn vv_seq_header() -> i64 {
    if !br_has(0, 64 + 2 * 64 * 8) { return 0; }
    var w: i64 = br_read(0, 12);
    var h: i64 = br_read(0, 12);
    if w <= 0 || h <= 0 { return 0; }
    br_skip(0, 4);                          // the pixels' aspect
    vv_fps = vt_rate[br_read(0, 4)];
    br_skip(0, 18 + 1 + 10 + 1);
    var i: i64 = 0;
    if br_read(0, 1) == 1 {
        while i < 64 {
            vv_iq[vt_zigzag[i]] = br_read(0, 8);
            i = i + 1;
        }
    } else {
        while i < 64 {
            vv_iq[i] = vt_intra[i];
            i = i + 1;
        }
    }
    i = 0;
    if br_read(0, 1) == 1 {
        while i < 64 {
            vv_nq[vt_zigzag[i]] = br_read(0, 8);
            i = i + 1;
        }
    } else {
        while i < 64 {
            vv_nq[i] = vt_nonintra[i];
            i = i + 1;
        }
    }
    if vv_has_seq == 1 {
        // a sequence header again (each group of pictures may have one):
        // the size is the first one's
        return 1;
    }
    if w > 4096 || h > 4096 {
        fail "this film is too large" hint "4096 x 4096 at most";
    }
    vv_w = w;
    vv_h = h;
    vv_mbw = (w + 15) >> 4;
    vv_mbh = (h + 15) >> 4;
    vv_mbsize = vv_mbw * vv_mbh;
    vv_lw = vv_mbw << 4;
    vv_lh = vv_mbh << 4;
    vv_cw = vv_mbw << 3;
    vv_ch = vv_mbh << 3;
    var lsize: i64 = vv_lw * vv_lh;
    var csize: i64 = vv_cw * vv_ch;
    var fsize: i64 = lsize + 2 * csize;
    vv_data = hp_alloc(fsize * 3 + 64);
    if vv_data == 0 {
        fail "no memory for the film's pictures" hint "a smaller film";
    }
    hp_zero(vv_data, fsize * 3);
    var k: i64 = 0;
    while k < 3 {
        vv_y[k] = vv_data + fsize * k;
        vv_cr[k] = vv_y[k] + lsize;
        vv_cb[k] = vv_cr[k] + csize;
        k = k + 1;
    }
    vv_cur = 0;
    vv_fwd = 1;
    vv_bwd = 2;
    vv_has_seq = 1;
    return 1;
}

fn vv_has_header() -> i64 {
    if vv_has_seq == 1 { return 1; }
    if vv_start != START_SEQUENCE {
        vv_start = br_find_start(0, START_SEQUENCE);
    }
    if vv_start == -1 { return 0; }
    return vv_seq_header();
}

// the next picture in the order they are shown: 1 with vv_out its frame
fn vv_decode() -> i64 {
    if vv_has_header() == 0 { return 0; }
    var got: i64 = -1;
    while got == -1 {
        if vv_start != START_PICTURE {
            vv_start = br_find_start(0, START_PICTURE);
            if vv_start == -1 {
                // the end: the last reference picture is still to be shown
                if vv_has_ref == 1 && (vv_ptype == PIC_I || vv_ptype == PIC_P) {
                    vv_has_ref = 0;
                    got = vv_bwd;
                } else {
                    return 0;
                }
            }
        }
        if got == -1 {
            if vv_picture() == 1 {
                if vv_ptype == PIC_B {
                    got = vv_cur;
                } else if vv_has_ref == 1 {
                    got = vv_fwd;
                } else {
                    vv_has_ref = 1;
                }
            }
        }
    }
    vv_out = got;
    vv_frames = vv_frames + 1;
    vv_time = (vv_frames as f64) / vv_fps;
    return 1;
}

// a picture: 1 when it was decoded (0: skipped, or not one to decode)
fn vv_picture() -> i64 {
    br_skip(0, 10);
    vv_ptype = br_read(0, 3);
    br_skip(0, 16);
    if vv_ptype <= 0 || vv_ptype > PIC_B {
        vv_start = br_next_start(0);
        return 0;
    }
    if vv_ptype == PIC_B && vv_skip_b == 1 {
        vv_start = br_next_start(0);
        return 0;
    }
    if vv_ptype == PIC_P || vv_ptype == PIC_B {
        vv_fw_full = br_read(0, 1);
        var fc: i64 = br_read(0, 3);
        if fc == 0 {
            vv_start = br_next_start(0);
            return 0;
        }
        vv_fw_rsize = fc - 1;
    }
    if vv_ptype == PIC_B {
        vv_bw_full = br_read(0, 1);
        var bc: i64 = br_read(0, 3);
        if bc == 0 {
            vv_start = br_next_start(0);
            return 0;
        }
        vv_bw_rsize = bc - 1;
    }
    var temp: i64 = vv_fwd;
    if vv_ptype == PIC_I || vv_ptype == PIC_P {
        vv_fwd = vv_bwd;
    }
    vv_start = br_next_start(0);
    while vv_start == START_EXTENSION || vv_start == START_USER {
        vv_start = br_next_start(0);
    }
    var going: i64 = 1;
    while going == 1 && vv_start >= 1 && vv_start <= 175 {
        vv_slice(vv_start);
        if vv_mba >= vv_mbsize - 1 {
            going = 0;
        } else {
            vv_start = br_next_start(0);
        }
    }
    if going == 0 {
        vv_start = br_next_start(0);
    }
    if vv_ptype == PIC_I || vv_ptype == PIC_P {
        vv_bwd = vv_cur;
        vv_cur = temp;
        if vv_skip_b == 1 && vv_has_ref == 1 { vv_skip_b = 0; }
    }
    return 1;
}

fn vv_reset_dc() -> i64 {
    vv_dc[0] = 128;
    vv_dc[1] = 128;
    vv_dc[2] = 128;
    return 0;
}

fn vv_slice(sl: i64) -> i64 {
    vv_slice_begin = 1;
    vv_mba = (sl - 1) * vv_mbw - 1;
    vv_fw_h = 0;
    vv_fw_v = 0;
    vv_bw_h = 0;
    vv_bw_v = 0;
    vv_reset_dc();
    vv_qscale = br_read(0, 5);
    while br_read(0, 1) == 1 {
        br_skip(0, 8);
    }
    var go: i64 = 1;
    while go == 1 {
        vv_macroblock();
        if vv_mba >= vv_mbsize - 1 || br_peek_nonzero(0, 23) == 0 { go = 0; }
    }
    return 0;
}

fn vv_macroblock() -> i64 {
    var inc: i64 = 0;
    var t: i64 = br_vlc(0, VL_MBA);
    while t == 34 {
        t = br_vlc(0, VL_MBA);
    }
    while t == 35 {
        inc = inc + 33;
        t = br_vlc(0, VL_MBA);
    }
    inc = inc + t;
    if vv_slice_begin == 1 {
        vv_slice_begin = 0;
        vv_mba = vv_mba + inc;
    } else {
        if vv_mba + inc >= vv_mbsize { return 0; }
        if inc > 1 {
            vv_reset_dc();
            if vv_ptype == PIC_P {
                vv_fw_h = 0;
                vv_fw_v = 0;
            }
        }
        while inc > 1 {
            vv_mba = vv_mba + 1;
            vv_row = vv_mba / vv_mbw;
            vv_col = vv_mba % vv_mbw;
            vv_predict();
            inc = inc - 1;
        }
        vv_mba = vv_mba + 1;
    }
    vv_row = vv_mba / vv_mbw;
    vv_col = vv_mba % vv_mbw;
    if vv_col >= vv_mbw || vv_row >= vv_mbh || vv_row < 0 { return 0; }
    var base: i64 = VL_MBT_I;
    if vv_ptype == PIC_P { base = VL_MBT_P; }
    if vv_ptype == PIC_B { base = VL_MBT_B; }
    vv_mbtype = br_vlc(0, base);
    vv_intra = vv_mbtype & 1;
    vv_fw_set = (vv_mbtype & 8) != 0;
    vv_bw_set = (vv_mbtype & 4) != 0;
    if (vv_mbtype & 16) != 0 {
        vv_qscale = br_read(0, 5);
    }
    if vv_intra == 1 {
        vv_fw_h = 0;
        vv_fw_v = 0;
        vv_bw_h = 0;
        vv_bw_v = 0;
    } else {
        vv_reset_dc();
        vv_motion_vectors();
        vv_predict();
    }
    var cbp: i64 = 0;
    if (vv_mbtype & 2) != 0 {
        cbp = br_vlc(0, VL_CBP);
    } else if vv_intra == 1 {
        cbp = 63;
    }
    var block: i64 = 0;
    var mask: i64 = 32;
    while block < 6 {
        if (cbp & mask) != 0 {
            vv_decode_block(block);
        }
        mask = mask >> 1;
        block = block + 1;
    }
    return 0;
}

fn vv_motion_vectors() -> i64 {
    if vv_fw_set == 1 {
        vv_fw_h = vv_motion_vector(vv_fw_rsize, vv_fw_h);
        vv_fw_v = vv_motion_vector(vv_fw_rsize, vv_fw_v);
    } else if vv_ptype == PIC_P {
        vv_fw_h = 0;
        vv_fw_v = 0;
    }
    if vv_bw_set == 1 {
        vv_bw_h = vv_motion_vector(vv_bw_rsize, vv_bw_h);
        vv_bw_v = vv_motion_vector(vv_bw_rsize, vv_bw_v);
    }
    return 0;
}

fn vv_motion_vector(rsize: i64, motion0: i64) -> i64 {
    var fscale: i64 = 1 << rsize;
    var mcode: i64 = br_vlc(0, VL_MOTION);
    var d: i64 = 0;
    if mcode != 0 && fscale != 1 {
        var r: i64 = br_read(0, rsize);
        var am: i64 = mcode;
        if am < 0 { am = 0 - am; }
        d = ((am - 1) << rsize) + r + 1;
        if mcode < 0 { d = 0 - d; }
    } else {
        d = mcode;
    }
    var motion: i64 = motion0 + d;
    if motion > (fscale << 4) - 1 {
        motion = motion - (fscale << 5);
    } else if motion < 0 - (fscale << 4) {
        motion = motion + (fscale << 5);
    }
    return motion;
}

fn vv_predict() -> i64 {
    var fh: i64 = vv_fw_h;
    var fv: i64 = vv_fw_v;
    if vv_fw_full == 1 {
        fh = fh << 1;
        fv = fv << 1;
    }
    if vv_ptype == PIC_B {
        var bh: i64 = vv_bw_h;
        var bv: i64 = vv_bw_v;
        if vv_bw_full == 1 {
            bh = bh << 1;
            bv = bv << 1;
        }
        if vv_fw_set == 1 {
            vv_copy_mb(vv_fwd, fh, fv, 0);
            if vv_bw_set == 1 {
                vv_copy_mb(vv_bwd, bh, bv, 1);
            }
        } else {
            vv_copy_mb(vv_bwd, bh, bv, 0);
        }
    } else {
        vv_copy_mb(vv_fwd, fh, fv, 0);
    }
    return 0;
}

// C's / on ints: toward 0
fn vv_half(x: i64) -> i64 {
    if x < 0 { return 0 - ((0 - x) / 2); }
    return x / 2;
}

fn vv_copy_mb(s: i64, mh: i64, mv: i64, interp: i64) -> i64 {
    vv_process_mb(vv_y[s], vv_y[vv_cur], mh, mv, 16, interp);
    vv_process_mb(vv_cr[s], vv_cr[vv_cur], vv_half(mh), vv_half(mv), 8, interp);
    vv_process_mb(vv_cb[s], vv_cb[vv_cur], vv_half(mh), vv_half(mv), 8, interp);
    return 0;
}

// a block of size bs from s at the motion's place into d (averaged with
// what d has when interp)
fn vv_process_mb(s: i64, d: i64, mh: i64, mv: i64, bs: i64, interp: i64) -> i64 {
    var dw: i64 = vv_mbw * bs;
    var hp: i64 = mh >> 1;
    var vp: i64 = mv >> 1;
    var oh: i64 = mh & 1;
    var ov: i64 = mv & 1;
    var si: i64 = ((vv_row * bs) + vp) * dw + (vv_col * bs) + hp;
    var di: i64 = (vv_row * dw + vv_col) * bs;
    var maxa: i64 = dw * (vv_mbh * bs - bs + 1) - bs;
    if si < 0 || si > maxa || di > maxa { return 0; }
    var scan: i64 = dw - bs;
    var y: i64 = 0;
    var mode: i64 = (interp << 2) | (oh << 1) | ov;
    raw {
        var sp: i64 = s + si;
        var dp: i64 = d + di;
        while y < bs {
            var x: i64 = 0;
            while x < bs {
                var v: i64 = 0;
                var m: i64 = mode & 3;
                if m == 0 {
                    v = peek8(sp);
                } else if m == 1 {
                    v = (peek8(sp) + peek8(sp + dw) + 1) >> 1;
                } else if m == 2 {
                    v = (peek8(sp) + peek8(sp + 1) + 1) >> 1;
                } else {
                    v = (peek8(sp) + peek8(sp + 1) + peek8(sp + dw) + peek8(sp + dw + 1) + 2) >> 2;
                }
                if mode >= 4 {
                    v = (peek8(dp) + v + 1) >> 1;
                }
                poke8(dp, v);
                sp = sp + 1;
                dp = dp + 1;
                x = x + 1;
            }
            sp = sp + scan;
            dp = dp + scan;
            y = y + 1;
        }
    }
    return 0;
}

fn vv_decode_block(block: i64) -> i64 {
    var n: i64 = 0;
    var qintra: i64 = vv_intra;
    if vv_intra == 1 {
        var plane: i64 = 0;
        if block > 3 { plane = block - 3; }
        var pred: i64 = vv_dc[plane];
        var dbase: i64 = VL_DCTL;
        if plane > 0 { dbase = VL_DCTC; }
        var dsize: i64 = br_vlc(0, dbase);
        if dsize > 0 {
            var diff: i64 = br_read(0, dsize);
            if (diff & (1 << (dsize - 1))) != 0 {
                vv_block[0] = pred + diff;
            } else {
                vv_block[0] = pred + ((0 - (1 << dsize)) | (diff + 1));
            }
        } else {
            vv_block[0] = pred;
        }
        vv_dc[plane] = vv_block[0];
        vv_block[0] = vv_block[0] << 8;
        n = 1;
    }
    var level: i64 = 0;
    var go: i64 = 1;
    while go == 1 {
        var run: i64 = 0;
        var coeff: i64 = br_vlc(0, VL_COEFF) & 65535;
        if coeff == 1 && n > 0 && br_read(0, 1) == 0 {
            go = 0;
        } else {
            if coeff == 65535 {
                run = br_read(0, 6);
                level = br_read(0, 8);
                if level == 0 {
                    level = br_read(0, 8);
                } else if level == 128 {
                    level = br_read(0, 8) - 256;
                } else if level > 128 {
                    level = level - 256;
                }
            } else {
                run = coeff >> 8;
                level = coeff & 255;
                if br_read(0, 1) == 1 {
                    level = 0 - level;
                }
            }
            n = n + run;
            if n < 0 || n >= 64 { return 0; }
            var dz: i64 = vt_zigzag[n];
            n = n + 1;
            level = level * 2;
            if qintra == 0 {
                if level < 0 { level = level - 1; } else { level = level + 1; }
            }
            var q: i64 = vv_nq[dz];
            if qintra == 1 { q = vv_iq[dz]; }
            level = (level * vv_qscale * q) >> 4;
            if (level & 1) == 0 {
                if level > 0 { level = level - 1; } else { level = level + 1; }
            }
            if level > 2047 { level = 2047; }
            if level < -2048 { level = -2048; }
            vv_block[dz] = level * vt_premul[dz];
        }
    }
    // the block's place in its plane
    var d: i64 = 0;
    var dw: i64 = 0;
    var di: i64 = 0;
    if block < 4 {
        d = vv_y[vv_cur];
        dw = vv_lw;
        di = (vv_row * vv_lw + vv_col) << 4;
        if (block & 1) != 0 { di = di + 8; }
        if (block & 2) != 0 { di = di + (vv_lw << 3); }
    } else {
        d = vv_cb[vv_cur];
        if block == 5 { d = vv_cr[vv_cur]; }
        dw = vv_cw;
        di = ((vv_row * vv_lw) << 2) + (vv_col << 3);
    }
    var scan: i64 = dw - 8;
    var y: i64 = 0;
    var x: i64 = 0;
    var si: i64 = 0;
    if n == 1 {
        // the DC alone: one value for the whole block
        var v: i64 = (vv_block[0] + 128) >> 8;
        vv_block[0] = 0;
        raw {
            var dp: i64 = d + di;
            while y < 8 {
                x = 0;
                while x < 8 {
                    if qintra == 1 {
                        poke8(dp, vv_clamp(v));
                    } else {
                        poke8(dp, vv_clamp(peek8(dp) + v));
                    }
                    dp = dp + 1;
                    x = x + 1;
                }
                dp = dp + scan;
                y = y + 1;
            }
        }
        return 0;
    }
    vv_idct();
    raw {
        var dp2: i64 = d + di;
        while y < 8 {
            x = 0;
            while x < 8 {
                if qintra == 1 {
                    poke8(dp2, vv_clamp(vv_block[si]));
                } else {
                    poke8(dp2, vv_clamp(peek8(dp2) + vv_block[si]));
                }
                vv_block[si] = 0;
                si = si + 1;
                dp2 = dp2 + 1;
                x = x + 1;
            }
            dp2 = dp2 + scan;
            y = y + 1;
        }
    }
    return 0;
}

fn vv_idct() -> i64 {
    var i: i64 = 0;
    while i < 8 {
        var b1: i64 = vv_block[32 + i];
        var b3: i64 = vv_block[16 + i] + vv_block[48 + i];
        var b4: i64 = vv_block[40 + i] - vv_block[24 + i];
        var tmp1: i64 = vv_block[8 + i] + vv_block[56 + i];
        var tmp2: i64 = vv_block[24 + i] + vv_block[40 + i];
        var b6: i64 = vv_block[8 + i] - vv_block[56 + i];
        var b7: i64 = tmp1 + tmp2;
        var m0: i64 = vv_block[i];
        var x4: i64 = ((b6 * 473 - b4 * 196 + 128) >> 8) - b7;
        var x0: i64 = x4 - (((tmp1 - tmp2) * 362 + 128) >> 8);
        var x1: i64 = m0 - b1;
        var x2: i64 = (((vv_block[16 + i] - vv_block[48 + i]) * 362 + 128) >> 8) - b3;
        var x3: i64 = m0 + b1;
        var y3: i64 = x1 + x2;
        var y4: i64 = x3 + b3;
        var y5: i64 = x1 - x2;
        var y6: i64 = x3 - b3;
        var y7: i64 = 0 - x0 - ((b4 * 473 + b6 * 196 + 128) >> 8);
        vv_block[i] = b7 + y4;
        vv_block[8 + i] = x4 + y3;
        vv_block[16 + i] = y5 - x0;
        vv_block[24 + i] = y6 - y7;
        vv_block[32 + i] = y6 + y7;
        vv_block[40 + i] = x0 + y5;
        vv_block[48 + i] = y3 - x4;
        vv_block[56 + i] = y4 - b7;
        i = i + 1;
    }
    i = 0;
    while i < 64 {
        var c1: i64 = vv_block[4 + i];
        var c3: i64 = vv_block[2 + i] + vv_block[6 + i];
        var c4: i64 = vv_block[5 + i] - vv_block[3 + i];
        var u1: i64 = vv_block[1 + i] + vv_block[7 + i];
        var u2: i64 = vv_block[3 + i] + vv_block[5 + i];
        var c6: i64 = vv_block[1 + i] - vv_block[7 + i];
        var c7: i64 = u1 + u2;
        var n0: i64 = vv_block[i];
        var z4: i64 = ((c6 * 473 - c4 * 196 + 128) >> 8) - c7;
        var z0: i64 = z4 - (((u1 - u2) * 362 + 128) >> 8);
        var z1: i64 = n0 - c1;
        var z2: i64 = (((vv_block[2 + i] - vv_block[6 + i]) * 362 + 128) >> 8) - c3;
        var z3: i64 = n0 + c1;
        var w3: i64 = z1 + z2;
        var w4: i64 = z3 + c3;
        var w5: i64 = z1 - z2;
        var w6: i64 = z3 - c3;
        var w7: i64 = 0 - z0 - ((c4 * 473 + c6 * 196 + 128) >> 8);
        vv_block[i] = (c7 + w4 + 128) >> 8;
        vv_block[1 + i] = (z4 + w3 + 128) >> 8;
        vv_block[2 + i] = (w5 - z0 + 128) >> 8;
        vv_block[3 + i] = (w6 - w7 + 128) >> 8;
        vv_block[4 + i] = (w6 + w7 + 128) >> 8;
        vv_block[5 + i] = (z0 + w5 + 128) >> 8;
        vv_block[6 + i] = (w3 - z4 + 128) >> 8;
        vv_block[7 + i] = (w4 - c7 + 128) >> 8;
        i = i + 8;
    }
    return 0;
}

// frame f into the picture, B G R A (BT.601), two rows and columns at once
fn vv_to_bgra(f: i64, dst: i64) -> i64 {
    var cols: i64 = vv_w >> 1;
    var rows: i64 = vv_h >> 1;
    var yw: i64 = vv_lw;
    var cw: i64 = vv_cw;
    var stride: i64 = vv_w * 4;
    var py: i64 = vv_y[f];
    var pcr: i64 = vv_cr[f];
    var pcb: i64 = vv_cb[f];
    var row: i64 = 0;
    raw {
        while row < rows {
            var ci: i64 = row * cw;
            var yi: i64 = row * 2 * yw;
            var di: i64 = row * 2 * stride;
            var col: i64 = 0;
            while col < cols {
                var cr: i64 = peek8(pcr + ci) - 128;
                var cb: i64 = peek8(pcb + ci) - 128;
                var r: i64 = (cr * 104597) >> 16;
                var g: i64 = (cb * 25674 + cr * 53278) >> 16;
                var b: i64 = (cb * 132201) >> 16;
                var k: i64 = 0;
                while k < 4 {
                    var yo: i64 = 0;
                    var dof: i64 = 0;
                    if k == 1 { yo = 1; dof = 4; }
                    if k == 2 { yo = yw; dof = stride; }
                    if k == 3 { yo = yw + 1; dof = stride + 4; }
                    var yy: i64 = ((peek8(py + yi + yo) - 16) * 76309) >> 16;
                    var q: i64 = dst + di + dof;
                    poke8(q, vv_clamp(yy + b));
                    poke8(q + 1, vv_clamp(yy - g));
                    poke8(q + 2, vv_clamp(yy + r));
                    poke8(q + 3, 255);
                    k = k + 1;
                }
                ci = ci + 1;
                yi = yi + 2;
                di = di + 8;
                col = col + 1;
            }
            row = row + 1;
        }
    }
    return 0;
}

// ------------------------------------------------------------- sound ---
// MPEG-1 Layer II: 1152 samples a frame, two channels (mono doubled)
var va_rate: i64;          // samples a second, 0 before a header
var va_srate_i: i64;
var va_brate_i: i64;
var va_mode: i64;
var va_bound: i64;
var va_vpos: i64;
var va_next: i64;          // bytes of the frame whose header was read
var va_has_header: i64;
var va_alloc: [i64; 64];   // [ch][sb]: the quantizer's place in vt_qtab + 1, 0 none
var va_sfi: [i64; 64];
var va_sf: [i64; 192];     // [ch][sb][3]
var va_sample: [i64; 192];
var va_d: [f64; 1024];
var va_v: [f64; 2048];     // [ch][1024]
var va_u: [f64; 32];
var va_out: [f64; 2304];   // a frame's samples, interleaved, -1 .. 1
var va_samples: i64;       // samples decoded since the start

fn va_reset() -> i64 {
    va_vpos = 0;
    va_next = 0;
    va_has_header = 0;
    va_samples = 0;
    var i: i64 = 0;
    while i < 2048 {
        va_v[i] = 0.0;
        i = i + 1;
    }
    i = 0;
    while i < 512 {
        va_d[i] = vt_window[i];
        va_d[i + 512] = vt_window[i];
        i = i + 1;
    }
    return 0;
}

fn va_find_sync() -> i64 {
    var i: i64 = br_bit[1] >> 3;
    var p: i64 = br_p[1];
    while i < br_n[1] - 1 {
        if vd_b(p + i) == 255 && (vd_b(p + i + 1) & 254) == 252 {
            br_bit[1] = ((i + 1) << 3) + 3;
            return 1;
        }
        i = i + 1;
    }
    br_bit[1] = (i + 1) << 3;
    return 0;
}

// a frame's header: the bytes of its data, 0 when there is none
fn va_header() -> i64 {
    if !br_has(1, 48) { return 0; }
    br_skip_bytes(1, 0);
    var sync: i64 = br_read(1, 11);
    if sync != 2047 && va_find_sync() == 0 { return 0; }
    var version: i64 = br_read(1, 2);
    var layer: i64 = br_read(1, 2);
    var crc: i64 = 1 - br_read(1, 1);
    if version != 3 || layer != 2 { return 0; }
    var bi: i64 = br_read(1, 4) - 1;
    if bi > 13 || bi < 0 { return 0; }
    var si: i64 = br_read(1, 2);
    if si == 3 { return 0; }
    var padding: i64 = br_read(1, 1);
    br_skip(1, 1);
    var mode: i64 = br_read(1, 2);
    if va_has_header == 1 && (va_brate_i != bi || va_srate_i != si || va_mode != mode) {
        return 0;
    }
    va_brate_i = bi;
    va_srate_i = si;
    va_mode = mode;
    va_has_header = 1;
    va_rate = vt_srate[si];
    if mode == 1 {
        va_bound = (br_read(1, 2) + 1) << 2;
    } else {
        br_skip(1, 2);
        va_bound = 32;
        if mode == 3 { va_bound = 0; }
    }
    br_skip(1, 4);
    if crc == 1 { br_skip(1, 16); }
    var size: i64 = (144000 * vt_brate[bi] / va_rate) + padding;
    if crc == 1 { return size - 6; }
    return size - 4;
}

// the next frame into va_out: 1, 0 at the end
fn va_decode() -> i64 {
    if va_next == 0 {
        if !br_has(1, 48) { return 0; }
        va_next = va_header();
    }
    if va_next == 0 || !br_has(1, va_next << 3) { return 0; }
    va_frame();
    va_next = 0;
    va_samples = va_samples + 1152;
    return 1;
}

fn va_read_alloc(sb: i64, tab3: i64) -> i64 {
    var tab4: i64 = vt_lut3[tab3 * 32 + sb];
    var q: i64 = vt_lut4[(tab4 & 15) * 16 + br_read(1, tab4 >> 4)];
    return q;
}

fn va_frame() -> i64 {
    var tab1: i64 = 1;
    if va_mode == 3 { tab1 = 0; }
    var tab2: i64 = vt_lut1[tab1 * 16 + va_brate_i];
    var tab3: i64 = vt_lut2[tab2 * 3 + va_srate_i];
    var sblimit: i64 = tab3 & 63;
    tab3 = tab3 >> 6;
    if va_bound > sblimit { va_bound = sblimit; }
    var sb: i64 = 0;
    while sb < va_bound {
        va_alloc[sb] = va_read_alloc(sb, tab3);
        va_alloc[32 + sb] = va_read_alloc(sb, tab3);
        sb = sb + 1;
    }
    sb = va_bound;
    while sb < sblimit {
        var a: i64 = va_read_alloc(sb, tab3);
        va_alloc[sb] = a;
        va_alloc[32 + sb] = a;
        sb = sb + 1;
    }
    var channels: i64 = 2;
    if va_mode == 3 { channels = 1; }
    sb = 0;
    while sb < sblimit {
        var ch: i64 = 0;
        while ch < channels {
            if va_alloc[ch * 32 + sb] != 0 {
                va_sfi[ch * 32 + sb] = br_read(1, 2);
            }
            ch = ch + 1;
        }
        if va_mode == 3 { va_sfi[32 + sb] = va_sfi[sb]; }
        sb = sb + 1;
    }
    sb = 0;
    while sb < sblimit {
        var ch2: i64 = 0;
        while ch2 < channels {
            if va_alloc[ch2 * 32 + sb] != 0 {
                var at: i64 = (ch2 * 32 + sb) * 3;
                var info: i64 = va_sfi[ch2 * 32 + sb];
                if info == 0 {
                    va_sf[at] = br_read(1, 6);
                    va_sf[at + 1] = br_read(1, 6);
                    va_sf[at + 2] = br_read(1, 6);
                } else if info == 1 {
                    var s01: i64 = br_read(1, 6);
                    va_sf[at] = s01;
                    va_sf[at + 1] = s01;
                    va_sf[at + 2] = br_read(1, 6);
                } else if info == 2 {
                    var s012: i64 = br_read(1, 6);
                    va_sf[at] = s012;
                    va_sf[at + 1] = s012;
                    va_sf[at + 2] = s012;
                } else {
                    va_sf[at] = br_read(1, 6);
                    var s12: i64 = br_read(1, 6);
                    va_sf[at + 1] = s12;
                    va_sf[at + 2] = s12;
                }
            }
            ch2 = ch2 + 1;
        }
        if va_mode == 3 {
            va_sf[(32 + sb) * 3] = va_sf[sb * 3];
            va_sf[(32 + sb) * 3 + 1] = va_sf[sb * 3 + 1];
            va_sf[(32 + sb) * 3 + 2] = va_sf[sb * 3 + 2];
        }
        sb = sb + 1;
    }
    var outpos: i64 = 0;
    var part: i64 = 0;
    while part < 3 {
        var gr: i64 = 0;
        while gr < 4 {
            sb = 0;
            while sb < va_bound {
                va_read_samples(0, sb, part);
                va_read_samples(1, sb, part);
                sb = sb + 1;
            }
            sb = va_bound;
            while sb < sblimit {
                va_read_samples(0, sb, part);
                va_sample[(32 + sb) * 3] = va_sample[sb * 3];
                va_sample[(32 + sb) * 3 + 1] = va_sample[sb * 3 + 1];
                va_sample[(32 + sb) * 3 + 2] = va_sample[sb * 3 + 2];
                sb = sb + 1;
            }
            sb = sblimit;
            while sb < 32 {
                var z: i64 = 0;
                while z < 3 {
                    va_sample[sb * 3 + z] = 0;
                    va_sample[(32 + sb) * 3 + z] = 0;
                    z = z + 1;
                }
                sb = sb + 1;
            }
            var p: i64 = 0;
            while p < 3 {
                va_vpos = (va_vpos - 64) & 1023;
                var c: i64 = 0;
                while c < 2 {
                    va_idct36(c, p, c * 1024 + va_vpos);
                    va_synth(c, outpos);
                    c = c + 1;
                }
                outpos = outpos + 32;
                p = p + 1;
            }
            gr = gr + 1;
        }
        part = part + 1;
    }
    br_align(1);
    return 0;
}

// the window over V into 32 samples of channel c, at outpos
fn va_synth(c: i64, outpos: i64) -> i64 {
    var i: i64 = 0;
    while i < 32 {
        va_u[i] = 0.0;
        i = i + 1;
    }
    var vb: i64 = c * 1024;
    var di: i64 = 512 - (va_vpos >> 1);
    var vi: i64 = (va_vpos % 128) >> 1;
    while vi < 1024 {
        i = 0;
        while i < 32 {
            va_u[i] = va_u[i] + va_d[di] * va_v[vb + vi];
            di = di + 1;
            vi = vi + 1;
            i = i + 1;
        }
        vi = vi + 128 - 32;
        di = di + 64 - 32;
    }
    di = di - (512 - 32);
    vi = (128 - 32 + 1024) - vi;
    while vi < 1024 {
        i = 0;
        while i < 32 {
            va_u[i] = va_u[i] + va_d[di] * va_v[vb + vi];
            di = di + 1;
            vi = vi + 1;
            i = i + 1;
        }
        vi = vi + 128 - 32;
        di = di + 64 - 32;
    }
    var j: i64 = 0;
    while j < 32 {
        va_out[((outpos + j) << 1) + c] = va_u[j] / -1090519040.0;
        j = j + 1;
    }
    return 0;
}

fn va_read_samples(ch: i64, sb: i64, part: i64) -> i64 {
    var q: i64 = va_alloc[ch * 32 + sb];
    var at: i64 = (ch * 32 + sb) * 3;
    if q == 0 {
        va_sample[at] = 0;
        va_sample[at + 1] = 0;
        va_sample[at + 2] = 0;
        return 0;
    }
    var sf: i64 = va_sf[at + part];
    if sf == 63 {
        sf = 0;
    } else {
        var shift: i64 = sf / 3;
        sf = (vt_sfbase[sf % 3] + ((1 << shift) >> 1)) >> shift;
    }
    var adj: i64 = vt_qtab[(q - 1) * 3];
    var group: i64 = vt_qtab[(q - 1) * 3 + 1];
    var bits: i64 = vt_qtab[(q - 1) * 3 + 2];
    if group != 0 {
        var val: i64 = br_read(1, bits);
        va_sample[at] = val % adj;
        val = val / adj;
        va_sample[at + 1] = val % adj;
        va_sample[at + 2] = val / adj;
    } else {
        va_sample[at] = br_read(1, bits);
        va_sample[at + 1] = br_read(1, bits);
        va_sample[at + 2] = br_read(1, bits);
    }
    var scale: i64 = 65536 / (adj + 1);
    adj = ((adj + 1) >> 1) - 1;
    var k: i64 = 0;
    while k < 3 {
        var v: i64 = (adj - va_sample[at + k]) * scale;
        va_sample[at + k] = (v * (sf >> 12) + ((v * (sf & 4095) + 2048) >> 12)) >> 12;
        k = k + 1;
    }
    return 0;
}

// a sample of subband k, sub-block ss, of channel c (as a real)
fn va_s(c: i64, k: i64, ss: i64) -> f64 {
    return va_sample[(c * 32 + k) * 3 + ss] as f64;
}
// the 32-point DCT of sub-block ss of channel c into V at dp (pl_mpeg's
// plm_audio_idct36, statement by statement)
fn va_idct36(c: i64, ss: i64, dp: i64) -> i64 {
