    var t02: f64 = (va_s(c, 0, ss) - va_s(c, 31, ss)) * 0.500602998235;
    var t03: f64 = (va_s(c, 1, ss) + va_s(c, 30, ss));
    var t04: f64 = (va_s(c, 1, ss) - va_s(c, 30, ss)) * 0.505470959898;
    var t05: f64 = (va_s(c, 2, ss) + va_s(c, 29, ss));
    var t06: f64 = (va_s(c, 2, ss) - va_s(c, 29, ss)) * 0.515447309923;
    var t07: f64 = (va_s(c, 3, ss) + va_s(c, 28, ss));
    var t08: f64 = (va_s(c, 3, ss) - va_s(c, 28, ss)) * 0.53104259109;
    var t09: f64 = (va_s(c, 4, ss) + va_s(c, 27, ss));
    var t10: f64 = (va_s(c, 4, ss) - va_s(c, 27, ss)) * 0.553103896034;
    var t11: f64 = (va_s(c, 5, ss) + va_s(c, 26, ss));
    var t12: f64 = (va_s(c, 5, ss) - va_s(c, 26, ss)) * 0.582934968206;
