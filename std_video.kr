// the film's sound, streamed (video_sound)
var vs_on: i64;
var vs_stream: i64;
var vs_voice: i64;
var vs_gen: i64;
var vs_hooked: i64;
var vs_src: [f64; 4608];   // decoded samples not yet given, stereo, as i16
var vs_n: i64;
var vs_base: i64;          // the sample of the sound vs_src starts at
var vs_o: i64;             // frames given to the stream since sample 0
var vs_last: i64;
var vs_buf: i64;

// ------------------------------------------------------------ the film ---
var vd_img: i64;           // the picture video_image gives
var vd_pic: i64;           // the picture's time, ms; -1 none yet
var vd_pts_v: f64;         // the first time stamps of the picture and of the
var vd_pts_a: f64;         // sound, seconds: the sound starts this much later
var vd_count: i64;         // pictures in the film
var vd_pics: i64;          // each picture's place in the video stream: its
var vd_ptype: i64;         // start code's, its type, the time it is shown at
var vd_pshow: i64;         // (a number: pictures before it)
var vd_afr: i64;           // each sound frame's place in the sound's stream

// the time stamp of a packet (33 bits, 90 kHz) at p, seconds
fn vd_time_at(p: i64) -> f64 {
    var c: i64 = ((vd_b(p) >> 1) & 7) << 30;
    c = c | (vd_b(p + 1) << 22) | ((vd_b(p + 2) >> 1) << 15);
    c = c | (vd_b(p + 3) << 7) | (vd_b(p + 4) >> 1);
    return (c as f64) / 90000.0;
}

// the program stream: the payloads of video 0xE0 and sound 0xC0 into
// their streams, one after the other
fn vd_demux() -> i64 {
    var p: i64 = vd_file;
    var n: i64 = vd_size;
    var i: i64 = 0;
    vd_pts_v = -1.0;
    vd_pts_a = -1.0;
    while i + 6 <= n {
        if vd_b(p + i) != 0 || vd_b(p + i + 1) != 0 || vd_b(p + i + 2) != 1 {
            i = i + 1;
        } else {
            var code: i64 = vd_b(p + i + 3);
            if code == 186 {
                // a pack header: MPEG-1's is 12 bytes, MPEG-2's 14 and stuffing
                if (vd_b(p + i + 4) >> 6) == 1 {
                    i = i + 14 + (vd_b(p + i + 13) & 7);
                } else {
                    i = i + 12;
                }
            } else if code == 185 {
                i = i + 4;
            } else if code >= 187 {
                var len: i64 = (vd_b(p + i + 4) << 8) | vd_b(p + i + 5);
                var at: i64 = i + 6;
                var end: i64 = at + len;
                if end > n { end = n; }
                if code == 224 || code == 192 {
                    // stuffing, the buffer's size, the time stamps
                    while at < end && vd_b(p + at) == 255 { at = at + 1; }
                    if at < end && (vd_b(p + at) >> 6) == 1 { at = at + 2; }
                    var pts: f64 = -1.0;
                    if at < end && (vd_b(p + at) >> 4) == 3 {
                        pts = vd_time_at(p + at);
                        at = at + 10;
                    } else if at < end && (vd_b(p + at) >> 4) == 2 {
                        pts = vd_time_at(p + at);
                        at = at + 5;
                    } else if at < end && (vd_b(p + at) >> 6) == 2 {
                        // MPEG-2's header: its length is in its third byte
                        if (vd_b(p + at + 1) & 128) != 0 { pts = vd_time_at(p + at + 3); }
                        at = at + 3 + vd_b(p + at + 2);
                    } else {
                        at = at + 1;
                    }
                    if at < end {
                        if code == 224 {
                            if vd_pts_v < 0.0 { vd_pts_v = pts; }
                            hp_copy(vd_ves + vd_vlen, p + at, end - at);
                            vd_vlen = vd_vlen + end - at;
                        } else {
                            if vd_pts_a < 0.0 { vd_pts_a = pts; }
                            hp_copy(vd_aes + vd_alen, p + at, end - at);
                            vd_alen = vd_alen + end - at;
                        }
                    }
                }
                i = i + 6 + len;
            } else {
                i = i + 4;
            }
        }
    }
    return 1;
}

// where each picture starts, its type, and when it is shown (groups of
// pictures number theirs from 0); where each sound frame starts
fn vd_index() -> i64 {
    vd_pics = list_new();
    vd_ptype = list_new();
    vd_pshow = list_new();
    vd_afr = list_new();
    br_p[0] = vd_ves;
    br_n[0] = vd_vlen;
    br_bit[0] = 0;
    var gop: i64 = 0;
    var seen: i64 = 0;
    var c: i64 = br_next_start(0);
    while c != -1 {
        if c == START_GOP {
            gop = seen;
        } else if c == START_PICTURE {
            var at: i64 = (br_bit[0] >> 3) - 4;
            var tref: i64 = br_read(0, 10);
            var t: i64 = br_read(0, 3);
            list_add(vd_pics, at);
            list_add(vd_ptype, t);
            list_add(vd_pshow, gop + tref);
            seen = seen + 1;
        }
        c = br_next_start(0);
    }
    vd_count = seen;
    // the sound's frames: a header each, at a size the header gives
    if vd_alen > 0 {
        br_p[1] = vd_aes;
        br_n[1] = vd_alen;
        br_bit[1] = 0;
        va_reset();
        var go: i64 = 1;
        while go == 1 {
            // where the reader is before the header: decoding from there
            // finds this frame again
            var before: i64 = br_bit[1];
            var size: i64 = va_header();
            if size <= 0 || !br_has(1, size << 3) {
                go = 0;
            } else {
                list_add(vd_afr, before);
                br_bit[1] = br_bit[1] + (size << 3);
            }
        }
    }
    return 1;
}

fn vd_check() -> i64 {
    if vd_on == 0 {
        fail "no film is open" hint "video_open first";
    }
    return 1;
}

fn vv_restart() -> i64 {
    br_p[0] = vd_ves;
    br_n[0] = vd_vlen;
    br_bit[0] = 0;
    vv_start = -1;
    vv_has_ref = 0;
    vv_frames = 0;
    vv_time = 0.0;
    vv_skip_b = 0;
    vv_ptype = 0;
    vv_out = -1;
    return 0;
}

fn video_open(path: i64) -> i64 {
    vt_init();
    if vd_on == 1 { video_close(); }
    var f: i64 = file_open(path, "r");
    if f == 0 {
        fail "cannot read the film" hint "check the name";
    }
    var size: i64 = file_size(f);
    vd_file = hp_alloc(size + 16);
    vd_ves = hp_alloc(size + 16);
    vd_aes = hp_alloc(size + 16);
    if vd_file == 0 || vd_ves == 0 || vd_aes == 0 {
        file_close(f);
        fail "no memory for the film" hint "a shorter one";
    }
    file_read_at(f, 0, vd_file, size);
    file_close(f);
    vd_size = size;
    vd_vlen = 0;
    vd_alen = 0;
    if size > 4 && vd_b(vd_file) == 0 && vd_b(vd_file + 1) == 0 && vd_b(vd_file + 2) == 1 && vd_b(vd_file + 3) == START_SEQUENCE {
        // a video stream alone (.m1v)
        hp_copy(vd_ves, vd_file, size);
        vd_vlen = size;
        vd_pts_v = 0.0;
        vd_pts_a = 0.0;
    } else {
        vd_demux();
    }
    hp_zero(vd_ves + vd_vlen, 16);
    hp_zero(vd_aes + vd_alen, 16);
    vv_has_seq = 0;
    vd_index();
    vv_restart();
    if vv_has_header() == 0 || vd_count == 0 {
        fail "this is no MPEG-1 film" hint "an .mpg of MPEG-1 video (ffmpeg: -c:v mpeg1video -c:a mp2 -f mpeg)";
    }
    vv_restart();
    if vd_img != 0 { image_free(vd_img); }
    vd_img = image_new(vv_w, vv_h);
    vd_pic = -1;
    vd_on = 1;
    return 1;
}

fn video_close() -> i64 {
    if vd_on == 0 { return 0; }
    if vs_voice != 0 { audio_stop(vs_voice); }
    vs_on = 0;
    hp_release(vd_file);
    hp_release(vd_ves);
    hp_release(vd_aes);
    hp_release(vv_data);
    vd_on = 0;
    vv_has_seq = 0;
    return 1;
}

fn video_width() -> i64 { vd_check(); return vv_w; }
fn video_height() -> i64 { vd_check(); return vv_h; }
fn video_fps() -> f64 { vd_check(); return vv_fps; }
fn video_length() -> i64 {
    vd_check();
    return ((vd_count as f64) * 1000.0 / vv_fps) as i64;
}
fn video_has_sound() -> i64 {
    vd_check();
    return list_len(vd_afr) > 0;
}
fn video_time() -> i64 { vd_check(); return vd_pic; }

// the next picture into video_image: 1, 0 after the last
fn video_next() -> i64 {
    vd_check();
    var t: f64 = vv_time;
    if vv_decode() == 0 { return 0; }
    lock_take(HP_LOCK);
    var q: i64 = im_pixels(vd_img);
    lock_give(HP_LOCK);
    vv_to_bgra(vv_out, q + 16);
    vd_pic = (t * 1000.0) as i64;
    return 1;
}

// the pictures up to the one shown at ms: 1 when the picture changed
fn video_frame_at(ms: i64) -> i64 {
    vd_check();
    var changed: i64 = 0;
    if ms < vd_pic {
        video_seek(ms);
        changed = 1;
    }
    var go: i64 = 1;
    while go == 1 && (vv_time * 1000.0) <= (ms as f64) {
        if video_next() == 1 {
            changed = 1;
        } else {
            go = 0;
        }
    }
    if vd_pic < 0 && video_next() == 1 { changed = 1; }
    return changed;
}

// to the picture shown at ms: the reference picture before it decoded
// first, then the ones after it to there
fn video_seek(ms0: i64) -> i64 {
    vd_check();
    var ms: i64 = ms0;
    if ms < 0 { ms = 0; }
    var want: i64 = ((ms as f64) * vv_fps / 1000.0) as i64;
    if want >= vd_count { want = vd_count - 1; }
    // the last intra picture (in the stream's order) shown at or before it
    var best: i64 = 0;
    var k: i64 = 0;
    while k < vd_count {
        if list_get(vd_ptype, k) == PIC_I && list_get(vd_pshow, k) <= want {
            best = k;
        }
        k = k + 1;
    }
    vv_restart();
    if best > 0 {
        br_bit[0] = (list_get(vd_pics, best) + 4) << 3;
        vv_start = START_PICTURE;
        vv_skip_b = 1;
        vv_frames = list_get(vd_pshow, best);
        vv_time = (vv_frames as f64) / vv_fps;
    }
    vd_pic = -1;
    var go: i64 = 1;
    while go == 1 {
        if video_next() == 0 {
            go = 0;
        } else if (vv_time * 1000.0) > (ms as f64) {
            go = 0;
        }
    }
    return 1;
}

fn video_image() -> i64 {
    vd_check();
    if vd_pic < 0 { video_next(); }
    return vd_img;
}

// ----------------------------------------------------------- its sound ---
// a stream of std_audio, filled as it plays from the sound's frames,
// made the device's rate

fn vs_i16(x0: f64) -> f64 {
    var x: f64 = x0 * 32767.0;
    if x > 32767.0 { x = 32767.0; }
    if x < -32768.0 { x = -32768.0; }
    return (x as i64) as f64;
}

// the next sound frame into vs_src: 0 at the end
fn vs_more() -> i64 {
    if va_decode() == 0 { return 0; }
    var k: i64 = vs_o * va_rate / au_rate - vs_base;
    if k > vs_n { k = vs_n; }
    if k > 0 {
        var i: i64 = 0;
        while i < (vs_n - k) * 2 {
            vs_src[i] = vs_src[i + k * 2];
            i = i + 1;
        }
        vs_n = vs_n - k;
        vs_base = vs_base + k;
    }
    var j: i64 = 0;
    while j < 1152 && vs_n < 2304 {
        vs_src[vs_n * 2] = vs_i16(va_out[j * 2]);
        vs_src[vs_n * 2 + 1] = vs_i16(va_out[j * 2 + 1]);
        vs_n = vs_n + 1;
        j = j + 1;
    }
    return 1;
}

fn vs_fill(arg: i64) -> i64 {
    if vs_on == 0 { return 0; }
    if vs_voice != 0 && audio_playing(vs_voice) == 0 {
        vs_on = 0;
        return 0;
    }
    var room: i64 = audio_stream_room(vs_stream);
    var made: i64 = 0;
    var inbuf: i64 = 0;
    var going: i64 = 1;
    var hz: i64 = va_rate;
    while made < room && going == 1 {
        var pos: i64 = vs_o * hz * 65536 / au_rate;
        var k: i64 = (pos >> 16) - vs_base;
        var k2: i64 = k + 1;
        if k2 >= vs_n && vs_last == 0 {
            if vs_more() == 0 { vs_last = 1; }
        } else if vs_last == 1 && vs_o >= (vs_base + vs_n) * au_rate / hz {
            going = 0;
        } else {
            if k2 >= vs_n { k2 = vs_n - 1; }
            if k >= vs_n { k = vs_n - 1; }
            if k < 0 { k = 0; }
            if k2 < 0 { k2 = 0; }
            var fr: i64 = pos & 65535;
            var c: i64 = 0;
            while c < 2 {
                var a: i64 = vs_src[k * 2 + c] as i64;
                var b: i64 = vs_src[k2 * 2 + c] as i64;
                var v: i64 = a + (b - a) * fr / 65536;
                raw { poke16(vs_buf + inbuf * 4 + c * 2, v); }
                c = c + 1;
            }
            vs_o = vs_o + 1;
            inbuf = inbuf + 1;
            made = made + 1;
            if inbuf == 1024 {
                audio_stream_write(vs_stream, vs_buf, inbuf);
                inbuf = 0;
            }
        }
    }
    if inbuf > 0 { audio_stream_write(vs_stream, vs_buf, inbuf); }
    if going == 0 {
        audio_stream_end(vs_stream);
        vs_on = 0;
    }
    return made;
}

// the sound from frame (at the device's rate) of the film's time: the
// frame before it decoded first, for the filter bank's history
fn vs_from(frame0: i64) -> i64 {
    var frame: i64 = frame0;
    if frame < 0 { frame = 0; }
    var t: i64 = frame * va_rate / au_rate;
    var fi: i64 = t / 1152;
    var nf: i64 = list_len(vd_afr);
    br_p[1] = vd_aes;
    br_n[1] = vd_alen;
    va_reset();
    if fi >= nf {
        br_bit[1] = vd_alen * 8;
    } else if fi > 0 {
        br_bit[1] = list_get(vd_afr, fi - 1);
        va_decode();
    } else {
        br_bit[1] = list_get(vd_afr, 0);
    }
    au_stream_restart(vs_stream, frame);
    vs_o = frame;
    vs_base = fi * 1152;
    vs_n = 0;
    vs_last = 0;
    vs_on = 1;
    return 1;
}

// st's position set (audio_seek): 1 when it is the film's
fn vs_seek(st: i64, frame: i64) -> i64 {
    if vd_on == 0 || st != vs_stream || vs_stream == 0 { return 0; }
    vs_from(frame);
    vs_fill(0);
    return 1;
}

// the film's sound, from the time of the picture shown: its voice, 0 when
// the film has none
fn video_sound(volume: f64) -> i64 {
    vd_check();
    if au_on == 0 {
        fail "the sound is not open" hint "audio_open first";
    }
    if list_len(vd_afr) == 0 { return 0; }
    if vs_voice != 0 { audio_stop(vs_voice); }
    vs_on = 0;
    if vs_stream == 0 || vs_gen != au_gen {
        vs_stream = audio_stream_new(au_rate / 2);
        if vs_buf == 0 { vs_buf = hp_alloc(1024 * 4 + 8); }
        vs_gen = au_gen;
    }
    if vs_hooked == 0 {
        au_add_hook(vs_fill);
        au_add_seekhook(vs_seek);
        vs_hooked = 1;
    }
    var ms: i64 = vd_pic;
    if ms < 0 { ms = 0; }
    vs_voice = 0;
    va_rate = vt_srate[va_srate_i];
    vs_from(ms * au_rate / 1000);
    vs_fill(0);
    vs_voice = audio_stream_play(vs_stream, volume);
    return vs_voice;
}

