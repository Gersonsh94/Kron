// =========================================================================
// TEST (must be rejected): a call with fewer arguments than the function
// takes -- the last one would be whatever its register held.
// =========================================================================

fn parallel_for(n: i64, workers: i64, dt: f64) -> i64 {
    return n * workers;
}

fn main() {
    print(parallel_for(4, 1));
    return 0;
}
