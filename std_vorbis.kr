// ------------------------------------------------------------- the front ---
fn vorbis_open(path: i64) -> i64 {
    if ogg_open(path) == 0 {
        fail "this Ogg file could not be read" hint "check the path, and that it is an .ogg";
    }
    if ogg_count() < 3 {
        fail "this Ogg file has no Vorbis in it" hint "it needs its three headers";
    }
    vb_read_headers();
    vb_tables(0, vb_bs0);
    vb_tables(1, vb_bs1);
    vb_inv_db_init();
    vb_total = 0;
    var i: i64 = 0;
    while i < ogg_count() {
        if ogg_granule(i) > vb_total { vb_total = ogg_granule(i); }
        i = i + 1;
    }
    vb_next_pk = 3;
    vb_done = 0;
    vb_prevn = 0;
    vb_outn = 0;
    return 1;
}

fn vorbis_channels() -> i64 { return vb_ch; }

fn vorbis_rate() -> i64 { return vb_rate; }

fn vorbis_length() -> i64 { return vb_total; }

// sample i of channel c of the last packet, about -1 to 1
fn vorbis_sample(c: i64, i: i64) -> f64 {
    if c < 0 || c >= vb_ch || i < 0 || i >= vb_outn {
        fail "no such sample" hint "a channel below vorbis_channels(), i below what vorbis_next gave";
    }
    return vb_out[c * 4096 + i];
}

// frame i of the last packet, as one side of stereo (0 left, 1 right). The
// channels are in Vorbis's order (its specification, 4.3.9): with more than
// two, the centre and the rear of that side are mixed in at -3 dB and the
// low-frequency channel is left out; the sum is scaled not to clip.
fn vb_side(i: i64, side: i64) -> f64 {
    if vb_ch == 1 { return vb_out[i]; }
    if vb_ch == 2 { return vb_out[side * 4096 + i]; }
    var front: i64 = side * 2;          // L 0, R 2, with the centre at 1
    var center: i64 = 1;
    var rear: i64 = -1;
    var rear2: i64 = -1;
    if vb_ch == 4 {
        front = side;                    // FL FR RL RR
        center = -1;
        rear = 2 + side;
    }
    if vb_ch == 5 || vb_ch == 6 { rear = 3 + side; }
    if vb_ch == 7 {
        rear = 3 + side;                 // FL C FR SL SR RC LFE
        rear2 = 5;
    }
    if vb_ch == 8 {
        rear = 3 + side;                 // FL C FR SL SR RL RR LFE
        rear2 = 5 + side;
    }
    var x: f64 = vb_out[front * 4096 + i];
    var w: f64 = 1.0;
    if center >= 0 {
        x = x + 0.7071 * vb_out[center * 4096 + i];
        w = w + 0.7071;
    }
    if rear >= 0 {
        x = x + 0.7071 * vb_out[rear * 4096 + i];
        w = w + 0.7071;
    }
    if rear2 >= 0 {
        x = x + 0.7071 * vb_out[rear2 * 4096 + i];
        w = w + 0.7071;
    }
    return x / w;
}

// the file open, decoded from where it is to its end, as stereo i16 frames
// at rate: the block of the heap and how many frames it holds
fn vorbis_to_stereo(rate: i64) -> (i64, i64) {
    if rate < 8000 || rate > 192000 {
        fail "no such sample rate" hint "48000 or 44100";
    }
    var nin: i64 = vb_total - vb_done;
    if nin <= 0 { nin = 1; }
    // the file's frames, stereo i16 at its own rate
    var src: i64 = hp_alloc(nin * 4 + 8);
    if src == 0 {
        fail "no memory for the sound" hint "a shorter one";
    }
    var have: i64 = 0;
    var n: i64 = vorbis_next();
    while n >= 0 {
        var i: i64 = 0;
        while i < n && have < nin {
            var c: i64 = 0;
            while c < 2 {
                var x: f64 = vb_side(i, c) * 32767.0;
                if x > 32767.0 { x = 32767.0; }
                if x < -32768.0 { x = -32768.0; }
                var v: i64 = x as i64;
                raw { poke16(src + have * 4 + c * 2, v); }
                c = c + 1;
            }
            have = have + 1;
            i = i + 1;
        }
        n = vorbis_next();
    }
    if have == 0 {
        hp_release(src);
        fail "this Ogg Vorbis file has no sound in it" hint "it has headers but no audio";
    }
    // to the rate asked for, by straight lines between frames
    var nout: i64 = have * rate / vb_rate;
    var p: i64 = hp_alloc(nout * 4 + 8);
    if p == 0 {
        hp_release(src);
        fail "no memory for the sound" hint "a shorter one";
    }
    var o: i64 = 0;
    while o < nout {
        var pos: i64 = o * vb_rate * 65536 / rate;
        var k: i64 = pos >> 16;
        var fr: i64 = pos & 65535;
        var k2: i64 = k + 1;
        if k2 >= have { k2 = have - 1; }
        var c2: i64 = 0;
        while c2 < 2 {
            var a: i64 = au_le16(src + k * 4 + c2 * 2);
            var b: i64 = au_le16(src + k2 * 4 + c2 * 2);
            var w: i64 = a + (b - a) * fr / 65536;
            raw { poke16(p + o * 4 + c2 * 2, w); }
            c2 = c2 + 1;
        }
        o = o + 1;
    }
    hp_release(src);
    return p, nout;
}

// the whole file as a sound of std_audio: stereo, at the device's rate
fn audio_load_ogg(path: i64) -> i64 {
    if au_on == 0 {
        fail "the sound is not open" hint "audio_open first";
    }
    if vs_on == 1 {
        fail "an Ogg stream is playing" hint "audio_stop it first: the decoder is one";
    }
    vorbis_open(path);
    var p, frames = vorbis_to_stereo(au_rate);
    return au_add_sound(p, frames);
}

// ------------------------------------------------------------- streaming ---

// the decoder back to the first audio packet, the file kept
fn vb_rewind() -> i64 {
    vb_next_pk = 3;
    vb_done = 0;
    vb_prevn = 0;
    vb_outn = 0;
    return 0;
}

// the frames of the next packet into vs_src; 0 when the file has no more
fn vs_more() -> i64 {
    var n: i64 = vorbis_next();
    while n == 0 {
        n = vorbis_next();
    }
    if n < 0 && vs_loop == 1 {
        vb_rewind();
        n = vorbis_next();
        while n == 0 {
            n = vorbis_next();
        }
    }
    if n < 0 { return 0; }
    // what is behind the position goes
    var k: i64 = vs_o * vb_rate / au_rate - vs_base;
    if k > 0 {
        var i: i64 = 0;
        while i < (vs_n - k) * 2 {
            vs_src[i] = vs_src[i + k * 2];
            i = i + 1;
        }
        vs_n = vs_n - k;
        vs_base = vs_base + k;
    }
    var j: i64 = 0;
    while j < n && vs_n < 8192 {
        vs_src[vs_n * 2] = vb_side(j, 0);
        vs_src[vs_n * 2 + 1] = vb_side(j, 1);
        vs_n = vs_n + 1;
        j = j + 1;
    }
    return 1;
}

// as much as the stream has room for, at the device's rate
fn vs_fill(arg: i64) -> i64 {
    if vs_on == 0 { return 0; }
    if vs_voice != 0 && audio_playing(vs_voice) == 0 {
        vs_on = 0;                   // stopped: nothing more to decode
        return 0;
    }
    var room: i64 = audio_stream_room(vs_stream);
    var made: i64 = 0;
    var inbuf: i64 = 0;
    var going: i64 = 1;
    while made < room && going == 1 {
        // where this frame falls in the file, worked out from the start each
        // time, not added up: an added step drifts (44100/48000 is no
        // 65536th)
        var pos: i64 = vs_o * vb_rate * 65536 / au_rate;
        var k: i64 = (pos >> 16) - vs_base;
        var k2: i64 = k + 1;
        if k2 >= vs_n && vs_last == 0 {
            if vs_more() == 0 {
                // the file's end: its frames all in, as many out as the
                // whole decode gives (vorbis_to_stereo), the last one with
                // no neighbour after it
                vs_last = 1;
            }
        } else if vs_last == 1 && vs_o >= (vs_base + vs_n) * au_rate / vb_rate {
            going = 0;
        } else {
            if k2 >= vs_n { k2 = vs_n - 1; }
            if k >= vs_n { k = vs_n - 1; }
            var fr: f64 = ((pos & 65535) as f64) / 65536.0;
            var c: i64 = 0;
            while c < 2 {
                var a: f64 = vs_src[k * 2 + c];
                var b: f64 = vs_src[k2 * 2 + c];
                var x: f64 = (a + (b - a) * fr) * 32767.0;
                if x > 32767.0 { x = 32767.0; }
                if x < -32768.0 { x = -32768.0; }
                var v: i64 = x as i64;
                raw { poke16(vs_buf + inbuf * 4 + c * 2, v); }
                c = c + 1;
            }
            vs_o = vs_o + 1;
            inbuf = inbuf + 1;
            made = made + 1;
            if inbuf == 1024 {
                audio_stream_write(vs_stream, vs_buf, inbuf);
                inbuf = 0;
            }
        }
    }
    if inbuf > 0 { audio_stream_write(vs_stream, vs_buf, inbuf); }
    if going == 0 {
        audio_stream_end(vs_stream);
        vs_on = 0;
    }
    return made;
}

// a voice playing the Ogg Vorbis file at path as it is decoded
fn audio_stream_ogg(path: i64, volume: f64, looping: i64) -> i64 {
    if au_on == 0 {
        fail "the sound is not open" hint "audio_open first";
    }
    if vs_on == 1 && vs_voice != 0 && audio_playing(vs_voice) == 1 {
        fail "an Ogg stream is playing already" hint "one at a time: audio_stop it first";
    }
    vorbis_open(path);
    if vs_stream == 0 {
        vs_stream = audio_stream_new(au_rate / 2);
        vs_buf = hp_alloc(1024 * 4 + 8);
    }
    var k: i64 = vs_stream - 1;
    au_st_read[k] = 0;
    au_st_write[k] = 0;
    au_st_end[k] = 0;
    vs_o = 0;
    vs_base = 0;
    vs_n = 0;
    vs_last = 0;
    vs_loop = looping;
    vs_voice = 0;
    vs_on = 1;
    au_set_hook(vs_fill);
    vs_fill(0);
    vs_voice = audio_stream_play(vs_stream, volume);
    return vs_voice;
}
