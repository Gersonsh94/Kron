kron_program
kron_domain test_float;
kron_imports
kron_definitions

fn main() {
    // Basic float arithmetic
    var a: real64 = 3.5;
    var b: real64 = 2.0;

    print(a + b);      // 5.5
    print(a - b);      // 1.5
    print(a * b);      // 7.0
    print(a / b);      // 1.75

    // What 3D needs: dot product of two Vec3
    // v1 = (1.0, 2.0, 3.0), v2 = (4.0, 5.0, 6.0)
    // dot = 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32.0
    var x1: real64 = 1.0;
    var y1: real64 = 2.0;
    var z1: real64 = 3.0;
    var x2: real64 = 4.0;
    var y2: real64 = 5.0;
    var z2: real64 = 6.0;

    var dot: real64 = x1 * x2 + y1 * y2 + z1 * z2;
    print(dot);        // 32.0

    // Magnitud al cuadrado de v1: 1 + 4 + 9 = 14.0
    var magsq: real64 = x1 * x1 + y1 * y1 + z1 * z1;
    print(magsq);      // 14.0

    return 0;
}
