kron_program
kron_domain std_mp3;
kron_imports
acquire_domain "std_math.kr";
acquire_domain "std_audio.kr";
kron_definitions

// =========================================================================
// Kron standard library -- MP3, decoded in Kron.
//
//     audio_open(48000);
//     var shot: i64 = audio_load_mp3("shot.mp3");        // a sound, as a .wav is
//     var music: i64 = audio_stream_mp3("theme.mp3", 0.5, 1);   // played as it is decoded
//
// Or frame by frame:
//
//     mp3_open("theme.mp3");
//     var n: i64 = mp3_next();          // frames of sound this one gave, -1 at the end
//     while n >= 0 {
//         ... mp3_sample(channel, i) for i from 0 to n - 1, from -1 to 1
//         n = mp3_next();
//     }
//
//     mp3_open(path)          1, or a fail
//     mp3_channels()  mp3_rate()  mp3_length()   frames of sound in all
//     mp3_next()  mp3_sample(channel, i)
//     mp3_to_stereo(rate)     the rest of the file as stereo i16: address, frames
//     audio_load_mp3(path)    the whole file as a sound of std_audio
//     audio_stream_mp3(path, volume, loop)
//                             a voice playing the file as it is decoded,
//                             half a second ahead; four at a time, with
//                             mp3_open and audio_load_mp3 besides.
//                             audio_seek and audio_position work on it.
//
// MPEG-1 and MPEG-2 (and 2.5) audio layer III: every bit rate, mono,
// stereo, joint stereo (mid/side and intensity), long, short and mixed
// blocks, the bit reservoir. An ID3v2 tag at the start is stepped over; a
// Xing or Info frame is no sound, and the encoder's delay and padding its
// LAME tag gives are left out, so the sound starts where the music does.
// Layers I and II are refused with a message, and so is free format.
//
// The decoder follows minimp3 (github.com/lieff/minimp3, public domain
// under CC0) step by step, its tables as they are, in doubles where it
// works in floats: the same sound, to the last bit or one away.
// =========================================================================

// ---- the tables of the standard (ISO 11172-3, 13818-3), as minimp3 lays them out ----
var m3_scf_long: [i64; 184];
var m3_scf_short: [i64; 320];
var m3_scf_mixed: [i64; 320];
var m3_scf_part: [i64; 84];
var m3_scfc: [i64; 16];
var m3_mod: [i64; 24];
var m3_preamp: [i64; 10];
var m3_tabs: [i64; 2164];
var m3_tab32: [i64; 28];
var m3_tab33: [i64; 16];
var m3_tabindex: [i64; 32];
var m3_linbits: [i64; 32];
var m3_expfrac: [f64; 4];
var m3_pow43: [f64; 145];
var m3_pan: [f64; 14];
var m3_aa: [f64; 16];
var m3_twid9: [f64; 18];
var m3_twid3: [f64; 6];
var m3_mdct_win: [f64; 36];
var m3_sec: [f64; 24];
var m3_win: [f64; 240];

