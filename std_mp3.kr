// ------------------------------------------------------------ number text ---
// "1,-2.5,3e-10": the numbers of a table, into it
var m3_pos: i64;

fn m3_num(t: i64) -> f64 {
    var c: i64 = 0;
    raw { c = peek8(t + m3_pos); }
    var neg: i64 = 0;
    if c == 45 {
        neg = 1;
        m3_pos = m3_pos + 1;
    }
    var v: f64 = 0.0;
    var scale: f64 = 1.0;
    var frac: i64 = 0;
    var go: i64 = 1;
    while go == 1 {
        raw { c = peek8(t + m3_pos); }
        if c >= 48 && c <= 57 {
            if frac == 1 {
                scale = scale / 10.0;
                v = v + ((c - 48) as f64) * scale;
            } else {
                v = v * 10.0 + ((c - 48) as f64);
            }
            m3_pos = m3_pos + 1;
        } else if c == 46 {
            frac = 1;
            m3_pos = m3_pos + 1;
        } else {
            go = 0;
        }
    }
    if c == 101 {
        m3_pos = m3_pos + 1;
        var eneg: i64 = 0;
        raw { c = peek8(t + m3_pos); }
        if c == 45 {
            eneg = 1;
            m3_pos = m3_pos + 1;
        }
        var e: i64 = 0;
        raw { c = peek8(t + m3_pos); }
        while c >= 48 && c <= 57 {
            e = e * 10 + c - 48;
            m3_pos = m3_pos + 1;
            raw { c = peek8(t + m3_pos); }
        }
        while e > 0 {
            if eneg == 1 { v = v / 10.0; } else { v = v * 10.0; }
            e = e - 1;
        }
    }
    raw { c = peek8(t + m3_pos); }
    if c == 44 { m3_pos = m3_pos + 1; }
    if neg == 1 { return 0.0 - v; }
    return v;
}

fn m3_fill_i(arr: i64, t: i64, n: i64) -> i64 {
    m3_pos = 0;
    var i: i64 = 0;
    while i < n {
        var v: i64 = m3_num(t) as i64;
        raw { poke(arr + i * 8, v); }
        i = i + 1;
    }
    return 0;
}

fn m3_fill_f(arr: i64, t: i64, n: i64) -> i64 {
    m3_pos = 0;
    var one: [f64; 1];
    var i: i64 = 0;
    while i < n {
        one[0] = m3_num(t);
        raw { poke(arr + i * 8, peek(&one)); }
        i = i + 1;
    }
    return 0;
}

// ------------------------------------------------------------- the header ---
// a frame header, its four bytes as one number: byte 0 lowest
fn mh(h: i64, i: i64) -> i64 { return (h >> (i * 8)) & 255; }
fn mh_mono(h: i64) -> i64 { return (mh(h, 3) & 192) == 192; }
fn mh_ms(h: i64) -> i64 { return (mh(h, 3) & 224) == 96; }
fn mh_free(h: i64) -> i64 { return (mh(h, 2) & 240) == 0; }
fn mh_crc(h: i64) -> i64 { return (mh(h, 1) & 1) == 0; }
fn mh_padding(h: i64) -> i64 { return (mh(h, 2) & 2) != 0; }
fn mh_mpeg1(h: i64) -> i64 { return (mh(h, 1) & 8) != 0; }
fn mh_not25(h: i64) -> i64 { return (mh(h, 1) & 16) != 0; }
fn mh_istereo(h: i64) -> i64 { return (mh(h, 3) & 16) != 0; }
fn mh_msbit(h: i64) -> i64 { return (mh(h, 3) & 32) != 0; }
fn mh_layer(h: i64) -> i64 { return (mh(h, 1) >> 1) & 3; }
fn mh_bitrate(h: i64) -> i64 { return mh(h, 2) >> 4; }
fn mh_srate(h: i64) -> i64 { return (mh(h, 2) >> 2) & 3; }
fn mh_mysr(h: i64) -> i64 { return mh_srate(h) + (((mh(h, 1) >> 3) & 1) + ((mh(h, 1) >> 4) & 1)) * 3; }
fn mh_576(h: i64) -> i64 { return (mh(h, 1) & 14) == 2; }
fn mh_layer1(h: i64) -> i64 { return (mh(h, 1) & 6) == 6; }

fn mh_at(p: i64) -> i64 {
    var v: i64 = 0;
    raw { v = peek32(p); }
    return v & 4294967295;
}

fn mh_valid(h: i64) -> i64 {
    if mh(h, 0) != 255 { return 0; }
    if (mh(h, 1) & 240) != 240 && (mh(h, 1) & 254) != 226 { return 0; }
    if mh_layer(h) == 0 || mh_bitrate(h) == 15 || mh_srate(h) == 3 { return 0; }
    return 1;
}

fn mh_compare(h1: i64, h2: i64) -> i64 {
    if mh_valid(h2) == 0 { return 0; }
    if ((mh(h1, 1) ^ mh(h2, 1)) & 254) != 0 { return 0; }
    if ((mh(h1, 2) ^ mh(h2, 2)) & 12) != 0 { return 0; }
    if mh_free(h1) != mh_free(h2) { return 0; }
    return 1;
}

// kilobits a second
fn mh_kbps(h: i64) -> i64 {
    var m1: i64 = 0;
    if mh_mpeg1(h) { m1 = 1; }
    var l: i64 = mh_layer(h) - 1;
    var b: i64 = mh_bitrate(h);
    var t: i64 = "0,4,8,12,16,20,24,28,32,40,48,56,64,72,80,0,4,8,12,16,20,24,28,32,40,48,56,64,72,80,0,16,24,28,32,40,48,56,64,72,80,88,96,112,128,0,16,20,24,28,32,40,48,56,64,80,96,112,128,160,0,16,24,28,32,40,48,56,64,80,96,112,128,160,192,0,16,32,48,64,80,96,112,128,144,160,176,192,208,224";
    m3_pos = 0;
    var k: i64 = (m1 * 3 + l) * 15 + b;
    var v: i64 = 0;
    var i: i64 = 0;
    while i <= k {
        v = m3_num(t) as i64;
        i = i + 1;
    }
    return 2 * v;
}

fn mh_hz(h: i64) -> i64 {
    var s: i64 = mh_srate(h);
    var hz: i64 = 44100;
    if s == 1 { hz = 48000; }
    if s == 2 { hz = 32000; }
    if mh_mpeg1(h) == 0 { hz = hz >> 1; }
    if mh_not25(h) == 0 { hz = hz >> 1; }
    return hz;
}

fn mh_samples(h: i64) -> i64 {
    if mh_layer1(h) { return 384; }
    if mh_576(h) { return 576; }
    return 1152;
}

fn mh_bytes(h: i64, free_size: i64) -> i64 {
    var fb: i64 = mh_samples(h) * mh_kbps(h) * 125 / mh_hz(h);
    if mh_layer1(h) { fb = fb & ~3; }
    if fb == 0 { return free_size; }
    return fb;
}

fn mh_pad(h: i64) -> i64 {
    if mh_padding(h) == 0 { return 0; }
    if mh_layer1(h) { return 4; }
    return 1;
}

// ------------------------------------------------------------- the bits ---
var bs_buf: i64;
var bs_pos: i64;
var bs_limit: i64;

fn bs_init(data: i64, bytes: i64) -> i64 {
    bs_buf = data;
    bs_pos = 0;
    bs_limit = bytes * 8;
    return 0;
}

fn mp_byte(p: i64) -> i64 {
    var v: i64 = 0;
    raw { v = peek8(p); }
    return v;
}

fn get_bits(n: i64) -> i64 {
    var s: i64 = bs_pos & 7;
    var shl: i64 = n + s;
    var p: i64 = bs_buf + (bs_pos >> 3);
    bs_pos = bs_pos + n;
    if bs_pos > bs_limit { return 0; }
    var next: i64 = mp_byte(p) & (255 >> s);
    p = p + 1;
    var cache: i64 = 0;
    shl = shl - 8;
    while shl > 0 {
        cache = cache | (next << shl);
        next = mp_byte(p);
        p = p + 1;
        shl = shl - 8;
    }
    return (cache | (next >> (0 - shl))) & 4294967295;
}

// ------------------------------------------------------- the side info ---
// four granule-channels: 0 1 the first granule's channels, 2 3 the second's
var gr_part23: [i64; 4];
var gr_bigv: [i64; 4];
var gr_sfc: [i64; 4];
var gr_gain: [i64; 4];
var gr_btype: [i64; 4];
var gr_mixed: [i64; 4];
var gr_nlong: [i64; 4];
var gr_nshort: [i64; 4];
var gr_tsel: [i64; 12];
var gr_rcount: [i64; 12];
var gr_sbg: [i64; 12];
var gr_preflag: [i64; 4];
var gr_scfscale: [i64; 4];
var gr_c1tab: [i64; 4];
var gr_scfsi: [i64; 4];
var gr_sfk: [i64; 4];           // the band table: 0 long, 1 short, 2 mixed
var gr_sfo: [i64; 4];           // where its row starts

// band i of granule-channel g's table, from off on
fn mp_sfb(g: i64, i: i64) -> i64 {
    var k: i64 = gr_sfk[g];
    var at: i64 = gr_sfo[g] + i;
    if k == 0 { return m3_scf_long[at]; }
    if k == 1 { return m3_scf_short[at]; }
    return m3_scf_mixed[at];
}

fn l3_side_info(h: i64) -> i64 {
    var scfsi: i64 = 0;
    var mdb: i64 = 0;
    var sum: i64 = 0;
    var sr: i64 = mh_mysr(h);
    if sr != 0 { sr = sr - 1; }
    var count: i64 = 2;
    if mh_mono(h) { count = 1; }
    if mh_mpeg1(h) {
        count = count * 2;
        mdb = get_bits(9);
        scfsi = get_bits(7 + count);
    } else {
        mdb = get_bits(8 + count) >> count;
    }
    var g: i64 = 0;
    while g < count {
        if mh_mono(h) { scfsi = scfsi << 4; }
        gr_part23[g] = get_bits(12);
        sum = sum + gr_part23[g];
        gr_bigv[g] = get_bits(9);
        if gr_bigv[g] > 288 { return -1; }
        gr_gain[g] = get_bits(8);
        if mh_mpeg1(h) {
            gr_sfc[g] = get_bits(4);
        } else {
            gr_sfc[g] = get_bits(9);
        }
        gr_sfk[g] = 0;
        gr_sfo[g] = sr * 23;
        gr_nlong[g] = 22;
        gr_nshort[g] = 0;
        var tables: i64 = 0;
        if get_bits(1) != 0 {
            gr_btype[g] = get_bits(2);
            if gr_btype[g] == 0 { return -1; }
            gr_mixed[g] = get_bits(1);
            gr_rcount[g * 3] = 7;
            gr_rcount[g * 3 + 1] = 255;
            if gr_btype[g] == 2 {
                scfsi = scfsi & 3855;
                if gr_mixed[g] == 0 {
                    gr_rcount[g * 3] = 8;
                    gr_sfk[g] = 1;
                    gr_sfo[g] = sr * 40;
                    gr_nlong[g] = 0;
                    gr_nshort[g] = 39;
                } else {
                    gr_sfk[g] = 2;
                    gr_sfo[g] = sr * 40;
                    if mh_mpeg1(h) { gr_nlong[g] = 8; } else { gr_nlong[g] = 6; }
                    gr_nshort[g] = 30;
                }
            }
            tables = get_bits(10);
            tables = tables << 5;
            gr_sbg[g * 3] = get_bits(3);
            gr_sbg[g * 3 + 1] = get_bits(3);
            gr_sbg[g * 3 + 2] = get_bits(3);
        } else {
            gr_btype[g] = 0;
            gr_mixed[g] = 0;
            tables = get_bits(15);
            gr_rcount[g * 3] = get_bits(4);
            gr_rcount[g * 3 + 1] = get_bits(3);
            gr_rcount[g * 3 + 2] = 255;
        }
        gr_tsel[g * 3] = tables >> 10;
        gr_tsel[g * 3 + 1] = (tables >> 5) & 31;
        gr_tsel[g * 3 + 2] = tables & 31;
        if mh_mpeg1(h) {
            gr_preflag[g] = get_bits(1);
        } else {
            gr_preflag[g] = 0;
            if gr_sfc[g] >= 500 { gr_preflag[g] = 1; }
        }
        gr_scfscale[g] = get_bits(1);
        gr_c1tab[g] = get_bits(1);
        gr_scfsi[g] = (scfsi >> 12) & 15;
        scfsi = scfsi << 4;
        g = g + 1;
    }
    if sum + bs_pos > bs_limit + mdb * 8 { return -1; }
    return mdb;
}

// --------------------------------------------------------- scalefactors ---
var mp_ist: [i64; 78];          // the intensity positions, 39 a channel
var mp_iscf: [i64; 44];
var mp_scf: [f64; 44];

fn l3_read_scf(ist: i64, size: i64, part: i64, scfsi0: i64) -> i64 {
    var scfsi: i64 = scfsi0;
    var at: i64 = 0;
    var i: i64 = 0;
    while i < 4 {
        var cnt: i64 = m3_scf_part[part + i];
        if cnt == 0 { i = 4; } else {
            if (scfsi & 8) != 0 {
                var k: i64 = 0;
                while k < cnt {
                    mp_iscf[at + k] = mp_ist[ist + at + k];
                    k = k + 1;
                }
            } else {
                var bits: i64 = (size >> (i * 8)) & 255;
                if bits == 0 {
                    var k2: i64 = 0;
                    while k2 < cnt {
                        mp_iscf[at + k2] = 0;
                        mp_ist[ist + at + k2] = 0;
                        k2 = k2 + 1;
                    }
                } else {
                    var maxs: i64 = -1;
                    if scfsi < 0 { maxs = (1 << bits) - 1; }
                    var k3: i64 = 0;
                    while k3 < cnt {
                        var s: i64 = get_bits(bits);
                        if s == maxs {
                            mp_ist[ist + at + k3] = 255;
                        } else {
                            mp_ist[ist + at + k3] = s & 255;
                        }
                        mp_iscf[at + k3] = s & 255;
                        k3 = k3 + 1;
                    }
                }
            }
            at = at + cnt;
            i = i + 1;
            scfsi = scfsi * 2;
        }
    }
    mp_iscf[at] = 0;
    mp_iscf[at + 1] = 0;
    mp_iscf[at + 2] = 0;
    return 0;
}

fn l3_ldexp_q2(y0: f64, exp0: i64) -> f64 {
    var y: f64 = y0;
    var exp_q2: i64 = exp0;
    var go: i64 = 1;
    while go == 1 {
        var e: i64 = exp_q2;
        if e > 120 { e = 120; }
        y = y * m3_expfrac[e & 3] * (((1 << 30) >> (e >> 2)) as f64);
        exp_q2 = exp_q2 - e;
        if exp_q2 <= 0 { go = 0; }
    }
    return y;
}

fn l3_decode_scf(h: i64, g: i64, ch: i64) -> i64 {
    var pidx: i64 = 0;
    if gr_nshort[g] != 0 { pidx = pidx + 1; }
    if gr_nlong[g] == 0 { pidx = pidx + 1; }
    var part: i64 = pidx * 28;
    var shift: i64 = gr_scfscale[g] + 1;
    var scfsi: i64 = gr_scfsi[g];
    var size: i64 = 0;
    if mh_mpeg1(h) {
        var pt: i64 = m3_scfc[gr_sfc[g]];
        var a: i64 = pt >> 2;
        var b: i64 = pt & 3;
        size = a | (a << 8) | (b << 16) | (b << 24);
    } else {
        var ist: i64 = 0;
        if mh_istereo(h) && ch != 0 { ist = 1; }
        var sfc: i64 = gr_sfc[g] >> ist;
        var k: i64 = ist * 12;
        var sz: [i64; 4];
        while sfc >= 0 {
            var modprod: i64 = 1;
            var i: i64 = 3;
            while i >= 0 {
                sz[i] = (sfc / modprod) % m3_mod[k + i];
                modprod = modprod * m3_mod[k + i];
                i = i - 1;
            }
            sfc = sfc - modprod;
            k = k + 4;
        }
        size = sz[0] | (sz[1] << 8) | (sz[2] << 16) | (sz[3] << 24);
        part = part + k;
        scfsi = -16;
    }
    l3_read_scf(ch * 39, size, part, scfsi);
    var nl: i64 = gr_nlong[g];
    var ns: i64 = gr_nshort[g];
    if ns != 0 {
        var sh: i64 = 3 - shift;
        var i2: i64 = 0;
        while i2 < ns {
            mp_iscf[nl + i2] = (mp_iscf[nl + i2] + (gr_sbg[g * 3] << sh)) & 255;
            mp_iscf[nl + i2 + 1] = (mp_iscf[nl + i2 + 1] + (gr_sbg[g * 3 + 1] << sh)) & 255;
            mp_iscf[nl + i2 + 2] = (mp_iscf[nl + i2 + 2] + (gr_sbg[g * 3 + 2] << sh)) & 255;
            i2 = i2 + 3;
        }
    } else if gr_preflag[g] != 0 {
        var i3: i64 = 0;
        while i3 < 10 {
            mp_iscf[11 + i3] = (mp_iscf[11 + i3] + m3_preamp[i3]) & 255;
            i3 = i3 + 1;
        }
    }
    var ms: i64 = 0;
    if mh_ms(h) { ms = 2; }
    // BITS_DEQUANTIZER_OUT -1; MAX_SCF 41, MAX_SCFI 44
    var gain_exp: i64 = gr_gain[g] - 4 - 210 - ms;
    var gain: f64 = l3_ldexp_q2(((1 << 11) as f64), 44 - gain_exp);
    var i4: i64 = 0;
    while i4 < nl + ns {
        mp_scf[i4] = l3_ldexp_q2(gain, mp_iscf[i4] << shift);
        i4 = i4 + 1;
    }
    return 0;
}

fn l3_pow43(x0: i64) -> f64 {
    var x: i64 = x0;
    if x < 129 { return m3_pow43[16 + x]; }
    var mult: f64 = 256.0;
    if x < 1024 {
        mult = 16.0;
        x = x << 3;
    }
    var sign: i64 = (2 * x) & 64;
    var frac: f64 = (((x & 63) - sign) as f64) / (((x & ~63) + sign) as f64);
    return m3_pow43[16 + ((x + sign) >> 6)] * (1.0 + frac * ((4.0 / 3.0) + frac * (2.0 / 9.0))) * mult;
}

// ------------------------------------------------------------- huffman ---
var mp_gr: [f64; 1152];         // the granule's two channels, 576 each
var hc_cache: i64;
var hc_sh: i64;
var hc_next: i64;

fn hc_peek(n: i64) -> i64 { return hc_cache >> (32 - n); }

fn hc_flush(n: i64) -> i64 {
    hc_cache = (hc_cache << n) & 4294967295;
    hc_sh = hc_sh + n;
    return 0;
}

fn hc_check() -> i64 {
    while hc_sh >= 0 {
        hc_cache = hc_cache | (mp_byte(hc_next) << hc_sh);
        hc_next = hc_next + 1;
        hc_sh = hc_sh - 8;
    }
    hc_cache = hc_cache & 4294967295;
    return 0;
}

fn hc_neg() -> i64 { return (hc_cache >> 31) & 1; }

fn l3_huffman(dst0: i64, g: i64, limit: i64) -> i64 {
    var dst: i64 = dst0;
    var one: f64 = 0.0;
    var ireg: i64 = 0;
    var big: i64 = gr_bigv[g];
    var sfb: i64 = 0;
    var scf: i64 = 0;
    hc_next = bs_buf + bs_pos / 8;
    hc_cache = (((mp_byte(hc_next) * 256 + mp_byte(hc_next + 1)) * 256 + mp_byte(hc_next + 2)) * 256 + mp_byte(hc_next + 3));
    hc_cache = (hc_cache << (bs_pos & 7)) & 4294967295;
    hc_sh = (bs_pos & 7) - 8;
    hc_next = hc_next + 4;
    var np: i64 = 0;
    while big > 0 {
        var tab: i64 = gr_tsel[g * 3 + ireg];
        var sfbcnt: i64 = gr_rcount[g * 3 + ireg];
        ireg = ireg + 1;
        var cb: i64 = m3_tabindex[tab];
        var linbits: i64 = m3_linbits[tab];
        var again: i64 = 1;
        while again == 1 {
            np = mp_sfb(g, sfb) / 2;
            sfb = sfb + 1;
            var pairs: i64 = big;
            if np < pairs { pairs = np; }
            one = mp_scf[scf];
            scf = scf + 1;
            while pairs > 0 {
                var w: i64 = 5;
                var leaf: i64 = m3_tabs[cb + hc_peek(w)];
                while leaf < 0 {
                    hc_flush(w);
                    w = leaf & 7;
                    leaf = m3_tabs[cb + hc_peek(w) - (leaf >> 3)];
                }
                hc_flush(leaf >> 8);
                var j: i64 = 0;
                while j < 2 {
                    var lsb: i64 = leaf & 15;
                    if linbits != 0 && lsb == 15 {
                        lsb = lsb + hc_peek(linbits);
                        hc_flush(linbits);
                        hc_check();
                        var sg: f64 = 1.0;
                        if hc_neg() == 1 { sg = -1.0; }
                        mp_gr[dst] = one * l3_pow43(lsb) * sg;
                    } else {
                        mp_gr[dst] = m3_pow43[16 + lsb - 16 * hc_neg()] * one;
                    }
                    if lsb != 0 { hc_flush(1); }
                    dst = dst + 1;
                    leaf = leaf >> 4;
                    j = j + 1;
                }
                hc_check();
                pairs = pairs - 1;
            }
            big = big - np;
            sfbcnt = sfbcnt - 1;
            if big <= 0 || sfbcnt < 0 { again = 0; }
        }
    }
    np = 1 - big;
    var go: i64 = 1;
    while go == 1 {
        var c1: i64 = gr_c1tab[g];
        var leaf2: i64 = 0;
        if c1 != 0 { leaf2 = m3_tab33[hc_peek(4)]; } else { leaf2 = m3_tab32[hc_peek(4)]; }
        if (leaf2 & 8) == 0 {
            var idx: i64 = (leaf2 >> 3) + (((hc_cache << 4) & 4294967295) >> (32 - (leaf2 & 3)));
            if c1 != 0 { leaf2 = m3_tab33[idx]; } else { leaf2 = m3_tab32[idx]; }
        }
        hc_flush(leaf2 & 7);
        var pos: i64 = (hc_next - bs_buf) * 8 - 24 + hc_sh;
        if pos > limit {
            go = 0;
        } else {
            np = np - 1;
            if np == 0 {
                np = mp_sfb(g, sfb) / 2;
                sfb = sfb + 1;
                if np == 0 { go = 0; }
                if go == 1 {
                    one = mp_scf[scf];
                    scf = scf + 1;
                }
            }
            if go == 1 {
                hc_q(dst, leaf2, 0, one);
                hc_q(dst, leaf2, 1, one);
                np = np - 1;
                if np == 0 {
                    np = mp_sfb(g, sfb) / 2;
                    sfb = sfb + 1;
                    if np == 0 { go = 0; }
                    if go == 1 {
                        one = mp_scf[scf];
                        scf = scf + 1;
                    }
                }
                if go == 1 {
                    hc_q(dst, leaf2, 2, one);
                    hc_q(dst, leaf2, 3, one);
                    hc_check();
                    dst = dst + 4;
                }
            }
        }
    }
    bs_pos = limit;
    return 0;
}

// one value of a count1 quadruple
fn hc_q(dst: i64, leaf: i64, s: i64, one: f64) -> i64 {
    if (leaf & (128 >> s)) != 0 {
        if hc_neg() == 1 {
            mp_gr[dst + s] = 0.0 - one;
        } else {
            mp_gr[dst + s] = one;
        }
        hc_flush(1);
    }
    return 0;
}

// -------------------------------------------------------------- stereo ---
fn l3_midside(left: i64, n: i64) -> i64 {
    var i: i64 = 0;
    while i < n {
        var a: f64 = mp_gr[left + i];
        var b: f64 = mp_gr[left + 576 + i];
        mp_gr[left + i] = a + b;
        mp_gr[left + 576 + i] = a - b;
        i = i + 1;
    }
    return 0;
}

fn l3_is_band(left: i64, n: i64, kl: f64, kr: f64) -> i64 {
    var i: i64 = 0;
    while i < n {
        mp_gr[left + 576 + i] = mp_gr[left + i] * kr;
        mp_gr[left + i] = mp_gr[left + i] * kl;
        i = i + 1;
    }
    return 0;
}

var mp_maxb: [i64; 3];

fn l3_top_band(g: i64, nbands: i64) -> i64 {
    mp_maxb[0] = -1;
    mp_maxb[1] = -1;
    mp_maxb[2] = -1;
    var right: i64 = 576;
    var i: i64 = 0;
    while i < nbands {
        var w: i64 = mp_sfb(g, i);
        var k: i64 = 0;
        while k < w {
            if mp_gr[right + k] != 0.0 || mp_gr[right + k + 1] != 0.0 {
                mp_maxb[i % 3] = i;
                k = w;
            } else {
                k = k + 2;
            }
        }
        right = right + w;
        i = i + 1;
    }
    return 0;
}

fn l3_stereo_process(h: i64, g: i64, mpeg2_sh: i64) -> i64 {
    var maxpos: i64 = 64;
    if mh_mpeg1(h) { maxpos = 7; }
    var left: i64 = 0;
    var i: i64 = 0;
    while mp_sfb(g, i) != 0 {
        var w: i64 = mp_sfb(g, i);
        var ipos: i64 = mp_ist[39 + i];
        if i > mp_maxb[i % 3] && ipos < maxpos {
            var s: f64 = 1.0;
            if mh_msbit(h) { s = 1.41421356; }
            var kl: f64 = 0.0;
            var kr: f64 = 0.0;
            if mh_mpeg1(h) {
                kl = m3_pan[2 * ipos];
                kr = m3_pan[2 * ipos + 1];
            } else {
                kl = 1.0;
                kr = l3_ldexp_q2(1.0, ((ipos + 1) >> 1) << mpeg2_sh);
                if (ipos & 1) != 0 {
                    kl = kr;
                    kr = 1.0;
                }
            }
            l3_is_band(left, w, kl * s, kr * s);
        } else if mh_msbit(h) {
            l3_midside(left, w);
        }
        left = left + w;
        i = i + 1;
    }
    return 0;
}

fn l3_intensity(h: i64, g: i64) -> i64 {
    var nsfb: i64 = gr_nlong[g] + gr_nshort[g];
    var maxblocks: i64 = 1;
    if gr_nshort[g] != 0 { maxblocks = 3; }
    l3_top_band(g, nsfb);
    if gr_nlong[g] != 0 {
        var m: i64 = mp_maxb[0];
        if mp_maxb[1] > m { m = mp_maxb[1]; }
        if mp_maxb[2] > m { m = mp_maxb[2]; }
        mp_maxb[0] = m;
        mp_maxb[1] = m;
        mp_maxb[2] = m;
    }
    var i: i64 = 0;
    while i < maxblocks {
        var dp: i64 = 0;
        if mh_mpeg1(h) { dp = 3; }
        var itop: i64 = nsfb - maxblocks + i;
        var prev: i64 = itop - maxblocks;
        if mp_maxb[i] >= prev {
            mp_ist[39 + itop] = dp;
        } else {
            mp_ist[39 + itop] = mp_ist[39 + prev];
        }
        i = i + 1;
    }
    l3_stereo_process(h, g, gr_sfc[g + 1] & 1);
    return 0;
}

// ------------------------------------------------- reorder, antialias ---
var mp_tmp: [f64; 576];

fn l3_reorder(grb: i64, g: i64, off: i64) -> i64 {
    var src: i64 = grb;
    var d: i64 = 0;
    var b: i64 = off;
    var len: i64 = mp_sfb(g, b);
    while len != 0 {
        var i: i64 = 0;
        while i < len {
            mp_tmp[d] = mp_gr[src];
            mp_tmp[d + 1] = mp_gr[src + len];
            mp_tmp[d + 2] = mp_gr[src + 2 * len];
            d = d + 3;
            src = src + 1;
            i = i + 1;
        }
        src = src + 2 * len;
        b = b + 3;
        len = mp_sfb(g, b);
    }
    var k: i64 = 0;
    while k < d {
        mp_gr[grb + k] = mp_tmp[k];
        k = k + 1;
    }
    return 0;
}

fn l3_antialias(grb: i64, nb: i64) -> i64 {
    var at: i64 = grb;
    var n: i64 = nb;
    while n > 0 {
        var i: i64 = 0;
        while i < 8 {
            var u: f64 = mp_gr[at + 18 + i];
            var d: f64 = mp_gr[at + 17 - i];
            mp_gr[at + 18 + i] = u * m3_aa[i] - d * m3_aa[8 + i];
            mp_gr[at + 17 - i] = u * m3_aa[8 + i] + d * m3_aa[i];
            i = i + 1;
        }
        n = n - 1;
        at = at + 18;
    }
    return 0;
}

// ---------------------------------------------------------------- imdct ---
var mp_y: [f64; 9];

fn l3_dct3_9() -> i64 {
    var s0: f64 = mp_y[0];
    var s2: f64 = mp_y[2];
    var s4: f64 = mp_y[4];
    var s6: f64 = mp_y[6];
    var s8: f64 = mp_y[8];
    var t0: f64 = s0 + s6 * 0.5;
    s0 = s0 - s6;
    var t4: f64 = (s4 + s2) * 0.93969262;
    var t2: f64 = (s8 + s2) * 0.76604444;
    s6 = (s4 - s8) * 0.17364818;
    s4 = s4 + s8 - s2;
    s2 = s0 - s4 * 0.5;
    mp_y[4] = s4 + s0;
    s8 = t0 - t2 + s6;
    s0 = t0 - t4 + t2;
    s4 = t0 + t4 - s6;
    var s1: f64 = mp_y[1];
    var s3: f64 = mp_y[3];
    var s5: f64 = mp_y[5];
    var s7: f64 = mp_y[7];
    s3 = s3 * 0.86602540;
    t0 = (s5 + s1) * 0.98480775;
    t4 = (s5 - s7) * 0.34202014;
    t2 = (s1 + s7) * 0.64278761;
    s1 = (s1 - s5 - s7) * 0.86602540;
    s5 = t0 - s3 - t2;
    s7 = t4 - s3 - t0;
    s3 = t4 + s3 - t2;
    mp_y[0] = s4 - s7;
    mp_y[1] = s2 + s1;
    mp_y[2] = s0 - s3;
    mp_y[3] = s8 + s5;
    mp_y[5] = s8 - s5;
    mp_y[6] = s0 + s3;
    mp_y[7] = s2 - s1;
    mp_y[8] = s4 + s7;
    return 0;
}

var mp_co: [f64; 9];
var mp_si: [f64; 9];
var mp_ovl: [f64; 2880];        // the overlap of each decoder: 576 (two channels)
var mp_dec: i64;                // the decoder working now (0 .. 4)

fn l3_imdct36(grb0: i64, ovl0: i64, win: i64, nb: i64) -> i64 {
    var grb: i64 = grb0;
    var ovl: i64 = ovl0;
    var j: i64 = 0;
    while j < nb {
        mp_co[0] = 0.0 - mp_gr[grb];
        mp_si[0] = mp_gr[grb + 17];
        var i: i64 = 0;
        while i < 4 {
            mp_si[8 - 2 * i] = mp_gr[grb + 4 * i + 1] - mp_gr[grb + 4 * i + 2];
            mp_co[1 + 2 * i] = mp_gr[grb + 4 * i + 1] + mp_gr[grb + 4 * i + 2];
            mp_si[7 - 2 * i] = mp_gr[grb + 4 * i + 4] - mp_gr[grb + 4 * i + 3];
            mp_co[2 + 2 * i] = 0.0 - (mp_gr[grb + 4 * i + 3] + mp_gr[grb + 4 * i + 4]);
            i = i + 1;
        }
        var k: i64 = 0;
        while k < 9 { mp_y[k] = mp_co[k]; k = k + 1; }
        l3_dct3_9();
        k = 0;
        while k < 9 { mp_co[k] = mp_y[k]; mp_y[k] = mp_si[k]; k = k + 1; }
        l3_dct3_9();
        k = 0;
        while k < 9 { mp_si[k] = mp_y[k]; k = k + 1; }
        mp_si[1] = 0.0 - mp_si[1];
        mp_si[3] = 0.0 - mp_si[3];
        mp_si[5] = 0.0 - mp_si[5];
        mp_si[7] = 0.0 - mp_si[7];
        i = 0;
        while i < 9 {
            var o: f64 = mp_ovl[ovl + i];
            var sum: f64 = mp_co[i] * m3_twid9[9 + i] + mp_si[i] * m3_twid9[i];
            mp_ovl[ovl + i] = mp_co[i] * m3_twid9[i] - mp_si[i] * m3_twid9[9 + i];
            mp_gr[grb + i] = o * m3_mdct_win[win + i] - sum * m3_mdct_win[win + 9 + i];
            mp_gr[grb + 17 - i] = o * m3_mdct_win[win + 9 + i] + sum * m3_mdct_win[win + i];
            i = i + 1;
        }
        j = j + 1;
        grb = grb + 18;
        ovl = ovl + 9;
    }
    return 0;
}

var mp_c3: [f64; 3];

fn l3_idct3(x0: f64, x1: f64, x2: f64) -> i64 {
    var m1: f64 = x1 * 0.86602540;
    var a1: f64 = x0 - x2 * 0.5;
    mp_c3[1] = x0 + x2;
    mp_c3[0] = a1 + m1;
    mp_c3[2] = a1 - m1;
    return 0;
}

var mp_x18: [f64; 18];

// x: 18 values at mp_x18 + xo (every third); dst in mp_gr (dk 0) or the
// overlap (dk 1)
fn l3_imdct12(xo: i64, dk: i64, dst: i64, ovl: i64) -> i64 {
    var co0: f64 = 0.0;
    var co1: f64 = 0.0;
    var co2: f64 = 0.0;
    l3_idct3(0.0 - mp_x18[xo], mp_x18[xo + 6] + mp_x18[xo + 3], mp_x18[xo + 12] + mp_x18[xo + 9]);
    co0 = mp_c3[0];
    co1 = mp_c3[1];
    co2 = mp_c3[2];
    l3_idct3(mp_x18[xo + 15], mp_x18[xo + 12] - mp_x18[xo + 9], mp_x18[xo + 6] - mp_x18[xo + 3]);
    mp_c3[1] = 0.0 - mp_c3[1];
    var i: i64 = 0;
    while i < 3 {
        var co: f64 = co0;
        if i == 1 { co = co1; }
        if i == 2 { co = co2; }
        var si: f64 = mp_c3[i];
        var o: f64 = mp_ovl[ovl + i];
        var sum: f64 = co * m3_twid3[3 + i] + si * m3_twid3[i];
        mp_ovl[ovl + i] = co * m3_twid3[i] - si * m3_twid3[3 + i];
        var a: f64 = o * m3_twid3[2 - i] - sum * m3_twid3[5 - i];
        var b: f64 = o * m3_twid3[5 - i] + sum * m3_twid3[2 - i];
        if dk == 0 {
            mp_gr[dst + i] = a;
            mp_gr[dst + 5 - i] = b;
        } else {
            mp_ovl[dst + i] = a;
            mp_ovl[dst + 5 - i] = b;
        }
        i = i + 1;
    }
    return 0;
}

fn l3_imdct_short(grb0: i64, ovl0: i64, nb: i64) -> i64 {
    var grb: i64 = grb0;
    var ovl: i64 = ovl0;
    var n: i64 = nb;
    while n > 0 {
        var k: i64 = 0;
        while k < 18 { mp_x18[k] = mp_gr[grb + k]; k = k + 1; }
        k = 0;
        while k < 6 { mp_gr[grb + k] = mp_ovl[ovl + k]; k = k + 1; }
        l3_imdct12(0, 0, grb + 6, ovl + 6);
        l3_imdct12(1, 0, grb + 12, ovl + 6);
        l3_imdct12(2, 1, ovl, ovl + 6);
        n = n - 1;
        ovl = ovl + 9;
        grb = grb + 18;
    }
    return 0;
}

fn l3_change_sign(grb: i64) -> i64 {
    var at: i64 = grb + 18;
    var b: i64 = 0;
    while b < 32 {
        var i: i64 = 1;
        while i < 18 {
            mp_gr[at + i] = 0.0 - mp_gr[at + i];
            i = i + 2;
        }
        b = b + 2;
        at = at + 36;
    }
    return 0;
}

fn l3_imdct_gr(grb0: i64, ovl0: i64, btype: i64, nlong: i64) -> i64 {
    var grb: i64 = grb0;
    var ovl: i64 = ovl0;
    if nlong != 0 {
        l3_imdct36(grb, ovl, 0, nlong);
        grb = grb + 18 * nlong;
        ovl = ovl + 9 * nlong;
    }
    if btype == 2 {
        l3_imdct_short(grb, ovl, 32 - nlong);
    } else {
        var w: i64 = 0;
        if btype == 3 { w = 18; }
        l3_imdct36(grb, ovl, w, 32 - nlong);
    }
    return 0;
}

// ------------------------------------------------------------ reservoir ---
var mp_main: i64;                // the main data: 511 + 2304 bytes, and room after
var mp_res: [i64; 2560];         // each decoder's reservoir: 512 bytes
var mp_resn: [i64; 5];

fn l3_save_reservoir() -> i64 {
    var pos: i64 = (bs_pos + 7) / 8;
    var remains: i64 = bs_limit / 8 - pos;
    if remains > 511 {
        pos = pos + remains - 511;
        remains = 511;
    }
    var i: i64 = 0;
    while i < remains {
        mp_res[mp_dec * 512 + i] = mp_byte(mp_main + pos + i);
        i = i + 1;
    }
    if remains < 0 { remains = 0; }
    mp_resn[mp_dec] = remains;
    return 0;
}

fn l3_restore_reservoir(mdb: i64) -> i64 {
    var frame_bytes: i64 = (bs_limit - bs_pos) / 8;
    var have: i64 = mp_resn[mp_dec];
    if mdb < have { have = mdb; }
    var start: i64 = mp_resn[mp_dec] - mdb;
    if start < 0 { start = 0; }
    var i: i64 = 0;
    while i < have {
        var b: i64 = mp_res[mp_dec * 512 + start + i];
        raw { poke8(mp_main + i, b); }
        i = i + 1;
    }
    var src: i64 = bs_buf + bs_pos / 8;
    i = 0;
    while i < frame_bytes {
        var b2: i64 = mp_byte(src + i);
        raw { poke8(mp_main + have + i, b2); }
        i = i + 1;
    }
    // what Huffman may read past the end: zeros
    i = 0;
    while i < 8 {
        raw { poke8(mp_main + have + frame_bytes + i, 0); }
        i = i + 1;
    }
    var ok: i64 = 0;
    if mp_resn[mp_dec] >= mdb { ok = 1; }
    bs_init(mp_main, have + frame_bytes);
    return ok;
}

fn l3_decode(h: i64, g0: i64, nch: i64) -> i64 {
    var ch: i64 = 0;
    while ch < nch {
        var limit: i64 = bs_pos + gr_part23[g0 + ch];
        l3_decode_scf(h, g0 + ch, ch);
        l3_huffman(ch * 576, g0 + ch, limit);
        ch = ch + 1;
    }
    if mh_istereo(h) {
        l3_intensity(h, g0);
    } else if mh_ms(h) {
        l3_midside(0, 576);
    }
    ch = 0;
    while ch < nch {
        var g: i64 = g0 + ch;
        var aa: i64 = 31;
        var nlong: i64 = 0;
        if gr_mixed[g] != 0 {
            nlong = 2;
            if mh_mysr(h) == 2 { nlong = 4; }
        }
        if gr_nshort[g] != 0 {
            aa = nlong - 1;
            l3_reorder(ch * 576 + nlong * 18, g, gr_nlong[g]);
        }
        l3_antialias(ch * 576, aa);
        l3_imdct_gr(ch * 576, mp_dec * 576 + ch * 288, gr_btype[g], nlong);
        l3_change_sign(ch * 576);
        ch = ch + 1;
    }
    return 0;
}

// ------------------------------------------------------------ synthesis ---
var mp_tt: [f64; 32];

fn mp_dct2(grb: i64, n: i64) -> i64 {
    var k: i64 = 0;
    while k < n {
        var y: i64 = grb + k;
        var i: i64 = 0;
        while i < 8 {
            var x0: f64 = mp_gr[y + i * 18];
            var x1: f64 = mp_gr[y + (15 - i) * 18];
            var x2: f64 = mp_gr[y + (16 + i) * 18];
            var x3: f64 = mp_gr[y + (31 - i) * 18];
            var t0: f64 = x0 + x3;
            var t1: f64 = x1 + x2;
            var t2: f64 = (x1 - x2) * m3_sec[3 * i];
            var t3: f64 = (x0 - x3) * m3_sec[3 * i + 1];
            mp_tt[i] = t0 + t1;
            mp_tt[8 + i] = (t0 - t1) * m3_sec[3 * i + 2];
            mp_tt[16 + i] = t3 + t2;
            mp_tt[24 + i] = (t3 - t2) * m3_sec[3 * i + 2];
            i = i + 1;
        }
        var q: i64 = 0;
        while q < 4 {
            var x: i64 = q * 8;
            var a0: f64 = mp_tt[x];
            var a1: f64 = mp_tt[x + 1];
            var a2: f64 = mp_tt[x + 2];
            var a3: f64 = mp_tt[x + 3];
            var a4: f64 = mp_tt[x + 4];
            var a5: f64 = mp_tt[x + 5];
            var a6: f64 = mp_tt[x + 6];
            var a7: f64 = mp_tt[x + 7];
            var xt: f64 = a0 - a7;
            a0 = a0 + a7;
            a7 = a1 - a6;
            a1 = a1 + a6;
            a6 = a2 - a5;
            a2 = a2 + a5;
            a5 = a3 - a4;
            a3 = a3 + a4;
            a4 = a0 - a3;
            a0 = a0 + a3;
            a3 = a1 - a2;
            a1 = a1 + a2;
            mp_tt[x] = a0 + a1;
            mp_tt[x + 4] = (a0 - a1) * 0.70710677;
            a5 = a5 + a6;
            a6 = (a6 + a7) * 0.70710677;
            a7 = a7 + xt;
            a3 = (a3 + a4) * 0.70710677;
            a5 = a5 - a7 * 0.198912367;
            a7 = a7 + a5 * 0.382683432;
            a5 = a5 - a7 * 0.198912367;
            a0 = xt - a6;
            xt = xt + a6;
            mp_tt[x + 1] = (xt + a7) * 0.50979561;
            mp_tt[x + 2] = (a4 + a3) * 0.54119611;
            mp_tt[x + 3] = (a0 - a5) * 0.60134488;
            mp_tt[x + 5] = (a0 + a5) * 0.89997619;
            mp_tt[x + 6] = (a4 - a3) * 1.30656302;
            mp_tt[x + 7] = (xt - a7) * 2.56291556;
            q = q + 1;
        }
        i = 0;
        while i < 7 {
            mp_gr[y] = mp_tt[i];
            mp_gr[y + 18] = mp_tt[16 + i] + mp_tt[24 + i] + mp_tt[24 + i + 1];
            mp_gr[y + 36] = mp_tt[8 + i] + mp_tt[8 + i + 1];
            mp_gr[y + 54] = mp_tt[16 + i + 1] + mp_tt[24 + i] + mp_tt[24 + i + 1];
            i = i + 1;
            y = y + 72;
        }
        mp_gr[y] = mp_tt[7];
        mp_gr[y + 18] = mp_tt[16 + 7] + mp_tt[24 + 7];
        mp_gr[y + 36] = mp_tt[8 + 7];
        mp_gr[y + 54] = mp_tt[24 + 7];
        k = k + 1;
    }
    return 0;
}

var mp_lins: [f64; 2112];        // (18 + 15) x 64
var mp_qmf: [f64; 4800];         // each decoder's 15 x 64
var mp_pcm: [f64; 2304];         // the frame's samples, channels interleaved, 32768 full

fn mp_scale(x: f64) -> f64 { return x; }

fn mp_synth_pair(pcm: i64, nch: i64, z0: i64) -> i64 {
    var z: i64 = z0;
    var a: f64 = (mp_lins[z + 14 * 64] - mp_lins[z]) * 29.0;
    a = a + (mp_lins[z + 64] + mp_lins[z + 13 * 64]) * 213.0;
    a = a + (mp_lins[z + 12 * 64] - mp_lins[z + 2 * 64]) * 459.0;
    a = a + (mp_lins[z + 3 * 64] + mp_lins[z + 11 * 64]) * 2037.0;
    a = a + (mp_lins[z + 10 * 64] - mp_lins[z + 4 * 64]) * 5153.0;
    a = a + (mp_lins[z + 5 * 64] + mp_lins[z + 9 * 64]) * 6574.0;
    a = a + (mp_lins[z + 8 * 64] - mp_lins[z + 6 * 64]) * 37489.0;
    a = a + mp_lins[z + 7 * 64] * 75038.0;
    mp_pcm[pcm] = a;
    z = z + 2;
    a = mp_lins[z + 14 * 64] * 104.0;
    a = a + mp_lins[z + 12 * 64] * 1567.0;
    a = a + mp_lins[z + 10 * 64] * 9727.0;
    a = a + mp_lins[z + 8 * 64] * 64019.0;
    a = a + mp_lins[z + 6 * 64] * -9975.0;
    a = a + mp_lins[z + 4 * 64] * -45.0;
    a = a + mp_lins[z + 2 * 64] * 146.0;
    a = a + mp_lins[z] * -5.0;
    mp_pcm[pcm + 16 * nch] = a;
    return 0;
}

var mp_sa: [f64; 4];
var mp_sb: [f64; 4];

fn mp_synth(xl: i64, dstl: i64, nch: i64, lins: i64) -> i64 {
    var xr: i64 = xl + 576 * (nch - 1);
    var dstr: i64 = dstl + (nch - 1);
    var zlin: i64 = lins + 15 * 64;
    mp_lins[zlin + 60] = mp_gr[xl + 18 * 16];
    mp_lins[zlin + 61] = mp_gr[xr + 18 * 16];
    mp_lins[zlin + 62] = mp_gr[xl];
    mp_lins[zlin + 63] = mp_gr[xr];
    mp_lins[zlin + 124] = mp_gr[xl + 1 + 18 * 16];
    mp_lins[zlin + 125] = mp_gr[xr + 1 + 18 * 16];
    mp_lins[zlin + 126] = mp_gr[xl + 1];
    mp_lins[zlin + 127] = mp_gr[xr + 1];
    mp_synth_pair(dstr, nch, lins + 60 + 1);
    mp_synth_pair(dstr + 32 * nch, nch, lins + 60 + 64 + 1);
    mp_synth_pair(dstl, nch, lins + 60);
    mp_synth_pair(dstl + 32 * nch, nch, lins + 60 + 64);
    var i: i64 = 14;
    while i >= 0 {
        mp_lins[zlin + 4 * i] = mp_gr[xl + 18 * (31 - i)];
        mp_lins[zlin + 4 * i + 1] = mp_gr[xr + 18 * (31 - i)];
        mp_lins[zlin + 4 * i + 2] = mp_gr[xl + 1 + 18 * (31 - i)];
        mp_lins[zlin + 4 * i + 3] = mp_gr[xr + 1 + 18 * (31 - i)];
        mp_lins[zlin + 4 * (i + 16)] = mp_gr[xl + 1 + 18 * (1 + i)];
        mp_lins[zlin + 4 * (i + 16) + 1] = mp_gr[xr + 1 + 18 * (1 + i)];
        mp_lins[zlin + 4 * (i - 16) + 2] = mp_gr[xl + 18 * (1 + i)];
        mp_lins[zlin + 4 * (i - 16) + 3] = mp_gr[xr + 18 * (1 + i)];
        var w: i64 = (14 - i) * 16;
        var k: i64 = 0;
        while k < 8 {
            var w0: f64 = m3_win[w + 2 * k];
            var w1: f64 = m3_win[w + 2 * k + 1];
            var vz: i64 = zlin + 4 * i - k * 64;
            var vy: i64 = zlin + 4 * i - (15 - k) * 64;
            var j: i64 = 0;
            while j < 4 {
                var zz: f64 = mp_lins[vz + j];
                var yy: f64 = mp_lins[vy + j];
                var bb: f64 = zz * w1 + yy * w0;
                var aa: f64 = zz * w0 - yy * w1;
                if (k & 1) == 1 {
                    aa = yy * w1 - zz * w0;
                }
                if k == 0 {
                    mp_sb[j] = bb;
                    mp_sa[j] = aa;
                } else {
                    mp_sb[j] = mp_sb[j] + bb;
                    mp_sa[j] = mp_sa[j] + aa;
                }
                j = j + 1;
            }
            k = k + 1;
        }
        mp_pcm[dstr + (15 - i) * nch] = mp_sa[1];
        mp_pcm[dstr + (17 + i) * nch] = mp_sb[1];
        mp_pcm[dstl + (15 - i) * nch] = mp_sa[0];
        mp_pcm[dstl + (17 + i) * nch] = mp_sb[0];
        mp_pcm[dstr + (47 - i) * nch] = mp_sa[3];
        mp_pcm[dstr + (49 + i) * nch] = mp_sb[3];
        mp_pcm[dstl + (47 - i) * nch] = mp_sa[2];
        mp_pcm[dstl + (49 + i) * nch] = mp_sb[2];
        i = i - 1;
    }
    return 0;
}

fn mp_synth_granule(nbands: i64, nch: i64, pcm: i64) -> i64 {
    var i: i64 = 0;
    while i < nch {
        mp_dct2(576 * i, nbands);
        i = i + 1;
    }
    var q: i64 = mp_dec * 960;
    i = 0;
    while i < 960 {
        mp_lins[i] = mp_qmf[q + i];
        i = i + 1;
    }
    i = 0;
    while i < nbands {
        mp_synth(i, pcm + 32 * nch * i, nch, i * 64);
        i = i + 2;
    }
    if nch == 1 {
        i = 0;
        while i < 960 {
            mp_qmf[q + i] = mp_lins[nbands * 64 + i];
            i = i + 2;
        }
    } else {
        i = 0;
        while i < 960 {
            mp_qmf[q + i] = mp_lins[nbands * 64 + i];
            i = i + 1;
        }
    }
    return 0;
}
// ------------------------------------------------------------ the files ---
// five decoders: 0 mp3_open's and audio_load_mp3's, 1 to 4 the streams'
const MP_N: i64 = 5;
var mp_ready: i64;
var mp_file: [i64; 5];           // the file's bytes, a block of the heap
var mp_size: [i64; 5];
var mp_fo: [i64; 5];             // a list: where each frame starts
var mp_nfr: [i64; 5];
var mp_next: [i64; 5];           // the frame decoded next
var mp_hz: [i64; 5];
var mp_ch: [i64; 5];
var mp_spf: [i64; 5];            // frames of sound an MP3 frame gives
var mp_skip: [i64; 5];           // at the start, the encoder's delay
var mp_trim: [i64; 5];           // at the end, its padding
var mp_total: [i64; 5];          // frames of sound in all, delay and padding out
var mp_done: [i64; 5];           // frames given so far
var mp_outn: i64;                // frames of the last decode, at mp_pcm (+ mp_outo)
var mp_outo: i64;                // the first of them that counts

fn mp_init() -> i64 {
    if mp_ready == 1 { return 0; }
    m3_init();
    mp_main = hp_alloc(2900);
    mp_ready = 1;
    return 0;
}

// the decoder d from silence: what one frame keeps for the next cleared
fn mp_reset(d: i64) -> i64 {
    var i: i64 = 0;
    while i < 576 {
        mp_ovl[d * 576 + i] = 0.0;
        i = i + 1;
    }
    i = 0;
    while i < 960 {
        mp_qmf[d * 960 + i] = 0.0;
        i = i + 1;
    }
    mp_resn[d] = 0;
    return 0;
}

// the bytes of an MP3 file into decoder d: its frames found, its tag read
fn mp_load(d: i64, path: i64) -> i64 {
    mp_init();
    var f: i64 = file_open(path, "r");
    if f == 0 {
        fail "cannot read the MP3 file" hint "check the name";
    }
    var size: i64 = file_size(f);
    var buf: i64 = hp_alloc(size + 16);
    if buf == 0 {
        file_close(f);
        fail "no memory for the MP3 file" hint "a shorter one";
    }
    file_read_at(f, 0, buf, size);
    file_close(f);
    if mp_file[d] != 0 { hp_release(mp_file[d]); }
    mp_file[d] = buf;
    mp_size[d] = size;
    mp_fo[d] = list_new();
    var at: i64 = 0;
    // an ID3v2 tag first: its size in four bytes of seven bits
    if size > 10 && mp_byte(buf) == 73 && mp_byte(buf + 1) == 68 && mp_byte(buf + 2) == 51 {
        at = 10 + ((mp_byte(buf + 6) & 127) << 21) + ((mp_byte(buf + 7) & 127) << 14) + ((mp_byte(buf + 8) & 127) << 7) + (mp_byte(buf + 9) & 127);
    }
    var first: i64 = 0;
    while at + 4 <= size {
        var h: i64 = mh_at(buf + at);
        var ok: i64 = 0;
        var fb: i64 = 0;
        if mh_valid(h) {
            fb = mh_bytes(h, 0) + mh_pad(h);
            if fb > 4 {
                if first == 0 {
                    // the first: the one after it has to agree
                    if at + fb + 4 > size || mh_compare(h, mh_at(buf + at + fb)) {
                        ok = 1;
                    }
                } else if mh_compare(first, h) {
                    ok = 1;
                }
            }
        }
        if ok == 1 && at + fb <= size {
            if first == 0 { first = h; }
            list_add(mp_fo[d], at);
            at = at + fb;
        } else {
            at = at + 1;
        }
    }
    mp_nfr[d] = list_len(mp_fo[d]);
    if mp_nfr[d] == 0 {
        fail "this is no MP3 file" hint "no MPEG audio frames were found in it";
    }
    if mh_layer(first) != 1 {
        fail "this MPEG audio is not layer III" hint "Kron reads MP3 (layer III); layers I and II are not read";
    }
    mp_hz[d] = mh_hz(first);
    mp_ch[d] = 2;
    if mh_mono(first) { mp_ch[d] = 1; }
    mp_spf[d] = mh_samples(first);
    mp_skip[d] = 0;
    mp_trim[d] = 0;
    // a Xing or Info frame first: no sound, and (LAME) the delay and the
    // padding the encoder put around the sound
    var f0: i64 = buf + list_get(mp_fo[d], 0);
    var side: i64 = 32;
    if mh_mpeg1(first) == 0 { side = 17; }
    if mh_mono(first) {
        side = 17;
        if mh_mpeg1(first) == 0 { side = 9; }
    }
    var x: i64 = f0 + 4 + side;
    if mh_crc(first) { x = x + 2; }
    var tag: i64 = mh_at(x);
    if tag == 1735289176 || tag == 1868983881 {
        // "Xing", "Info": the fields that follow its flags
        var flags: i64 = mp_byte(x + 7);
        var l: i64 = x + 8;
        if (flags & 1) != 0 { l = l + 4; }
        if (flags & 2) != 0 { l = l + 4; }
        if (flags & 4) != 0 { l = l + 100; }
        if (flags & 8) != 0 { l = l + 4; }
        if mp_byte(l) != 0 {
            // an encoder's tag (LAME, Lavc): the delay and the padding,
            // twelve bits each, 21 bytes in
            var b0: i64 = mp_byte(l + 21);
            var b1: i64 = mp_byte(l + 22);
            var b2: i64 = mp_byte(l + 23);
            mp_skip[d] = ((b0 << 4) | (b1 >> 4)) + 529;
            mp_trim[d] = (((b1 & 15) << 8) | b2) - 529;
            if mp_trim[d] < 0 { mp_trim[d] = 0; }
        }
        list_remove(mp_fo[d], 0);
        mp_nfr[d] = mp_nfr[d] - 1;
    }
    mp_total[d] = mp_nfr[d] * mp_spf[d] - mp_skip[d] - mp_trim[d];
    if mp_total[d] < 0 { mp_total[d] = 0; }
    mp_reset(d);
    mp_next[d] = 0;
    mp_done[d] = 0;
    return 1;
}

// frame k of decoder d: frames of sound it gave (into mp_pcm), 0 when it
// could not be decoded (the bits it needs from before are not there)
fn mp_frame(d: i64, k: i64) -> i64 {
    mp_dec = d;
    var off: i64 = list_get(mp_fo[d], k);
    var p: i64 = mp_file[d] + off;
    var h: i64 = mh_at(p);
    var fsize: i64 = mh_bytes(h, 0) + mh_pad(h);
    if off + fsize > mp_size[d] { return 0; }
    var nch: i64 = 2;
    if mh_mono(h) { nch = 1; }
    bs_init(p + 4, fsize - 4);
    if mh_crc(h) { get_bits(16); }
    var mdb: i64 = l3_side_info(h);
    if mdb < 0 || bs_pos > bs_limit {
        mp_reset(d);
        return 0;
    }
    var ok: i64 = l3_restore_reservoir(mdb);
    if ok == 1 {
        var ngr: i64 = 1;
        if mh_mpeg1(h) { ngr = 2; }
        var igr: i64 = 0;
        while igr < ngr {
            var i: i64 = 0;
            while i < 1152 {
                mp_gr[i] = 0.0;
                i = i + 1;
            }
            l3_decode(h, igr * nch, nch);
            mp_synth_granule(18, nch, igr * 576 * nch);
            igr = igr + 1;
        }
    }
    l3_save_reservoir();
    if ok == 0 { return 0; }
    return mh_samples(h);
}

// the next frame of decoder d: the frames of sound that count in it (the
// delay and the padding left out), -1 at the end of the file
fn mp_next_of(d: i64) -> i64 {
    while mp_next[d] < mp_nfr[d] {
        var k: i64 = mp_next[d];
        mp_next[d] = k + 1;
        var n: i64 = mp_frame(d, k);
        // where these frames fall in the file's sound
        var first: i64 = k * mp_spf[d];
        var lo: i64 = 0;
        if first < mp_skip[d] { lo = mp_skip[d] - first; }
        var end: i64 = mp_skip[d] + mp_total[d];
        var hi: i64 = n;
        if first + hi > end { hi = end - first; }
        if hi < lo { hi = lo; }
        mp_outo = lo;
        mp_outn = hi - lo;
        if n > 0 && mp_outn > 0 {
            mp_done[d] = mp_done[d] + mp_outn;
            return mp_outn;
        }
        if first >= end { return -1; }
    }
    return -1;
}

// sample i of channel c of what mp_next_of gave last: -1 to 1
fn mp_get(d: i64, c: i64, i: i64) -> f64 {
    var ch: i64 = c;
    if mp_ch[d] == 1 { ch = 0; }
    return mp_pcm[(mp_outo + i) * mp_ch[d] + ch] / 32768.0;
}

// decoder d from frame f of its sound: decoded from three MP3 frames
// before, which give the bits and the overlap the first one needs
fn mp_seek_frame(d: i64, f: i64) -> i64 {
    var target: i64 = f + mp_skip[d];
    var k: i64 = target / mp_spf[d];
    var start: i64 = k - 3;
    if start < 0 { start = 0; }
    mp_reset(d);
    var j: i64 = start;
    while j < k && j < mp_nfr[d] {
        mp_frame(d, j);
        j = j + 1;
    }
    mp_next[d] = k;
    mp_done[d] = k * mp_spf[d] - mp_skip[d];
    if mp_done[d] < 0 { mp_done[d] = 0; }
    return target - k * mp_spf[d];
}

// ------------------------------------------------------- what programs use ---
fn mp3_open(path: i64) -> i64 {
    return mp_load(0, path);
}

fn mp3_channels() -> i64 { return mp_ch[0]; }

fn mp3_rate() -> i64 { return mp_hz[0]; }

fn mp3_length() -> i64 { return mp_total[0]; }

fn mp3_next() -> i64 { return mp_next_of(0); }

fn mp3_sample(c: i64, i: i64) -> f64 {
    if c < 0 || c > 1 || i < 0 || i >= mp_outn {
        fail "no such sample" hint "channel 0 or 1, i below what mp3_next gave";
    }
    return mp_get(0, c, i);
}

// the rest of the file open, as stereo i16 frames at rate: the block of the
// heap and how many frames it holds
fn mp3_to_stereo(rate: i64) -> (i64, i64) {
    if rate < 8000 || rate > 192000 {
        fail "no such sample rate" hint "48000 or 44100";
    }
    var nin: i64 = mp_total[0] - mp_done[0];
    if nin <= 0 { nin = 1; }
    var src: i64 = hp_alloc(nin * 4 + 8);
    if src == 0 {
        fail "no memory for the sound" hint "a shorter one";
    }
    var have: i64 = 0;
    var n: i64 = mp_next_of(0);
    while n >= 0 {
        var i: i64 = 0;
        while i < n && have < nin {
            var c: i64 = 0;
            while c < 2 {
                var x: f64 = mp_get(0, c, i) * 32768.0;
                if x > 32767.0 { x = 32767.0; }
                if x < -32768.0 { x = -32768.0; }
                var v: i64 = mp_round(x);
                raw { poke16(src + have * 4 + c * 2, v); }
                c = c + 1;
            }
            have = have + 1;
            i = i + 1;
        }
        n = mp_next_of(0);
    }
    if have == 0 {
        hp_release(src);
        fail "this MP3 file has no sound in it" hint "its frames could not be decoded";
    }
    var hz: i64 = mp_hz[0];
    var nout: i64 = have * rate / hz;
    var p: i64 = hp_alloc(nout * 4 + 8);
    if p == 0 {
        hp_release(src);
        fail "no memory for the sound" hint "a shorter one";
    }
    var o: i64 = 0;
    while o < nout {
        var pos: i64 = o * hz * 65536 / rate;
        var k: i64 = pos >> 16;
        var fr: i64 = pos & 65535;
        var k2: i64 = k + 1;
        if k2 >= have { k2 = have - 1; }
        var c2: i64 = 0;
        while c2 < 2 {
            var a: i64 = au_le16(src + k * 4 + c2 * 2);
            var b: i64 = au_le16(src + k2 * 4 + c2 * 2);
            var w: i64 = a + (b - a) * fr / 65536;
            raw { poke16(p + o * 4 + c2 * 2, w); }
            c2 = c2 + 1;
        }
        o = o + 1;
    }
    hp_release(src);
    return p, nout;
}

// a sample (-1 .. 1) as i16
fn ms_i16(x0: f64) -> i64 {
    var x: f64 = x0 * 32768.0;
    if x > 32767.0 { x = 32767.0; }
    if x < -32768.0 { x = -32768.0; }
    return mp_round(x);
}

// to the nearest whole number, halves away from zero: minimp3's rounding
fn mp_round(x: f64) -> i64 {
    if x >= 0.0 { return (x + 0.5) as i64; }
    return 0 - ((0.5 - x) as i64);
}

fn audio_load_mp3(path: i64) -> i64 {
    if au_on == 0 {
        fail "the sound is not open" hint "audio_open first";
    }
    mp3_open(path);
    var p, frames = mp3_to_stereo(au_rate);
    return au_add_sound(p, frames);
}

// ------------------------------------------------------------- streaming ---
var ms_on: [i64; 5];
var ms_stream: [i64; 5];
var ms_voice: [i64; 5];
var ms_loop: [i64; 5];
var ms_src: [f64; 46080];        // decoded frames not yet resampled, stereo: 9216 a decoder
var ms_n: [i64; 5];
var ms_last: [i64; 5];
var ms_o: [i64; 5];              // frames given to the stream since it started
var ms_base: [i64; 5];           // the frame of the file (looped on) its ms_src starts at
var ms_buf: [i64; 5];
var ms_gen: [i64; 5];            // the audio_open its stream was made under
var ms_hooked: i64;

// the next frames of decoder d into its ms_src; 0 at the end
fn ms_more(d: i64) -> i64 {
    var n: i64 = mp_next_of(d);
    if n < 0 && ms_loop[d] == 1 {
        mp_seek_frame(d, 0);
        n = mp_next_of(d);
    }
    if n < 0 { return 0; }
    var s: i64 = d * 9216;
    var k: i64 = ms_o[d] * mp_hz[d] / au_rate - ms_base[d];
    if k > ms_n[d] { k = ms_n[d]; }
    if k > 0 {
        var i: i64 = 0;
        while i < (ms_n[d] - k) * 2 {
            ms_src[s + i] = ms_src[s + i + k * 2];
            i = i + 1;
        }
        ms_n[d] = ms_n[d] - k;
        ms_base[d] = ms_base[d] + k;
    }
    var j: i64 = 0;
    while j < n && ms_n[d] < 4608 {
        // as i16, as mp3_to_stereo makes them: the same sound streamed or whole
        ms_src[s + ms_n[d] * 2] = ms_i16(mp_get(d, 0, j)) as f64;
        ms_src[s + ms_n[d] * 2 + 1] = ms_i16(mp_get(d, 1, j)) as f64;
        ms_n[d] = ms_n[d] + 1;
        j = j + 1;
    }
    return 1;
}

fn ms_fill_one(d: i64) -> i64 {
    if ms_on[d] == 0 { return 0; }
    if ms_voice[d] != 0 && audio_playing(ms_voice[d]) == 0 {
        ms_on[d] = 0;
        return 0;
    }
    var st: i64 = ms_stream[d];
    var s: i64 = d * 9216;
    var room: i64 = audio_stream_room(st);
    var made: i64 = 0;
    var inbuf: i64 = 0;
    var going: i64 = 1;
    var hz: i64 = mp_hz[d];
    while made < room && going == 1 {
        var pos: i64 = ms_o[d] * hz * 65536 / au_rate;
        var k: i64 = (pos >> 16) - ms_base[d];
        var k2: i64 = k + 1;
        if k2 >= ms_n[d] && ms_last[d] == 0 {
            if ms_more(d) == 0 { ms_last[d] = 1; }
        } else if ms_last[d] == 1 && ms_o[d] >= (ms_base[d] + ms_n[d]) * au_rate / hz {
            going = 0;
        } else {
            if k2 >= ms_n[d] { k2 = ms_n[d] - 1; }
            if k >= ms_n[d] { k = ms_n[d] - 1; }
            if k < 0 { k = 0; }
            if k2 < 0 { k2 = 0; }
            var fr: i64 = pos & 65535;
            var c: i64 = 0;
            while c < 2 {
                var a: i64 = ms_src[s + k * 2 + c] as i64;
                var b: i64 = ms_src[s + k2 * 2 + c] as i64;
                var v: i64 = a + (b - a) * fr / 65536;
                raw { poke16(ms_buf[d] + inbuf * 4 + c * 2, v); }
                c = c + 1;
            }
            ms_o[d] = ms_o[d] + 1;
            inbuf = inbuf + 1;
            made = made + 1;
            if inbuf == 1024 {
                audio_stream_write(st, ms_buf[d], inbuf);
                inbuf = 0;
            }
        }
    }
    if inbuf > 0 { audio_stream_write(st, ms_buf[d], inbuf); }
    if going == 0 {
        audio_stream_end(st);
        ms_on[d] = 0;
    }
    return made;
}

fn ms_fill(arg: i64) -> i64 {
    var made: i64 = 0;
    var d: i64 = 1;
    while d < MP_N {
        made = made + ms_fill_one(d);
        d = d + 1;
    }
    return made;
}

// the stream st from frame (at the device's rate): 1 when it is an MP3's
fn ms_seek(st: i64, frame0: i64) -> i64 {
    var d: i64 = 1;
    var found: i64 = 0;
    while d < MP_N && found == 0 {
        if ms_stream[d] == st && mp_file[d] != 0 { found = d; }
        d = d + 1;
    }
    if found == 0 { return 0; }
    d = found;
    var frame: i64 = frame0;
    var t: i64 = frame * mp_hz[d] / au_rate;
    if mp_total[d] > 0 && t >= mp_total[d] {
        if ms_loop[d] == 1 {
            t = t % mp_total[d];
            frame = t * au_rate / mp_hz[d];
        } else {
            t = mp_total[d];
        }
    }
    var drop: i64 = mp_seek_frame(d, t);
    au_stream_restart(st, frame);
    ms_o[d] = frame;
    ms_base[d] = t - drop;
    if ms_base[d] < 0 { ms_base[d] = 0; }
    ms_n[d] = 0;
    ms_last[d] = 0;
    ms_on[d] = 1;
    ms_fill_one(d);
    return 1;
}

fn audio_stream_mp3(path: i64, volume: f64, looping: i64) -> i64 {
    if au_on == 0 {
        fail "the sound is not open" hint "audio_open first";
    }
    var d: i64 = 0;
    var k: i64 = 1;
    while k < MP_N && d == 0 {
        if ms_on[k] == 0 || ms_voice[k] == 0 || audio_playing(ms_voice[k]) == 0 {
            d = k;
        }
        k = k + 1;
    }
    if d == 0 {
        fail "four MP3 streams are playing already" hint "audio_stop one first, or load a short one whole with audio_load_mp3";
    }
    ms_on[d] = 0;
    mp_load(d, path);
    if ms_stream[d] == 0 || ms_gen[d] != au_gen {
        ms_stream[d] = audio_stream_new(au_rate / 2);
        if ms_buf[d] == 0 { ms_buf[d] = hp_alloc(1024 * 4 + 8); }
        ms_gen[d] = au_gen;
    }
    au_stream_restart(ms_stream[d], 0);
    ms_o[d] = 0;
    ms_base[d] = 0;
    ms_n[d] = 0;
    ms_last[d] = 0;
    ms_loop[d] = looping;
    ms_voice[d] = 0;
    ms_on[d] = 1;
    if ms_hooked == 0 {
        au_add_hook(ms_fill);
        au_add_seekhook(ms_seek);
        ms_hooked = 1;
    }
    ms_fill_one(d);
    ms_voice[d] = audio_stream_play(ms_stream[d], volume);
    return ms_voice[d];
}
